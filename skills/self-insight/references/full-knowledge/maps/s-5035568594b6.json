            "s-5035568594b6-c001:a010",
            "s-5035568594b6-c001:a011"
          ],
          "condition": "当配偶只说不做或推卸责任时"
        },
        {
          "action": "应对责任转移，明确界限",
          "atom_ids": [
            "s-5035568594b6-c001:a013",
            "s-5035568594b6-c001:a014",
            "s-5035568594b6-c001:r004"
          ],
          "condition": "当配偶将父母责任转移给自己时"
        },
        {
          "action": "为金钱设立界限",
          "atom_ids": [
            "s-5035568594b6-c001:a020",
            "s-5035568594b6-c001:a021",
            "s-5035568594b6-c001:r006",
            "s-5035568594b6-c003:a007"
          ],
          "condition": "当夫妻在金钱上有分歧时"
        },
        {
          "action": "使用婚姻交集清单法处理生活方式差异",
          "atom_ids": [
            "s-5035568594b6-c001:a022",
            "s-5035568594b6-c002:a001"
          ],
          "condition": "当夫妻生活方式有差异时"
        },
        {
          "action": "明确恩赐与责任，分配家庭事务",
          "atom_ids": [
            "s-5035568594b6-c002:a002"
          ],
          "condition": "当家庭事务需要分配时"
        },
        {
          "action": "尊重界限，容纳不同观点",
          "atom_ids": [
            "s-5035568594b6-c002:a003",
            "s-5035568594b6-c002:a004"
          ],
          "condition": "当夫妻观点不同或不想谈论某话题时"
        },
        {
          "action": "实现金钱合一或公用透明",
          "atom_ids": [
            "s-5035568594b6-c002:a005",
            "s-5035568594b6-c002:a006",
            "s-5035568594b6-c002:a007",
            "s-5035568594b6-c002:a008",
            "s-5035568594b6-c003:a010"
          ],
          "condition": "当夫妻在金钱管理上有分歧时"
        },
        {
          "action": "满足情感需求，预防精神出轨",
          "atom_ids": [
            "s-5035568594b6-c002:a018",
            "s-5035568594b6-c002:a019",
            "s-5035568594b6-c002:a020"
          ],
          "condition": "当情感需求未满足时"
        },
        {
          "action": "决定是否放弃关系",
          "atom_ids": [
            "s-5035568594b6-c002:a021",
            "s-5035568594b6-c003:a001",
            "s-5035568594b6-c003:a002",
            "s-5035568594b6-c003:r001"
          ],
          "condition": "当配偶不改变且情感需求长期未满足时"
        }
      ]
    }
