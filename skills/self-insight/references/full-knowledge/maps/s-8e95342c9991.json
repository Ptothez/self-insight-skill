{
  "concepts": [
    {
      "name": "专制型育儿",
      "definition": "以父母为导向的育儿方式，父母做主、孩子不需要解释或顶嘴；设置严格规则且无例外；沟通单方面；对孩子情绪反应低；常用惩罚控制；关注身体和学业而非情绪心理社交。",
      "atom_ids": [
        "s-8e95342c9991-c001:a001",
        "s-8e95342c9991-c001:a002",
        "s-8e95342c9991-c001:a003",
        "s-8e95342c9991-c001:a004",
        "s-8e95342c9991-c001:a005",
        "s-8e95342c9991-c001:a006",
        "s-8e95342c9991-c001:r001"
      ]
    },
    {
      "name": "专制型父母的信念与态度",
      "definition": "专制型父母相信孩子不需要解释、不应顶嘴，坚信挫折教育，认为孩子错了要狠狠罚，态度强硬，管教方式缺乏变化。",
      "atom_ids": [
        "s-8e95342c9991-c001:a002",
        "s-8e95342c9991-c001:a025",
        "s-8e95342c9991-c001:a026"
      ]
    },
    {
      "name": "溺爱型育儿",
      "definition": "以孩子为导向的育儿方式，孩子做主，父母回应高但要求低；沟通开放但缺乏引导；规则无界限和后果；父母希望孩子开心，避免冲突，可能自身是讨好型人格。",
      "atom_ids": [
        "s-8e95342c9991-c001:a007",
        "s-8e95342c9991-c001:a008",
        "s-8e95342c9991-c001:a009",
        "s-8e95342c9991-c001:a010",
        "s-8e95342c9991-c001:a011",
        "s-8e95342c9991-c001:a012"
      ]
    },
    {
      "name": "放任式育儿",
      "definition": "父母很少参与孩子生活，回应低、要求低，对孩子情绪和社交需求麻木，很少给规则，可能因父母自身情绪问题或忙碌导致。",
      "atom_ids": [
        "s-8e95342c9991-c001:a013",
        "s-8e95342c9991-c001:a014",
        "s-8e95342c9991-c001:a015",
        "s-8e95342c9991-c001:a018",
        "s-8e95342c9991-c001:a019",
        "s-8e95342c9991-c001:a020"
      ]
    },
    {
      "name": "放任式育儿案例",
      "definition": "具体案例：科学家爸爸描述父亲只关注成绩和惹祸时体罚，其他不关心，感觉成长像白开水；女学员描述父亲传递“只能自己顾自己”，孩子往往独立。",
      "atom_ids": [
        "s-8e95342c9991-c001:a016",
        "s-8e95342c9991-c001:a017"
      ]
    },
    {
      "name": "育儿方式的对比与混合",
      "definition": "专制型要求高回应低，溺爱型回应高要求低；放任式与溺爱型在少规则上相似但回应不同；一般父母可能混合多种方式，对不同孩子倾向不同。",
      "atom_ids": [
        "s-8e95342c9991-c001:a022",
        "s-8e95342c9991-c001:a023",
        "s-8e95342c9991-c001:r002"
      ]
    },
    {
      "name": "让孩子做决定需根据年龄",
      "definition": "给孩子自主权应根据年龄判断，太小承担过多自由和权利对孩子是一种摧毁。",
      "atom_ids": [
        "s-8e95342c9991-c001:a024"
      ]
    },
    {
      "name": "父母处理自身情绪的重要性",
      "definition": "父母应处理好自己的情绪和问题，因为情绪和心理健康会影响育儿方式。",
      "atom_ids": [
        "s-8e95342c9991-c001:a021"
      ]
    }
