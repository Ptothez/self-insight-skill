{
  "concepts": [
    {
      "name": "自信和健康的自我认知",
      "definition": "孩子情绪健康的第二要素，指孩子拥有自信和健康的自我认知。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a001"
      ]
    },
    {
      "name": "建立自信和健康自我认知的方法",
      "definition": "通过三点要求建立：在公共场合夸奖孩子、夸奖要发自内心、夸奖要给予细节。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a002"
      ]
    },
    {
      "name": "在公共场合夸奖孩子",
      "definition": "在公共场合公开夸奖孩子，让孩子感到父母在别人面前认可他，对孩子是鼓励和激动的事情。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a003",
        "s-4d660f06f9e5-c001:r002"
      ]
    },
    {
      "name": "夸奖要发自内心",
      "definition": "夸奖要发自内心，不要花样夸孩子，否则孩子会感觉到夸奖不真诚，夸奖会变得廉价且失去作用。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a004",
        "s-4d660f06f9e5-c001:r003"
      ]
    },
    {
      "name": "夸奖要给予细节",
      "definition": "夸奖孩子时要给予细节，传递出父母真正参与孩子生活的信息，而不是泛泛而夸。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a006",
        "s-4d660f06f9e5-c001:r004"
      ]
    },
    {
      "name": "为孩子设立可行而实际的目标",
      "definition": "建立自信和健康自我认知的第二点，不切实际的目标会让孩子注定失败，导致孩子不自信。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a007"
      ]
    },
    {
      "name": "不切实际目标导致不自信的机制",
      "definition": "不切实际的目标让孩子永远达不到，孩子会得出“我做不到，我不够好”的结论，从而不自信。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a008"
      ]
    },
    {
      "name": "对孩子诚实，分享过去的失败",
      "definition": "建立自信和健康自我认知的第三点，对孩子诚实，分享父母过去的失败。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a010"
      ]
    },
    {
      "name": "孩子认为父母万能的机制",
      "definition": "孩子小的时候容易认为父母是万能的、不会出错的，因此当孩子犯错或失败时，会觉得自己是异类、糟糕的。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a011"
      ]
    },
    {
      "name": "对孩子诚实传递的信息",
      "definition": "对孩子诚实可以传递两点信息：失败是正常的、允许发生的、没什么大不了的，所有人都会遇到；失败后可以再站起来。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a012",
        "s-4d660f06f9e5-c001:r010"
      ]
    },
    {
      "name": "诚实分享失败让孩子有自信",
      "definition": "当父母诚实分享失败并展示自己仍然很好地生活时，孩子会认为“如果爸爸妈妈失败了可以再站起来，那么我也可以”，从而成为有自信的人。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a013"
      ]
    },
    {
      "name": "给其他孩子玩耍的机会",
      "definition": "孩子情绪健康的第三要素，给其他孩子玩耍的机会。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a014"
      ]
    },
    {
      "name": "让孩子出去玩",
      "definition": "一定要让孩子出去玩，去玩脏、去滚、去弄脏自己的身体。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a016",
        "s-4d660f06f9e5-c001:r013"
      ]
    },
    {
      "name": "有非常鼓励、支持他的老师或抚养人",
      "definition": "孩子情绪健康的第四要素，有非常鼓励、支持他的老师或抚养人。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a017"
      ]
    },
    {
      "name": "了解老师的方法",
      "definition": "讲者分享在国外了解自己孩子任课老师的做法：邀请老师吃饭，通过交谈了解其家庭结构、成长经历、性格和教育理念，观察其对好动、犯错等情况的看法，以判断老师的类型与性格。讲者明确说，邀请的目的不是讨好，而是了解老师。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a018",
        "s-4d660f06f9e5-c001:r014"
      ]
    },
    {
      "name": "向老师阐明育儿理念",
      "definition": "在请老师吃饭时，向老师清楚阐明自己的育儿理念，让老师了解孩子可能出现的行为，例如孩子会拒绝不想要的亲密接触。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a019",
        "s-4d660f06f9e5-c001:r015"
      ]
    },
    {
      "name": "安全的环境",
      "definition": "孩子情绪健康的第五要素，包括四点：父母不暴力孩子、父母彼此不暴力、父母有正常的婚姻、家庭有完整的情绪。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a020",
        "s-4d660f06f9e5-c001:r016"
      ]
    },
    {
      "name": "父母不暴力孩子",
      "definition": "不仅指不打孩子，还包括不在身体、思想、心理、情绪上暴力孩子。例如，不冷嘲热讽、不贬低、不强迫身体、不打、不冷暴力。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a021",
        "s-4d660f06f9e5-c001:r017"
      ]
    },
    {
      "name": "孩子哭闹时的陪伴",
      "definition": "当孩子哭闹时，父母不应使用冷暴力把孩子关在房间闭门思过，而应陪孩子待在房间，表达虽然不喜欢孩子的行为，但因为爱孩子所以会陪伴。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a022"
      ]
    },
    {
      "name": "父母彼此不暴力",
      "definition": "父母之间不能有低级暴力，如打架、漫骂、拿刀追砍等。但父母可以有矛盾，并鼓励在孩子面前表现矛盾。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a023"
      ]
    },
    {
      "name": "正常的婚姻",
      "definition": "正常的婚姻是会吵架、会和好、会嫌弃、会称赞、会哭、会笑的，不需要在孩子面前装完美婚姻。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a024"
      ]
    },
    {
      "name": "真实婚姻给孩子安全环境",
      "definition": "孩子需要知道婚姻最真实的状态，这样会给孩子一种安全的环境，因为孩子知道自己是活在真相中的。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a025"
      ]
    },
    {
      "name": "孩子能感知父母演戏",
      "definition": "孩子可能说不出来，但能感觉到父母在演戏，觉得别扭、假。不要以为孩子说不出来就不懂。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a026"
      ]
    },
    {
      "name": "家庭有完整的情绪",
      "definition": "家庭中会有暴怒、后悔、开心、得意、伤心、悲痛、嫉妒等各种情绪，这些情绪都是正常的。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a028"
      ]
    },
    {
      "name": "正确合适的引导和管教",
      "definition": "孩子情绪健康的第六要素，正确合适的引导和管教。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a029"
      ]
    },
    {
      "name": "使用情绪轮帮助孩子识别情绪",
      "definition": "可以使用情绪轮（如随书附赠的情绪轮）帮助孩子从小识别自己的情绪。情绪轮有多层，每层对应不同情绪，颜色对应情绪。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a030"
      ]
    },
    {
      "name": "父母接纳和鼓励孩子的情绪",
      "definition": "父母要接纳和鼓励孩子的情绪，允许孩子有负面情绪，认为孩子有负面情绪是健康的事情，不是灾难而是祝福。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a031"
      ]
    },
    {
      "name": "父母对自己的情绪状态敏感",
      "definition": "父母要对自己的情绪状态敏感，很多父母不敏感，例如明明生气却不承认，或焦虑却不自知。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a032"
      ]
    },
    {
      "name": "孩子情绪健康衡量标准一：喜欢优点讨厌缺点但爱自己",
      "definition": "孩子喜欢自己的优点，讨厌自己的缺点，但仍然爱自己。不是自恋，而是能分辨优缺点，即使不喜欢缺点也爱自己。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a033"
      ]
    },
    {
      "name": "孩子情绪健康衡量标准二：情绪完整",
      "definition": "情绪完整，会哭会笑，但有原因的哭笑，且能自我平衡，收得住，不会停不下来。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a034"
      ]
    },
    {
      "name": "孩子情绪健康衡量标准三：能准确体验自己的情绪",
      "definition": "能准确体验自己的情绪，即使很小说不出来，但能知道自己的情绪，例如能回答是否高兴。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a035"
      ]
    },
    {
      "name": "孩子情绪健康衡量标准四：能够社交",
      "definition": "能够社交。内向的孩子也喜欢和人交往，只是方式不同，如喜欢小范围社交，不喜欢成为焦点。",
      "atom_ids": [
        "s-4d660f06f9e5-c001:a036"
      ]
    },
    {
      "name": "情绪健康孩子的睡眠特征",
      "definition": "情绪健康的孩子睡眠正常，躺下就能睡着。",
      "atom_ids": [
        "s-4d660f06f9e5-c002:a001"
      ]
    },
    {
      "name": "情绪健康孩子的受教意愿",
      "definition": "能够并且愿意受教，这里的受教不是指上学，而是指有开放的心态，愿意听他人说，愿意接受批评，愿意自我反省，承认错误，并愿意改变。",
      "atom_ids": [
        "s-4d660f06f9e5-c002:a002"
      ]
    },
    {
      "name": "情绪健康孩子面对未知的能力",
      "definition": "愿意接受未知，面对未知时能够控制自己的恐惧并继续前进。",
      "atom_ids": [
        "s-4d660f06f9e5-c002:a003"
      ]
    },
    {
      "name": "面对未知能力的发展阶段",
      "definition": "孩子面对未知时控制恐惧并继续的能力是随着年龄发展的。年龄较小的孩子需要在成人的陪伴下，例如牵手时，才能做到。不能要求三岁的孩子独立面对未知并控制恐惧。",
      "atom_ids": [
        "s-4d660f06f9e5-c002:a004"
      ]
    },
    {
      "name": "情绪健康孩子的适应改变能力",
      "definition": "能够适应改变，突然的改变不会让他们抓狂或崩溃。",
      "atom_ids": [
        "s-4d660f06f9e5-c002:a005"
      ]
    },
    {
      "name": "孩子的适应能力通常较强",
      "definition": "一般来讲，孩子的适应能力其实是很强的。有些改变大人觉得可能难以适应，但孩子往往适应得很好。",
      "atom_ids": [
        "s-4d660f06f9e5-c002:a006"
      ]
    },
    {
      "name": "情绪健康孩子的综合标准",
      "definition": "根据孩子不同的年龄，如果孩子具备睡眠正常、能够且愿意受教、愿意接受未知并控制恐惧继续、能够适应改变等特征，则可以说孩子的情绪是健康的。这是衡量孩子情绪健康的标准。",
      "atom_ids": [
        "s-4d660f06f9e5-c002:a007"
      ]
    }
  ],
