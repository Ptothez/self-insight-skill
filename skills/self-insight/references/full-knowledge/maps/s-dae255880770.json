{
  "concepts": [
    {
      "name": "大脑的三个主要区域",
      "definition": "大脑分为三个主要区域：底部是原始区域，中部是情感区域，前部和顶部是思考区域。",
      "atom_ids": [
        "s-dae255880770-c001:a003"
      ]
    },
    {
      "name": "原始区域的功能",
      "definition": "原始区域负责自动发生的基本生命功能，如呼吸和心率，协调基本身体运动如平衡和姿势，并在扫描环境寻找生存威胁中起关键作用，帮助本能部分自动启动。",
      "atom_ids": [
        "s-dae255880770-c001:a005"
      ]
    },
    {
      "name": "情感区域的功能",
      "definition": "情感区域在情绪和社交体验中起重要作用，是愤怒、恐惧、快乐等情绪和冲动的来源；当原始区域检测到威胁时被激活，触发战斗或逃跑反应；驱动许多行为和习惯，并帮助形成记忆并附加情感，尤其在强烈情感如恐惧或快乐时。",
      "atom_ids": [
        "s-dae255880770-c001:a006"
      ]
    },
    {
      "name": "思考区域的功能",
      "definition": "思考区域是最大且最发达的部分，存储记忆，允许计划、想象、分析、寻找解决方案和沟通；能够控制决策和情绪，覆盖原始和情感区域的自动反应；赋予喜好、希望和抱负，使人独特。",
      "atom_ids": [
        "s-dae255880770-c001:a007"
      ]
    },
    {
      "name": "前额叶的功能",
      "definition": "前额叶（prefrontal cortex）是区分人和动物的关键区域，负责高级工作如语言管理、信息处理、重要决策（考虑多维因素和长远后果），并作为冲动时的刹车片，帮助及时停止冲动行为，做出自我控制。",
      "atom_ids": [
        "s-dae255880770-c001:a011"
      ]
    },
    {
      "name": "杏仁核的功能",
      "definition": "杏仁核管理焦虑、危险、恐惧、攻击等紧张情绪。",
      "atom_ids": [
        "s-dae255880770-c001:a016"
      ]
    },
    {
      "name": "压力荷尔蒙",
      "definition": "当感到压力时，杏仁核促使大脑释放两种压力荷尔蒙：肾上腺素和皮质醇，由肾上腺释放，帮助身体做好战斗或逃跑准备，快速应对危险。",
      "atom_ids": [
        "s-dae255880770-c001:a017"
      ]
    },
    {
      "name": "情绪的定义与来源",
      "definition": "情绪是大脑释放的化学信使在身体中传递的效应；大脑会检测威胁或奖励，情感区域通过释放化学信使提醒我们。",
      "atom_ids": [
        "s-dae255880770-c001:a020",
        "s-dae255880770-c002:a001"
      ]
    },
    {
      "name": "威胁与奖励的化学反应",
      "definition": "当大脑检测到潜在威胁时，释放压力荷尔蒙肾上腺素和皮质醇，准备战斗或逃跑；当检测到奖励（如有人对你好）时，释放多巴胺、催产素或血清素，这些化学物质让人感觉良好并激励继续任务或行为。",
      "atom_ids": [
        "s-dae255880770-c001:a021",
        "s-dae255880770-c002:a002",
        "s-dae255880770-c002:a003"
      ]
    },
    {
      "name": "情绪劫持大脑",
      "definition": "有时情感区域的反应非常强烈，会主导我们的行为，使我们无法理性思考，情绪劫持大脑。",
      "atom_ids": [
        "s-dae255880770-c001:a022",
        "s-dae255880770-c001:r001",
        "s-dae255880770-c002:a004",
        "s-dae255880770-c002:a005"
      ]
    },
    {
      "name": "思考对情绪的影响",
      "definition": "思考可以影响情绪，有时可能无益；仅仅思考威胁性事物就能触发情绪反应，因此可以通过意识管理情绪。",
      "atom_ids": [
        "s-dae255880770-c001:a023",
        "s-dae255880770-c001:r002",
        "s-dae255880770-c002:a005"
      ]
    },
    {
      "name": "情绪调节的重要性",
      "definition": "情绪在体验世界中起强大作用；通过思想和行为理解和调节情绪，可以帮助更好地控制大脑并实现目标。",
      "atom_ids": [
        "s-dae255880770-c001:a024",
        "s-dae255880770-c001:r003",
        "s-dae255880770-c002:a006"
      ]
    },
    {
      "name": "左脑活跃与积极情绪和社交",
      "definition": "左脑越活跃，人更可能有更多积极情绪和社交活动；右脑越活跃，人更可能有更多负面情绪和自我封闭。两者相互强化：负面情绪和自我封闭的人右脑更活跃，积极开朗和社交多的孩子左脑更活跃，形成滚雪球效应。",
      "atom_ids": [
        "s-dae255880770-c001:a010"
      ]
    }
  ],
