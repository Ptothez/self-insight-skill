{
  "concepts": [
    {
      "name": "夫妻沟通质量影响孩子情绪与亲密关系认知",
      "definition": "夫妻之间的沟通质量会直接影响孩子对人与人之间亲密关系的认知。当夫妻沟通顺畅时，孩子的心理压力和情绪紧张感较低；如果夫妻一沟通就吵架，孩子会感到紧张，情绪可能变得暴躁或极度自闭，表现为不愿与人沟通或变得好战。",
      "atom_ids": [
        "s-44590c57ff06-c001:a001"
      ]
    },
    {
      "name": "错误沟通方式：你输我赢",
      "definition": "错误的夫妻沟通方式之一是“你输我赢”，即一方必须说服另一方同意自己的观点，沟通变成输赢之争，而不是共同解决问题。",
      "atom_ids": [
        "s-44590c57ff06-c001:a002"
      ]
    },
    {
      "name": "错误沟通方式：不同屏",
      "definition": "错误的夫妻沟通方式之一是“不同屏”，即双方在沟通时谈论的不是同一件事，例如一方在讲感受，另一方在讲解决问题，导致沟通无效。",
      "atom_ids": [
        "s-44590c57ff06-c001:a003"
      ]
    },
    {
      "name": "辣度沟通不同屏案例",
      "definition": "讲师与丈夫因对“辣”的定义不同而产生沟通问题。讲师是重庆人，认为食物不辣；丈夫是广东人，吃后觉得非常辣并生气。后来讲师调整沟通方式，说明“我觉得不辣，有可能对你辣，你自己判断”，并提醒丈夫自己对辣的理解不同。",
      "atom_ids": [
        "s-44590c57ff06-c001:a004"
      ]
    },
    {
      "name": "错误沟通方式：没有主题",
      "definition": "错误的夫妻沟通方式之一是“没有主题”，即沟通时偏离原本的话题，例如从讨论孩子上学问题转到指责对方家庭，导致争吵。",
      "atom_ids": [
        "s-44590c57ff06-c001:a005"
      ]
    },
    {
      "name": "错误沟通方式：事比人重要",
      "definition": "错误的夫妻沟通方式之一是“事比人重要”，即只关注事情本身而忽视对方的感受，导致沟通失败。沟通是两个人之间的事情，人应该放在事情之前。",
      "atom_ids": [
        "s-44590c57ff06-c001:a006"
      ]
    },
    {
      "name": "正确沟通方法：以共赢为目的",
      "definition": "夫妻沟通应以共赢为目的，即双方都感到赢，即使一方让步，也认为整体关系改善是赢。",
      "atom_ids": [
        "s-44590c57ff06-c001:a007"
      ]
    },
    {
      "name": "正确沟通方法：抓住重点",
      "definition": "夫妻沟通时要抓住重点，避免偏离主题。可以在沟通开始前共同拟定要讨论的重点，并在偏离时及时拉回。",
      "atom_ids": [
        "s-44590c57ff06-c001:a008"
      ]
    },
    {
      "name": "正确沟通方法：时刻分享感受",
      "definition": "夫妻沟通时要时刻分享对沟通的感受，例如表达“我觉得今天我们沟通很愉快”，以增强沟通效果。",
      "atom_ids": [
        "s-44590c57ff06-c001:a009"
      ]
    },
    {
      "name": "正确沟通方法：人比事重要",
      "definition": "夫妻沟通时，当感觉可能伤害对方感情或对方尚未理解时，应停下来先处理人的问题，再继续沟通，否则对方可能听不进后续内容。",
      "atom_ids": [
        "s-44590c57ff06-c001:a010"
      ]
    },
    {
      "name": "夫妻共同做决定让孩子感到安全",
      "definition": "夫妻共同做决定（如买房、买家具）会让孩子感到特别安全，并对决定持更积极的态度。如果父母意见不一致，孩子会感到情绪紧张。",
      "atom_ids": [
        "s-44590c57ff06-c001:a011"
      ]
    },
    {
      "name": "错误做决定方式：一个人说了算",
      "definition": "错误的做决定方式之一是“一个人说了算”，例如爸爸或妈妈单方面决定，另一方不参与或事后抱怨，这会导致问题。",
      "atom_ids": [
        "s-44590c57ff06-c001:a012"
      ]
    },
    {
      "name": "错误做决定方式：必须一致同意",
      "definition": "错误的做决定方式之一是认为夫妻必须完全一致同意才能做决定，这会导致难以做决定并影响感情，因为夫妻性格往往不同。",
      "atom_ids": [
        "s-44590c57ff06-c001:a013"
      ]
    },
    {
      "name": "买房决定冲突案例",
      "definition": "讲师想买一套价格合适的房子，但丈夫认为不明朗而反对，讲师因此生气，甚至想如果单身就可以自己决定。后来讲师分析房子优点并与丈夫商量，最终听从丈夫意见，因为丈夫在房产投资方面更有经验。事实证明丈夫的判断正确。",
      "atom_ids": [
        "s-44590c57ff06-c001:a014"
      ]
    },
    {
      "name": "正确做决定方法：共同商量，彼此顺服",
      "definition": "夫妻做决定时应遵循“共同商量，彼此顺服”的原则。首先确定谁在某方面更擅长，如果不擅长则交给专业人士。双方分享意见后，由更懂的一方做决定，做错了也不互相埋怨。",
      "atom_ids": [
        "s-44590c57ff06-c001:a015"
      ]
    },
    {
      "name": "育儿决定顺服案例",
      "definition": "在育儿问题上，讲师丈夫有很多想法，但最终会按照讲师建议做，因为讲师是育儿专家，正确概率更大。丈夫需要时间平息愤怒，但最终会顺服。",
      "atom_ids": [
        "s-44590c57ff06-c001:a016"
      ]
    },
    {
      "name": "夫妻育儿方法不一致影响孩子情绪稳定性",
      "definition": "夫妻育儿方法不一致（如各教各的）会导致孩子情绪不稳定，容易出现极端情绪，柔韧度差。凭经验或感觉育儿也会让孩子在情感上感到混淆和混乱。",
      "atom_ids": [
        "s-44590c57ff06-c001:a017"
      ]
    },
    {
      "name": "正确育儿方式：一起分析讨论",
      "definition": "正确的育儿方式是夫妻一起分析讨论孩子的情况，分享各自观察和意见，并尝试制定方案。例如讲师和丈夫会在送孩子上学后开早会讨论孩子问题，并尝试解决方法。",
      "atom_ids": [
        "s-44590c57ff06-c001:a018"
      ]
    },
    {
      "name": "正确育儿方式：谁学习听谁的",
      "definition": "夫妻育儿时遵循“谁学习听谁的”原则，即谁在某方面投入时间精力更多、学得更多，就听谁的。讲师和丈夫会分享学习内容并讨论，必要时查文献。",
      "atom_ids": [
        "s-44590c57ff06-c001:a019"
      ]
    },
    {
      "name": "夫妻育儿一致让孩子情绪稳定",
      "definition": "当夫妻在育儿上做到一致时，孩子会感到情绪稳定和安全，不必活在恐惧和不知所措中，避免被两个爱的人撕裂。",
      "atom_ids": [
        "s-44590c57ff06-c001:a020"
      ]
    },
    {
      "name": "与父母关系影响孩子对权威的情绪",
      "definition": "夫妻与父母（爷爷奶奶、外公外婆）的关系会影响孩子对权威的情绪。界限是关键，如果爷爷奶奶说了算且没有界限，孩子可能控制权威人物，导致焦虑和极端情绪，并对自己的期待产生错误认知。",
      "atom_ids": [
        "s-44590c57ff06-c001:a021"
      ]
    },
    {
      "name": "界限里的孝敬",
      "definition": "在界限里孝敬父母意味着成年人孝敬父母不等于完全听从。例如，爷爷奶奶不可以体罚孩子，处罚必须由父母执行；如果孩子打爷爷奶奶，老人只能抓住孩子的手并告知父母。这样孩子能清楚知道听谁的，情绪更不容易紊乱。",
      "atom_ids": [
        "s-44590c57ff06-c001:a022"
      ]
    },
    {
      "name": "父母在长辈面前立界限让孩子感到安全",
      "definition": "当父母能够在自己的父母面前为家庭立界限、制止长辈越界行为时，孩子会感受到巨大的安全感。这是研究得出的结论。前提是父母不能甩手把孩子扔给父母不管。",
      "atom_ids": [
        "s-44590c57ff06-c001:a023",
        "s-44590c57ff06-c002:a001"
      ]
    },
    {
      "name": "沟通时使用纸笔辅助保持主题",
      "definition": "夫妻沟通时最好准备一张纸和一支笔，在沟通中时不时判断是否还在主题中，以帮助保持沟通不偏离。",
      "atom_ids": [
        "s-44590c57ff06-c001:r001"
      ]
    },
    {
      "name": "父母设立界限的前提是亲自养育孩子",
      "definition": "父母在长辈面前设立界限能让孩子感到安全，但前提是父母不能把孩子完全交给长辈养育。如果孩子长期（如一周吃住都在爷爷奶奶家）由长辈照顾，孩子会感到混乱，这种情况不在当前讨论范围内。",
      "atom_ids": [
        "s-44590c57ff06-c002:a002"
      ]
    },
    {
      "name": "家庭社交联系促进孩子情绪稳定",
      "definition": "家庭与外界保持联系，如经常有朋友到家里做客或带孩子去别人家做客，能让孩子通过安全的连接和亲密的连接，对人际关系感到自信，并看到父母有良好的人际圈，从而情绪比较稳定。",
      "atom_ids": [
        "s-44590c57ff06-c002:a003"
      ]
    },
    {
      "name": "以家庭为单位对外服务让孩子有力量感和同理心",
      "definition": "以家庭为单位带着孩子对外界服务，会让孩子特别感到有力量感，并且培养同理心。",
      "atom_ids": [
        "s-44590c57ff06-c002:a004"
      ]
    },
    {
      "name": "孩子资助贫困儿童并克制购买冰冻酸奶",
      "definition": "讲师的两个孩子各自资助了一名贫困儿童，每月需支付40美元。孩子需要自己攒钱。老大资助的男孩与他同名且同一天生日，老二资助的男孩与他同一天生日但不同名。两个孩子从未见过资助对象。",
      "atom_ids": [
        "s-44590c57ff06-c002:a005"
      ]
    },
    {
      "name": "孩子为资助而放弃购买冰冻酸奶",
      "definition": "讲师的孩子非常喜欢吃冰冻酸奶，甚至生气时可以用冰冻酸奶立刻原谅别人。一次夏天，孩子刚存够40美元（通过推垃圾桶等方式赚钱），在冰冻酸奶店门口犹豫后，请求妈妈买一个大的，自己只吃三口，因为他的钱要用来帮助另一个与他同名的孩子。讲师很感动，决定买一个送给他吃。",
      "atom_ids": [
        "s-44590c57ff06-c002:a006"
      ]
    },
    {
      "name": "帮助他人带来的满足感支撑情绪自控",
      "definition": "孩子在帮助别人时获得的满足感可以支撑他放弃吃冰淇淋的情绪，说明孩子情绪中有稳定、自控、自制的部分，他清楚知道自己的力量应该放在哪个维度上。这样的孩子不必太担心情绪出问题。",
      "atom_ids": [
        "s-44590c57ff06-c002:a007"
      ]
    },
    {
      "name": "以家庭为单位服务他人使孩子情绪成熟和有责任感",
      "definition": "以家庭为单位服侍别人时，孩子的情绪会变得更加成熟，更有责任感。这种影响不一定立刻可见，但久而久之可以看到孩子的情绪开始变得成熟，只有情绪成熟的孩子才能达到可控、可管理、可监控的状态。",
      "atom_ids": [
        "s-44590c57ff06-c002:a008"
      ]
    },
    {
      "name": "家庭社交关系的两个要点",
      "definition": "家庭与外界的关系主要分为两点：一是与人之间的联系，如朋友到家做客或带孩子去别人家做客；二是对外界的服务，特别是以家庭为单位带着孩子对外界服务。",
      "atom_ids": [
        "s-44590c57ff06-c002:a009"
      ]
    }
  ],
