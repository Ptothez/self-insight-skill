{
  "concepts": [
    {
      "name": "情绪关怀与陪伴质量",
      "definition": "情绪关怀够不够与有没有做到应做之事不同；陪伴可能只是陪玩而未满足真正需要。",
      "atom_ids": [
        "s-8000df081279-c001:a001"
      ]
    },
    {
      "name": "替代活动",
      "definition": "家长需提供替代故事、游戏等活动，否则家长会被故事或游戏替代；需分析孩子喜欢的原因并提供更好替代。",
      "atom_ids": [
        "s-8000df081279-c001:a002",
        "s-8000df081279-c001:a003",
        "s-8000df081279-c001:a007",
        "s-8000df081279-c002:a004"
      ]
    },
    {
      "name": "听力型学习与声音互动",
      "definition": "听力型学习的孩子需要声音互动，家长可用好玩声音讲故事满足需求，电子故事无法满足人际互动。",
      "atom_ids": [
        "s-8000df081279-c001:a004"
      ]
    },
    {
      "name": "人际互动与电子设备吸引力",
      "definition": "人天生喜欢与人玩而非机器，但当人变得不好玩、机器越来越好玩时，孩子转向机器；家长需让自己比电子设备更有趣。",
      "atom_ids": [
        "s-8000df081279-c001:a005",
        "s-8000df081279-c002:a017"
      ]
    },
    {
      "name": "游戏上瘾原因",
      "definition": "游戏上瘾不是因为时间安排不合理，而是从一开始就错了；上瘾与年龄无关，可能因归属感、社交需求、成就感等。",
      "atom_ids": [
        "s-8000df081279-c001:a008",
        "s-8000df081279-c001:a010",
        "s-8000df081279-c001:a016",
        "s-8000df081279-c002:a008"
      ]
    },
    {
      "name": "上瘾判断标准",
      "definition": "判断是否上瘾看能否不玩：若某天不让玩会发疯或强烈抗拒则可能上瘾；欺骗家长也是上瘾标志。",
      "atom_ids": [
        "s-8000df081279-c001:a013",
        "s-8000df081279-c002:a014"
      ]
    },
    {
      "name": "自制力与意愿",
      "definition": "自制力是意愿之间的竞争，人不存在没有自制力，只是用在了别处；孩子半夜玩游戏说明有很强自制力，只是用于游戏。",
      "atom_ids": [
        "s-8000df081279-c001:a015"
      ]
    },
    {
      "name": "界限与没收",
      "definition": "无界限收手机是拿走孩子力量，界限内收手机是给孩子力量；界限明确时孩子会主动遵守规则。",
      "atom_ids": [
        "s-8000df081279-c001:a025",
        "s-8000df081279-c002:a001",
        "s-8000df081279-c002:a002"
      ]
    },
    {
      "name": "家长榜样与电子设备使用",
      "definition": "家长不应在孩子面前使用娱乐性电子设备，应将手机定位为工作工具；家长改变行为可减少孩子对电子设备的兴趣。",
      "atom_ids": [
        "s-8000df081279-c002:a005",
        "s-8000df081279-c002:a006",
        "s-8000df081279-c002:a007"
      ]
    },
    {
      "name": "延迟满足",
      "definition": "延迟满足是预防上瘾的关键能力；培养方法包括让孩子看到失去的东西，通过失去造成痛苦来增强延迟能力。",
      "atom_ids": [
        "s-8000df081279-c002:a018",
        "s-8000df081279-c002:a019",
        "s-8000df081279-c002:a021",
        "s-8000df081279-c002:a022",
        "s-8000df081279-c003:a001",
        "s-8000df081279-c003:a002",
        "s-8000df081279-c003:a005"
      ]
    },
    {
      "name": "逐步减少游戏时间",
      "definition": "减少游戏时间应逐步进行，如每周提前半小时，同时用其他活动填补空出的时间。",
      "atom_ids": [
        "s-8000df081279-c002:a016",
        "s-8000df081279-c002:r001"
      ]
    },
    {
      "name": "隐性控制与选择权",
      "definition": "控制孩子应隐性进行，给孩子选择权，如选择电视节目，避免直接指定导致上瘾。",
      "atom_ids": [
        "s-8000df081279-c002:a012"
      ]
    },
    {
      "name": "情感需求与音乐沉迷",
      "definition": "孩子沉迷音乐反映情感需求未满足，歌词能说出孩子心声；父母需替代音乐回应孩子情绪。",
      "atom_ids": [
        "s-8000df081279-c002:a010"
      ]
    },
    {
      "name": "年龄与自控能力",
      "definition": "三岁半孩子不具备自控能力，不应让其玩手机；上瘾与年龄无关，两三岁到六七岁都可能上瘾。",
      "atom_ids": [
        "s-8000df081279-c002:a011",
        "s-8000df081279-c002:a008"
      ]
    },
    {
      "name": "事实检验学习影响",
      "definition": "当孩子声称听音乐不影响学习时，用事实检验：看作业能否按时完成且正确率90%以上。",
      "atom_ids": [
        "s-8000df081279-c002:a009"
      ]
    },
    {
      "name": "亲子互动与游戏",
      "definition": "亲子打游戏是好的互动，但不能是唯一互动；需同时立界限。",
      "atom_ids": [
        "s-8000df081279-c002:a015"
      ]
    },
    {
      "name": "抓娃娃和盲盒上瘾",
      "definition": "抓娃娃和开盲盒类似，容易上瘾，建议少玩；但手机、电脑、网络不能躲避，只能引导和覆盖。",
      "atom_ids": [
        "s-8000df081279-c002:a013"
      ]
    },
    {
      "name": "同龄人互动需求",
      "definition": "孩子需要跟同龄人玩，若家长忙碌无法陪伴，孩子会转向电子设备；需提供同龄人互动机会。",
      "atom_ids": [
        "s-8000df081279-c001:a018"
      ]
    },
    {
      "name": "家长陪伴与上瘾预防",
      "definition": "家长无法提供高质量陪伴时，不能要求孩子不上瘾；必须提供替代活动。",
      "atom_ids": [
        "s-8000df081279-c001:a019"
      ]
    },
    {
      "name": "运动与游戏价值",
      "definition": "运动不一定比游戏好，游戏不是洪水猛兽，关键是与孩子一起参与。",
      "atom_ids": [
        "s-8000df081279-c001:a011"
      ]
    },
    {
      "name": "多游戏分散与上瘾",
      "definition": "让孩子玩多个游戏分散注意力不能避免上瘾，上瘾是对游戏本身的上瘾。",
      "atom_ids": [
        "s-8000df081279-c001:a012"
      ]
    },
    {
      "name": "固定时间游戏与上瘾",
      "definition": "每天固定时间玩游戏会导致上瘾，建议找一天玩半小时，其他时间不玩。",
      "atom_ids": [
        "s-8000df081279-c001:a014"
      ]
    },
    {
      "name": "社交替代与游戏规则",
      "definition": "若孩子因社交需求半夜玩游戏，可邀请朋友到家光明正大玩，并明确规则。",
      "atom_ids": [
        "s-8000df081279-c001:a017"
      ]
    },
    {
      "name": "案例：名字的孩子喜欢听故事",
      "definition": "家长担心情绪关怀不够导致孩子喜欢听故事，讲师建议用声情并茂方式讲故事替代。",
      "atom_ids": [
        "s-8000df081279-c001:a020"
      ]
    },
    {
      "name": "案例：学员询问游戏时间安排",
      "definition": "学员询问半小时游戏中间是否应运动喝水，讲师建议与孩子一起玩游戏并穿插其他活动；多游戏分散不能避免上瘾。",
      "atom_ids": [
        "s-8000df081279-c001:a021"
      ]
    },
    {
      "name": "案例：学员的孩子每天玩五分钟蛋仔游戏",
      "definition": "学员允许孩子每天玩五分钟蛋仔游戏，讲师认为每天固定玩五分钟会导致上瘾，建议找一天玩半小时。",
      "atom_ids": [
        "s-8000df081279-c001:a022"
      ]
    },
    {
      "name": "案例：学员的孩子半夜玩游戏",
      "definition": "学员的孩子半夜玩游戏，讲师指出孩子有很强自制力，只是用于游戏，建议邀请朋友到家光明正大玩。",
      "atom_ids": [
        "s-8000df081279-c001:a023"
      ]
    },
    {
      "name": "案例：学员忙碌导致孩子看电视",
      "definition": "学员忙碌时让孩子看电视，讲师建议请人做饭腾出时间陪孩子或带孩子到小区玩。",
      "atom_ids": [
        "s-8000df081279-c001:a024"
      ]
    },
    {
      "name": "延迟满足练习：吃糖",
      "definition": "孩子想吃糖时提供选择：马上吃一颗或等待后吃更多；若选择马上吃，家长应继续引导延迟满足。",
      "atom_ids": [
        "s-8000df081279-c002:a019"
      ]
    },
    {
      "name": "孩子拒绝延迟满足时的引导",
      "definition": "若孩子坚持马上吃糖，家长可展示失去的糖并自己吃掉，让孩子看到失去什么。",
      "atom_ids": [
        "s-8000df081279-c002:a020",
        "s-8000df081279-c002:a022",
        "s-8000df081279-c002:r002"
      ]
    },
    {
      "name": "看电视与吃饭冲突的延迟满足方法",
      "definition": "方法一：暂停电视吃完饭再看；方法二：允许继续看电视但延迟吃饭，让吃不上饭成为痛苦。",
      "atom_ids": [
        "s-8000df081279-c003:a004"
      ],
      "limits": [
        "本段未说明孩子拒不关电视时如何处理；同源前文提供了事先约定后果、到时提醒并由孩子自己关电视的例子，未提供强制处置步骤。",
        "方法二可能涉及不让孩子吃饭，需注意健康和安全。"
      ]
    },
    {
      "name": "讲师自家孩子延迟满足案例",
      "definition": "讲师称自己孩子延迟满足能力强，归因于使用让孩子看到失去的方法。",
      "atom_ids": [
        "s-8000df081279-c003:a003"
      ]
    },
    {
      "name": "课后作业",
      "definition": "讲师布置课后作业，要求实践培养延迟满足的方法。",
      "atom_ids": [
        "s-8000df081279-c003:a006"
      ]
    }
