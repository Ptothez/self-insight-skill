{
  "concepts": [
    {
      "name": "父母界限",
      "definition": "父母在原则、价值观和绝对不可触碰的底线上的立场，应持续稳定，不因忙碌或忽视而动摇。",
      "atom_ids": [
        "s-6b4f071bc2e1-c001:a001",
        "s-6b4f071bc2e1-c001:a003",
        "s-6b4f071bc2e1-c001:a004"
      ]
    },
    {
      "name": "自然后果",
      "definition": "与越界行为直接相关的后果，让孩子承担以学习责任，而非无关的惩罚。",
      "atom_ids": [
        "s-6b4f071bc2e1-c001:a010",
        "s-6b4f071bc2e1-c001:a012",
        "s-6b4f071bc2e1-c001:a013"
      ]
    },
    {
      "name": "父母自我反思",
      "definition": "父母将焦点从孩子的问题行为转移到自己身上，反思自己的行为如何影响孩子，并改变自己以帮助孩子。",
      "atom_ids": [
        "s-6b4f071bc2e1-c001:a006",
        "s-6b4f071bc2e1-c001:a007",
        "s-6b4f071bc2e1-c001:a008"
      ]
    },
    {
      "name": "选择权与责任",
      "definition": "界限赋予孩子选择权，不同选择带来不同后果，从而教导孩子为自己的行为负责。",
      "atom_ids": [
        "s-6b4f071bc2e1-c001:a005",
        "s-6b4f071bc2e1-c001:a010"
      ]
    }
  ],
