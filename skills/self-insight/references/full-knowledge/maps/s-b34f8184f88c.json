{
  "concepts": [
    {
      "name": "独立",
      "definition": "孩子离开父母后，可以自己生活、思考、判断、做决定、付出行动，且这一切都可以与父母无关。",
      "atom_ids": [
        "s-b34f8184f88c-c001:a001"
      ]
    },
    {
      "name": "经济独立",
      "definition": "经济独立不是指会挣钱，而是指一个人可以自主花钱，并且在任何情况下都能挣到钱。经济独立是独立的最后一步。",
      "atom_ids": [
        "s-b34f8184f88c-c001:a002",
        "s-b34f8184f88c-c001:a033",
        "s-b34f8184f88c-c001:r001",
        "s-b34f8184f88c-c001:r002",
        "s-b34f8184f88c-c002:a001"
      ]
    },
    {
      "name": "精神独立",
      "definition": "一个人可以不被父母的道德、习惯、文化、习俗、认知甚至宗教所捆绑。",
      "atom_ids": [
        "s-b34f8184f88c-c001:a004",
        "s-b34f8184f88c-c001:a009"
      ]
    },
    {
      "name": "心理独立",
      "definition": "你是你，我是我，我们都有各自的生活。",
      "atom_ids": [
        "s-b34f8184f88c-c001:a021"
      ]
    },
    {
      "name": "情绪独立",
      "definition": "遇到挫折、受伤时不会总是想到找妈妈，能够自己处理情绪。",
      "atom_ids": [
        "s-b34f8184f88c-c002:a011"
      ]
    },
    {
      "name": "认知独立",
      "definition": "不会讨好别人，不需要别人处处肯定，不以别人对自己的评价作为标准。",
      "atom_ids": [
        "s-b34f8184f88c-c002:a016"
      ]
    },
    {
      "name": "独立思考",
      "definition": "不仅思考现有的事情，还能思考尚未出现的事情，能够走一步想三步。",
      "atom_ids": [
        "s-b34f8184f88c-c002:a021"
      ]
    },
    {
      "name": "微管理",
      "definition": "父母在所有事情上都管理孩子，例如叠被子只要叠整齐就好，不需要严格按照父母的方式。",
      "atom_ids": [
        "s-b34f8184f88c-c002:a008"
      ]
    },
    {
      "name": "白日梦",
      "definition": "孩子在独处时间会做白日梦，任何年龄的孩子都会。做白日梦是他自己幻想将来、创造未来，非常重要。",
      "atom_ids": [
        "s-b34f8184f88c-c001:a017"
      ]
    },
    {
      "name": "发呆",
      "definition": "发呆是精神休息，就是脑子开始睡觉。",
      "atom_ids": [
        "s-b34f8184f88c-c001:a018"
      ]
    }
  ],
