{
  "concepts": [
    {
      "name": "错误道歉方式",
      "definition": "父母常见的认错方式中，有些方式是错误的。使用这些方式认错，会导致孩子越来越恨父母，亲子关系越来越糟糕，甚至感觉不如不认错。",
      "atom_ids": [
        "s-b2b900e0045d-c001:a001"
      ]
    },
    {
      "name": "用行为代替言语道歉",
      "definition": "父母不直接口头认错，而是通过间接行为表达歉意，例如做一顿饭、铺被子、买衣服、送礼物、给零花钱等，但不直接说出口。",
      "atom_ids": [
        "s-b2b900e0045d-c001:a002"
      ]
    },
    {
      "name": "一句话道歉",
      "definition": "父母口头道歉，但只说一句“对不起，我错了”或最多加一句“请原谅我”，然后就结束，不深入讨论伤害和情绪。",
      "atom_ids": [
        "s-b2b900e0045d-c001:a007"
      ]
    },
    {
      "name": "流氓式道歉",
      "definition": "先承认错误，但话锋一转，把错误归咎于对方，例如“我不该打你，但是是你气得我没办法”。这种道歉方式危害最大。",
      "atom_ids": [
        "s-b2b900e0045d-c001:a011"
      ]
    },
    {
      "name": "积怨",
      "definition": "没有说出来的、压抑在心里的愤怒，英文为resentment。",
      "atom_ids": [
        "s-b2b900e0045d-c001:a016"
      ]
    },
    {
      "name": "道歉是一门学问",
      "definition": "道歉不是简单的一句话或一个行为，而是一门学问，包含许多需要做的步骤和事情，才能让孩子从伤害中释怀并原谅父母。",
      "atom_ids": [
        "s-b2b900e0045d-c001:a015"
      ]
    }
  ],
