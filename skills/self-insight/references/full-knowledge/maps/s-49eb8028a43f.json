{
  "concepts": [
    {
      "name": "冲突前准备",
      "definition": "在冲突发生前，父母采取的一系列预防措施，包括联想自己年轻时的感受、在小问题上保持灵活、反应过度后道歉、等候时机、谈话前想好用词和顺序、平时多聊轻松话题。",
      "atom_ids": [
        "s-49eb8028a43f-c001:a001",
        "s-49eb8028a43f-c001:a002",
        "s-49eb8028a43f-c001:a003",
        "s-49eb8028a43f-c001:a004",
        "s-49eb8028a43f-c001:a005",
        "s-49eb8028a43f-c001:a006"
      ]
    },
    {
      "name": "冲突中处理",
      "definition": "在冲突发生时，父母应创造时间倾听孩子、公开自己的感受、简单简短说明观点、准备妥协、需要时让步和道歉。",
      "atom_ids": [
        "s-49eb8028a43f-c001:a007",
        "s-49eb8028a43f-c001:a009",
        "s-49eb8028a43f-c001:a010",
        "s-49eb8028a43f-c001:a011",
        "s-49eb8028a43f-c001:a013"
      ]
    },
    {
      "name": "19-25岁阶段矛盾特点",
      "definition": "在19-25岁阶段，矛盾以积怨已形成和关系疏远为特征，处理更困难。",
      "atom_ids": [
        "s-49eb8028a43f-c001:a014",
        "s-49eb8028a43f-c001:a015"
      ]
    },
    {
      "name": "常见错误处理方式",
      "definition": "许多家庭常用避免和逃避尴尬话题、用行动化解矛盾的方式处理矛盾，但无效。",
      "atom_ids": [
        "s-49eb8028a43f-c001:a016",
        "s-49eb8028a43f-c001:a017"
      ]
    },
    {
      "name": "19-25岁阶段处理",
      "definition": "在19-25岁阶段，父母应为过去的事情道歉并改正过去的错误。",
      "atom_ids": [
        "s-49eb8028a43f-c001:a018",
        "s-49eb8028a43f-c001:a019"
      ]
    },
    {
      "name": "青少年大脑发育特点",
      "definition": "青少年的大脑发育特点导致他们可能看不到风险与后果，这不是故意针对父母。",
      "atom_ids": [
        "s-49eb8028a43f-c001:r001"
      ]
    },
    {
      "name": "公开感受的具体例子",
      "definition": "父母公开感受的具体例子，如告诉孩子某些话让自己刺痛、难过，并解释禁止某些事情的原因。",
      "atom_ids": [
        "s-49eb8028a43f-c001:r002"
      ]
    },
    {
      "name": "简短说明观点的具体例子",
      "definition": "父母简单简短说明观点的具体例子，如要求孩子晚上出门告知行踪和同伴。",
      "atom_ids": [
        "s-49eb8028a43f-c001:r003"
      ]
    },
    {
      "name": "改正错误的具体例子",
      "definition": "改正过去错误的具体例子，如尊重隐私和界限、尊重安全感。",
      "atom_ids": [
        "s-49eb8028a43f-c001:r004"
      ]
    },
    {
      "name": "妥协案例",
      "definition": "孩子想将卧室染成黑色，父母折中允许一面墙涂成黑色或两面墙涂成深灰色。",
      "atom_ids": [
        "s-49eb8028a43f-c001:a012"
      ]
    },
    {
      "name": "赢得争辩可能输掉关系",
      "definition": "父母可能赢得一场争辩，但可能输掉与孩子的关系。",
      "atom_ids": [
        "s-49eb8028a43f-c001:a008"
      ]
    }
  ],
