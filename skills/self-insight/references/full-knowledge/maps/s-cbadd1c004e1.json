  "path": [
    {
      "name": "4-6岁儿童教养方法",
      "steps": [
        {
          "action": "理解发展阶段：认识到4-6岁儿童处于主动与内疚阶段，核心是通过游戏探索人际交往能力。",
          "atom_ids": [
            "s-cbadd1c004e1-c001:a001"
          ],
          "condition": "适用于4-6岁儿童"
        },
        {
          "action": "提供游戏机会：让孩子自由玩游戏，通过游戏培养领导力和人际交往能力。",
          "atom_ids": [
            "s-cbadd1c004e1-c001:a002",
            "s-cbadd1c004e1-c001:a003",
            "s-cbadd1c004e1-c001:a004"
          ],
          "condition": "无需付费培训"
        },
        {
          "action": "平衡主动与限制：避免过度抑制或完全不加限制，追求平衡。",
          "atom_ids": [
            "s-cbadd1c004e1-c001:a005",
            "s-cbadd1c004e1-c001:a006",
            "s-cbadd1c004e1-c001:a007"
          ],
          "condition": "父母需注意自己的反应"
        },
        {
          "action": "回应孩子提问：认真对待孩子的问题，避免让孩子觉得被讨厌。",
          "atom_ids": [
            "s-cbadd1c004e1-c001:a008"
          ],
          "condition": "孩子提问时"
        },
        {
          "action": "建立界限：让孩子知道父母的爱是持续性的、有准则的、不改变的。",
          "atom_ids": [
            "s-cbadd1c004e1-c001:a013"
          ],
          "condition": "核心情感需求"
        },
        {
          "action": "塑造自信和自尊：鼓励孩子、倾听孩子、设立切合实际的目标。",
          "atom_ids": [
            "s-cbadd1c004e1-c001:a014",
            "s-cbadd1c004e1-c001:a015",
            "s-cbadd1c004e1-c001:a016"
          ],
          "condition": "父母积极参与"
        },
        {
          "action": "诚实面对失败：不隐瞒失败，避免讽刺性言论。",
          "atom_ids": [
            "s-cbadd1c004e1-c001:a018",
            "s-cbadd1c004e1-c001:a019"
          ],
          "condition": "孩子失败时"
        },
        {
          "action": "管教方式：批评行为而非孩子，允许犯错，避免喋喋不休、威胁、贿赂。",
          "atom_ids": [
            "s-cbadd1c004e1-c001:a020",
            "s-cbadd1c004e1-c001:a021",
            "s-cbadd1c004e1-c001:a022",
            "s-cbadd1c004e1-c001:a023"
          ],
          "condition": "管教时"
        }
      ]
    }
