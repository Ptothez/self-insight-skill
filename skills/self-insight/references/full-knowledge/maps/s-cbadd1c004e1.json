{
  "concepts": [
    {
      "name": "主动与内疚阶段",
      "definition": "4-6岁儿童处于主动与内疚的发展阶段，核心是通过游戏探索人际交往能力，而非学业内容。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a001"
      ]
    },
    {
      "name": "游戏的作用",
      "definition": "游戏让孩子通过发起活动、办家家酒等方式探索人际交往能力，并开始认知自己的能力，如计划游戏。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a002"
      ]
    },
    {
      "name": "游戏培养领导力",
      "definition": "通过游戏中的互动、配合、比赛和处理矛盾，孩子能发展主动意识、领导他人和做决定的倾向，从而自然形成领导力。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a003"
      ]
    },
    {
      "name": "免费游戏与付费领导力培训的对比",
      "definition": "让孩子自由玩游戏即可培养领导力，无需花钱参加领导力培训；游戏还能让孩子处理矛盾，且孩子开心。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a004"
      ]
    },
    {
      "name": "过度抑制导致内疚感",
      "definition": "如果父母通过批评、呵斥、指责、控制来抑制4-6岁孩子的躁动倾向，孩子容易产生内疚感。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a005"
      ]
    },
    {
      "name": "孩子以强悍能力标识独立性",
      "definition": "4-6岁孩子往往以快速、粗暴、强悍的能力作为标识来印证独立性，但父母倾向于惩罚或过多限制其主动性。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a006"
      ]
    },
    {
      "name": "平衡主动与限制",
      "definition": "父母不应完全不加限制，也不应过度限制，需在主动性和限制之间追求平衡，避免两极化。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a007"
      ]
    },
    {
      "name": "孩子提问与父母反应的影响",
      "definition": "4-6岁孩子开始提出很多问题，如果父母将问题视为琐碎、烦人、讨厌或尴尬，孩子可能觉得父母讨厌他。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a008"
      ]
    },
    {
      "name": "过分内疚抑制互动与创造力",
      "definition": "孩子对父母的讨厌感到内疚，过分内疚会让孩子与其他人的互动变慢，并抑制创造力和想象力。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a009"
      ]
    },
    {
      "name": "健康内疚的必要性",
      "definition": "当孩子伤害他人或扔东西时，内疚是必要的，否则孩子无法学会自我控制和行为准则。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a010"
      ]
    },
    {
      "name": "主动与内疚的健康平衡",
      "definition": "在主动和内疚之间保持健康平衡非常重要，成功则孩子成为自信的人，失败则孩子经常有醉酒感（内疚感）。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a011"
      ]
    },
    {
      "name": "客人对他人吵架产生醉酒感",
      "definition": "一位客人在公交车上听到两个人吵架，第一反应是这两人因她而吵架，尽管他们不认识她，这反映了失败阶段的内疚感。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a012"
      ]
    },
    {
      "name": "4-6岁核心情感需求：界限",
      "definition": "4-6岁孩子的核心情感需求是界限而非惩罚，孩子需要知道父母的爱是持续性的、有准则的、不改变的。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a013"
      ]
    },
    {
      "name": "塑造自信心和自尊心",
      "definition": "通过鼓励孩子踏出第一步或学习新游戏，帮助培养对世界的好奇心和了解周围的愿望，让孩子在安全环境中探索和玩耍，同时父母积极参与孩子的活动，给予注意力以建立自信和自尊。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a014"
      ]
    },
    {
      "name": "倾听孩子以建立自信",
      "definition": "当孩子说话时，父母应放下手上的事情，蹲下来看着孩子的眼睛，仔细听孩子说话，以帮助建立自信和自尊。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a015"
      ]
    },
    {
      "name": "设立切合实际的目标",
      "definition": "为孩子设立的目标应与他们的能力相匹配；年龄大的孩子应给予能增加自信心的活动，例如让孩子帮忙切菜。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a016"
      ]
    },
    {
      "name": "六岁孩子仍被喂饭的案例",
      "definition": "一个富裕家庭中，妈妈让六岁孩子坐在幼儿餐椅上喂饭，讲师认为妈妈因自身心理问题需要孩子依赖她来获得价值感，这样会培养出胆小、懦弱、胆怯的孩子。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a017"
      ]
    },
    {
      "name": "诚实面对失败",
      "definition": "父母不要向孩子隐瞒失败，让孩子知道人一定会失败和犯错，父母也不完美，也有软弱。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a018"
      ]
    },
    {
      "name": "避免讽刺性言论",
      "definition": "避免对孩子说“输不起”“小气”等讽刺性言论，因为孩子输了后需要鼓舞士气，这类话会伤害打击孩子。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a019"
      ]
    },
    {
      "name": "批评行为而非孩子",
      "definition": "批评孩子的行为，而不是批评孩子本身；告诉孩子“你做了一件错的事情，但你不是一个错误的人”，让孩子理解行为与人的区别。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a020"
      ]
    },
    {
      "name": "允许孩子犯错并避免不当管教方式",
      "definition": "允许孩子犯错，避免对孩子喋喋不休、威胁或贿赂（如用甜品奖励），否则孩子会忽略父母的话。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a021"
      ]
    },
    {
      "name": "催促穿鞋的对比案例",
      "definition": "讲师丈夫反复催促孩子穿鞋无效，而讲师采用“我现在上车，如果你还没穿鞋，我就走了”的方式，孩子马上过来，说明避免喋喋不休、用行动和后果更有效。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a022"
      ]
    },
    {
      "name": "让孩子自己做判断",
      "definition": "告诉孩子管教的原因和行为可能带来的潜在后果，然后给孩子自己做判断的权利；此年龄孩子犯不了大错，但需在安全前提下进行。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a023"
      ]
    },
    {
      "name": "阶段失败的后果",
      "definition": "如果此阶段失败，孩子会讨厌自己，感到深深的自卑，并在13岁以后可能出现自残自杀的情况。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:a024"
      ]
    },
    {
      "name": "4-6岁男孩的躁动倾向",
      "definition": "4-6岁男孩可能除了睡觉外不停活动，整个人躁动，这是该年龄段的常见表现。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:r001"
      ]
    },
    {
      "name": "孩子对父母讨厌的内疚感",
      "definition": "如果孩子觉得父母讨厌他，他会对父母的讨厌感到内疚，这种内疚可能影响其互动和创造力。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:r002"
      ]
    },
    {
      "name": "避免贿赂孩子",
      "definition": "避免用甜品、奖励等贿赂孩子，否则孩子很快会忽略父母的话。",
      "atom_ids": [
        "s-cbadd1c004e1-c001:r003"
      ]
    }
  ],
