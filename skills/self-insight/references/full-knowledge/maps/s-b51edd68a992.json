{
  "concepts": [
    {
      "name": "儿童退缩的健康反应",
      "definition": "三岁半以下儿童遇到困难时，退缩是自然的、健康的反应；迎难而上反而危险。",
      "atom_ids": [
        "s-b51edd68a992-c001:a001"
      ]
    },
    {
      "name": "训练勇敢的方法",
      "definition": "给孩子稍加努力就能完成的目标，鼓励尝试新鲜事情，允许经历轻微伤害（非大问题）。",
      "atom_ids": [
        "s-b51edd68a992-c001:a002"
      ]
    },
    {
      "name": "经历轻微伤害减少恐惧",
      "definition": "孩子经历轻微伤害后知道能恢复，从而减少对困难事情的恐惧。",
      "atom_ids": [
        "s-b51edd68a992-c001:a004"
      ]
    },
    {
      "name": "正确称赞方式",
      "definition": "称赞应针对努力而非结果，描述具体努力过程。",
      "atom_ids": [
        "s-b51edd68a992-c001:a005"
      ]
    },
    {
      "name": "错误称赞方式",
      "definition": "针对结果的称赞（如比赛得第一名）不利于培养勇敢品质。",
      "atom_ids": [
        "s-b51edd68a992-c001:a006"
      ]
    },
    {
      "name": "退缩时批评或比较的负面影响",
      "definition": "批评孩子胆小或与他人比较会加重恐惧，让孩子更想逃避挑战。",
      "atom_ids": [
        "s-b51edd68a992-c001:a007"
      ]
    },
    {
      "name": "不必挽回",
      "definition": "对于情绪失控留下阴影的妈妈，孩子还小，不必挽回；挽回心态不利于建立界限和安全感。",
      "atom_ids": [
        "s-b51edd68a992-c001:a008"
      ]
    },
    {
      "name": "疫情导致的温柔是暂时的",
      "definition": "因疫情空闲而温柔可能是暂时的，恢复正常生活后可能复发，需处理根本问题。",
      "atom_ids": [
        "s-b51edd68a992-c001:a009"
      ]
    },
    {
      "name": "寻求专业心理辅导",
      "definition": "建议找专业心理辅导处理情绪阻塞，可能原因包括产后抑郁、原生家庭问题等。",
      "atom_ids": [
        "s-b51edd68a992-c001:a010"
      ]
    },
    {
      "name": "好的心理辅导标准",
      "definition": "好的心理辅导讲话不超过5%，且其中90%为提问。",
      "atom_ids": [
        "s-b51edd68a992-c001:a011"
      ]
    },
    {
      "name": "糟糕心理辅导特征",
      "definition": "一直给建议、开导，或不分青红皂白叫吃药的心理辅导不专业。",
      "atom_ids": [
        "s-b51edd68a992-c001:a012",
        "s-b51edd68a992-c001:a013"
      ]
    },
    {
      "name": "新课程《打败焦虑并不难》",
      "definition": "课程分三部分：常见焦虑处理、青少年焦虑、父母帮助焦虑孩子。",
      "atom_ids": [
        "s-b51edd68a992-c001:a014"
      ]
    }
  ],
