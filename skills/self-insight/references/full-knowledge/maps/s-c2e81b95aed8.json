{
  "concepts": [
    {
      "name": "情绪塑造",
      "definition": "情绪不能被控制或抑制，但可以被重新塑造。成功的人并非一帆风顺，而是经历艰难后能继续前行。",
      "atom_ids": [
        "s-c2e81b95aed8-c001:a001"
      ]
    },
    {
      "name": "情绪抵抗力",
      "definition": "情绪抵抗力如同房子的地基，重塑情绪如同在地基上建房子。在情绪之前建立情绪抵抗力，情绪中间用情绪连接帮助走出，情绪之后重塑情绪。",
      "atom_ids": [
        "s-c2e81b95aed8-c001:a003"
      ]
    },
    {
      "name": "情绪误区",
      "definition": "重塑情绪时常见的错误做法，包括否认负面情绪、压抑情绪、忽略情绪、让自己变得更强大、盲目原谅。",
      "atom_ids": [
        "s-c2e81b95aed8-c001:a004",
        "s-c2e81b95aed8-c001:a005",
        "s-c2e81b95aed8-c001:a006",
        "s-c2e81b95aed8-c001:a007",
        "s-c2e81b95aed8-c001:a009"
      ]
    },
    {
      "name": "情绪第一定律",
      "definition": "情绪本身是中性的，没有好坏之分，但对情绪的反应有好坏之分。",
      "atom_ids": [
        "s-c2e81b95aed8-c001:a010"
      ]
    },
    {
      "name": "情绪第二定律",
      "definition": "情绪不能被压制，但可以被监管。监管情绪是分辨人类和动物的重要区别，由前额叶负责。压制情绪会阻止体验和表达感受，且常是无意识的。",
      "atom_ids": [
        "s-c2e81b95aed8-c001:a011"
      ]
    },
    {
      "name": "情绪第三定律",
      "definition": "情绪是必要的，让生命成为生命，让一个人活起来。没有情绪的人像机器，无法亲近，但情绪让生命丰盛。",
      "atom_ids": [
        "s-c2e81b95aed8-c001:a014"
      ]
    },
    {
      "name": "无意识情绪压抑",
      "definition": "个体在无意识中压制情绪，导致无法体验和表达感受，常源于创伤经历。",
      "atom_ids": [
        "s-c2e81b95aed8-c001:a012",
        "s-c2e81b95aed8-c001:r001"
      ]
    },
    {
      "name": "情绪稳定与无情绪的区别",
      "definition": "情绪稳定不等于没有情绪；没有情绪的人可能看似稳定，但缺乏情绪沟通，会导致关系问题。",
      "atom_ids": [
        "s-c2e81b95aed8-c002:a006"
      ]
    },
    {
      "name": "情绪沟通困难",
      "definition": "有些人可以谈论具体事务，但一谈情绪就说不出来，好像被堵住；被问及自己的情绪时整个人都是堵着的，因为很少想过自己的情绪是什么。",
      "atom_ids": [
        "s-c2e81b95aed8-c002:r001"
      ]
    },
    {
      "name": "情绪工具化倾向",
      "definition": "很多人觉得情绪没有必要、太麻烦，甚至希望伴侣是没有情绪的工具；这种观念导致对情绪的忽视和排斥。",
      "atom_ids": [
        "s-c2e81b95aed8-c002:r002"
      ]
    },
    {
      "name": "情绪丰富与灵气",
      "definition": "一个人很有灵气，是因为他里面有很多的情绪；情绪是让一个生命丰盛起来的东西。",
      "atom_ids": [
        "s-c2e81b95aed8-c002:r003"
      ]
    },
    {
      "name": "无情绪伴侣的吸引力与风险",
      "definition": "无情绪的人可能显得非常稳定，能接住错误而不波动，对来自暴力家庭的人有吸引力；但长期缺乏情绪沟通会导致婚姻痛苦。",
      "atom_ids": [
        "s-c2e81b95aed8-c002:r004"
      ]
    }
  ],
