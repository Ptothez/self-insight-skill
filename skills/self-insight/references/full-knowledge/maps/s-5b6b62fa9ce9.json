{
  "concepts": [
    {
      "name": "左脑时间概念发展",
      "definition": "左脑负责处理时间概念，儿童在八九岁左右才开始慢慢形成时间概念，并逐渐发展出认识钟表时间的能力。",
      "atom_ids": [
        "s-5b6b62fa9ce9-c001:a001"
      ]
    },
    {
      "name": "右脑视觉能力",
      "definition": "右脑负责视觉能力，在儿童期已经发育得非常好。",
      "atom_ids": [
        "s-5b6b62fa9ce9-c001:a002"
      ]
    },
    {
      "name": "左右脑互补策略",
      "definition": "利用右脑视觉能力弥补左脑时间概念缺陷，通过视觉辅助帮助儿童建立时间观念。",
      "atom_ids": [
        "s-5b6b62fa9ce9-c001:a003",
        "s-5b6b62fa9ce9-c001:a006"
      ]
    },
    {
      "name": "变色闹钟时间管理法",
      "definition": "使用会随时间改变颜色的闹钟帮助孩子管理时间：设定30分钟为绿色，20分钟为黄色，10分钟为红色，并事先约定颜色对应的剩余时间和任务进度。",
      "atom_ids": [
        "s-5b6b62fa9ce9-c001:a004"
      ]
    },
    {
      "name": "沙漏时间管理法",
      "definition": "当孩子稍大时，可以在面前放一个沙漏，让孩子随时看见沙漏漏沙程度，从而判断剩余作业时间。",
      "atom_ids": [
        "s-5b6b62fa9ce9-c001:a005"
      ]
    },
    {
      "name": "高中生想象力记忆案例",
      "definition": "16岁高中生利用想象力将枯燥历史事实编成故事记忆，成绩从不及格变为A，体现右脑长处弥补左脑短板。",
      "atom_ids": [
        "s-5b6b62fa9ce9-c001:a007"
      ]
    },
    {
      "name": "儿童时间概念缺失",
      "definition": "五六岁孩子不理解五分钟的具体含义，因为左脑尚未发展出处理时间的能力，并非故意耍赖。",
      "atom_ids": [
        "s-5b6b62fa9ce9-c001:a008"
      ]
    },
    {
      "name": "家长时间观念问题",
      "definition": "家长常问如何让孩子有时间观念，如何让孩子把十分钟的作业不在一个小时内完成。",
      "atom_ids": [
        "s-5b6b62fa9ce9-c001:a009"
      ]
    },
    {
      "name": "下期预告",
      "definition": "下期节目将讨论孩子在发脾气或生气时，家长应如何面对他们的负面情绪。",
      "atom_ids": [
        "s-5b6b62fa9ce9-c001:a010"
      ]
    }
  ],
