{
  "concepts": [
    {
      "name": "家庭用餐作为沟通时机",
      "definition": "家庭用餐是重要的沟通时机，因为用餐时大家情绪放松、不忙，可以放松下来交流。应有计划地安排每周几次家庭共餐，让晚餐变得有趣，孩子们喜欢聊天分享学校发生的事情。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r001"
      ]
    },
    {
      "name": "用餐时的沟通规则",
      "definition": "用餐时不要一直催促孩子快吃饭，也不要一听孩子讲点什么就批评他，让孩子多讲话。让每个人参与准备和清洗晚餐，一起忙事情有助于关系亲密和连接。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r002"
      ]
    },
    {
      "name": "用餐时收起手机",
      "definition": "用餐时要把手机放好，例如放在篮子里反过来扣住，提醒大家没有在看手机，好好利用晚餐时间。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r003"
      ]
    },
    {
      "name": "该年龄段孩子不应需要哄睡",
      "definition": "这个年龄的孩子应该不需要再哄睡了，如果还需要哄睡，那是很大的问题。孩子的睡眠绝对比他这个时候多做几页作业更重要。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r004"
      ]
    },
    {
      "name": "固定睡觉时间前与孩子聊天",
      "definition": "孩子有固定睡觉时间时，可以在睡觉时间之前跟孩子聊天，一起读书，回顾今天的亮点。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r005"
      ]
    },
    {
      "name": "因作业晚导致沟通时间被挤压",
      "definition": "常见问题是孩子做作业到很晚，吃饭时被催促快吃去做作业，睡觉时也匆忙，导致吃饭和睡前都没有时间聊天。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r006"
      ]
    },
    {
      "name": "每晚三个问题总结一天",
      "definition": "每天晚上问孩子三个问题：今天最开心的事情是什么？今天最不开心的事情是什么？今天最期待明天发生的事情是什么？以此给孩子的一天做总结，促进沟通。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r007"
      ]
    },
    {
      "name": "开车时作为沟通时机",
      "definition": "开车送孩子上学放学或去其他地方时，是沟通的好时机。因为眼睛望着前方，可以避免尴尬，孩子更倾向于说一些让他感到困扰、尴尬或羞耻的事情。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r008"
      ]
    },
    {
      "name": "避免眼神交流降低沟通压力",
      "definition": "开车时因为不能眼神交流，反而让孩子更轻松自在，缓解不适感，更愿意开口。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r009"
      ]
    },
    {
      "name": "开车时避免打电话和开收音机",
      "definition": "开车时不要打电话或一开车就打开收音机，要给孩子一些空间，看看他是否想说一些平时不太好开口的事情。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r010"
      ]
    },
    {
      "name": "通过共同活动分享日常",
      "definition": "分享日常生活，找一些可以一起做的事情，如一起遛狗、跑步、洗车、烤饼干，在做事情的过程中有一句没一句地聊天，给孩子谈论自己想法的机会。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r011"
      ]
    },
    {
      "name": "做事情时思想放松更易表达真实想法",
      "definition": "在做事情时，孩子的思想更加放松，更能够告诉你他们内心真实的想法。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r012"
      ]
    },
    {
      "name": "向孩子表达爱的重要性",
      "definition": "在这个阶段，很多父母忽略向孩子表达爱，但表达爱非常有价值，会让孩子感到安全和被爱，并展示积极健康的情感表达方式。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r013"
      ]
    },
    {
      "name": "公共场合孩子可能抗拒亲密表达",
      "definition": "孩子开始懂事，在公共场合可能对父母表达爱更加抗拒、不自然，例如每天上学亲吻可能被拒绝。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r014"
      ]
    },
    {
      "name": "尊重孩子的情感表达方式",
      "definition": "当孩子对亲密表达感到不自在时，要尊重他，可以改用挥手、拍拍背等方式表达爱，不一定要用以前的方法。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r015"
      ]
    },
    {
      "name": "向孩子发出赞叹",
      "definition": "父母应该足够了解孩子，看到他的长项、天赋、素质人品和能力，经常不断地向孩子说出来，发出赞叹。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r016"
      ]
    },
    {
      "name": "赞叹孩子踢球的具体例子",
      "definition": "例如对孩子说：你今天踢球脚好快，虽然你没有别人高，但翻脚翻得很快。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r017"
      ]
    },
    {
      "name": "中国父母认为称赞会让孩子骄傲",
      "definition": "很多中国父母秉承孩子不能称赞的思想，认为称赞了就会骄傲。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r018"
      ]
    },
    {
      "name": "母亲称赞跑步像小豹子",
      "definition": "讲师回忆自己母亲曾称赞她跑步像一头小豹子，气势无人能争，这个称赞让她至今记得，感到骄傲自豪，豹也成为她最喜欢的动物之一。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r019"
      ]
    },
    {
      "name": "父母称赞对孩子影响深远",
      "definition": "父母在称赞孩子时，可以带给孩子很大的影响，即使看似无关紧要的称赞也可能深深留在孩子心中。",
      "atom_ids": [
        "s-4f8c28d59810-c001:r020"
      ]
    }
  ],
