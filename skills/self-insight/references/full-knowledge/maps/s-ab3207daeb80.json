{
  "concepts": [
    {
      "name": "双赢模式",
      "definition": "亲子关系中双方处于共赢状态，而非对立、你输我赢或我输你赢的模式。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a001"
      ]
    },
    {
      "name": "非双赢模式的后果",
      "definition": "如果亲子关系不是双赢模式，容易出现对立，变成你输我赢或我输你赢的对立模式。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a002"
      ]
    },
    {
      "name": "亲子角色反思",
      "definition": "父母应反思自己在家庭中的角色以及与孩子的关系，判断是否处于对立状态。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a003"
      ]
    },
    {
      "name": "孩子一生追求父母认可",
      "definition": "心理咨询室中许多孩子一生都希望父母以他们为荣，这源于缺乏双赢模式。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a004"
      ]
    },
    {
      "name": "父母害怕失去崇拜",
      "definition": "许多父母害怕孩子超越自己后不再获得孩子的崇拜和尊敬，因此可能压制孩子。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a005"
      ]
    },
    {
      "name": "双赢提高执行意愿",
      "definition": "双赢过程中孩子参与讨论和讨价还价，因此更愿意执行讨论出的结果。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a006"
      ]
    },
    {
      "name": "双赢培养创造力和变通力",
      "definition": "双赢过程帮助孩子练习创造力和变通力，从而找到双方都想要的结果。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a007"
      ]
    },
    {
      "name": "双赢模式下孩子解决冲突",
      "definition": "一位家长担心自己孩子与别人打架，但发现该孩子与讲师家孩子玩耍时不打架，因为讲师家孩子总能找到方法解决矛盾，让双方都得到想要的。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a008"
      ]
    },
    {
      "name": "双赢鼓励思考和责任",
      "definition": "双赢过程鼓励孩子思考并接受问题的责任和答案，因为孩子参与思考双方可以退让什么，并对最终决定负责。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a009"
      ]
    },
    {
      "name": "孩子不负责的表现",
      "definition": "孩子遇到困难就扔给父母，不思考，好像事情是父母的事，因为孩子没有学会对自己的事情负责。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a010"
      ]
    },
    {
      "name": "双赢避免强迫",
      "definition": "双赢让父母不必站在权威角色用强迫执行解决方法，而是共同讨论参与。强迫会导致孩子不信任、反抗和关系疏远。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a011"
      ]
    },
    {
      "name": "双赢减少指责和矛盾",
      "definition": "双赢避免单方面解决问题，双方共同负责，减少指责和矛盾。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a012"
      ]
    },
    {
      "name": "双赢促进孩子自觉",
      "definition": "孩子有双赢意识后更自觉，愿意为事情付出责任。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a013"
      ]
    },
    {
      "name": "双赢前提：承认自己的问题",
      "definition": "双赢前提是双方承认自己的问题，而不是指责对方。父母和孩子常不承认自己的问题，只指责对方。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a014"
      ]
    },
    {
      "name": "父母承认焦虑的例子",
      "definition": "讲师举例：孩子晚睡，讲师说“现在已经九点半了，你还没有睡觉，妈妈心里非常焦虑，妈妈一焦虑语气就很重，说话不会好好说。”或“妈妈今天好累，看你把玩具扔得到处都是，我心里一把火，导致矛盾的是我的问题，我焦虑，所以想大声跟你说话。”",
      "atom_ids": [
        "s-ab3207daeb80-c001:a015"
      ]
    },
    {
      "name": "使用我人称而非你人称",
      "definition": "双赢前提是用“我”人称表达感受，而不是“你”人称指责。例如，孩子在客厅玩球，父母说“我很担心你的球会把电视砸坏，如果砸坏我一定会非常生气”，而不是“你的球一定会把电视机砸坏”。使用你人称会引发孩子争辩。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a016"
      ]
    },
    {
      "name": "双赢六步骤概述",
      "definition": "实现双赢的六个步骤：1.找出问题；2.提出可能的解决方案；3.讨论分析方案；4.决定最佳方案；5.实施细节；6.复盘评估。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a017"
      ]
    },
    {
      "name": "双赢步骤1：找出问题",
      "definition": "找出矛盾的核心。例如，玩球问题：孩子想在客厅玩球，父母不想，因为怕砸坏电视。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a018"
      ]
    },
    {
      "name": "双赢步骤2：提出可能的解决方案",
      "definition": "提出所有可能的解决方案，即使不可能完成也先写下来。例如，孩子说去玩电子游戏机，或父母建议球在地上玩不让弹起来。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a019"
      ]
    },
    {
      "name": "双赢步骤3：讨论分析方案",
      "definition": "讨论分析提出的方案是否可行，圈出可行的。例如，刚打过游戏不能再玩，球不可能只在地上滚。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a020"
      ]
    },
    {
      "name": "双赢步骤4：决定最佳方案",
      "definition": "从可行方案中共同讨论选择双方都觉得最好的方案。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a021"
      ]
    },
    {
      "name": "双赢步骤5：实施细节",
      "definition": "讨论如何实施方案，包括具体细节。例如，打游戏在哪个房间、是否设闹钟、闹钟时长、玩哪个游戏。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a022"
      ]
    },
    {
      "name": "双赢步骤6：复盘评估",
      "definition": "事情做完后回顾解决方案效果，评估方案如何解决矛盾，帮助下次沟通。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a023"
      ]
    },
    {
      "name": "双赢过程的两个问题",
      "definition": "双赢过程有两个问题：1.时间长，需要父母耐心和时间；2.讨论方案时可能产生矛盾，双方生气。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a024"
      ]
    },
    {
      "name": "双赢过程培养父母情绪肌肉",
      "definition": "双赢过程中的情绪困难可以帮助父母练习处理孩子将来让人生气的情况，增强情绪应对能力。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a025"
      ]
    },
    {
      "name": "习惯养成的重要性",
      "definition": "双赢模式是习惯养成，父母需要时间练习，底层逻辑是遇到矛盾首先想到双赢而非控制或解决。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a026"
      ]
    },
    {
      "name": "课程收获与自我认知",
      "definition": "课程帮助学员获得自我认知，理解过去和现在家庭，以及未来做法。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a027"
      ]
    },
    {
      "name": "系统听课形成立体思维",
      "definition": "系统听课并实践后，育儿理念会形成完整立体的思维模式，能举一反三应对孩子问题。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a028"
      ]
    },
    {
      "name": "赋能孩子独立",
      "definition": "通过课程学习，父母能赋能孩子，使孩子有能力做对的选择、平衡关系、独立成为优秀的人。",
      "atom_ids": [
        "s-ab3207daeb80-c001:a029"
      ]
    }
  ],
