{
  "concepts": [
    {
      "name": "赋能式管教",
      "definition": "管教是赋能式的，在给后果之后还要教孩子替代行为，让孩子知道下次怎么做，而不是单纯惩罚或应对漏洞。",
      "atom_ids": [
        "s-58f4352dacc2-c001:a001",
        "s-58f4352dacc2-c001:a002",
        "s-58f4352dacc2-c002:a023",
        "s-58f4352dacc2-c003:a006"
      ]
    },
    {
      "name": "惩罚",
      "definition": "惩罚是单纯给后果，不教替代行为，不能让孩子学到东西，可能伤害孩子或引发怒气。",
      "atom_ids": [
        "s-58f4352dacc2-c001:a001",
        "s-58f4352dacc2-c003:a005",
        "s-58f4352dacc2-c003:a006"
      ]
    },
    {
      "name": "后果",
      "definition": "后果是行为带来的自然或逻辑结果，应与行为有因果关系，且需事先立好规矩。",
      "atom_ids": [
        "s-58f4352dacc2-c001:a001",
        "s-58f4352dacc2-c001:a006",
        "s-58f4352dacc2-c002:a015",
        "s-58f4352dacc2-c002:r001",
        "s-58f4352dacc2-c003:a005"
      ]
    },
    {
      "name": "权柄",
      "definition": "父母的教育权柄不是靠打、压迫、镇压、道德绑架或信仰绑架建立的，而是来自正确的管教方式，让孩子心服口服地顺服。",
      "atom_ids": [
        "s-58f4352dacc2-c001:a011",
        "s-58f4352dacc2-c001:a012"
      ]
    },
    {
      "name": "情绪连接",
      "definition": "情绪连接的目的不是引导孩子，而是父母本来就应该与孩子做的，不应有功利心。",
      "atom_ids": [
        "s-58f4352dacc2-c001:a013"
      ]
    },
    {
      "name": "注意力时长公式",
      "definition": "儿童注意力时长约为年龄乘以3到5分钟，超出范围无法集中是正常的。",
      "atom_ids": [
        "s-58f4352dacc2-c001:a005"
      ]
    },
    {
      "name": "成功与持续成功",
      "definition": "成功只需要技术好，持续成功要求孩子身心灵都健康。",
      "atom_ids": [
        "s-58f4352dacc2-c001:a008"
      ]
    },
    {
      "name": "体罚与怒气",
      "definition": "用杖打孩子会惹动孩子的怒气，如果孩子被打却不发怒，这是很危险的；书上说不要惹动孩子的怒气，与用杖打孩子矛盾，说明理解有误。",
      "atom_ids": [
        "s-58f4352dacc2-c001:a009",
        "s-58f4352dacc2-c001:a010"
      ]
    },
    {
      "name": "作业责任归属",
      "definition": "作业是孩子和老师之间的事情，家长不要管；孩子需要帮助时可以帮忙，但不要守着；要提前告知孩子责任和睡觉时间，未完成让孩子自己与老师沟通。",
      "atom_ids": [
        "s-58f4352dacc2-c001:a014",
        "s-58f4352dacc2-c001:r003"
      ]
    },
    {
      "name": "睡觉优先级",
      "definition": "睡觉绝对比做作业更重要，到时间必须睡觉。",
      "atom_ids": [
        "s-58f4352dacc2-c001:a015"
      ]
    },
    {
      "name": "困倦与管教时机",
      "definition": "孩子困的时候最好不要管教，尤其是四岁孩子，因为睡眠不好时反常行为多；14岁孩子困时可以管教。",
      "atom_ids": [
        "s-58f4352dacc2-c001:a017",
        "s-58f4352dacc2-c002:a001"
      ]
    },
    {
      "name": "吼叫类型",
      "definition": "吼叫孩子分为两种：制止行为的吼叫和侮辱人格的吼叫；后者需要配偶立即介入保护孩子。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a002"
      ]
    },
    {
      "name": "介入原则",
      "definition": "当配偶或家人伤害孩子时，侮辱人格的吼叫必须立即介入，制止行为的吼叫不必介入；介入时用行为影响对方，并用知识沟通。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a003"
      ]
    },
    {
      "name": "行为影响",
      "definition": "通过自己使用正确的管教行为，让孩子产生不同反应，从而让家人看到正确管教更有效，进而影响家人改变。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a004"
      ]
    },
    {
      "name": "二胎打架干预",
      "definition": "二胎之间打架，如果只是推来推去、没有伤害，可以不用管；但如果出现伤害行为或力量悬殊，必须立即阻止。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a005"
      ]
    },
    {
      "name": "伤害处理步骤",
      "definition": "当孩子伤害弟弟时，应立即阻止，先安慰弟弟，再管教打人的孩子，并询问愤怒原因。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a006"
      ]
    },
    {
      "name": "愤怒时离开",
      "definition": "当家长感到愤怒时，可以离开现场让自己冷静，这是可行的做法。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a007"
      ]
    },
    {
      "name": "人来疯与心散漫",
      "definition": "孩子心散漫、人来疯、喜欢开玩笑、学习不专心，通常不需要过度担心；人来疯说明孩子喜欢与人相处、开心。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a008"
      ]
    },
    {
      "name": "父母焦虑感知",
      "definition": "父母的焦虑孩子一定能感觉到，孩子对父母情绪的感知比想象中更多。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a009"
      ]
    },
    {
      "name": "停止无效讲道理",
      "definition": "如果每天给孩子讲道理但无效，应停止这种做法，先处理自己的焦虑问题，因为带着焦虑传递的道理会变形。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a010"
      ]
    },
    {
      "name": "成绩具体化",
      "definition": "“成绩不理想”是抽象表述，需要具体分数才能判断问题；90分的不理想应处理家长焦虑，60分的不理想需进一步分析。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a011"
      ]
    },
    {
      "name": "全科差与焦虑",
      "definition": "如果孩子所有科目都是60分左右，不偏科，可能提示孩子存在焦虑问题；如果只有一两科差，则可能只是该科学习困难。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a012"
      ]
    },
    {
      "name": "家庭整体焦虑",
      "definition": "如果孩子所有科目都差，且父母都有焦虑问题，家庭整体处于焦虑状态，会影响孩子。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a013"
      ]
    },
    {
      "name": "打妈妈处理",
      "definition": "当孩子因零食被收走而打妈妈时，应抓住孩子的手压制住，严肃告诉孩子不可以打妈妈；如果继续打，则取消零食，并解释原因。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a014"
      ]
    },
    {
      "name": "事先警告与后果执行",
      "definition": "对于孩子打妈妈的行为，应事先警告：如果再打，所有零食会被当着他的面扔进垃圾桶；执行时要压住孩子，严肃告知不允许打妈妈。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a015",
        "s-58f4352dacc2-c002:r001"
      ]
    },
    {
      "name": "管教目的",
      "definition": "管教的目的可以多种多样，不需要验证对错，只需确认目的是为了赋能孩子而不是伤害孩子。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a016"
      ]
    },
    {
      "name": "偷玩电脑处理",
      "definition": "当怀疑孩子偷玩电脑时，如果电脑有记录，应先查看记录，而不是先问孩子，因为直接问会诱导撒谎。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a017"
      ]
    },
    {
      "name": "培养诚实",
      "definition": "如果目的是培养孩子诚实，应先告知孩子已查看记录，然后给孩子一次坦诚的机会，只问一次。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a018"
      ]
    },
    {
      "name": "诱导撒谎",
      "definition": "如果家长明知有记录却先问孩子是否偷玩，会诱导孩子撒谎，因为孩子犯错后第一反应是遮盖。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a019",
        "s-58f4352dacc2-c002:xe005"
      ]
    },
    {
      "name": "网络监控软件",
      "definition": "建议安装可以阻止孩子访问不良网站的软件，该软件能防止孩子删除记录，并在孩子访问可疑网站时通知家长。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a020"
      ]
    },
    {
      "name": "信任重建",
      "definition": "孩子撒谎后，要告诉孩子失去了信任，并说明失去信任的后果，然后明确孩子需要做什么来赢回信任。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a021"
      ]
    },
    {
      "name": "作业撒谎信任重建案例",
      "definition": "讲师分享自己孩子的案例：孩子作业撒谎后，要求孩子半年内每天作业做完后交给讲师检查，孩子每天问是否赢回一点信任。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a022"
      ]
    },
    {
      "name": "原生家庭影响",
      "definition": "几乎所有父母都受到原生家庭管教模式的影响，有时自己都未察觉；需要处理原生家庭带来的模式，以免影响自己的育儿方式。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a024"
      ]
    },
    {
      "name": "一岁半所有权认知",
      "definition": "一岁半的孩子对所有权的认知很强，会认为妈妈是自己的，不允许其他孩子接近。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a025",
        "s-58f4352dacc2-c003:a001"
      ]
    },
    {
      "name": "独占妈妈原因",
      "definition": "孩子不允许其他孩子接触妈妈，可能有两个原因：一是家长陪伴过多，孩子没有独处时间；二是孩子平时与其他人接触不多。",
      "atom_ids": [
        "s-58f4352dacc2-c003:a002"
      ]
    },
    {
      "name": "行为拉开距离",
      "definition": "对于一岁半孩子独占妈妈的问题，建议多让孩子自己玩，家长要有自己的时间和空间，通过行为拉开距离，让孩子意识到每个人是独立的个体。",
      "atom_ids": [
        "s-58f4352dacc2-c002:a026",
        "s-58f4352dacc2-c003:a003"
      ]
    },
    {
      "name": "冷静与timeout区别",
      "definition": "冷静与timeout/cold shoulder的区别在于：timeout/cold shoulder是以惩罚为目的，本质上是伤害孩子；而冷静是为了不伤害孩子。",
      "atom_ids": [
        "s-58f4352dacc2-c003:a004"
      ]
    },
    {
      "name": "12岁打架罚钱案例",
      "definition": "两个12岁男孩因小事打架，家长罚钱每次五块，讲师指出这个后果与打架行为没有因果关系，惩罚不能让孩子学到东西，不是赋能。",
      "atom_ids": [
        "s-58f4352dacc2-c003:a005"
      ]
    },
    {
      "name": "9岁时间管理案例",
      "definition": "9岁孩子需要学会管理规划时间，但家长沟通引导无效；孩子选择周末忙上加忙，牺牲玩耍时间，作业拖到周日完成，心里有怨言；讲师指出问题在于家长没有办法让孩子承担自己不爽的事情，家长比孩子着急。",
      "atom_ids": [
        "s-58f4352dacc2-c003:a007"
      ]
    },
    {
      "name": "承担后果与等待求助",
      "definition": "当孩子做出选择并承担后果时，家长不应过度干涉或急于教导；应该让孩子受苦受够，当孩子主动求助时再去帮助。",
      "atom_ids": [
        "s-58f4352dacc2-c003:a008"
      ]
    },
    {
      "name": "合理分配任务标准",
      "definition": "只要孩子能在一周内完成作业，即使选择在周日做，也属于合理分配任务；做不完才叫没有合理分配。",
      "atom_ids": [
        "s-58f4352dacc2-c003:a009"
      ]
    },
    {
      "name": "家长期望与目标达成",
      "definition": "家长常常认为孩子不对劲，只是因为孩子没有按照家长想要的方式来；但实际上孩子可能已经完成了目标，家长应该关注目标是否达成，而不是过程是否符合自己的期望。",
      "atom_ids": [
        "s-58f4352dacc2-c003:a010",
        "s-58f4352dacc2-c003:r002"
      ]
    },
    {
      "name": "独立个体意识",
      "definition": "家长需要让孩子知道妈妈不是他的，妈妈也不是孩子的所有物，每个人是独立的个体。",
      "atom_ids": [
        "s-58f4352dacc2-c003:r001"
      ]
    }
  ],
