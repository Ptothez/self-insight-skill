          "action": "明确哪些行为可以（打沙发、打床），哪些不可以（打人、打墙壁、摔门）",
          "atom_ids": [
            "s-58f4352dacc2-c001:a002"
          ],
          "condition": null
        }
      ]
    },
    {
      "name": "处理孩子伤害弟弟的流程",
      "steps": [
        {
          "action": "立即阻止伤害行为",
          "atom_ids": [
            "s-58f4352dacc2-c002:a006"
          ],
          "condition": "孩子对弟弟实施伤害行为"
        },
        {
          "action": "先安慰弟弟",
          "atom_ids": [
            "s-58f4352dacc2-c002:a006"
          ],
          "condition": null
        },
        {
          "action": "管教打人的孩子",
          "atom_ids": [
            "s-58f4352dacc2-c002:a006"
          ],
          "condition": null
        },
        {
          "action": "询问孩子愤怒的原因",
          "atom_ids": [
            "s-58f4352dacc2-c002:a006"
          ],
          "condition": null
        }
      ]
    },
    {
      "name": "处理孩子打妈妈的流程",
      "steps": [
        {
          "action": "事先警告孩子：再打妈妈则零食扔垃圾桶",
          "atom_ids": [
            "s-58f4352dacc2-c002:a015",
            "s-58f4352dacc2-c002:r001"
          ],
          "condition": "孩子有打妈妈的行为"
        },
        {
          "action": "孩子再次打妈妈时，执行后果",
          "atom_ids": [
            "s-58f4352dacc2-c002:a015",
            "s-58f4352dacc2-c002:r001"
          ],
          "condition": "孩子再次打妈妈"
        },
        {
          "action": "压住孩子，严肃告知不允许打妈妈",
          "atom_ids": [
            "s-58f4352dacc2-c002:a015",
            "s-58f4352dacc2-c002:r001"
          ],
          "condition": null
        }
      ]
    },
    {
      "name": "培养孩子诚实的流程",
      "steps": [
        {
          "action": "查看电脑使用记录",
          "atom_ids": [
            "s-58f4352dacc2-c002:a017"
          ],
          "condition": "有可查的记录"
        },
        {
          "action": "告知孩子已查看记录",
          "atom_ids": [
            "s-58f4352dacc2-c002:a018"
          ],
          "condition": "目的是培养孩子诚实"
        },
        {
          "action": "给孩子一次坦诚的机会，只问一次",
          "atom_ids": [
            "s-58f4352dacc2-c002:a018"
          ],
          "condition": null
        },
        {
          "action": "孩子承认后，强化诚实行为",
          "atom_ids": [
            "s-58f4352dacc2-c002:a018"
          ],
          "condition": null
        }
      ]
    },
    {
      "name": "孩子撒谎后重建信任的流程",
      "steps": [
        {
          "action": "告知孩子失去信任",
          "atom_ids": [
            "s-58f4352dacc2-c002:a021"
          ],
          "condition": "孩子撒谎"
        },
        {
          "action": "说明失去信任的后果",
          "atom_ids": [
            "s-58f4352dacc2-c002:a021"
          ],
          "condition": null
        },
        {
          "action": "明确赢回信任的具体行为",
          "atom_ids": [
            "s-58f4352dacc2-c002:a021"
          ],
          "condition": null
        }
      ]
    },
    {
      "name": "处理一岁半孩子独占妈妈的流程",
      "steps": [
        {
          "action": "多让孩子自己玩",
          "atom_ids": [
            "s-58f4352dacc2-c002:a026",
            "s-58f4352dacc2-c003:a003"
          ],
          "condition": "孩子一岁半左右，无法通过沟通解决问题"
        },
        {
          "action": "家长要有自己的时间和空间",
          "atom_ids": [
            "s-58f4352dacc2-c002:a026",
            "s-58f4352dacc2-c003:a003"
          ],
          "condition": null
        },
        {
          "action": "通过行为拉开与孩子的距离",
          "atom_ids": [
            "s-58f4352dacc2-c003:a003"
          ],
          "condition": null
        }
      ]
    }
