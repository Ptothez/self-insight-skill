  "path": [
    {
      "name": "4-8岁孩子沟通方法",
      "steps": [
        {
          "action": "确保家庭氛围安全",
          "atom_ids": [
            "s-9f55090f1cb8-c001:a001"
          ],
          "condition": "没有危险性的争吵"
        },
        {
          "action": "父母对感觉敏感并自律控制行为",
          "atom_ids": [
            "s-9f55090f1cb8-c001:a003",
            "s-9f55090f1cb8-c001:a005"
          ],
          "condition": "父母能表达自己的情绪，同时敏感于孩子的情绪，并控制自己避免伤害孩子"
        },
        {
          "action": "接纳孩子情绪",
          "atom_ids": [
            "s-9f55090f1cb8-c001:a006"
          ],
          "condition": "无论孩子以任何方式表达情绪，父母都要能接得住"
        },
        {
          "action": "训练孩子的沟通习惯",
          "atom_ids": [
            "s-9f55090f1cb8-c001:a009",
            "s-9f55090f1cb8-c001:a011",
            "s-9f55090f1cb8-c001:a013",
            "s-9f55090f1cb8-c001:a012"
          ],
          "condition": "在孩子还没那么忙的时候，花大量时间沟通交流，包括大量聊天、回应肢体语言、让孩子接纳沟通差异"
        }
      ]
    },
    {
      "name": "9-12岁孩子沟通方法",
      "steps": [
        {
          "action": "定期沟通",
          "atom_ids": [
            "s-9f55090f1cb8-c001:a015"
          ],
          "condition": "找出特别的地方和时间，最好每天，至少每周两到三次，无干扰"
        },
        {
          "action": "明确沟通目的为增进彼此了解",
          "atom_ids": [
            "s-9f55090f1cb8-c001:a016"
          ],
          "condition": "不是为了指挥或引导孩子"
        },
        {
          "action": "实现双向倾听",
          "atom_ids": [
            "s-9f55090f1cb8-c001:a017"
          ],
          "condition": "父母让孩子知道自己的想法很重要"
        },
        {
          "action": "保持情绪安全",
          "atom_ids": [
            "s-9f55090f1cb8-c001:a020"
          ],
          "condition": "不管孩子分享什么，父母都不要大惊小怪"
        },
        {
          "action": "开放心态，分享生活",
          "atom_ids": [
            "s-9f55090f1cb8-c001:a019"
          ],
          "condition": "分享自己的挣扎、困难等，但注意内容选择"
        }
      ]
    }
  ],
