{
  "concepts": [
    {
      "name": "问错问题的后果",
      "definition": "问错问题会带来一系列负面后果，包括失去孩子信任、传递错误信息、和孩子失联、让孩子对人不感兴趣、导致孩子上瘾。",
      "atom_ids": [
        "s-18a5df5d1f41-c001:a001",
        "s-18a5df5d1f41-c001:a006",
        "s-18a5df5d1f41-c001:a009",
        "s-18a5df5d1f41-c001:a015",
        "s-18a5df5d1f41-c001:a018"
      ]
    },
    {
      "name": "失去孩子信任",
      "definition": "孩子认为父母只关心成绩，不关心自己，觉得父母的爱是有条件的，从而不信任父母。",
      "atom_ids": [
        "s-18a5df5d1f41-c001:a001",
        "s-18a5df5d1f41-c001:a002",
        "s-18a5df5d1f41-c001:a003",
        "s-18a5df5d1f41-c001:a004",
        "s-18a5df5d1f41-c001:a005"
      ]
    },
    {
      "name": "传递错误信息",
      "definition": "孩子通过父母的问题判断父母的价值观和重视的事物，问错问题会传递错误信息。",
      "atom_ids": [
        "s-18a5df5d1f41-c001:a006",
        "s-18a5df5d1f41-c001:a007",
        "s-18a5df5d1f41-c001:a008"
      ]
    },
    {
      "name": "和孩子失联",
      "definition": "问错问题会导致和孩子失联，特别是情绪失联，孩子对父母的问题不感兴趣，对父母本人也不感兴趣。",
      "atom_ids": [
        "s-18a5df5d1f41-c001:a009",
        "s-18a5df5d1f41-c001:a010",
        "s-18a5df5d1f41-c001:a011",
        "s-18a5df5d1f41-c001:a014"
      ]
    },
    {
      "name": "让孩子对人不感兴趣",
      "definition": "问错问题会让孩子对人不感兴趣，即non-relational，对人际关系和与人打交道不感兴趣甚至恐惧。",
      "atom_ids": [
        "s-18a5df5d1f41-c001:a015",
        "s-18a5df5d1f41-c001:a017"
      ]
    },
    {
      "name": "孩子上瘾",
      "definition": "问错问题可能导致孩子上瘾，因为失联让孩子对人不感兴趣甚至厌恶，孩子会寻找其他东西进行联系，如游戏、网络。",
      "atom_ids": [
        "s-18a5df5d1f41-c001:a018",
        "s-18a5df5d1f41-c001:a019",
        "s-18a5df5d1f41-c001:a021",
        "s-18a5df5d1f41-c001:a022"
      ]
    },
    {
      "name": "无聊问题与有趣问题",
      "definition": "无聊问题是寻求信息的问题，如“今天学校怎么样？”；有趣的问题能产生连接，应占大部分。",
      "atom_ids": [
        "s-18a5df5d1f41-c001:r001",
        "s-18a5df5d1f41-c001:a019",
        "s-18a5df5d1f41-c001:a020"
      ]
    },
    {
      "name": "好的提问",
      "definition": "好的问题让人感到被了解，回答问题让人感到在介绍自己，能产生连接。",
      "atom_ids": [
        "s-18a5df5d1f41-c001:a012",
        "s-18a5df5d1f41-c001:a013"
      ]
    },
    {
      "name": "relational特质",
      "definition": "relational的人对人好奇、感兴趣，喜欢与人打交道，更容易成功，更有同理心，能迅速与人成为朋友。",
      "atom_ids": [
        "s-18a5df5d1f41-c001:a015",
        "s-18a5df5d1f41-c001:a016"
      ]
    }
  ],
