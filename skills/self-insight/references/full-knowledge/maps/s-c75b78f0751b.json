{
  "concepts": [
    {
      "name": "情绪",
      "definition": "突然的、快速的、直接的涌动反应，像潮水或浪一样一下子涌上来。",
      "atom_ids": [
        "s-c75b78f0751b-c001:a001",
        "s-c75b78f0751b-c001:a003",
        "s-c75b78f0751b-c001:r004"
      ]
    },
    {
      "name": "感受",
      "definition": "缓慢的、持续性的、日复一日建立起来的流淌式反应，像水慢慢浸过来，不是快速涌来。",
      "atom_ids": [
        "s-c75b78f0751b-c001:a002",
        "s-c75b78f0751b-c001:a003",
        "s-c75b78f0751b-c001:r004"
      ]
    },
    {
      "name": "思想-感受-情绪-行为机制",
      "definition": "思想影响感受，感受引发情绪，情绪导致行为；情绪又会加强感受，形成双向影响。",
      "atom_ids": [
        "s-c75b78f0751b-c001:a005"
      ]
    },
    {
      "name": "心理需要",
      "definition": "每个情绪背后都是心理需要。心理需要被满足时，孩子感到被爱、幸福、被接纳、有归属感，情绪是开心、兴奋，行为是笑、听话、顺从；未被满足时，感受是孤独、被拒绝、羞耻、觉得自己不好、不被接受、不被爱，情绪多种多样，行为是作对、不听话。",
      "atom_ids": [
        "s-c75b78f0751b-c001:a006",
        "s-c75b78f0751b-c001:r002",
        "s-c75b78f0751b-c001:r006"
      ]
    },
    {
      "name": "孩子对自己的感受",
      "definition": "孩子对自己的感受包括：觉得自己有价值吗？喜欢自己吗？觉得自己好吗？能接纳自己的缺点吗？为自己感到羞耻吗？",
      "atom_ids": [
        "s-c75b78f0751b-c001:a008"
      ]
    },
    {
      "name": "孩子对父母的感受",
      "definition": "孩子对父母的感受是指孩子是否喜欢父母，而非是否爱父母。爱是血缘关系带来的，但喜欢与否无法勉强。孩子可能爱父母但不喜欢父母，不喜欢与父母待在一起。",
      "atom_ids": [
        "s-c75b78f0751b-c001:a012"
      ]
    },
    {
      "name": "孩子对家庭的感受",
      "definition": "孩子对家庭的感受包括：家是温暖的吗？幸福吗？冰冷吗？充满欢声笑语还是漫骂？家庭的颜色、味道、声音是什么？",
      "atom_ids": [
        "s-c75b78f0751b-c001:a015"
      ]
    },
    {
      "name": "孩子对关系的感受",
      "definition": "孩子对关系的感受是指孩子认为建立一段关系是让人愉悦的事情吗？有些人骨子里不喜欢与人建立关系，或者关系点到为止，无法深入。有些人可以有很多关系但无法亲密。",
      "atom_ids": [
        "s-c75b78f0751b-c001:a018"
      ]
    },
    {
      "name": "孩子对外界的感受",
      "definition": "孩子对外界的感受包括：这个世界对我友好吗？我在社会中有位置吗？有力量吗？被朋友喜欢和接纳吗？世界危险吗？别人会骗我吗？别人是真心喜欢还是敷衍？",
      "atom_ids": [
        "s-c75b78f0751b-c001:a020"
      ]
    },
    {
      "name": "抓狂",
      "definition": "孩子抓狂不一定表现为爆发，有些孩子不爆发但情绪压抑，整个人是抓狂的。例如，有些孩子不说话但会伤害小动物或放火。",
      "atom_ids": [
        "s-c75b78f0751b-c001:a024",
        "s-c75b78f0751b-c002:a004"
      ]
    },
    {
      "name": "羞耻感与自恋",
      "definition": "自恋的人往往有很深的羞耻感，除非是病理性自恋（人格障碍）。正常范围内的自恋可能是因为内心羞耻，但为了保护自己，不承认自己不好，以免被伤害。",
      "atom_ids": [
        "s-c75b78f0751b-c001:a010"
      ]
    },
    {
      "name": "安全感",
      "definition": "孩子对世界的安全感，来源于家庭环境、父母言行等。如果父母长期传递负面信息，孩子可能觉得世界危险。",
      "atom_ids": [
        "s-c75b78f0751b-c001:a021",
        "s-c75b78f0751b-c002:a001"
      ]
    }
  ],
