        "s-bc6b75de580d-c002:a008",
        "s-bc6b75de580d-c002:r002",
        "s-bc6b75de580d-c002:r003"
      ]
    },
    {
      "name": "上瘾判断的条件",
      "definition": "判断孩子是否上瘾不能仅凭单一行为，需参考课程中讲的上瘾条件和前提。孩子想先玩游戏再复习是正常想法，但也可能是上瘾的表现。",
      "atom_ids": [
        "s-bc6b75de580d-c002:a009",
        "s-bc6b75de580d-c002:a010",
        "s-bc6b75de580d-c002:r004"
      ]
    },
    {
      "name": "成绩观",
      "definition": "一次考试考不好不代表孩子不好，成绩不能决定孩子的一生，尤其在AI时代更是如此。父母应提醒自己不要过度担忧成绩。",
      "atom_ids": [
        "s-bc6b75de580d-c002:a011",
        "s-bc6b75de580d-c002:r005",
        "s-bc6b75de580d-c002:r006"
      ]
    },
    {
      "name": "游戏时间不应作为奖励",
      "definition": "如果孩子有上瘾倾向，游戏时间不能作为奖励。父母不应将游戏时间与考试等表现关联，考得好就奖励玩游戏是错误的。",
      "atom_ids": [
        "s-bc6b75de580d-c002:a012"
      ]
    },
    {
      "name": "合理放松与上瘾的界限",
      "definition": "放假时适当增加游戏时间作为放松是正常的，但需区分放松与上瘾。如果放松意味着没日没夜打游戏，则会上瘾；如果设定界限并能准时停止，则没问题。",
      "atom_ids": [
        "s-bc6b75de580d-c002:a013",
        "s-bc6b75de580d-c002:a014"
      ]
    },
    {
      "name": "夏令营手机管理",
      "definition": "夏令营中统一由老师收手机，结束时归还，是合理的管理方式。对于学生借手机处理作业的请求，应拒绝，作业可在白天完成。",
      "atom_ids": [
        "s-bc6b75de580d-c002:a015",
        "s-bc6b75de580d-c002:a016"
      ]
    },
    {
      "name": "儿童异性亲密行为的纯洁性",
      "definition": "七岁女孩与男孩的亲密行为是纯洁的，不纯洁的是成人的眼光。只要在公共场合而非私人场合，七岁孩子与男孩保持距离不是必须的。年龄影响关注度：七岁无需过度担心，17岁则需要认真教导。",
      "atom_ids": [
        "s-bc6b75de580d-c002:a017",
        "s-bc6b75de580d-c002:a018",
        "s-bc6b75de580d-c002:a019"
      ]
    },
    {
      "name": "iPad使用管理",
      "definition": "父母陪伴孩子时不应使用iPad或任何电子产品，否则孩子会养成习惯，认为父母陪伴时就是用iPad，失去高质量互动。不陪伴孩子时，可以给孩子限时使用iPad，如20或30分钟，时间到立即收回。不必全程监控，但需监督时间。",
      "atom_ids": [
        "s-bc6b75de580d-c002:a020",
        "s-bc6b75de580d-c002:a021",
        "s-bc6b75de580d-c002:a022"
      ]
    },
    {
      "name": "父母情绪与孩子安全感",
      "definition": "父母在孩子痛苦时崩溃哭泣，孩子会收到信息：我的崩溃妈妈hold不住，因此最好不要在妈妈面前崩溃。这让孩子感到无助、不安全，并怀疑父母能否帮助自己。父母可以真实表达自己的情绪低落，不需要强装，但不能崩溃。",
      "atom_ids": [
