{
  "concepts": [
    {
      "name": "说教",
      "definition": "一种管教方式，包括机会教育和讲道理，容易导致情绪失联、孩子觉得父母不真实，并传递对感受不感兴趣的信息。",
      "atom_ids": [
        "s-217825eaba68-c001:a001",
        "s-217825eaba68-c001:a003",
        "s-217825eaba68-c001:a004",
        "s-217825eaba68-c001:a009"
      ]
    },
    {
      "name": "情绪失联",
      "definition": "父母与孩子之间情绪连接断裂，孩子不愿敞开心扉，常由说教引起。",
      "atom_ids": [
        "s-217825eaba68-c001:a003",
        "s-217825eaba68-c001:a005"
      ]
    },
    {
      "name": "情绪连接",
      "definition": "父母进入孩子的世界，认识他、聆听他，与他一起经历情绪和感知，是有效沟通的前提。",
      "atom_ids": [
        "s-217825eaba68-c001:a003",
        "s-217825eaba68-c001:a006",
        "s-217825eaba68-c001:a007",
        "s-217825eaba68-c001:a008"
      ]
    },
    {
      "name": "罪恶式管教",
      "definition": "通过让孩子感到罪恶感、罪疚感来管教，例如强调父母的牺牲，导致孩子背负重担、没有界限、自我价值感低。",
      "atom_ids": [
        "s-217825eaba68-c001:a013",
        "s-217825eaba68-c001:a014",
        "s-217825eaba68-c001:a018",
        "s-217825eaba68-c001:a019"
      ]
    },
    {
      "name": "界限",
      "definition": "父母应明确自己的选择与责任，不让孩子为父母的情绪负责，并帮助孩子建立健康的界限。",
      "atom_ids": [
        "s-217825eaba68-c001:a017",
        "s-217825eaba68-c001:a020"
      ]
    },
    {
      "name": "重担",
      "definition": "孩子因家庭期望或罪恶感而背负的心理负担，导致无法享受生活和幸福。",
      "atom_ids": [
        "s-217825eaba68-c001:a014",
        "s-217825eaba68-c001:a015",
        "s-217825eaba68-c001:a016",
        "s-217825eaba68-c001:a021"
      ]
    }
  ],
