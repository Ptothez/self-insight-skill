{
  "concepts": [
    {
      "name": "睡眠与专注力",
      "definition": "睡眠不足会降低专注力、记忆力和脾气控制；睡眠中大脑连接点大量产生，对大脑发育和专注力至关重要。",
      "atom_ids": [
        "s-2de835ba03be-c001:a002",
        "s-2de835ba03be-c001:a004"
      ]
    },
    {
      "name": "学龄前儿童睡眠时长",
      "definition": "五六岁至六七岁的孩子每天至少应睡11个小时，但很多孩子只睡8小时。",
      "atom_ids": [
        "s-2de835ba03be-c001:a003"
      ]
    },
    {
      "name": "建议睡眠时间",
      "definition": "建议孩子晚上九点半时已经进入深度睡眠。",
      "atom_ids": [
        "s-2de835ba03be-c001:a005"
      ]
    },
    {
      "name": "观察孩子的专注力特点",
      "definition": "父母应观察什么让孩子专注力旺盛、专注力方式、学习方式、兴趣等。",
      "atom_ids": [
        "s-2de835ba03be-c001:a006"
      ]
    },
    {
      "name": "深入了解孩子的内心世界",
      "definition": "父母应了解孩子心底深处想什么、思考什么问题、对人生有什么疑问。",
      "atom_ids": [
        "s-2de835ba03be-c001:a007"
      ]
    },
    {
      "name": "将孩子视为复杂事物来学习",
      "definition": "父母应把孩子当成非常复杂、艰难的事情来认真学习，通过观察获得更好的认知以帮助提升注意力。",
      "atom_ids": [
        "s-2de835ba03be-c001:a008"
      ]
    },
    {
      "name": "身体力行：父母专注的榜样作用",
      "definition": "父母要求孩子专注做事时，自己应先做到专注，如孩子说话时专注听完，不玩手机。",
      "atom_ids": [
        "s-2de835ba03be-c001:a009"
      ]
    },
    {
      "name": "陪伴孩子时放下手机",
      "definition": "陪孩子玩时，父母应把手机放到一边，聚精会神地陪伴。",
      "atom_ids": [
        "s-2de835ba03be-c001:a010"
      ]
    },
    {
      "name": "陪伴孩子时走神是反面教材",
      "definition": "有些家长陪孩子时想生活琐事、发呆，这是身体力行的反面教材。",
      "atom_ids": [
        "s-2de835ba03be-c001:a011"
      ]
    },
    {
      "name": "不打扰孩子的专注活动",
      "definition": "孩子玩耍或学习时，父母不要轻易打扰，如问喝水、送水果等，以免打断思绪。",
      "atom_ids": [
        "s-2de835ba03be-c001:a012"
      ]
    },
    {
      "name": "孩子专注时间有限",
      "definition": "孩子的专注时间本来就不长，因此父母不应在相对专注的时段打扰他。",
      "atom_ids": [
        "s-2de835ba03be-c001:a013"
      ]
    },
    {
      "name": "让孩子按自己的速度进入和离开专注状态",
      "definition": "父母应帮助孩子用他自己的速度和时间进入一个情境去做事，然后自己出来，而不是频繁打断。",
      "atom_ids": [
        "s-2de835ba03be-c001:a014"
      ]
    },
    {
      "name": "以爱的名义打扰孩子",
      "definition": "父母不要以爱的名义打扰孩子，例如在孩子学习时送水果、牛奶或询问饿不饿。",
      "atom_ids": [
        "s-2de835ba03be-c001:a015"
      ]
    },
    {
      "name": "频繁更换活动破坏专注力",
      "definition": "孩子玩一种活动时，父母不要频繁建议换新活动，因为每次换新东西，孩子的专注力就要重新建立一次。",
      "atom_ids": [
        "s-2de835ba03be-c001:a016"
      ]
    },
    {
      "name": "找到有效的帮助",
      "definition": "父母应观察孩子在什么时候最不容易有专注力，从而提供有效的帮助。",
      "atom_ids": [
        "s-2de835ba03be-c001:a017"
      ]
    },
    {
      "name": "饥饿影响专注力",
      "definition": "孩子饿了的时候不容易有专注力，因此放学回家若想让他马上做作业，最好先给他吃点东西。",
      "atom_ids": [
        "s-2de835ba03be-c001:a018"
      ]
    },
    {
      "name": "困倦和疲劳影响专注力",
      "definition": "孩子困了或累了的时候最不容易有专注力，因此不要在他睡前或疲倦时让他做需要专注力的事情。",
      "atom_ids": [
        "s-2de835ba03be-c001:a019"
      ]
    },
    {
      "name": "有效帮助与无效帮助的区别",
      "definition": "如果孩子困了，让他吃东西不会提升专注力，这是无效帮助；应根据孩子的状态提供针对性帮助。",
      "atom_ids": [
        "s-2de835ba03be-c001:a020"
      ]
    },
    {
      "name": "建立日常惯例提升专注力",
      "definition": "建立日常惯例的生活方式有助于提升孩子的专注力，因为孩子不需要把注意力分散到很多新的、需要适应的东西上。",
      "atom_ids": [
        "s-2de835ba03be-c001:a021"
      ]
    },
    {
      "name": "规律生活带来安全感",
      "definition": "如果孩子每天知道接下来做什么，有固定的接送人和时间，生活有规律，内心有安全感，注意力更容易得到提升。",
      "atom_ids": [
        "s-2de835ba03be-c001:a022"
      ]
    },
    {
      "name": "设定短而能够实现的目标",
      "definition": "父母应给孩子设定短而能够实现的目标，而不是过长的目标。",
      "atom_ids": [
        "s-2de835ba03be-c001:a023"
      ]
    },
    {
      "name": "爬山时设定短目标帮助孩子专注",
      "definition": "讲师带孩子爬山时，孩子累了，讲师让他们休息一下，然后指着前面看得见的石头说：“我们爬到那块石头，可以再休息一下。”孩子眼睛盯着那块石头，因为这是一个短而能够实现的目标。",
      "atom_ids": [
        "s-2de835ba03be-c001:a024"
      ]
    },
    {
      "name": "长期目标无法激励孩子专注",
      "definition": "如果告诉孩子“开学第一天好好学习，学期末能拿A”，孩子中间无法保持专注，因为目标太远。",
      "atom_ids": [
        "s-2de835ba03be-c001:a025"
      ]
    },
    {
      "name": "设定及时鼓励的短目标",
      "definition": "如果今天学了明天就能拿A，这是非常及时的鼓励。应设定能实现且短的目标，如“今晚的作业可以拿A”。",
      "atom_ids": [
        "s-2de835ba03be-c001:a026"
      ]
    },
    {
      "name": "用短时间任务提升专注力",
      "definition": "例如，让孩子专心做五分钟题，五分钟后休息一下，比一个小时后再休息要好用得多。时间不要拉得太长。",
      "atom_ids": [
        "s-2de835ba03be-c001:a027"
      ]
    }
  ],
