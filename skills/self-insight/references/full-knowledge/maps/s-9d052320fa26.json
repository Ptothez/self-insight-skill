{
  "concepts": [
    {
      "name": "原生背景对引导的影响",
      "definition": "父母自身的成长经历和未解决的伤害会影响对孩子行为的解读和引导程度，可能导致误判或走向另一极端。",
      "atom_ids": [
        "s-9d052320fa26-c001:a002",
        "s-9d052320fa26-c001:a003",
        "s-9d052320fa26-c001:a007"
      ]
    },
    {
      "name": "引导中的投射机制",
      "definition": "父母因自己曾走过某条路并掉进坑，当看到孩子走上类似道路时，会紧张并相信孩子一定会遇到同样的坑，从而根据自己对那条路的记忆来引导孩子避开坑。",
      "atom_ids": [
        "s-9d052320fa26-c001:a003"
      ]
    },
    {
      "name": "站在孩子自己的路上引导",
      "definition": "引导孩子时应站在孩子自己走的那条路上，帮助他渡过路上可能碰到的坑，而不是把孩子走的路想象成自己曾经走过的路。",
      "atom_ids": [
        "s-9d052320fa26-c001:a004",
        "s-9d052320fa26-c001:r001"
      ]
    },
    {
      "name": "原生背景影响的两种极端表现",
      "definition": "一种是因自身经历先入为主，误判孩子行为；另一种是因曾被严格方式伤害，走向另一极端，对孩子的问题行为视而不见甚至包庇。",
      "atom_ids": [
        "s-9d052320fa26-c001:a007"
      ]
    }
  ],
