{
  "concepts": [
    {
      "name": "管教",
      "definition": "帮助孩子明白并学习一个道理或能力，赋能给孩子，让孩子从错误中学习到知识和道理，从而感到有力量和安全。",
      "atom_ids": [
        "s-b9d525b9be3d-c001:a001",
        "s-b9d525b9be3d-c001:a003",
        "s-b9d525b9be3d-c001:r001"
      ]
    },
    {
      "name": "惩罚",
      "definition": "发泄自己的怒气，通过让孩子痛苦来平息自己的愤怒，使孩子感到无能为力、弱小，拆毁孩子的安全感。",
      "atom_ids": [
        "s-b9d525b9be3d-c001:a001",
        "s-b9d525b9be3d-c001:a003",
        "s-b9d525b9be3d-c001:r001"
      ]
    },
    {
      "name": "管教目标",
      "definition": "父母在管教前必须想清楚要孩子学习什么，带着目的去管教，而不是盲目惩罚。",
      "atom_ids": [
        "s-b9d525b9be3d-c001:a004"
      ]
    },
    {
      "name": "惩罚式管教模式",
      "definition": "最简单的管教态度和模式，包括罚站、打骂、羞辱孩子、绑架、收东西（如收手机、零花钱、玩具），以及冷暴力（cold shoulder），即不理孩子。",
      "atom_ids": [
        "s-b9d525b9be3d-c001:a016"
      ]
    },
    {
      "name": "安全感",
      "definition": "管教建立孩子的安全感，惩罚拆毁孩子的安全感。",
      "atom_ids": [
        "s-b9d525b9be3d-c001:a003",
        "s-b9d525b9be3d-c001:r001"
      ]
    },
    {
      "name": "权威式管教",
      "definition": "父母以确认自己的权威为管教目标，不准孩子解释，压抑孩子情绪，可能导致孩子成为懦夫或暴君。",
      "atom_ids": [
        "s-b9d525b9be3d-c001:a011",
        "s-b9d525b9be3d-c001:a012"
      ]
    },
    {
      "name": "听话",
      "definition": "以让孩子听话顺服为管教目标，可能导致孩子长大后依赖他人，或行为反弹。",
      "atom_ids": [
        "s-b9d525b9be3d-c001:a006",
        "s-b9d525b9be3d-c001:a013"
      ]
    },
    {
      "name": "害怕",
      "definition": "以让孩子害怕为管教目标，可能导致孩子情绪低落、焦虑、抑郁。",
      "atom_ids": [
        "s-b9d525b9be3d-c001:a009"
      ]
    },
    {
      "name": "行为改变",
      "definition": "以改变行为为唯一管教目标，不关注孩子内心，可能导致孩子讨好型人格、界限缺失、情绪失联。",
      "atom_ids": [
        "s-b9d525b9be3d-c001:a010"
      ]
    },
    {
      "name": "优秀",
      "definition": "讲师提出疑问：什么是优秀？赚钱多、成绩好、家庭美满、感知幸福、生两个孩子、年薪多少等都不能明确界定优秀。",
      "atom_ids": [
        "s-b9d525b9be3d-c001:a007"
      ]
    }
  ],
