  "path": [
    {
      "name": "减少刺激杏仁核的方法",
      "steps": [
        {
          "action": "提供安全稳定的家庭环境",
          "atom_ids": [
            "s-9b112f4770a5-c001:a003"
          ],
          "condition": "避免暴力、侮辱、羞辱等。"
        },
        {
          "action": "提供有规律的家庭环境",
          "atom_ids": [
            "s-9b112f4770a5-c001:a006"
          ],
          "condition": "接送人一致、准时、可预测。"
        },
        {
          "action": "提供情绪安全",
          "atom_ids": [
            "s-9b112f4770a5-c001:a009"
          ],
          "condition": "孩子发脾气时给予安慰、安抚、陪伴。"
        },
        {
          "action": "识别并避免诱因",
          "atom_ids": [
            "s-9b112f4770a5-c001:a013"
          ],
          "condition": "如饥饿、困倦等，提前准备或调整。"
        }
      ]
    },
    {
      "name": "刺激前额叶的方法",
      "steps": [
        {
          "action": "玩游戏",
          "atom_ids": [
            "s-9b112f4770a5-c001:a015"
          ],
          "condition": "填字游戏、记忆游戏、乐高游戏、拼字游戏等。"
        },
        {
          "action": "做饭",
          "atom_ids": [
            "s-9b112f4770a5-c001:a016"
          ],
          "condition": "手眼协调、注意力集中、多任务处理等。"
        },
        {
          "action": "充足睡眠",
          "atom_ids": [
            "s-9b112f4770a5-c001:a017"
          ],
          "condition": "孩子九点半进入睡眠状态。"
        },
        {
          "action": "身体接触",
          "atom_ids": [
            "s-9b112f4770a5-c001:a020"
          ],
          "condition": "拥抱、抚摸，最好摸到皮肤。"
        },
        {
          "action": "运动",
          "atom_ids": [
            "s-9b112f4770a5-c001:a021"
          ],
          "condition": "打球、羽毛球、乒乓球等。"
        }
      ]
    }
  ],
