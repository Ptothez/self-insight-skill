{
  "concepts": [
    {
      "name": "杏仁核",
      "definition": "大脑中负责情绪反应和战斗准备的区域，被刺激时会导致孩子狂躁、抓狂。",
      "atom_ids": [
        "s-9b112f4770a5-c001:a001",
        "s-9b112f4770a5-c001:a002",
        "s-9b112f4770a5-c001:a010",
        "s-9b112f4770a5-c001:a013"
      ]
    },
    {
      "name": "前额叶",
      "definition": "大脑中负责自我控制、计划、判断等高级功能的区域，刺激越多越发达。",
      "atom_ids": [
        "s-9b112f4770a5-c001:a014",
        "s-9b112f4770a5-c001:a015",
        "s-9b112f4770a5-c001:a016",
        "s-9b112f4770a5-c001:a017",
        "s-9b112f4770a5-c001:a020",
        "s-9b112f4770a5-c001:a021"
      ]
    },
    {
      "name": "安全稳定的家庭环境",
      "definition": "孩子不会突然遭到袭击、不会因成绩不好被暴打或羞辱、父母不会拿刀砍人或打架、不会受到侮辱的家庭环境。",
      "atom_ids": [
        "s-9b112f4770a5-c001:a003"
      ]
    },
    {
      "name": "有规律的家庭环境",
      "definition": "放学上学接送的人一致、准时、大部分情况可预测的家庭环境。",
      "atom_ids": [
        "s-9b112f4770a5-c001:a006"
      ]
    },
    {
      "name": "情绪安全",
      "definition": "孩子发脾气时，父母应扮演安慰、安抚、陪伴的角色，而不是愤怒、粗暴打断或伤害孩子。",
      "atom_ids": [
        "s-9b112f4770a5-c001:a009"
      ]
    },
    {
      "name": "诱因",
      "definition": "导致孩子杏仁核被刺激的因素，如饥饿、困倦、没睡够、没喝水等。",
      "atom_ids": [
        "s-9b112f4770a5-c001:a013"
      ]
    },
    {
      "name": "情绪词汇",
      "definition": "描述情绪的词汇，如愤怒、嫉妒、悲伤，储存在左脑，调动左脑有助于平息情绪。",
      "atom_ids": [
        "s-9b112f4770a5-c001:a022"
      ]
    }
  ],
