  "path": [
    {
      "name": "权威式教育中的刻意养育方法",
      "steps": [
        {
          "action": "回顾过去一周与孩子的互动，评估talk to与talk at的时间",
          "atom_ids": [
            "s-22a4f2562957-c001:a003"
          ],
          "condition": "父母希望评估自己的沟通模式时"
        },
        {
          "action": "当孩子遇到挫折时，暂停解决问题的冲动，先与孩子建立情绪连接",
          "atom_ids": [
            "s-22a4f2562957-c001:a004",
            "s-22a4f2562957-c001:a005"
          ],
          "condition": "孩子表达负面情绪或事件时"
        },
        {
          "action": "允许孩子坐在失败和挫败感中，通过共情进入孩子的世界",
          "atom_ids": [
            "s-22a4f2562957-c001:a006"
          ],
          "condition": "孩子经历失败或挫败时"
        },
        {
          "action": "纠正孩子的行为，而不是纠正孩子的情绪",
          "atom_ids": [
            "s-22a4f2562957-c001:a008"
          ],
          "condition": "孩子有不当行为时"
        },
        {
          "action": "在非原则性小事上允许孩子犯错误",
          "atom_ids": [
            "s-22a4f2562957-c001:a009"
          ],
          "condition": "非原则性的事情上"
        },
        {
          "action": "对比自己的育儿类型，思考改进之处，成为权威式父母",
          "atom_ids": [
            "s-22a4f2562957-c001:a010"
          ],
          "condition": "课程结束时进行自我反思"
        }
      ]
    }
  ],
