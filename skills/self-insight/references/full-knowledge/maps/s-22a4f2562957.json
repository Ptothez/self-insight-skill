{
  "concepts": [
    {
      "name": "刻意养育",
      "definition": "有意识地选择回应方式，而非自动反应。",
      "atom_ids": [
        "s-22a4f2562957-c001:a001"
      ]
    },
    {
      "name": "条件反射性养育",
      "definition": "自动反应，未经思考的回应方式。",
      "atom_ids": [
        "s-22a4f2562957-c001:a001"
      ]
    },
    {
      "name": "talk at",
      "definition": "单方面对孩子说话，包括告知、讲道理、给指令。",
      "atom_ids": [
        "s-22a4f2562957-c001:a002"
      ]
    },
    {
      "name": "talk to",
      "definition": "与孩子进行双向的、你来我往的对话。",
      "atom_ids": [
        "s-22a4f2562957-c001:a002"
      ]
    },
    {
      "name": "情绪连接",
      "definition": "先共情孩子的情绪，理解孩子的感受，再处理问题。",
      "atom_ids": [
        "s-22a4f2562957-c001:a004",
        "s-22a4f2562957-c001:a005",
        "s-22a4f2562957-c001:a006"
      ]
    },
    {
      "name": "task mode",
      "definition": "立即进入解决问题模式，追问原因、分析问题、联系对方家长等。",
      "atom_ids": [
        "s-22a4f2562957-c001:a004",
        "s-22a4f2562957-c001:a005"
      ]
    },
    {
      "name": "允许孩子坐在失败和挫败感中",
      "definition": "不急于将孩子从痛苦中拉出来，允许孩子体验挫败感，父母通过共情和连接进入孩子的世界。",
      "atom_ids": [
        "s-22a4f2562957-c001:a006"
      ]
    },
    {
      "name": "纠正行为而非情绪",
      "definition": "情绪本身没有对错，需要被接纳；行为则需要被引导和纠正。",
      "atom_ids": [
        "s-22a4f2562957-c001:a008"
      ]
    },
    {
      "name": "非原则性小事上允许孩子犯错误",
      "definition": "在非原则性的事情上，孩子做得过了一点或没有做到，没有关系，应给孩子自由犯错误。",
      "atom_ids": [
        "s-22a4f2562957-c001:a009"
      ]
    }
  ],
