{
  "concepts": [
    {
      "name": "爱的五种语言",
      "definition": "表达爱的五种方式：鼓励的语言、身体的接触、用心的礼物、高质量的陪伴和提供帮助。",
      "atom_ids": [
        "s-07148dfa8e6f-c001:a003"
      ]
    },
    {
      "name": "鼓励的语言",
      "definition": "通过言语表达鼓励和肯定。",
      "atom_ids": [
        "s-07148dfa8e6f-c001:a004"
      ]
    },
    {
      "name": "身体的接触",
      "definition": "包括拥抱、亲吻、抚摸等身体接触行为。",
      "atom_ids": [
        "s-07148dfa8e6f-c001:a005"
      ]
    },
    {
      "name": "用心的礼物",
      "definition": "通过观察和了解对方需求后赠送的礼物，而非随意赠送。",
      "atom_ids": [
        "s-07148dfa8e6f-c001:a006"
      ]
    },
    {
      "name": "高质量的陪伴",
      "definition": "花时间、关掉手机、专注地与对方共度愉快时光。",
      "atom_ids": [
        "s-07148dfa8e6f-c001:a007"
      ]
    },
    {
      "name": "提供帮助",
      "definition": "在对方需要时主动为对方做事，如帮忙洗碗等。",
      "atom_ids": [
        "s-07148dfa8e6f-c001:a008"
      ]
    },
    {
      "name": "爱的语言测试方法",
      "definition": "通过一系列选择题测试个人主要的爱的语言，统计各选项出现次数，最多的即为个人主要爱的语言。",
      "atom_ids": [
        "s-07148dfa8e6f-c001:a009"
      ]
    },
    {
      "name": "爱的语言测试题目",
      "definition": "测试包含多道选择题，每题两个选项，分别对应爱的五种语言。",
      "atom_ids": [
        "s-07148dfa8e6f-c001:a010"
      ]
    },
    {
      "name": "父母爱孩子与孩子感受到爱是两回事",
      "definition": "父母可能付出一切甚至生命去爱孩子，但孩子可能从心底感受不到这种爱，甚至产生怨恨和缺失感。",
      "atom_ids": [
        "s-07148dfa8e6f-c001:a001",
        "s-07148dfa8e6f-c001:r001"
      ]
    },
    {
      "name": "孩子感受不到爱的原因",
      "definition": "父母给予的爱与孩子需要的爱不匹配，父母沿用孩子小时候的方式表达爱，而孩子在不同年龄阶段需要不同的爱。",
      "atom_ids": [
        "s-07148dfa8e6f-c001:a002",
        "s-07148dfa8e6f-c001:r002"
      ]
    },
    {
      "name": "父母等感谢与孩子等道歉的错位",
      "definition": "父母在等孩子一句感谢，而孩子在等父母一句道歉，这种错位源于父母给予的爱不是孩子需要的爱。",
      "atom_ids": [
        "s-07148dfa8e6f-c001:r003"
      ]
    },
    {
      "name": "精准给予孩子所需爱的方法",
      "definition": "从科学角度了解孩子每个年龄阶段需要的爱，精准给予，使付出事半功倍，孩子也因得到准确的爱而更幸福。",
      "atom_ids": [
        "s-07148dfa8e6f-c001:r004"
      ]
    }
  ],
