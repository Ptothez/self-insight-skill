{
  "concepts": [
    {
      "name": "赋能孩子达到不抓狂状态",
      "definition": "父母赋能给孩子，帮助孩子自己达到不抓狂的状态，而不是替孩子达到。",
      "atom_ids": [
        "s-54e16185d7df-c001:a001"
      ]
    },
    {
      "name": "婴幼儿基础情绪学习（0-2岁）",
      "definition": "0-2岁孩子大量积累和学习情绪，情绪简单粗暴，主要是第一情绪（咯咯笑、哇哇哭、啊啊生气），主要从父母或养育者学习，且学习后不会反馈给父母。",
      "atom_ids": [
        "s-54e16185d7df-c001:a002",
        "s-54e16185d7df-c001:a005"
      ]
    },
    {
      "name": "养育者表情对婴幼儿情绪理解的影响",
      "definition": "养育者面无表情或严肃会导致孩子情绪理解片面、易焦虑；互动活泼则情绪学习更全面广泛。",
      "atom_ids": [
        "s-54e16185d7df-c001:a003"
      ]
    },
    {
      "name": "社交情绪发展（2-4岁）",
      "definition": "2-4岁孩子延伸出社交情绪，如恐惧、害羞、因输而产生的愤怒，这些情绪是孩子与他人和外界建立联系后延伸出来的。",
      "atom_ids": [
        "s-54e16185d7df-c001:a004"
      ]
    },
    {
      "name": "夫妻界限影响孩子情绪安全感",
      "definition": "夫妻之间有没有界限会影响孩子情绪里的安全感、以后跟人的亲密度以及对情感的兴趣度。",
      "atom_ids": [
        "s-54e16185d7df-c001:a006"
      ]
    },
    {
      "name": "父母婚姻不幸福与孩子上瘾行为关联",
      "definition": "沉迷于游戏、色情、毒品等上瘾行为的人，其父母婚姻往往不幸福；父母健康恩爱的孩子很少对谈恋爱不感兴趣。",
      "atom_ids": [
        "s-54e16185d7df-c001:a007"
      ]
    },
    {
      "name": "夫妻冲突对儿童的负面影响机制",
      "definition": "夫妻冲突对儿童情绪、行为和学业完成有负面影响，通过羞耻和恐惧的内化、模仿等机制发生。",
      "atom_ids": [
        "s-54e16185d7df-c001:a008",
        "s-54e16185d7df-c001:r001"
      ]
    },
    {
      "name": "家暴家庭孩子模仿暴力行为",
      "definition": "家暴家庭中孩子可能出现打同学、伤害动物等暴力行为，是模仿在家看到的倾向。",
      "atom_ids": [
        "s-54e16185d7df-c001:a009"
      ]
    },
    {
      "name": "错误的吵架方式",
      "definition": "包括暴力行为、语言侮辱、冷暴力、讽刺，会让孩子感受到人与人之间刺透人心的伤害，产生恐惧和焦虑。",
      "atom_ids": [
        "s-54e16185d7df-c001:a010"
      ]
    },
    {
      "name": "语言侮辱案例",
      "definition": "丈夫对孤儿妻子说“你是一个没有人要的人，怪不得你爸妈要抛弃你”，属于语言侮辱。",
      "atom_ids": [
        "s-54e16185d7df-c001:a011"
      ]
    },
    {
      "name": "正确的吵架方式",
      "definition": "可以提高音量、生气、指责行为（而非人格）、哭、走开、拒绝继续对话。",
      "atom_ids": [
        "s-54e16185d7df-c001:a012"
      ]
    },
    {
      "name": "夫妻和好对孩子的重要性",
      "definition": "夫妻吵架后一定要在孩子面前和好，否则孩子以后与人发生矛盾时容易崩溃，因为脑子里没有和好的模型。",
      "atom_ids": [
        "s-54e16185d7df-c001:a013"
      ]
    },
    {
      "name": "知道如何和好的孩子更少极端行为",
      "definition": "知道如何与别人和好的孩子，在与人闹矛盾后崩溃几率更少，出现伤害他人或自己的极端情绪和行为几率更小。",
      "atom_ids": [
        "s-54e16185d7df-c001:a014"
      ]
    },
    {
      "name": "自残案例：未婚夫削肉",
      "definition": "男性客人与未婚妻吵架后自残削肉，因不知道如何处理矛盾、如何和好；其父母婚姻支离破碎但表面维系，从不在孩子面前吵架和和好。",
      "atom_ids": [
        "s-54e16185d7df-c001:a015"
      ]
    },
    {
      "name": "错误的和好方式",
      "definition": "包括找别的话题转移、装没发生过、开玩笑平事，没有真正解决问题。",
      "atom_ids": [
        "s-54e16185d7df-c001:a016"
      ]
    },
    {
      "name": "开玩笑和好案例",
      "definition": "三姨父开玩笑说“数到三他马上就笑”，三姨说“滚”，然后两人就好了，但问题从未解决。",
      "atom_ids": [
        "s-54e16185d7df-c001:a017"
      ]
    },
    {
      "name": "正确的和好方式：先恢复关系再解决问题",
      "definition": "和好的第一步是恢复关系，然后再解决问题，绝对不是先解决问题。",
      "atom_ids": [
        "s-54e16185d7df-c001:a018"
      ]
    },
    {
      "name": "和好方法：撒娇",
      "definition": "撒娇是非常好的和好方式，男方女方都可以撒娇，孩子也会学。",
      "atom_ids": [
        "s-54e16185d7df-c001:a019"
      ]
    },
    {
      "name": "和好方法：谈感受",
      "definition": "和好时谈感受，如“我觉得好难过”“我好害怕”，包括谈对吵架的感受、孤独感受等。",
      "atom_ids": [
        "s-54e16185d7df-c001:a020"
      ]
    },
    {
      "name": "和好方法：谈为什么生气",
      "definition": "和好时谈为什么生气，如对方的话让自己联想到父母曾说过，感觉被瞧不起。",
      "atom_ids": [
        "s-54e16185d7df-c001:a021"
      ]
    },
    {
      "name": "和好方法：分析吵架中发生了什么",
      "definition": "和好时分析吵架过程中发生了什么，包括外界干扰因素导致矛盾激化。",
      "atom_ids": [
        "s-54e16185d7df-c001:a022"
      ]
    }
  ],
