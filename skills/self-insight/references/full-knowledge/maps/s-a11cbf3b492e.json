{
  "concepts": [
    {
      "name": "右脑功能",
      "definition": "负责感觉、视觉、想象力、音乐、情感、整体思维和情绪，如孩子的大哭、大笑、尖叫等。",
      "atom_ids": [
        "s-a11cbf3b492e-c001:a002"
      ]
    },
    {
      "name": "左脑功能",
      "definition": "负责语言、逻辑、讲道理、时间观念、抽象思考和准确性判断，如用词是否准确。",
      "atom_ids": [
        "s-a11cbf3b492e-c001:a003"
      ]
    },
    {
      "name": "大脑发育顺序",
      "definition": "右脑先发育，左脑七岁后快速发育；右脑从出生到七岁飞速发展，左脑七岁以后快速发育，负责抽象逻辑等能力。",
      "atom_ids": [
        "s-a11cbf3b492e-c001:a004"
      ]
    },
    {
      "name": "幼儿时间概念缺失",
      "definition": "三至五岁孩子的大脑不具备理解“20分钟”等时间概念的能力，对他们来说，五秒钟、一分钟、十分钟、50分钟、100分钟没有区别。",
      "atom_ids": [
        "s-a11cbf3b492e-c001:a005"
      ]
    },
    {
      "name": "幼儿注意力特点",
      "definition": "幼儿右脑发育好，对颜色和声音敏感，因此玩具通常五颜六色并带有声音，以吸引孩子注意力。",
      "atom_ids": [
        "s-a11cbf3b492e-c001:a006"
      ]
    },
    {
      "name": "讲道理对幼儿无效",
      "definition": "父母给孩子讲道理时，孩子听不进去，因为右脑无法处理左脑负责的逻辑和抽象思考。",
      "atom_ids": [
        "s-a11cbf3b492e-c001:a008"
      ]
    },
    {
      "name": "大脑成熟年龄",
      "definition": "人的大脑在25岁之前都未发育成熟，18岁成年但大脑仍处于逐步发育定型阶段。25岁后大脑定型成熟。",
      "atom_ids": [
        "s-a11cbf3b492e-c001:a009"
      ]
    },
    {
      "name": "七岁后左脑发育未成熟",
      "definition": "七岁后左脑开始发育，但孩子能力是逐步跟上的，不能因为孩子超过七岁就要求其完全具备专注力或理解抽象概念。",
      "atom_ids": [
        "s-a11cbf3b492e-c001:a010"
      ]
    },
    {
      "name": "右脑比喻",
      "definition": "右脑被比喻为带孩子去公园玩，铺桌巾在草地上，看蓝天白云、听音乐、放风筝、躺在草地上，代表放松、情感和感觉体验。",
      "atom_ids": [
        "s-a11cbf3b492e-c001:a012"
      ]
    },
    {
      "name": "左脑比喻",
      "definition": "左脑被比喻为在公司上班的格子间，井然有序，有固定时间开会、见客户、做方案、汇报、上下班和坐地铁，代表逻辑、秩序和时间管理。",
      "atom_ids": [
        "s-a11cbf3b492e-c001:a013"
      ]
    },
    {
      "name": "婴儿哭表达需求",
      "definition": "婴儿出生后右脑已高速发展，因此通过哭来表达饥饿、寒冷、不舒服、找不到父母或不高兴等需求。",
      "atom_ids": [
        "s-a11cbf3b492e-c001:r001"
      ]
    },
    {
      "name": "幼儿想象力充足",
      "definition": "幼儿时期想象力特别充足，这是右脑发育良好的表现。",
      "atom_ids": [
        "s-a11cbf3b492e-c001:r002"
      ]
    }
  ],
