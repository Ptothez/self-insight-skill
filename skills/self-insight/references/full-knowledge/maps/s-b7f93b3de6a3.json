{
  "concepts": [
    {
      "name": "提问作为优秀父母习惯",
      "definition": "优秀父母将提问作为载体，用来传递关心、爱和建立孩子的价值观，因此提问被列入优秀父母的七个习惯之一。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a001"
      ]
    },
    {
      "name": "令人厌烦的提问",
      "definition": "通常涉及收入、车房、婚育等隐私或比较性问题，让人想远离。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a002"
      ]
    },
    {
      "name": "令人愉快的提问",
      "definition": "关注个人经历、反思和分享，能促进愉快聊天。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a002"
      ]
    },
    {
      "name": "哈佛大学提问实验",
      "definition": "哈佛大学教授让40对陌生人两两配对，按设计从浅到深提问（如从喜欢吃什么到最深伤害），回答完所有问题后双方感到非常亲近，甚至有人觉得亲密度超过父母或兄弟姐妹，最后有两对成为夫妻。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a003"
      ]
    },
    {
      "name": "问对问题拉近距离",
      "definition": "问对问题能让两个人的距离无限且快速地拉近；问错问题（如直接问收入等）会让人厌恶并想远离。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a004"
      ]
    },
    {
      "name": "父母提问方式导致孩子厌烦",
      "definition": "很多父母对孩子提问时像令人厌烦的亲戚朋友一样，喋喋不休地问让孩子厌烦的问题，导致孩子不愿回答，甚至从小就不喜欢回答父母问题，形成无效沟通。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a005"
      ]
    },
    {
      "name": "培养问对问题的习惯",
      "definition": "目标不是上完课就能做到，而是开始建立问对问题的习惯；通过打卡训练营大量案例练习，在生活中遇到事情时警觉并练习问对问题的习惯。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a006"
      ]
    },
    {
      "name": "朋友问儿子偷吃巧克力案例",
      "definition": "朋友看到儿子偷吃巧克力，却问“你有偷吃巧克力吗？”，儿子撒谎。讲师指出这是引诱孩子撒谎的问题，因为已经看到事实就不该提问，而应直接告诉孩子“我看到你吃了”。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a007"
      ]
    },
    {
      "name": "提问的重要作用",
      "definition": "提问有很重要的作用，如果问题没有起到这些作用，孩子会不想要回答和沟通；因此不要浪费每一个问题。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a008"
      ]
    },
    {
      "name": "不要试验孩子的诚实",
      "definition": "如果已经看到孩子偷吃，不要用提问来试验孩子是否诚实，因为自己也不一定经得住考验；不要试验孩子。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a009"
      ]
    },
    {
      "name": "不会问问题的底层原因",
      "definition": "不会问问题的原因包括：用成人心理和孩子心理沟通、兴奋点不同、问问题的目的不当（获取信息和机会教育）。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a010"
      ]
    },
    {
      "name": "成人心理与孩子心理的沟通差异",
      "definition": "成人心理注重逻辑和次序，孩子心理则跳跃、语无伦次，会说一些成人不明白但孩子明白的话；如果按成人心理与孩子沟通，提问会让孩子觉得无聊。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a011"
      ]
    },
    {
      "name": "兴奋点不同导致提问无效",
      "definition": "父母的兴奋点在于获取信息（如学校学习、人际关系、午饭等）并进行分析判断；孩子的兴奋点在于分享自己认为兴奋的事情（如玩什么、小汽车、朋友说的话等），父母会自动删除认为无用的信息。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a012"
      ]
    },
    {
      "name": "家长提问的两个主要目的",
      "definition": "大部分家长提问的目的有两个：获取信息（如午饭、考试成绩、春游时间）和机会教育（如从故事中学到什么），但这类问题不应占据提问的大多数时间。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a013"
      ]
    },
    {
      "name": "孩子喜欢回答的问题类型",
      "definition": "孩子喜欢回答让他们感到被了解、被认识、被喜欢的问题。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a014"
      ]
    },
    {
      "name": "被了解的问题示例",
      "definition": "被了解的问题示例：“你这样大哭是因为你以为妈妈走了以后就再也不会回来了，对吗？”“你在开心的时候，你是喜欢想要尖叫，对吗？”这类问题解释孩子的行为并确认，让孩子感到被理解。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a015"
      ]
    },
    {
      "name": "被认识的问题示例",
      "definition": "被认识的问题示例：“是什么原因让你不喜欢跟某个小朋友玩呢？”让孩子解释原因，孩子在澄清自己的过程中让对方认识自己。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a016"
      ]
    },
    {
      "name": "认识和被认识的核心需要",
      "definition": "每个人都有核心的需要：认识和被认识。当孩子觉得被更深认识时，会喜欢回答这样的问题。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a017"
      ]
    },
    {
      "name": "被喜欢的问题示例",
      "definition": "被喜欢的问题示例：“宝贝，为什么所有人都想请你去参加他的生日宴会呢？”这样的问题让孩子感到被喜欢。",
      "atom_ids": [
        "s-b7f93b3de6a3-c001:a018"
      ]
    }
  ],
