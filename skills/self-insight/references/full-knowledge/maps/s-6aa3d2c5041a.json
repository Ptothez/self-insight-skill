{
  "concepts": [
    {
      "name": "允许失败与收拾残局",
      "definition": "在读书阶段，孩子需要确认自己能否成功，允许孩子失败并让其收拾失败残局，使其认识到失败并不可怕。",
      "atom_ids": [
        "s-6aa3d2c5041a-c001:a001"
      ]
    },
    {
      "name": "允许并鼓励孩子拒绝父母",
      "definition": "孩子长大后有了更多独立想法，父母应允许并鼓励孩子拒绝自己，以支持其独立性发展。",
      "atom_ids": [
        "s-6aa3d2c5041a-c001:a002"
      ]
    },
    {
      "name": "13-18岁父母角色为导师",
      "definition": "13到18岁，父母应做孩子的导师，把孩子当作门徒来尊重，劝导但给予很多自由，让孩子选择后果。",
      "atom_ids": [
        "s-6aa3d2c5041a-c001:a003"
      ]
    },
    {
      "name": "允许早期犯错以控制后果",
      "definition": "让孩子在十三四岁早期犯错有好处，因为此时父母还能控制后果；而到十七八岁后犯错，父母已无能为力。",
      "atom_ids": [
        "s-6aa3d2c5041a-c001:a004"
      ]
    },
    {
      "name": "朋友影响短效，父母影响长效",
      "definition": "青少年期朋友影响多为短效方面，如发型、发色、穿衣等；而价值观、道德观、责任感、世界观等长效影响绝对由父母产生。",
      "atom_ids": [
        "s-6aa3d2c5041a-c001:a005"
      ]
    },
    {
      "name": "与孩子讨论行为后果以强化前额叶",
      "definition": "经常与青少年讨论行为后果，可以帮助他们将冲动性思维和事实联系起来，激发并强化前额叶，使其更有效管控行为后果。",
      "atom_ids": [
        "s-6aa3d2c5041a-c001:a006"
      ]
    },
    {
      "name": "提醒孩子注意自身能力以抵御不良影响",
      "definition": "青少年很难看到自己在恶劣环境中发挥作用的能力，父母提醒孩子有独立和自控能力，可帮助其在困难情境中保持住，并意识到某些行为是毁灭性的。",
      "atom_ids": [
        "s-6aa3d2c5041a-c001:a007"
      ]
    },
    {
      "name": "作为导师要对孩子感兴趣",
      "definition": "成功的导师一定对引导的人感兴趣，父母要对孩子好奇，了解其喜欢的原因，但不代表要喜欢孩子喜欢的东西。",
      "atom_ids": [
        "s-6aa3d2c5041a-c001:a008"
      ]
    },
    {
      "name": "不要乱给建议，先倾听",
      "definition": "青少年遇到问题时，父母常急于给建议，但孩子可能只希望被倾听。孩子未问建议时只听，问了才说。",
      "atom_ids": [
        "s-6aa3d2c5041a-c001:a009"
      ]
    },
    {
      "name": "18-25岁父母角色为朋友",
      "definition": "18到25岁，父母应做孩子的朋友，主动帮助孩子与自己分开，体面地分开，尊重其主权和独立性。",
      "atom_ids": [
        "s-6aa3d2c5041a-c001:a010"
      ]
    },
    {
      "name": "经济支持作为礼物，不附加要求",
      "definition": "18-25岁孩子可能仍用父母的钱，建议将钱作为礼物给予，但不能附加要求，如要求学特定专业或交特定女友。",
      "atom_ids": [
        "s-6aa3d2c5041a-c001:a011"
      ]
    }
  ],
