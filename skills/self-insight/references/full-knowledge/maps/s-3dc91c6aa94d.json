{
  "concepts": [
    {
      "name": "父母角色调整",
      "definition": "父母需要根据孩子不同年龄阶段的心理变化调整自己的角色，否则会导致孩子发展停滞或心理问题。",
      "atom_ids": [
        "s-3dc91c6aa94d-c001:a002",
        "s-3dc91c6aa94d-c001:a005",
        "s-3dc91c6aa94d-c001:a008",
        "s-3dc91c6aa94d-c001:a009",
        "s-3dc91c6aa94d-c001:a010",
        "s-3dc91c6aa94d-c001:a011"
      ]
    },
    {
      "name": "童年缺失的长期影响",
      "definition": "童年时期缺乏适当的父母角色或供养，会导致个体在成年后以某种形式表现出补偿行为或心理问题。",
      "atom_ids": [
        "s-3dc91c6aa94d-c001:a005",
        "s-3dc91c6aa94d-c001:a006",
        "s-3dc91c6aa94d-c001:a007",
        "s-3dc91c6aa94d-c001:a022"
      ]
    },
    {
      "name": "大脑发育与心理需求",
      "definition": "大脑发育带来能力增强和心理需求变化，忽略大脑发育与心理健康的联系会导致育儿偏颇。",
      "atom_ids": [
        "s-3dc91c6aa94d-c001:a016",
        "s-3dc91c6aa94d-c001:a017",
        "s-3dc91c6aa94d-c001:a018",
        "s-3dc91c6aa94d-c001:a019"
      ]
    },
    {
      "name": "阶段特定能力发展",
      "definition": "不同年龄阶段需要发展特定能力，如3-5岁独立、6-12岁允许犯错、青少年独立和反抗，否则会导致发展停滞。",
      "atom_ids": [
        "s-3dc91c6aa94d-c001:a012",
        "s-3dc91c6aa94d-c001:a013",
        "s-3dc91c6aa94d-c001:a014",
        "s-3dc91c6aa94d-c001:a015"
      ]
    },
    {
      "name": "心理问题的隐蔽性",
      "definition": "孩子心理问题可能在长大后才能被发现，表面优秀不代表没有问题。",
      "atom_ids": [
        "s-3dc91c6aa94d-c001:a020",
        "s-3dc91c6aa94d-c001:a021"
      ]
    },
    {
      "name": "健康养育环境对生理的影响",
      "definition": "缺乏健康养育环境会导致荷尔蒙紊乱和免疫系统削弱，影响终身身心健康。",
      "atom_ids": [
        "s-3dc91c6aa94d-c001:a023",
        "s-3dc91c6aa94d-c001:a024"
      ]
    }
  ],
