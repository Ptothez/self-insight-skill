{
  "concepts": [
    {
      "name": "左脑功能",
      "definition": "左脑负责逻辑事实、数学现象、思考时间、准确语言和次序。",
      "atom_ids": [
        "s-4510b0b83f29-c001:a001"
      ]
    },
    {
      "name": "左脑发育缓慢",
      "definition": "如果父母没有有意识地刻意引导孩子的左右脑连结，孩子的左脑在七岁之前发育非常缓慢，与右脑发育速度完全不成正比。",
      "atom_ids": [
        "s-4510b0b83f29-c001:a002"
      ]
    },
    {
      "name": "左脑发育加速",
      "definition": "左脑在孩子七岁过后开始飞速发展，但在七岁以前发育非常缓慢。",
      "atom_ids": [
        "s-4510b0b83f29-c001:a003"
      ]
    },
    {
      "name": "右脑主导",
      "definition": "孩子七岁后左脑开始发育，但不会自动平衡使用左右脑。因为在人生最初七年中绝大部分时间都在用右脑，左脑发育时右脑也在继续发育，所以孩子最熟悉和最擅长的仍然是使用右脑。",
      "atom_ids": [
        "s-4510b0b83f29-c001:a004"
      ]
    },
    {
      "name": "情绪化冲动",
      "definition": "七岁后的孩子很多时候仍然非常极端、情绪化、冲动，是因为他们最熟悉和擅长的还是使用右脑，而非左脑。",
      "atom_ids": [
        "s-4510b0b83f29-c001:a005"
      ]
    },
    {
      "name": "大脑成熟时间",
      "definition": "在孩子25岁之前，大脑都没有发育成熟。",
      "atom_ids": [
        "s-4510b0b83f29-c001:a006"
      ]
    },
    {
      "name": "事实概念缺失",
      "definition": "孩子左脑对事实概念尚未建立，并非真正撒谎。",
      "atom_ids": [
        "s-4510b0b83f29-c001:a007",
        "s-4510b0b83f29-c001:a008",
        "s-4510b0b83f29-c001:a009",
        "s-4510b0b83f29-c001:a010",
        "s-4510b0b83f29-c001:a011"
      ]
    },
    {
      "name": "左右脑特点应用",
      "definition": "下一期课程将讲到孩子做作业磨磨蹭蹭该怎么办，会运用左右脑的特点来处理这一情况。",
      "atom_ids": [
        "s-4510b0b83f29-c001:a012"
      ]
    }
  ],
