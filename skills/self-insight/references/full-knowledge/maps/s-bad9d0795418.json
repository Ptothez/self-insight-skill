{
  "concepts": [
    {
      "name": "反复学习巩固育儿知识",
      "definition": "课程建议父母反复听、反复理解课程内容，才能将科学育儿知识印在脑海中，避免几天后回到旧习惯。",
      "atom_ids": [
        "s-bad9d0795418-c001:a001"
      ]
    },
    {
      "name": "课程知识帮助情绪控制",
      "definition": "父亲在学习如何管教孩子后，某天正要发脾气时突然想起讲师的话，脸色由难看转为温柔，孩子感到莫名其妙。案例说明课程知识可在关键时刻帮助父母控制情绪。",
      "atom_ids": [
        "s-bad9d0795418-c001:a002"
      ]
    },
    {
      "name": "引导孩子前先了解行为原因",
      "definition": "引导孩子的第二个原则是：先搞清楚孩子为什么这样做。父母需要有好奇心，当孩子做了不喜欢的事时，先问自己：为什么他要这样做？他想要什么？他想要表达什么？",
      "atom_ids": [
        "s-bad9d0795418-c001:a003"
      ]
    },
    {
      "name": "游乐场推人事件：母亲未先了解原因",
      "definition": "讲师带两个孩子去公共游乐场，老大被一个大两三岁的男孩推倒。男孩母亲先安抚情绪，然后让孩子道歉，并教导公共玩具要分享。但她没有问孩子为什么推人，先入为主认为孩子自私霸占玩具。讲师询问后，孩子说因为玩得专心被突然出现的老大吓到，出于自我保护下意识推人，然后吓哭。母亲关于分享的教导因此没有太大意义。",
      "atom_ids": [
        "s-bad9d0795418-c001:a004"
      ]
    },
    {
      "name": "情绪联结后需探究行为原因",
      "definition": "在引导孩子时，先做情绪联结（如安抚情绪）是好的，但之后必须探究行为原因，否则教导可能无效。",
      "atom_ids": [
        "s-bad9d0795418-c001:a005"
      ]
    },
    {
      "name": "先入为主假设与真实原因的区别",
      "definition": "父母容易先入为主地假设孩子行为原因（如认为自私、霸占玩具），但真实原因可能完全不同（如受到惊吓的自我保护）。只有询问孩子才能了解真实原因。",
      "atom_ids": [
        "s-bad9d0795418-c001:a006"
      ]
    }
  ],
