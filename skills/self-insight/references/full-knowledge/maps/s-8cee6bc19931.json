{
  "concepts": [
    {
      "name": "过分关注孩子",
      "definition": "对五六七岁到高中的孩子投入过多时间、精力和经济，超过合理界限，导致孩子出现自我中心、贪婪、不负责任、没有耐心等问题，并导致父母过少关注自己。",
      "atom_ids": [
        "s-8cee6bc19931-c001:a001",
        "s-8cee6bc19931-c001:a002",
        "s-8cee6bc19931-c001:a003",
        "s-8cee6bc19931-c001:a004",
        "s-8cee6bc19931-c001:a005",
        "s-8cee6bc19931-c001:a006",
        "s-8cee6bc19931-c001:a007",
        "s-8cee6bc19931-c001:a008",
        "s-8cee6bc19931-c001:r001"
      ]
    },
    {
      "name": "正常关注",
      "definition": "对于很小的孩子（如两三个月大），父母所有时间都花在孩子身上是应当的，不叫过分关注。",
      "atom_ids": [
        "s-8cee6bc19931-c001:a001",
        "s-8cee6bc19931-c001:r001"
      ]
    },
    {
      "name": "关注自己的情绪",
      "definition": "关注自己是否因疲倦引起慢性抑郁、什么事情让自己焦虑、经历了什么伤害；不仅要问开不开心，还要关注事情对自己造成的情绪影响。",
      "atom_ids": [
        "s-8cee6bc19931-c001:a009"
      ]
    },
    {
      "name": "情绪测试",
      "definition": "在快乐、悲伤、愤怒、恐惧、恶心、惊讶六种基本情绪中，分别写出至少五种第二层情绪。",
      "atom_ids": [
        "s-8cee6bc19931-c001:a010"
      ]
    }
  ],
