{
  "concepts": [
    {
      "name": "承认错误",
      "definition": "父母愿意向孩子承认自己的错误，是优秀父母的重要习惯，需要培养，因为没有人天生喜欢认错。",
      "atom_ids": [
        "s-a35a14041d25-c001:a001",
        "s-a35a14041d25-c001:a002"
      ]
    },
    {
      "name": "害怕承认错误的原因",
      "definition": "父母害怕向孩子承认错误，因为担心孩子认为自己糟糕、不再顺服，或认为孩子会因此不认错。",
      "atom_ids": [
        "s-a35a14041d25-c001:a003"
      ]
    },
    {
      "name": "认错障碍",
      "definition": "父母不知道如何认错，认为要么全错要么不认错，害怕影响管教；同时缺乏认错模式，因为自己的父母从未道歉。",
      "atom_ids": [
        "s-a35a14041d25-c001:a004",
        "s-a35a14041d25-c001:a005"
      ]
    },
    {
      "name": "代际反差",
      "definition": "父母等待孩子说谢谢，孩子等待父母说对不起，因为父母不道歉。",
      "atom_ids": [
        "s-a35a14041d25-c001:a006"
      ]
    },
    {
      "name": "传统思想阻碍",
      "definition": "传统思想“天下无不是的父母”使父母不觉得应该道歉，也拉不下面子。",
      "atom_ids": [
        "s-a35a14041d25-c001:a007"
      ]
    },
    {
      "name": "顺服与欺负",
      "definition": "父母要求孩子顺服，即使自己错了也要顺服，这不是顺服而是欺负，因为父母仗着优势对孩子不公义。",
      "atom_ids": [
        "s-a35a14041d25-c001:a008"
      ]
    },
    {
      "name": "不道歉的长期后果",
      "definition": "父母不道歉，孩子小时候无奈，长大后拒绝父母参与重要决策，如考大学不商量。",
      "atom_ids": [
        "s-a35a14041d25-c001:a009"
      ]
    },
    {
      "name": "顺服的前提",
      "definition": "顺服需要先理顺关系，父母做错后要认错道歉，关系无隔阂，孩子才可能心服口服。",
      "atom_ids": [
        "s-a35a14041d25-c001:a010"
      ]
    },
    {
      "name": "骄傲阻碍认错",
      "definition": "父母的骄傲表现为认为自己经验丰富不会错，导致无法向孩子承认错误，也难以向孩子学习。",
      "atom_ids": [
        "s-a35a14041d25-c001:a011",
        "s-a35a14041d25-c001:a012",
        "s-a35a14041d25-c001:a013"
      ]
    },
    {
      "name": "错误认错方式",
      "definition": "父母用错误的方式承认错误，会对孩子造成二次伤害，使亲子关系更不好。",
      "atom_ids": [
        "s-a35a14041d25-c001:r001"
      ]
    },
    {
      "name": "挑战骄傲与面子",
      "definition": "向孩子承认错误需要挑战父母的骄傲、面子和错误认知，养成健康习惯。",
      "atom_ids": [
        "s-a35a14041d25-c001:r002"
      ]
    },
    {
      "name": "积怨与逆反",
      "definition": "父母不道歉，孩子表面顺服但内心积怨，长大后可能拒绝父母参与；内心逆反，拒绝父母参与生命。",
      "atom_ids": [
        "s-a35a14041d25-c001:r003",
        "s-a35a14041d25-c001:r004"
      ]
    },
    {
      "name": "不道歉掩盖问题",
      "definition": "父母不道歉可能掩盖自身的懦弱、骄傲和虚伪，而非真正为了管教。",
      "atom_ids": [
        "s-a35a14041d25-c001:r005"
      ]
    }
  ],
