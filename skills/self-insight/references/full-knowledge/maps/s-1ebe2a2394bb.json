{
  "concepts": [
    {
      "name": "负面情绪回避",
      "definition": "孩子对负面场景或感受的排斥和回避，在三岁是正常现象，不必过度担心。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a001",
        "s-1ebe2a2394bb-c001:a003",
        "s-1ebe2a2394bb-c001:a006"
      ]
    },
    {
      "name": "负面情绪回避的应对",
      "definition": "通过询问原因、陪伴观看、引导忍耐来帮助孩子度过负面场景。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a002"
      ]
    },
    {
      "name": "孩子排斥负面感受的原因",
      "definition": "家长生气让孩子感到不安全，或家长不接受孩子的负面情绪，导致孩子排斥负面感受。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a004"
      ]
    },
    {
      "name": "家长非语言反应的影响",
      "definition": "家长不耐烦、厌恶等非语言反应会让孩子讨厌负面情绪。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a005"
      ]
    },
    {
      "name": "公共场合尖叫的应对",
      "definition": "告诉孩子后果，尖叫就带离现场，冷静五分钟，允许哭并表达理解。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a008",
        "s-1ebe2a2394bb-c001:r001"
      ]
    },
    {
      "name": "心理学家无法知道行为原因",
      "definition": "讲师强调家长应比讲师更了解孩子，心理学家不是魔法师。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a009"
      ]
    },
    {
      "name": "孩子不敢表达真实情绪",
      "definition": "孩子哭时用无关理由搪塞，说明不信任家长，缺乏安全感。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a010"
      ]
    },
    {
      "name": "应对孩子不敢表达真实情绪",
      "definition": "接受哭泣，不表现厌恶，让孩子明白妈妈可以处理他的哭泣。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a011"
      ]
    },
    {
      "name": "绘本选择标准",
      "definition": "选择科学的绘本，避免情绪怪兽等诡异内容。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a013"
      ]
    },
    {
      "name": "大团圆结局的年龄适用性",
      "definition": "两到三岁孩子需要大团圆结局，13岁仍大团圆则不正常。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a014",
        "s-1ebe2a2394bb-c001:a015"
      ]
    },
    {
      "name": "孩子情感丰富但不敢表达",
      "definition": "可能因性格或缺乏安全感，不敢表达丰富情绪。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a016"
      ]
    },
    {
      "name": "成人压抑情绪导致间接释放",
      "definition": "成人压抑情绪通过看剧释放，孩子这样不正常。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a017"
      ]
    },
    {
      "name": "让孩子感觉情绪安全的方法",
      "definition": "不要直接问孩子是否安全，观察迹象，努力营造安全环境。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a018"
      ]
    },
    {
      "name": "自主入睡倒退",
      "definition": "21个月男宝自主入睡训练倒退，因未意识到永久性。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a019",
        "s-1ebe2a2394bb-c001:a020"
      ]
    },
    {
      "name": "应对自主入睡倒退",
      "definition": "分房睡，让孩子意识到自己睡觉是永久的事情。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a021"
      ]
    },
    {
      "name": "更早开放感受的前提",
      "definition": "让孩子知道不必为家长情绪负责，不情绪绑架。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a023"
      ]
    },
    {
      "name": "情绪界限",
      "definition": "我的情绪我来负责，不要你负责。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a024",
        "s-1ebe2a2394bb-c001:a025"
      ]
    },
    {
      "name": "电子产品作为奖励的错误",
      "definition": "用电子产品奖励会让孩子上瘾、成绩挂钩、毁约降低公信力。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a027"
      ]
    },
    {
      "name": "处理承诺毁约",
      "definition": "兑现承诺，道歉，让孩子明白是家长错。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a028"
      ]
    },
    {
      "name": "家长毁约并责怪孩子的错误",
      "definition": "毁约后责怪孩子导致愤怒、不信任、亲子关系恶化。",
      "atom_ids": [
        "s-1ebe2a2394bb-c001:a029",
        "s-1ebe2a2394bb-c002:a001"
      ]
    },
    {
      "name": "因孩子痛苦而妥协的负面强化",
      "definition": "妥协购买会强化孩子用愤怒和痛苦获得想要的东西。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a002"
      ]
    },
    {
      "name": "父母毁约后的补救方法",
      "definition": "道歉、解释、履行承诺、尊重孩子对钱的处理。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a003"
      ]
    },
    {
      "name": "六岁孩子敏感易怒",
      "definition": "六岁孩子敏感易怒是正常的，挫折逃避正常。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a005"
      ]
    },
    {
      "name": "处理孩子发脾气",
      "definition": "问是否继续玩，不禁止发脾气，接受负面情绪。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a006"
      ]
    },
    {
      "name": "打孩子传递拒绝接受情绪",
      "definition": "打孩子会让孩子发更大脾气。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a007"
      ]
    },
    {
      "name": "三岁半孩子扔东西、吃手",
      "definition": "处理需冷静坚定，收走扔的东西，吃手不过多关注。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a009"
      ]
    },
    {
      "name": "三岁半吃手与安全感",
      "definition": "吃手可能是反幼现象，与零到两岁安全感破坏有关。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a010"
      ]
    },
    {
      "name": "三岁半告知后果并增加身体接触",
      "definition": "告知后果，重复多次，增加拥抱和身体接触。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a011"
      ]
    },
    {
      "name": "九个月宝宝读绘本",
      "definition": "读绘本即聊天，抓什么书读什么书，用动作和问题让绘本有趣。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a012"
      ]
    },
    {
      "name": "让孩子专注玩",
      "definition": "不打扰孩子专注玩，培养独处能力。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a013"
      ]
    },
    {
      "name": "闪卡是智商税",
      "definition": "九个月宝宝闪卡是智商税，睡觉是最好的大脑刺激。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a014"
      ]
    },
    {
      "name": "讲师孩子未用闪卡案例",
      "definition": "讲师孩子未用闪卡但数学能力超前，睡觉好。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a015"
      ]
    },
    {
      "name": "养成睡觉好习惯",
      "definition": "睡觉是刺激大脑突触最好的方法。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a016"
      ]
    },
    {
      "name": "宝宝被多人抱的处理",
      "definition": "家长在场，只让放心的人抱，陌生人不能抱，尊重孩子意愿。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a017"
      ]
    },
    {
      "name": "让孩子哭与满足情感需求不冲突",
      "definition": "满足情感需求有时就是让孩子哭，婴儿哭要抱，但抱着还哭就让他哭。",
      "atom_ids": [
        "s-1ebe2a2394bb-c002:a018"
      ]
    },
    {
      "name": "分心方法不是长久之计",
