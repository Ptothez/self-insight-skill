        "s-b21bf7cf3331-c001:r001"
      ]
    },
    {
      "name": "自我情绪敏感度",
      "definition": "对自己的感受的敏感度，表现为对自己的感受非常敏感、对事物的感受深刻，或根本不太知道自己的感受。",
      "atom_ids": [
        "s-b21bf7cf3331-c001:a002",
        "s-b21bf7cf3331-c001:a003",
        "s-b21bf7cf3331-c001:a005",
