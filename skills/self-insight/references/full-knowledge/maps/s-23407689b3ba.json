{
  "concepts": [
    {
      "name": "界限数量控制",
      "definition": "给孩子立界限时一次只立一个界限，最多两个，避免一次立太多导致孩子难以遵守。",
      "atom_ids": [
        "s-23407689b3ba-c001:a001"
      ]
    },
    {
      "name": "界限与家规的区别",
      "definition": "立界限不同于立家规，不应像制定家规一样一次性列出大量规则。",
      "atom_ids": [
        "s-23407689b3ba-c001:a002"
      ]
    },
    {
      "name": "界限遵守效果",
      "definition": "宁愿让孩子100%遵守一条界限，也好过给孩子五条界限但每条只能遵守20%。",
      "atom_ids": [
        "s-23407689b3ba-c001:a003"
      ]
    },
    {
      "name": "界限具体化",
      "definition": "界限必须非常详细、有可视性、可量化，将抽象概念转化为具体可观察的行为描述。",
      "atom_ids": [
        "s-23407689b3ba-c001:a004",
        "s-23407689b3ba-c001:a005"
      ]
    },
    {
      "name": "后果可执行性",
      "definition": "界限的后果必须是父母做得到且能持续做到的，否则不应使用。",
      "atom_ids": [
        "s-23407689b3ba-c001:a006",
        "s-23407689b3ba-c001:a007"
      ]
    },
    {
      "name": "后果目的",
      "definition": "立界限给后果的目的不是恐吓或威胁孩子，而是帮助孩子理解、赋能给孩子。",
      "atom_ids": [
        "s-23407689b3ba-c001:a008"
      ]
    },
    {
      "name": "及时认可",
      "definition": "当孩子遵守界限时，父母要第一时间予以认可，表达感激、欣赏、骄傲和自豪。",
      "atom_ids": [
        "s-23407689b3ba-c001:a009",
        "s-23407689b3ba-c001:a010"
      ]
    },
    {
      "name": "界限合同",
      "definition": "与孩子一起讨论界限内容并写成书面合同，让孩子签字，合同内容具体明确，可包含弥补机制。",
      "atom_ids": [
        "s-23407689b3ba-c001:a011",
        "s-23407689b3ba-c001:a012",
        "s-23407689b3ba-c001:a013",
        "s-23407689b3ba-c001:a014",
        "s-23407689b3ba-c001:a015"
      ]
    },
    {
      "name": "坚持立界限",
      "definition": "立界限是困难的事情，但越不容易越要去做，因为值得。",
      "atom_ids": [
        "s-23407689b3ba-c001:a016"
      ]
    }
  ],
  "links": [
