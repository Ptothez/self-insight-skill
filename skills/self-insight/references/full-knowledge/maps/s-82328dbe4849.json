{
  "concepts": [
    {
      "name": "一二三管教法",
      "definition": "一套管教方法，包含一个目标、两个原则和三个步骤（原文仅详细展开一个目标和两个原则，三个步骤未在本段说明）。该方法提供大纲、原则和底层逻辑，具体内容需父母根据孩子性格、自身性格、家庭环境和背景自行填充，不能机械套用。",
      "atom_ids": [
        "s-82328dbe4849-c001:a001"
      ]
    },
    {
      "name": "管教目标",
      "definition": "在管教孩子前，父母必须先明确自己的目标。目标不同，后续行为也不同。没有目标时，父母容易以原始方式惩罚孩子，导致管教效果差。",
      "atom_ids": [
        "s-82328dbe4849-c001:a002"
      ]
    },
    {
      "name": "无目标管教的负面后果",
      "definition": "没有目标的管教往往以惩罚性方式出现，包括暴力或冷暴力。孩子会将注意力从事情本身转移到父母的情绪上，试图平息父母怒气，而不是从错误中学习。长期如此，孩子可能学会操控父母情绪，且父母逐渐无法制止孩子的不良行为，孩子可能变本加厉。",
      "atom_ids": [
        "s-82328dbe4849-c001:a003"
      ]
    },
    {
      "name": "两个原则",
      "definition": "一二三管教法中的“二”指两个原则：第一个原则是给孩子的，即必须在孩子准备好时才管教；第二个原则是给自己的，即管教要持续且有恩典。",
      "atom_ids": [
        "s-82328dbe4849-c001:a004"
      ]
    },
    {
      "name": "给孩子的原则：在孩子准备好时管教",
      "definition": "管教应在孩子准备好接受时进行，而非在孩子情绪失控或状态不佳时。孩子大哭大叫时不适合管教，因为此时孩子听不进去。父母需要观察孩子，找到其最愿意接受管教的时机。",
      "atom_ids": [
        "s-82328dbe4849-c001:a005"
      ]
    },
    {
      "name": "孩子不愿受管教的常见状态",
      "definition": "孩子通常在以下状态不愿受管教：困倦时（表现为烦躁而非困意）、饥饿时（尤其餐桌上不宜管教）、受挫折后（如考试失败、比赛失利）。在这些时候，孩子更需要情绪连接而非管教。",
      "atom_ids": [
        "s-82328dbe4849-c001:a006"
      ]
    },
    {
      "name": "离异家庭孩子周末返回后不愿受管教",
      "definition": "一位离异家庭的母亲发现，孩子平时跟她，周末去父亲那里，每次星期天晚上从父亲处回来时特别不愿意接受管教。因此她尽量避开这些时间，除非涉及伤害身体的紧急管教。",
      "atom_ids": [
        "s-82328dbe4849-c001:a007"
      ]
    },
    {
      "name": "孩子游泳后心情好时更易接受管教",
      "definition": "一位家长发现，孩子每次游泳后心情特别好，之后一起吃甜品时，孩子对家长的话都肯听进去。因此父母应观察孩子何时心情最好，作为管教的最佳时机。",
      "atom_ids": [
        "s-82328dbe4849-c001:a008"
      ]
    },
    {
      "name": "观察孩子以确定管教最佳时机",
      "definition": "父母应观察孩子的习性和性格，而非只关注行为。要分别观察每个孩子（老大和老二可能不同）何时最安静、最烦躁、心情最好或最差，从而判断管教的最佳时期。管教不争朝夕，应找到对的方式和对的时间。",
      "atom_ids": [
        "s-82328dbe4849-c001:a009"
      ]
    },
    {
      "name": "孩子犯错的原因：明白但做不到",
      "definition": "孩子有时明白道理但做不出来，因为他们缺乏管理情绪的能力，无法做出与情绪相符的正确行为。年龄越小的孩子这种能力越薄弱，因此管教需考虑孩子的实际年龄。",
      "atom_ids": [
        "s-82328dbe4849-c001:a010"
      ]
    },
    {
      "name": "孩子犯错的原因：情绪失控与上丘脑功能",
      "definition": "孩子犯错有时是因为情绪失控，此时上丘脑暂时无法履行功能，即无法帮助孩子做出正确判断和决定。失控可能由荷尔蒙水平或每日状态决定，需要观察。上丘脑正常功能包括做出正确决定、替他人着想、考虑后果、平衡身体和情绪等。",
      "atom_ids": [
        "s-82328dbe4849-c001:a011"
      ]
    },
    {
      "name": "孩子犯错的原因：神经系统唤醒水平不当",
      "definition": "孩子神经系统被under aroused（无聊、困倦）或over aroused（焦虑、压力大、目睹家庭暴力、被骂等）时，大脑无法正常学习，更容易做出错误判断和决定。唤醒水平太低或太高都不好。",
      "atom_ids": [
        "s-82328dbe4849-c001:a012"
      ]
    },
    {
      "name": "判断孩子是否准备好接受管教的问题",
      "definition": "父母可问自己：根据对孩子的了解，孩子现在是否准备好听我说话、接受我的信息、学习并理解？例如，孩子刚补完课大脑疲倦时，可能未准备好。同时也要问自己是否准备好用正确方式管教，能否心平气和。",
      "atom_ids": [
        "s-82328dbe4849-c001:a013"
      ]
    },
    {
      "name": "青春期孩子的管教需要更多空间和时间",
      "definition": "对于进入青春期的孩子，管教可能更棘手。有时孩子只是需要更多空间和时间，父母应有忍耐，因为青春期孩子事情多、学业压力大，稍微多等一会儿可能更好。",
      "atom_ids": [
        "s-82328dbe4849-c001:a014"
      ]
    },
    {
      "name": "给自己的原则：管教要持续且有恩典",
      "definition": "管教应具有持续性，即给孩子可预测的模式：孩子知道做某事会引发特定后果，且每次如此，不因父母心情或活动而改变。持续性帮助孩子明白父母的期望，建立安全感。同时管教要有恩典，即根据孩子的情绪需要做出微调，而非死板固定。",
      "atom_ids": [
        "s-82328dbe4849-c001:a015"
      ]
    },
    {
      "name": "持续性的管教建立安全感和明确期望",
      "definition": "持续性管教让孩子能够预测行为后果，从而明白父母对自己的期望，同时建立孩子对父母的期待。这种可预测性给孩子极大的安全感，安全感是家庭关系的基础和基调。",
      "atom_ids": [
        "s-82328dbe4849-c001:a016"
      ]
    },
    {
      "name": "恩典的定义",
      "definition": "恩典是指在持续性的基础上，根据孩子的情绪需要做出微调，愿意调整而非死板固定地执行规矩。",
      "atom_ids": [
        "s-82328dbe4849-c001:a017"
      ]
    },
    {
      "name": "持续性与恩典的区分",
      "definition": "管教需要持续一致，但也要根据孩子的情绪需要做出微调，给予恩典。持续性指每次做错都有后果，恩典指在特殊情况下愿意调整常规做法。",
      "atom_ids": [
        "s-82328dbe4849-c002:a001"
      ]
    },
    {
      "name": "孩子考砸后打游戏给予恩典的案例",
      "definition": "孩子回家后不耐烦、愤怒，不做作业直接打游戏。父母知道孩子平时成绩不错但这次考砸了，情绪低落。虽然打游戏必须在作业完成后，但父母理解孩子沮丧，愿意给予恩典，一起处理事情，允许打破常规。",
      "atom_ids": [
        "s-82328dbe4849-c002:a002"
      ]
    },
    {
      "name": "80岁爷爷在儿子家仍说了算的反例",
      "definition": "父母已经成家，但80岁的爸爸在儿子家仍说了算，即使有孙子也由爷爷决定。这是固执不愿改变的例子，缺乏恩典。",
      "atom_ids": [
        "s-82328dbe4849-c002:a003"
      ]
    },
    {
      "name": "孩子流感时吃冰淇淋的案例",
      "definition": "讲师的孩子得流感严重，整个人蔫了，不想吃饭。讲师每天每顿饭给孩子吃冰淇淋，因为那是唯一吃得下的东西，后来可以吃香蕉等甜食。这是特殊情况下的调整，不坚持必须吃完饭才能吃点心。",
      "atom_ids": [
        "s-82328dbe4849-c002:a004"
      ]
    },
    {
      "name": "恐惧为基础的育儿",
      "definition": "许多父母害怕给恩典或调整，因为育儿是以恐惧为基础。恐惧包括害怕被孩子操控、害怕失去控制等。恐惧会损害育儿，即使做法正确，内心恐惧也会带来负面影响。",
      "atom_ids": [
        "s-82328dbe4849-c002:a005"
      ]
    },
    {
      "name": "六岁孩子生病想和父母睡被拒绝的案例",
      "definition": "六岁孩子生病想和父母睡，父母害怕养成习惯，坚决不让孩子一起睡，把孩子放回自己房间。父母认为好不容易分房成功，不能再有例外。这是恐惧为基础的育儿表现。",
      "atom_ids": [
        "s-82328dbe4849-c002:a006"
      ]
    },
    {
      "name": "恐惧损害育儿",
      "definition": "当育儿中有害怕时，会损害育儿。即使做的事情是对的，如果内心动机是恐惧，也会损害育儿。父母需要解决自己的恐惧问题，而不是让孩子买单。",
      "atom_ids": [
        "s-82328dbe4849-c002:a007"
      ]
    },
    {
      "name": "爱里没有惧怕",
      "definition": "爱里没有惧怕，爱既完全就把惧怕除去。如果对孩子的爱中有很多惧怕，需要解决自己的问题，不应让孩子为此买单。",
      "atom_ids": [
        "s-82328dbe4849-c002:a008"
      ]
    },
    {
      "name": "给恩典的方法一：让孩子重新做一次",
      "definition": "当孩子犯错时，让孩子重新做一次，而不是责骂。例如孩子弹琴老弹错，让他多弹几遍；孩子发脾气扔玩具，让他捡起来再做一遍；孩子打人，重新来过一遍，问他在生气时应该怎么做。通过练习帮助孩子改进。",
      "atom_ids": [
        "s-82328dbe4849-c002:a009"
      ]
    },
    {
      "name": "给恩典的方法二：让孩子设立后果",
      "definition": "当孩子不做作业打游戏时，给予恩典，但让孩子自己设立后果。问孩子不做作业有什么后果，打算什么时候做，如果做不完怎么办。孩子可能说不知道，需要练习。让孩子设立后果能帮助他负责任。",
      "atom_ids": [
        "s-82328dbe4849-c002:a010"
      ]
    },
    {
      "name": "管教的三个结果",
      "definition": "管教要想到三个结果：第一，让孩子更加认识自己（性格、能力、有限、力量、短板、强板、情绪等）；第二，赋能给孩子，增加做正确决定和判断的能力；第三，让孩子承认并面对自己的错误和失败。",
      "atom_ids": [
        "s-82328dbe4849-c002:a011"
      ]
    },
    {
      "name": "赋能孩子的方法",
      "definition": "通过管教中的练习帮助孩子赋能，例如换位思考、共情能力、站在别人角度看事情、明白自己的行为如何影响别人。可以问孩子“你看到她哭了吗？你觉得她为什么哭？”来帮助孩子思考。",
      "atom_ids": [
        "s-82328dbe4849-c002:a012"
      ]
    },
    {
      "name": "避免羞耻感",
      "definition": "管教时要避免带给孩子羞耻感，因为有羞耻感的人会极力避免和否认自己做错。只有能承认做错的孩子才能修改、弥补、矫正错误。",
      "atom_ids": [
        "s-82328dbe4849-c002:a013"
      ]
    },
    {
      "name": "一二三管教法（总结）",
      "definition": "管教有一个目标、两个原则、三个结果。一个目标：不抓狂；两个原则：持续性和恩典；三个结果：让孩子认识自己、赋能孩子、让孩子面对错误。孩子越大越不抓狂，因为每次管教都赋能三个结果，孩子越来越有能力判断识别自己。",
      "atom_ids": [
        "s-82328dbe4849-c002:a014"
      ]
    }
  ],
