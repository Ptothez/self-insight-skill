        "s-22a73a6153af-c003:a005",
        "s-22a73a6153af-c003:a006",
        "s-22a73a6153af-c003:r001"
      ]
    },
    {
      "name": "安全行为",
      "definition": "在表达情绪时避免伤害孩子的行为，如不对着孩子耳膜怒吼、怒吼后不打孩子。",
      "atom_ids": [
        "s-22a73a6153af-c001:a012",
        "s-22a73a6153af-c001:a013",
        "s-22a73a6153af-c001:r005"
      ]
    },
    {
      "name": "正常情绪",
      "definition": "生气时怒吼是正常情绪表达，不正常情绪是指生气时不怒吼。",
      "atom_ids": [
        "s-22a73a6153af-c001:a012",
        "s-22a73a6153af-c001:a013"
      ]
    },
    {
      "name": "情绪不完整",
      "definition": "只能有某些情绪（如快乐），不能有其他情绪（如悲伤），导致无法经历悲伤等情绪。",
      "atom_ids": [
        "s-22a73a6153af-c001:a014",
        "s-22a73a6153af-c001:a015"
      ]
    },
    {
      "name": "自我反省（家长）",
      "definition": "当孩子不愿受教时，家长应首先自我反省，而不是试图让孩子反省。",
      "atom_ids": [
        "s-22a73a6153af-c001:a018",
        "s-22a73a6153af-c001:r007",
        "s-22a73a6153af-c002:a001"
      ]
    },
    {
      "name": "恐惧导致不受教",
      "definition": "孩子不愿受教、被指正时情绪爆发，是因为内心有很深的恐惧，可能源于承认错误后可能面临无法承担的后果。",
      "atom_ids": [
        "s-22a73a6153af-c001:a018",
        "s-22a73a6153af-c001:r007",
        "s-22a73a6153af-c002:a002",
        "s-22a73a6153af-c002:a003"
      ]
    },
    {
      "name": "情绪健康与年龄阶段",
      "definition": "孩子的情绪是否健康需结合年龄判断，如一岁八个月的双胞胎争夺妈妈是正常的，但17岁仍如此则不健康。",
      "atom_ids": [
        "s-22a73a6153af-c002:a009",
        "s-22a73a6153af-c002:a010"
      ]
    },
    {
      "name": "复盘赋能",
      "definition": "通过回顾事件、讨论处理方式，帮助孩子获得能力感的方法，如孩子上学迟到后放学复盘。",
      "atom_ids": [
        "s-22a73a6153af-c002:a016",
        "s-22a73a6153af-c002:a017",
        "s-22a73a6153af-c002:r001"
      ]
    },
    {
      "name": "希望与期待",
      "definition": "希望是允许孩子做不到，不因此暴怒；期待是必须得到，若未满足会愤怒。父母应对孩子抱有希望而非期待。",
      "atom_ids": [
        "s-22a73a6153af-c002:a019",
        "s-22a73a6153af-c003:a001"
      ]
    },
    {
      "name": "无条件的爱有界限",
      "definition": "无条件的爱并不意味着没有界限，父母对孩子的爱应当包含界限。",
      "atom_ids": [
        "s-22a73a6153af-c003:a004"
      ]
    },
    {
      "name": "付费换抱抱错误",
      "definition": "让孩子付费才能获得父母的拥抱是错误的，因为传递了错误信息，且可能导致孩子长大后要求父母付费才能得到拥抱。",
      "atom_ids": [
        "s-22a73a6153af-c003:a005",
        "s-22a73a6153af-c003:a006"
      ]
    }
  ],
