{
  "concepts": [
    {
      "name": "健康情绪的标准",
      "definition": "评价、衡量和判断孩子情绪是否健康的前提，只有明确标准后才能判断孩子是否达到标准。",
      "atom_ids": [
        "s-a90294f02828-c001:a001"
      ]
    },
    {
      "name": "孩子情绪健康的六个前提",
      "definition": "六个要素，如果这些要素不存在或没有很好地提供给孩子，无论外部付出多大努力，孩子的情绪都不可能健康。",
      "atom_ids": [
        "s-a90294f02828-c001:a002"
      ]
    },
    {
      "name": "六大要素的土壤比喻",
      "definition": "六大要素就像土壤，只有土壤好才能栽树；如果土壤荒芜，就无法种树。因此需要先培育适合树生长的土壤。",
      "atom_ids": [
        "s-a90294f02828-c001:a003"
      ]
    },
    {
      "name": "来自家庭无条件的爱",
      "definition": "孩子情绪健康的第一个要素是来自家庭无条件的爱。",
      "atom_ids": [
        "s-a90294f02828-c001:a004"
      ]
    },
    {
      "name": "无条件的爱不等于不惩罚不管教",
      "definition": "无条件的爱不等于不惩罚孩子、不管教孩子；相反，因为无条件的爱，才有可能做到正确的管教。",
      "atom_ids": [
        "s-a90294f02828-c001:a005"
      ]
    },
    {
      "name": "无条件的爱是无论孩子表现如何都按规则管教",
      "definition": "无条件的爱是无论孩子成绩好坏，迟到就要管教，按照规则和界限管教；生病时都用同样的爱照顾和关怀。",
      "atom_ids": [
        "s-a90294f02828-c001:a009"
      ]
    },
    {
      "name": "无条件的爱不等于没有矛盾",
      "definition": "无条件的爱不等于没有矛盾；爱一个人不代表时刻喜欢他，当孩子生气打人、撒谎、骂人、踢门时，父母会不喜欢并发生矛盾，但这不影响爱。",
      "atom_ids": [
        "s-a90294f02828-c001:a010"
      ]
    },
    {
      "name": "无条件的爱不等于什么都认同对方",
      "definition": "无条件的爱不等于什么都认同对方；爱不代表认同对方的行为或想法，真正的亲密关系一定经历过矛盾冲突。",
      "atom_ids": [
        "s-a90294f02828-c001:a011"
      ]
    },
    {
      "name": "真正的亲密关系需要经历矛盾",
      "definition": "真正的亲密关系一定经历过矛盾冲突；如果朋友从未吵过架、思想完全一致，关系是塑料情，无法深入。",
      "atom_ids": [
        "s-a90294f02828-c001:a012"
      ]
    },
    {
      "name": "无条件的爱不等于溺爱",
      "definition": "无条件的爱不等于溺爱；无条件的爱是最有界限的爱，没有界限的爱才是溺爱。",
      "atom_ids": [
        "s-a90294f02828-c001:a014",
        "s-a90294f02828-c001:r001"
      ]
    },
    {
      "name": "真正的爱不喜欢不义只喜欢真理",
      "definition": "真正的爱不喜欢不义，只喜欢真理；当孩子做不义或错误的事情时，因真理的缘故要帮助他。",
      "atom_ids": [
        "s-a90294f02828-c001:a015"
      ]
    },
    {
      "name": "无条件的爱不等于无止境退让",
      "definition": "无条件的爱不等于无止境退让，不是孩子要什么就给什么；无条件的爱非常有界限。",
      "atom_ids": [
        "s-a90294f02828-c001:a016"
      ]
    },
    {
      "name": "无条件的爱是没有附加条件",
      "definition": "无条件的爱是没有附加条件，如“听我的话就爱你”“考好了就是心肝宝贝”都是附加条件。",
      "atom_ids": [
        "s-a90294f02828-c001:a017"
      ]
    },
    {
      "name": "孩子通过行为判断父母的爱",
      "definition": "孩子不会只听父母说爱他，而是看父母的行为来判断是否爱他；就像爱人说爱你但行为暧昧，你不会相信。",
      "atom_ids": [
        "s-a90294f02828-c001:a019"
      ]
    },
    {
      "name": "无条件的爱是没有期待",
      "definition": "无条件的爱是没有期待，如“我爱你所以为你牺牲一切，期待你尽责任按我的规划做”“我养你将来你养我”“我图你做个孝子”都是有期待。",
      "atom_ids": [
        "s-a90294f02828-c001:a020"
      ]
    },
    {
      "name": "无条件的爱是不分情况",
      "definition": "无条件的爱是不分情况，无论孩子考100分还是50分，无论表现如何，都给予同样的爱。",
      "atom_ids": [
        "s-a90294f02828-c001:a022"
      ]
    }
  ],
