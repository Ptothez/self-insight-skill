  "path": [
    {
      "name": "延伸引导方法",
      "steps": [
        {
          "action": "问孩子：你可以继续生气，或者可以想一想，当你生气的时候，有什么事情是可以帮助你感觉好一点的吗？",
          "atom_ids": [
            "s-bb880f12a813-c001:a002"
          ],
          "condition": "孩子有情绪时"
        },
        {
          "action": "根据孩子回答，进一步提问探索情绪背后的原因或兴趣点。",
          "atom_ids": [
            "s-bb880f12a813-c001:a003"
          ],
          "condition": "孩子回答了第一个问题后"
        },
        {
          "action": "鼓励孩子尝试自己提出的解决方案。",
          "atom_ids": [
            "s-bb880f12a813-c001:a005"
          ],
          "condition": "孩子提出具体办法后"
        },
        {
          "action": "观察孩子是否开始自主运用该方法处理情绪。",
          "atom_ids": [
            "s-bb880f12a813-c001:a006"
          ],
          "condition": "多次引导后"
        }
      ]
    }
  ],
