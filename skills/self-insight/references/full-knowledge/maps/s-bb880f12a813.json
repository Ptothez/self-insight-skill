{
  "concepts": [
    {
      "name": "转移注意力",
      "definition": "在着急或孩子无法理解原理的情况下，引导孩子获得左右脑平衡的方法。相对简单、见效快，但若一味使用，会失去引导孩子从情绪焦虑转向问题思考的机会。",
      "atom_ids": [
        "s-bb880f12a813-c001:a001"
      ]
    },
    {
      "name": "延伸",
      "definition": "通过提问将孩子从引发情绪的事情本身，引导到情绪管理上的方法。",
      "atom_ids": [
        "s-bb880f12a813-c001:a002",
        "s-bb880f12a813-c001:a003",
        "s-bb880f12a813-c001:a004",
        "s-bb880f12a813-c001:a005",
        "s-bb880f12a813-c001:a006"
      ]
    },
    {
      "name": "同理心",
      "definition": "讲师个人认为一个孩子最需要具备的能力。",
      "atom_ids": [
        "s-bb880f12a813-c001:a008"
      ]
    },
    {
      "name": "诠释",
      "definition": "帮助孩子进行更深层次思考的引导方法，帮助孩子更加了解自己和自己行为背后的动机。",
      "atom_ids": [
        "s-bb880f12a813-c001:r001"
      ]
    },
    {
      "name": "教育核心目标",
      "definition": "帮助孩子有一天能够离开父母，成为一个独立健康的、有能力做智慧的决定、有辩证的思维能力、可以接纳自己的情绪并且管理他的人。",
      "atom_ids": [
        "s-bb880f12a813-c001:a007"
      ]
    }
  ],
