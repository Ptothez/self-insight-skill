{
  "concepts": [
    {
      "name": "13-18岁孩子接受爱的方式",
      "definition": "13到18岁的孩子接受爱的方式是提供帮助。",
      "atom_ids": [
        "s-e363fd38bf41-c001:a001"
      ]
    },
    {
      "name": "提供帮助的原则",
      "definition": "主动营造帮助的环境，但被动地提供帮助。让孩子知道任何时候需要帮助，父母都在身边，但父母不会主动强制性地给予帮助，孩子需要帮助时应主动邀请父母。",
      "atom_ids": [
        "s-e363fd38bf41-c001:a002"
      ]
    },
    {
      "name": "提供帮助的目的",
      "definition": "在这个年龄阶段提供帮助的目的是empowering（赋能），即赋予孩子能力。",
      "atom_ids": [
        "s-e363fd38bf41-c001:a003"
      ]
    },
    {
      "name": "帮助中的恶性循环",
      "definition": "如果父母与孩子关系不好，可能进入恶性循环：一边帮助孩子，一边打击、瞧不起、羞辱孩子。",
      "atom_ids": [
        "s-e363fd38bf41-c001:a004"
      ]
    },
    {
      "name": "帮助孩子时不可羞辱",
      "definition": "帮助孩子的目的绝对不可以让孩子觉得因为需要帮助而导致被羞辱，否则关系会非常糟糕。",
      "atom_ids": [
        "s-e363fd38bf41-c001:a005"
      ]
    },
    {
      "name": "父母向孩子寻求帮助",
      "definition": "在这个年龄阶段，父母一定要学习向孩子寻求帮助。因为孩子需要知道自己是有能力的，不是只能接受帮助的人，他们需要有机会帮助别人、服务别人。",
      "atom_ids": [
        "s-e363fd38bf41-c001:a006"
      ]
    },
    {
      "name": "向孩子寻求帮助的示例",
      "definition": "父母可以问孩子手机怎么用、电脑怎么搞，或者说“妈妈老了，你能不能帮妈妈提一下这袋米”，即使自己提得动，也要有意向孩子寻求帮助。",
      "atom_ids": [
        "s-e363fd38bf41-c001:a007"
      ]
    },
    {
      "name": "聆听作为帮助",
      "definition": "给予孩子全身心的关注和聆听也是一种帮助。这个年龄阶段的孩子很多时候需要父母听他讲，但不需要父母给建议。父母给孩子最大的帮助是让他的情绪有一个安全的出口，成为孩子安全的树洞。",
      "atom_ids": [
        "s-e363fd38bf41-c001:a008"
      ]
    },
    {
      "name": "18岁后爱的感知方式",
      "definition": "如果孩子在18岁之前没有感受到爱，那么18岁过后他只能用大脑的理性来说服自己相信父母是爱他的；如果之前感受到了爱，他就感受到了。",
      "atom_ids": [
        "s-e363fd38bf41-c001:a009"
      ]
    },
    {
      "name": "阿德勒名言",
      "definition": "著名的心理学家阿德勒曾说过：幸运的人用童年治愈一生，不幸的人却用一生治愈童年。",
      "atom_ids": [
        "s-e363fd38bf41-c001:a010"
      ]
    },
    {
      "name": "在童年时期提供正确的爱",
      "definition": "鼓励所有人在孩子18岁之前好好爱孩子，让孩子在今后岁月中深深感知到父母的爱，知道自己被深深爱着。",
      "atom_ids": [
        "s-e363fd38bf41-c001:a011"
      ]
    }
  ],
