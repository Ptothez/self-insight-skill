{
  "concepts": [
    {
      "name": "罪恶感作为管教障碍",
      "definition": "父母因平时没时间管孩子或过去管教错误而感到亏欠、内疚，从而不敢理直气壮地管教孩子。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a001"
      ]
    },
    {
      "name": "罪恶感导致放任行为",
      "definition": "父母因罪恶感而放任孩子：孩子要什么就给什么，想做什么就做什么，生气就去哄，因为觉得孩子脾气怪、任性是自己没教好造成的。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a002"
      ]
    },
    {
      "name": "过去错误导致不敢管教",
      "definition": "父母过去打骂孩子，孩子出现自杀或自伤行为后，父母知道做错了，现在就不敢管了。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a003"
      ]
    },
    {
      "name": "老大老二管教差异案例",
      "definition": "有家长发现对老大的管教方式错了，对老二就完全不敢管，走向另一个极端；或者老大以前被伤害不跟父母讲话，现在关系好不容易和好，父母就完全不管，要什么给什么。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a004"
      ]
    },
    {
      "name": "打骂-内疚-不管的恶性循环",
      "definition": "家长打孩子后感到内疚，于是后面孩子所有事情都不管，一直忍耐到下一次爆发又打孩子，然后又内疚，形成恶性循环。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a005"
      ]
    },
    {
      "name": "管教的两个极端",
      "definition": "管教有两个错误极端：管过了（过度管教）和不管（不作为），两者都是错的。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a006"
      ]
    },
    {
      "name": "罪恶感导致讨好孩子",
      "definition": "父母因罪恶感而哄着孩子、讨好孩子，不敢理直气壮地管教。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a007"
      ]
    },
    {
      "name": "破除罪恶感的方法：道歉和立界限",
      "definition": "破除罪恶感的方法：第一，按照七个步骤诚恳地向孩子道歉，让孩子知道你为过去的事情深深后悔；第二，学习立界限，给孩子正确的界限并赋能。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a008"
      ]
    },
    {
      "name": "真诚道歉的具体做法",
      "definition": "道歉时要勇敢承认错误，告诉孩子内心真实想法，一件一件说出过去做错的事情，表达深深的后悔，如“肠子都悔青了”。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a009"
      ]
    },
    {
      "name": "错误必须承认",
      "definition": "错了的东西没有办法通过替代、逃避去掩埋，错了一定要认，这是最简单、最方便、最快速能继续对孩子产生影响的路，没有别的捷径。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a010"
      ]
    },
    {
      "name": "想跟孩子做朋友是错误想法",
      "definition": "想要跟孩子做朋友是一件非常错误的事情，会导致父母放弃作为父母的权利，因为朋友没有权利管教朋友。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a011"
      ]
    },
    {
      "name": "想跟孩子做朋友的后果",
      "definition": "想跟孩子做朋友会导致几个结果：第一，没有办法面对孩子的痛苦和眼泪；第二，不知道怎样解决和孩子的矛盾；第三，怕孩子跟自己不亲。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a012"
      ]
    },
    {
      "name": "希望与期待的区别",
      "definition": "希望孩子永远没有痛苦、永远快乐、永远没有眼泪是好的，但希望不应该变成期待，更不应该变成育儿的要求。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a013"
      ]
    },
    {
      "name": "正确的育儿期待",
      "definition": "正确的期待是：在育儿路上一定会犯错，一定会不经意伤害孩子；有时为孩子好，但孩子当时一定不快乐，会有眼泪、不理解甚至怨恨。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a014"
      ]
    },
    {
      "name": "必须忍受管教造成的眼泪和痛苦",
      "definition": "父母要能够忍受孩子的眼泪和痛苦，有时这些眼泪和痛苦是管教造成的，但它是正确的事情。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a015"
      ]
    },
    {
      "name": "肌肉酸痛比喻",
      "definition": "就像练习让肌肉强壮必须经历肌肉酸痛，酸痛是撕裂重组的过程；孩子成长也必须经历管教带来的眼泪和痛苦。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a016"
      ]
    },
    {
      "name": "正确与错误的眼泪痛苦",
      "definition": "管教中应该有的眼泪和痛苦让孩子承担，这样他才能成长；但错误的眼泪和痛苦是不必要的，要尽可能避免，不能100%绝对避免。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a017"
      ]
    },
    {
      "name": "害怕与孩子矛盾",
      "definition": "想跟孩子做朋友的父母不知道怎样解决和孩子的矛盾，孩子稍大一点有矛盾就很害怕，觉得孩子恨自己、讨厌自己。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a018"
      ]
    },
    {
      "name": "建议参加团体辅导解决矛盾",
      "definition": "如果家长不知道怎么解决矛盾、避免冲突而不管教孩子，建议参加团体辅导，因为上课挖掘出的自身问题需要自己解决，团体项目可以帮助解决自身伤害。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a019"
      ]
    },
    {
      "name": "怕孩子跟自己不亲",
      "definition": "有些父母自己跟父母不亲密，感到遗憾和伤害，就一定要孩子跟自己很亲，把亲子关系亲密度当作育儿成功的唯一考量，这是极度危险的事情。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a020"
      ]
    },
    {
      "name": "关系不应主导育儿",
      "definition": "如果跟孩子的关系主导育儿，就会溺爱孩子、什么都顺着他，关系一定非常好；但管教的目的不是为了关系好，管教的结果正确才会有好的关系，好的关系是在最后的中间。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a021"
      ]
    },
    {
      "name": "管教过程中要承受怨恨",
      "definition": "管教过程中可能有孩子恨你、不理解、怨恨，比如不让孩子吃冰激凌他就恨你，这些要能够承受。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a022"
      ]
    },
    {
      "name": "管教的目的",
      "definition": "管教的目的不是关系好不好，而是：有没有赋能孩子；孩子离开父母后能不能独立做出正确的决定和行为；能不能在社会上成为有价值、有用、优秀的人；孩子的品格怎么样。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a023"
      ]
    },
    {
      "name": "满足孩子不等于好妈妈",
      "definition": "孩子要什么给什么，他会说你是全世界最好的妈妈，但这不需要花钱学习、花精力、花脑子，不是管教的目的。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a024"
      ]
    },
    {
      "name": "“长大了就好”的错误想法",
      "definition": "有些父母认为孩子还小，长大了自然就懂，不需要现在管教。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a025"
      ]
    },
    {
      "name": "朋友夫妻不管教孩子案例",
      "definition": "讲师认识一对夫妻，坚决不管孩子，认为孩子长大了自然懂。他们的孩子在公共场合脱裤子，在家不爽就脱裤子尿尿，父母认为孩子长大绝对不会在公共场合尿尿，会自己知道害羞，所以没必要教。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a026"
      ]
    },
    {
      "name": "讲师不主动给朋友建议",
      "definition": "讲师作为朋友，别人不问就闭嘴，因为必须有界限，不能因为自己懂就不管别人欢不欢迎都讲。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a027"
      ]
    },
    {
      "name": "小时候不管教的后果",
      "definition": "孩子长大了以后，如果小时候没有管教引导的习惯，长大了人家不要你去管教引导，到时候父母就没办法了。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a028"
      ]
    },
    {
      "name": "破除想跟孩子做朋友的方法",
      "definition": "破除想跟孩子做朋友的方法：第一，通过学习怎么做父母，让自己心里有底气敢用父母的权威权柄管教孩子；第二，告诉自己“我的孩子一生中有很多朋友，但只有我是他的父母”，不能丢掉父母位分。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a029"
      ]
    },
    {
      "name": "父母位分不可替代",
      "definition": "孩子一生中有很多朋友，但只有父母是父母，不能拿最好的位分去换朋友；如果做父母引导影响孩子，孩子会爱你感激你。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a030"
      ]
    },
    {
      "name": "父母社交圈小导致孩子成朋友",
      "definition": "有些父母在精英家庭忙碌工作，慢慢变得没有朋友，社交圈很小，最后孩子真的成了朋友，谁都不相信只相信孩子，特别是夫妻关系不好、爸爸缺席的情况。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a031"
      ]
    },
    {
      "name": "建立自己的社交团体",
      "definition": "如果父母需要孩子做朋友，应建立自己的有效社交团体，团体应支持你、彼此鼓励；如果没有，可以报名参加讲师的团体。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a032"
      ]
    },
    {
      "name": "把孩子当心灵慰藉的后果",
      "definition": "很多妈妈婚姻不幸福、老公不回家，把孩子当成唯一寄托，孩子长大后就各种捆绑、情绪勒索，最后两败俱伤，孩子不享受跟妈妈在一起。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a033"
      ]
    },
    {
      "name": "建立自己的生活圈子",
      "definition": "父母不要忘记建立自己的生活圈子，生活不应该只有孩子；讲师以自己母亲为例，母亲有一群朋友到处玩，有自己生活。",
      "atom_ids": [
        "s-0cfa8120b7c8-c001:a034"
      ]
    }
  ],
