{
  "concepts": [
    {
      "name": "给自己立界限",
      "definition": "不主动插手与自己无关的事情，除非对方寻求帮助；是练习界限意识的最佳方式，需要很强的界限意识来改变自己的行为。",
      "atom_ids": [
        "s-d75ed18a6fc1-c001:a001",
        "s-d75ed18a6fc1-c001:a003"
      ]
    },
    {
      "name": "界限",
      "definition": "知道自己的临界点，知道自己什么可以什么不可以，并对此设定界限；帮助对自己有清醒认知，提供稳定衡量标准，控制行为建立健康模式。",
      "atom_ids": [
        "s-d75ed18a6fc1-c001:a009",
        "s-d75ed18a6fc1-c001:a010"
      ]
    },
    {
      "name": "完美主义与界限缺失",
      "definition": "完美主义者没有界限意识，一定要做到最好最极致，导致“完美不够完美，好不够好，优秀不够优秀”；表现为过度工作或对孩子成绩要求苛刻。",
      "atom_ids": [
        "s-d75ed18a6fc1-c001:a004",
        "s-d75ed18a6fc1-c001:a005",
        "s-d75ed18a6fc1-c001:a006"
      ]
    },
    {
      "name": "界限点",
      "definition": "个人不可接受的行为或情境，往往是自己曾受伤害的地方，且自己也可能重复该行为；需要明确并告知他人。",
      "atom_ids": [
        "s-d75ed18a6fc1-c001:a030",
        "s-d75ed18a6fc1-c001:a033"
      ]
    },
    {
      "name": "情绪感知与界限",
      "definition": "为自己立界限时要感知自己的情绪，对情感敏感；当想越界时，问自己为什么会有这样的感觉，识别背后的情绪和动机。",
      "atom_ids": [
        "s-d75ed18a6fc1-c001:a035",
        "s-d75ed18a6fc1-c002:a002",
        "s-d75ed18a6fc1-c002:a003"
      ]
    },
    {
      "name": "循序渐进立界限",
      "definition": "为自己立界限要慢慢一步一步来，不要一开始就设定非常高的界限；少量、一次一次来，锁定2-3个目标，逐步递进。",
      "atom_ids": [
        "s-d75ed18a6fc1-c001:r001",
        "s-d75ed18a6fc1-c002:a005",
        "s-d75ed18a6fc1-c002:a007"
      ]
    },
    {
      "name": "原生家庭对界限的影响",
      "definition": "原生家庭没有好的界限，我们就不知道怎么给自己立好的界限；父母没有建立过好的界限包括放养、界限不持续、界限严苛三种情况，都会导致难以给自己立界限。",
      "atom_ids": [
        "s-d75ed18a6fc1-c001:a021",
        "s-d75ed18a6fc1-c001:a022"
      ]
    },
    {
      "name": "自我照顾优先",
      "definition": "给自己立界限的第一点是优先照顾自己，区分自我照顾和自私，在撑不下去时必须照顾自己，包括情绪和各方面需要。",
      "atom_ids": [
        "s-d75ed18a6fc1-c002:a016"
      ]
    }
  ],
