{
  "concepts": [
    {
      "name": "连接情绪",
      "definition": "在这套课程的「右脑情绪联结」框架中，连接情绪位于最后一个环节：成人先弄清孩子此刻的感受，再回想自己遇过的相近事情及当时的情绪，借这些亲身体验理解孩子。",
      "atom_ids": [
        "s-00a3585d8709-c001:a001"
      ]
    },
    {
      "name": "类似经历",
      "definition": "成人回忆自己曾有的与孩子当前情绪相似的经历，用于理解孩子情绪。",
      "atom_ids": [
        "s-00a3585d8709-c001:a002"
      ]
    },
    {
      "name": "左脑发育与情绪控制",
      "definition": "成人左脑发育成熟，能控制右脑情绪行为；孩子左脑未成熟（25岁后定型），越小的孩子越难平衡左右脑。",
      "atom_ids": [
        "s-00a3585d8709-c001:a003"
      ]
    },
    {
      "name": "被认知需求",
      "definition": "人的基本需求之一，当感到被他人真正理解时，会产生强烈信任，愿意敞开和无话不谈。",
      "atom_ids": [
        "s-00a3585d8709-c001:a005"
      ]
    },
    {
      "name": "情绪联结的作用",
      "definition": "连接情绪使成人与孩子心连心，孩子获得安全感并信任成人，为引导左脑平衡情绪行为奠定基础。",
      "atom_ids": [
        "s-00a3585d8709-c001:a007"
      ]
    }
  ],
