{
  "concepts": [
    {
      "name": "非我即敌型育儿",
      "definition": "父母认为孩子永远低自己一等，父母永远处于主宰地位，不允许孩子有任何异议，否则视为敌人并加以惩罚。",
      "atom_ids": [
        "s-d1d931a55a0f-c001:a004",
        "s-d1d931a55a0f-c001:a005",
        "s-d1d931a55a0f-c001:a006",
        "s-d1d931a55a0f-c001:a007"
      ]
    },
    {
      "name": "不可分割型育儿",
      "definition": "父母允许孩子独立，但当孩子的行为威胁到家庭整体感时，会坚决制止并扼杀在摇篮里。",
      "atom_ids": [
        "s-d1d931a55a0f-c001:a015",
        "s-d1d931a55a0f-c001:r001"
      ]
    },
    {
      "name": "冠军型育儿",
      "definition": "父母自己不一定优秀，但要求孩子在所有事情上都是全能、全才、做到最好。",
      "atom_ids": [
        "s-d1d931a55a0f-c002:a004",
        "s-d1d931a55a0f-c002:a005"
      ]
    },
    {
      "name": "幻影型育儿",
      "definition": "父母情绪极度失联，在生活中存在但好像不在，与孩子没有情绪连接，彼此不了解。",
      "atom_ids": [
        "s-d1d931a55a0f-c002:a015",
        "s-d1d931a55a0f-c002:a016",
        "s-d1d931a55a0f-c002:a017"
      ]
    },
    {
      "name": "无条件接纳",
      "definition": "人类最深的需求，被无条件接纳和爱，不因表现好坏而改变。",
      "atom_ids": [
        "s-d1d931a55a0f-c002:a007",
        "s-d1d931a55a0f-c002:a008"
      ]
    },
    {
      "name": "完美主义",
      "definition": "孩子因害怕不完美被抛弃或不被接纳，而要求自己各方面完美。",
      "atom_ids": [
        "s-d1d931a55a0f-c002:a009",
