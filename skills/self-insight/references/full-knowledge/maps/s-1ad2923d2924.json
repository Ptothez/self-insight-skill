{
  "concepts": [
    {
      "name": "界限",
      "definition": "界限是管教的前提，是普遍刚需；在传统思想中缺失，设立界限有顾虑；界限与尊重相关。",
      "atom_ids": [
        "s-1ad2923d2924-c001:a001",
        "s-1ad2923d2924-c001:a002",
        "s-1ad2923d2924-c001:a003",
        "s-1ad2923d2924-c001:a004",
        "s-1ad2923d2924-c001:a005"
      ]
    },
    {
      "name": "孩子界限感缺失",
      "definition": "孩子界限感缺失的表现及原因：父母没有立界限且自己越界。",
      "atom_ids": [
        "s-1ad2923d2924-c001:a006",
        "s-1ad2923d2924-c001:a007"
      ]
    },
    {
      "name": "父母越界行为",
      "definition": "父母越界的各种行为，包括替孩子做事、过度陪伴、让孩子参与夫妻生活、把孩子当朋友、责任转移、让年长孩子照顾弟妹、过度进入孩子世界、情感越界、心理越界等。",
      "atom_ids": [
        "s-1ad2923d2924-c001:a008",
        "s-1ad2923d2924-c001:a010",
        "s-1ad2923d2924-c001:a012",
        "s-1ad2923d2924-c001:a013",
        "s-1ad2923d2924-c001:a014",
        "s-1ad2923d2924-c001:a015",
        "s-1ad2923d2924-c001:a016",
        "s-1ad2923d2924-c001:a017",
        "s-1ad2923d2924-c001:a018",
        "s-1ad2923d2924-c001:a019"
      ]
    },
    {
      "name": "过分干预",
      "definition": "父母跳进孩子的“盒子”里，感知孩子的无力，变得焦虑，导致界限模糊；源于父母自身焦虑，常见于对孩子学习成绩、课外补习、生活能力等焦虑时；控制孩子可缓解父母焦虑。",
      "atom_ids": [
        "s-1ad2923d2924-c001:a022",
        "s-1ad2923d2924-c001:a023",
        "s-1ad2923d2924-c001:a024"
      ]
    },
    {
      "name": "过分同情",
      "definition": "父母出于爱把自己的情感强加在孩子身上，如自己觉得冷就给孩子穿衣服；与同情不同，强调不要过度同情。",
      "atom_ids": [
        "s-1ad2923d2924-c001:a030",
        "s-1ad2923d2924-c001:a033"
      ]
    },
    {
      "name": "自然后果",
      "definition": "让孩子通过自然的事情得到自然的后果，从而学习；例如允许孩子摸热汤（在安全前提下）被烫后学习。",
      "atom_ids": [
        "s-1ad2923d2924-c001:a029"
      ]
    }
  ],
  "links": [
    {
      "source": "s-1ad2923d2924-c001:a001",
      "target": "s-1ad2923d2924-c001:a005",
      "kind": "association",
      "condition": "",
      "reason": "两者均涉及管教和尊重的前提条件，但一方强调界限，另一方强调良好亲子关系，不能直接相互支持。",
      "evidence": "knowledge_synthesis",
      "review_status": "revised",
      "review_notes": "原支持关系不成立，改为关联"
    },
    {
      "source": "s-1ad2923d2924-c001:a003",
      "target": "s-1ad2923d2924-c001:a004",
      "kind": "causes",
      "condition": null,
      "reason": "传统思想中界限缺失导致人们害怕立界限，因为不知道对方反应。"
    },
    {
      "source": "s-1ad2923d2924-c001:a007",
      "target": "s-1ad2923d2924-c001:a006",
      "kind": "supports",
      "condition": "",
      "reason": "父母未跟孩子立界限且自己越界，导致孩子界限感缺失，支持界限感缺失表现的产生。",
      "evidence": "knowledge_synthesis",
      "review_status": "revised",
      "review_notes": "原 kind 为 causes，改为 supports"
    },
    {
      "source": "s-1ad2923d2924-c001:a008",
      "target": "s-1ad2923d2924-c001:a010",
      "kind": "supports",
      "condition": null,
      "reason": "两者都是父母越界行为的具体例子，相互支持越界概念。"
    },
    {
      "source": "s-1ad2923d2924-c001:a022",
      "target": "s-1ad2923d2924-c001:a023",
      "kind": "causes",
      "condition": null,
      "reason": "父母对孩子的学习成绩等感到焦虑，特别容易过分干预和越界。"
    },
    {
      "source": "s-1ad2923d2924-c001:a023",
      "target": "s-1ad2923d2924-c001:a024",
      "kind": "causes",
      "condition": null,
      "reason": "焦虑导致过分干预，而干预缓解焦虑，形成循环。"
    },
    {
      "source": "s-1ad2923d2924-c001:a026",
      "target": "s-1ad2923d2924-c001:a027",
      "kind": "contrasts",
      "condition": null,
      "reason": "错误做法与正确做法形成对比，正确做法强调让孩子自己处理。"
    },
    {
      "source": "s-1ad2923d2924-c001:a029",
      "target": "s-1ad2923d2924-c001:a027",
      "kind": "supports",
      "condition": null,
      "reason": "两者都体现让孩子自己体验和负责的原则，支持界限教育。"
    },
    {
      "source": "s-1ad2923d2924-c001:a030",
      "target": "s-1ad2923d2924-c001:a031",
      "kind": "example_of",
      "condition": null,
      "reason": "投射自身匮乏到孩子身上是过分同情的具体案例。"
    },
    {
      "source": "s-1ad2923d2924-c001:a030",
      "target": "s-1ad2923d2924-c001:a032",
      "kind": "example_of",
      "condition": null,
      "reason": "孩子湿疹案例是母亲过度同情的具体体现。"
    },
    {
      "source": "s-1ad2923d2924-c001:a033",
      "target": "s-1ad2923d2924-c001:a030",
      "kind": "contrasts",
      "condition": null,
      "reason": "强调同情与过度同情的区别，避免过度同情。"
    }
  ],
