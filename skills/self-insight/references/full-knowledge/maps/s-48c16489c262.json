{
  "concepts": [
    {
      "name": "不爱学习是人的本性",
      "definition": "人们普遍喜欢不劳而获，希望直接获得答案而不愿付出努力，因此不应责怪孩子不爱学习。",
      "atom_ids": [
        "s-48c16489c262-c001:a001"
      ]
    },
    {
      "name": "追求最少努力获取最多信息",
      "definition": "人们在提问或学习时倾向于用最简单的方式获得最多的信息，甚至期待他人用长时间解答简单问题。",
      "atom_ids": [
        "s-48c16489c262-c001:a002"
      ]
    },
    {
      "name": "只想要直接方法而非底层逻辑",
      "definition": "人们希望直接获得解决方法，而不想听底层逻辑或原理。",
      "atom_ids": [
        "s-48c16489c262-c001:a003"
      ]
    },
    {
      "name": "速成课程利用不愿努力心理",
      "definition": "许多课程宣传快速见效，利用人们想不劳而获的心理，但实际效果存疑。",
      "atom_ids": [
        "s-48c16489c262-c001:a004"
      ]
    },
    {
      "name": "反逻辑反常识标题吸引人",
      "definition": "反逻辑、反常识的课程标题非常吸引人，因为学习毫不费力又能让人自我感觉良好。",
      "atom_ids": [
        "s-48c16489c262-c001:a005"
      ]
    },
    {
      "name": "追求学习中的自我感觉良好",
      "definition": "人们学习时希望以最简单的方式获得自我感觉良好，例如看短视频、听直播就觉得自己有收获。",
      "atom_ids": [
        "s-48c16489c262-c001:a006"
      ]
    },
    {
      "name": "长远目标约束不爱学习",
      "definition": "讲师自述不爱学习，但因有长远目标（如避免发胖、知识能力削弱）而约束自己。",
      "atom_ids": [
        "s-48c16489c262-c001:a007"
      ]
    },
    {
      "name": "读博士的矛盾心理",
      "definition": "讲师因成绩好而读博士，但内心不喜欢读书，感到痛苦和纠结。",
      "atom_ids": [
        "s-48c16489c262-c001:a008"
      ]
    },
    {
      "name": "疲倦导致父母不愿学习",
      "definition": "父母因花大量时间在孩子身上而疲倦，高质量学习烧脑费劲，因此没有动力学习。",
      "atom_ids": [
        "s-48c16489c262-c001:a009"
      ]
    },
    {
      "name": "疲倦时只想做不费脑的事",
      "definition": "父母疲倦时只想看电视、刷手机、洗澡睡觉，因为大脑已经停摆。",
      "atom_ids": [
        "s-48c16489c262-c001:a010"
      ]
    },
    {
      "name": "未养成随时学习习惯导致觉得学习困难",
      "definition": "很多父母没有养成随时学习的习惯，所以一听到“学习”就觉得很难。",
      "atom_ids": [
        "s-48c16489c262-c001:a011"
      ]
    },
    {
      "name": "养成学习习惯后学习变得相对可行",
      "definition": "学习本身困难，但养成习惯后，肌肉强了就不会觉得那么难，方法技巧也掌握了，学习变得相对可行。",
      "atom_ids": [
        "s-48c16489c262-c001:a012"
      ]
    },
    {
      "name": "讲师怀孕期间考取三个执照",
      "definition": "讲师在怀孕后期到孩子第一年期间，与先生两人带孩子，没有保姆和父母帮忙，却考取了三个非常难拿的执照，因为具备随时学习的能力，能把大的学习任务分成很小的部分。",
      "atom_ids": [
        "s-48c16489c262-c001:a013"
      ]
    },
    {
      "name": "利用零碎时间学习",
      "definition": "讲师利用刷牙、洗澡等需要做事但脑子空闲的时间来学习，因为脑子从早到晚都保持活跃。",
      "atom_ids": [
        "s-48c16489c262-c001:a014"
      ]
    },
    {
      "name": "保持大脑持续活跃",
      "definition": "讲师的大脑从早上睁眼到晚上睡觉都处于非常活跃的状态，整天都在思考。",
      "atom_ids": [
        "s-48c16489c262-c001:a015"
      ]
    },
    {
      "name": "在陪伴孩子中学习",
      "definition": "讲师在陪伴孩子时积极学习更好的陪伴方法，观察孩子，了解他们的喜好，同时学习如何管教孩子。",
      "atom_ids": [
        "s-48c16489c262-c001:a016"
      ]
    },
    {
      "name": "骄傲使人不愿面对无知",
      "definition": "骄傲使人不喜欢面对自己的无知，人们喜欢被认为很厉害、什么都懂。",
      "atom_ids": [
        "s-48c16489c262-c001:a017"
      ]
    },
    {
      "name": "有知识的人可能最不喜欢学习",
      "definition": "高校教授、公司董事等自认为很牛、有一些知识的人最不喜欢学习，因为他们认为自己不可能教不好孩子或管不好家。",
      "atom_ids": [
        "s-48c16489c262-c001:a018"
      ]
    },
    {
      "name": "术业有专攻，承认自己不专业",
      "definition": "讲师相信术业有专攻，相信自己的专业同时也相信自己的不专业，会请专业人士并听取意见。",
      "atom_ids": [
        "s-48c16489c262-c001:a019"
      ]
    },
    {
      "name": "必须打败骄傲，承认无知",
      "definition": "要学习必须打败自己的骄傲，承认自己不行，例如讲师在会计方面是白痴。",
      "atom_ids": [
        "s-48c16489c262-c001:a020"
      ]
    },
    {
      "name": "懒惰是不愿改变",
      "definition": "懒惰不是不想学习，而是不愿意改变。如果不知道，不改变是可以的；如果知道了还不改变，说不过去，所以宁愿不要知道。",
      "atom_ids": [
        "s-48c16489c262-c001:a021"
      ]
    },
    {
      "name": "叫不醒装睡的人",
      "definition": "人们因为知道学习后要改变，所以像鸵鸟一样把头扎在沙子里，不愿意学习，以避免改变。",
      "atom_ids": [
        "s-48c16489c262-c001:a022"
      ]
    },
    {
      "name": "不知道自己不知道是危险状态",
      "definition": "不知道自己不知道是非常危险的事情，因为连找谁都不知道，根本不觉得需要帮助，直到崩盘。",
      "atom_ids": [
        "s-48c16489c262-c001:a023"
      ]
    },
    {
      "name": "学员未报名课程后意识到需要",
      "definition": "讲师讲“不上瘾的孩子”课程时，很多家长因孩子小未报名，后来买了多个课程一起听，才发现自己非常需要这个知识。",
      "atom_ids": [
        "s-48c16489c262-c001:a024"
      ]
    },
    {
      "name": "不知道自己不知道的人后来求助",
      "definition": "讲师遇到过很多不知道自己不知道的人，几年后知道自己不知道了来找她帮忙。",
      "atom_ids": [
        "s-48c16489c262-c001:a025"
      ]
    },
    {
      "name": "不知道自己不知道导致重复行为模式",
      "definition": "当人不知道自己不知道时，会一直重复一个行为模式，而根本不认为自己需要改变。",
      "atom_ids": [
        "s-48c16489c262-c001:a026"
      ]
    },
    {
      "name": "不反驳不知道自己不知道的人",
      "definition": "对于说“育儿学什么，我们还不是这样长大”的人，讲师很少反驳，因为对方不知道自己不知道，等他知道了再去帮他。",
      "atom_ids": [
        "s-48c16489c262-c001:a027"
      ]
    }
  ],
