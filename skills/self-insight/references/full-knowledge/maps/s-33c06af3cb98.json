        {
          "action": "跟孩子道歉",
          "atom_ids": [
            "s-33c06af3cb98-c001:a015"
          ],
          "condition": "如果发现自己有完美主义要求，需要向孩子道歉。"
        },
        {
          "action": "自己改过来，调整自己的思维",
          "atom_ids": [
            "s-33c06af3cb98-c001:a015"
          ],
          "condition": "父母需要改变自己的思维模式，不再追求完美。"
        }
      ]
