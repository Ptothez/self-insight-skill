          "atom_ids": [
            "s-33c06af3cb98-c001:a013"
          ],
          "condition": "父母需要从内心接纳孩子的缺点和错误，而不是勉强接受。"
        },
        {
          "action": "审视自己在孩子的哪些方面有完美主义要求",
          "atom_ids": [
