{
  "concepts": [
    {
      "name": "为自己做开心的事",
      "definition": "做与孩子无关、纯粹为了自己愉悦的事情，例如听到喜欢的歌就下载、做一道自己爱吃的菜。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a001"
      ]
    },
    {
      "name": "为自己做开心的事的日常性",
      "definition": "为自己做开心的事应该是每天进行的常态，而非偶尔为之，且不需要很大或花钱，例如走一条没走过的路。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a002"
      ]
    },
    {
      "name": "为自己买冰淇淋的例子",
      "definition": "为自己买冰淇淋是指特意绕路去给自己买，而不是为了孩子顺便买；对比了平时带孩子绕路去买他喜欢的冰淇淋的行为。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a003"
      ]
    },
    {
      "name": "独处时间",
      "definition": "特地为自己留出的、不为了任何人的时间，可以什么都不做、做白日梦、自己跟自己对话或冥想。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a004"
      ]
    },
    {
      "name": "独处时间与陪伴孩子时间的区别",
      "definition": "送孩子去学钢琴或游泳时一个人坐着等待，不算独处时间；独处时间必须是专门为自己安排的。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a005"
      ]
    },
    {
      "name": "做白日梦的例子",
      "definition": "讲师分享自己经常做白日梦，想象孩子长大后去上大学，自己可以和丈夫环游世界。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a006"
      ]
    },
    {
      "name": "为了自己的需要拒绝孩子合理需要的能力",
      "definition": "自我照顾的方法之一是能够为了自己的需要而拒绝孩子合理的需要，即认识到自己的需要同样合理，可以选择拒绝。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a007"
      ]
    },
    {
      "name": "生气时拒绝与平静时拒绝的区别",
      "definition": "大部分情况下，父母在生孩子的气时会拒绝其合理需要，但这不是真正的自我照顾；真正的自我照顾是在没有生气时也能为了自己的需要而拒绝。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a008"
      ]
    },
    {
      "name": "拒绝孩子合理需要的例子",
      "definition": "孩子想和妈妈一起看电影，妈妈有时间但想自己在家看电视或休息，可以选择拒绝，因为妈妈的需要（休息）也是合理的。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a009"
      ]
    },
    {
      "name": "社会对母亲牺牲的期望",
      "definition": "社会传递的观念是母亲必须牺牲一切才是好妈妈，广告常描绘母亲操劳一生、为孩子付出的形象，这导致母亲不敢关注自己。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a010"
      ]
    },
    {
      "name": "母亲角色单一化的扭曲观点",
      "definition": "社会将女人的角色和价值局限于母亲，忽略了其作为女人和妻子的身份，这是一种扭曲的观点。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a011"
      ]
    },
    {
      "name": "哺乳期减肥被劝阻的例子",
      "definition": "哺乳期母亲想减肥，但周围人会劝阻，认为减肥会影响奶水，母亲应该为了孩子多吃，这反映了社会对母亲自我需求的忽视。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a012"
      ]
    },
    {
      "name": "选择权与能力的区别",
      "definition": "在自我照顾中，区分“要不要这样做”（选择权）和“能不能这样做”（能力）以及“有没有权利不这样做”（权利）是重要的。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a013"
      ]
    },
    {
      "name": "自我关注被批评的现象",
      "definition": "母亲如果关注自己、打扮漂亮，会被他人批评为自私、不照顾孩子，这种社会评论导致母亲不敢自我关注。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a014"
      ]
    },
    {
      "name": "独处时间与日常事务的区别",
      "definition": "独处时间不是指做饭、洗澡、上课等日常事务中为自己留出的时间，除非这些活动让自己感到舒服；独处时间是自己与自己玩耍、单独相处、面对自己的时间。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:r001"
      ]
    },
    {
      "name": "自我照顾中拒绝的动机区分",
      "definition": "在自我照顾中，拒绝孩子合理需要时，需要区分是否因生气而拒绝；真正的自我照顾是在没有生气时也能为了自己的需要而拒绝，而不是因情绪冲动。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:r002"
      ]
    },
    {
      "name": "社会对母亲自我关注的负面评价",
      "definition": "母亲如果关注自己、打扮漂亮，会被他人批评为自私、不照顾孩子，这种社会评论导致母亲不敢自我关注。",
      "atom_ids": [
        "s-29d0fc38e3d4-c001:a014"
      ]
    }
  ],
