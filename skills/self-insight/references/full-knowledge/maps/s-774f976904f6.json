{
  "concepts": [
    {
      "name": "界限",
      "definition": "界限是个人在关系中设定的规则，必须包含后果，且必须与自己有关。界限不是统一标准，而是个人化的，可随关系远近修改。",
      "atom_ids": [
        "s-774f976904f6-c001:a005",
        "s-774f976904f6-c001:a006",
        "s-774f976904f6-c002:a005"
      ]
    },
    {
      "name": "硬界限",
      "definition": "当一个人对你有很深伤害时，容易立硬界限以保护自己。",
      "atom_ids": [
        "s-774f976904f6-c001:a002"
      ]
    },
    {
      "name": "软界限",
      "definition": "当一个人让你感到恐惧或有恐惧记忆时，容易立软界限。",
      "atom_ids": [
        "s-774f976904f6-c001:a002"
      ]
    },
    {
      "name": "界限与后果",
      "definition": "界限必须包含后果，而不是仅仅告知对方行为会带来困难。",
      "atom_ids": [
        "s-774f976904f6-c001:a005",
        "s-774f976904f6-c001:r001"
      ]
    },
    {
      "name": "界限与自身相关",
      "definition": "立界限必须是与自己有关的事情，与自己无关的事情无法立界限。",
      "atom_ids": [
        "s-774f976904f6-c001:a006",
        "s-774f976904f6-c001:r004"
      ]
    },
    {
      "name": "妥协与软界限",
      "definition": "判断妥协是否变成软界限有三个标准：是否被迫、利弊、妥协后是否会让他不尊重自己的界限。",
      "atom_ids": [
        "s-774f976904f6-c002:a003"
      ]
    },
    {
      "name": "健康界限",
      "definition": "健康界限下，双方彼此尊重对方的舒适区，对拒绝感到自在，对事不对人。",
      "atom_ids": [
        "s-774f976904f6-c002:a002"
      ]
    },
    {
      "name": "合理界限",
      "definition": "合理界限需要智慧判断，不能简单说某个要求不合理，需考虑背景和关系。",
      "atom_ids": [
        "s-774f976904f6-c002:a012",
        "s-774f976904f6-c002:a013",
        "s-774f976904f6-c002:a014"
      ]
    },
    {
      "name": "界限与情绪状态",
      "definition": "界限软硬与个人认知和情绪状态有关，不会立界限的人容易一会儿软一会儿硬。",
      "atom_ids": [
        "s-774f976904f6-c002:a004"
      ]
    },
    {
      "name": "界限与关系推进",
      "definition": "有界限感的人知道，如果对方不尊重自己的界限，关系不会往前进一步。",
      "atom_ids": [
        "s-774f976904f6-c002:a007"
      ]
    },
    {
      "name": "道德绑架",
      "definition": "即使一个人说的是对的，也不能要求因为说得对就必须听，这是隐性的道德绑架。",
      "atom_ids": [
        "s-774f976904f6-c002:a009"
      ]
    },
    {
      "name": "请求帮忙与负责",
      "definition": "请对方帮忙是对你负责，但要求对方确保结果就是要求对方为你负责，这不对。",
      "atom_ids": [
        "s-774f976904f6-c002:a011"
      ]
    },
    {
      "name": "系统学习",
      "definition": "只听直播可能只学到特定场景的话术，但缺乏底层逻辑和框架，系统学习才能搭建育儿框架。",
      "atom_ids": [
        "s-774f976904f6-c001:a015"
      ]
    },
    {
      "name": "孩子问“凭什么”",
      "definition": "孩子问“凭什么你说了算”时，背后的动机是想要力量平等，正常孩子都会问。",
      "atom_ids": [
        "s-774f976904f6-c001:a016",
        "s-774f976904f6-c001:r012"
      ]
    },
    {
      "name": "人格平等与能力不平等",
      "definition": "孩子的人格、尊严、价值与家长平等，但在能力、认知和做决定的能力上不平等，也不应该平等。",
      "atom_ids": [
        "s-774f976904f6-c001:a018"
      ]
    },
    {
      "name": "民主的相对性",
      "definition": "民主不是绝对的，任何绝对的民主都会害了孩子。",
      "atom_ids": [
        "s-774f976904f6-c001:a019",
        "s-774f976904f6-c001:r015"
      ]
    },
    {
      "name": "界限后果适度",
      "definition": "界限后果不应过于陡峭，例如领导批评态度不好就辞职，或与老公吵架就离婚。",
      "atom_ids": [
        "s-774f976904f6-c001:a020",
        "s-774f976904f6-c001:r016"
      ]
    },
    {
      "name": "报警作为界限后果",
      "definition": "报警可以作为界限后果，有学员在孩子藏手机后报警，警察出警并批评了孩子。",
      "atom_ids": [
        "s-774f976904f6-c001:a022",
        "s-774f976904f6-c001:r018",
        "s-774f976904f6-c002:a001"
      ]
    },
    {
      "name": "未尝试就否定",
      "definition": "不要在没有尝试和努力之前就判断事情不行、不可能、做不了。",
      "atom_ids": [
        "s-774f976904f6-c001:a023",
        "s-774f976904f6-c001:r019",
        "s-774f976904f6-c002:r001"
      ]
    },
    {
      "name": "好为人师与建议",
      "definition": "生活中很多人喜欢好为人师、提建议，当对方不愿意接受时，提建议者会给对方贴标签，如“不受教”。",
      "atom_ids": [
        "s-774f976904f6-c002:a009"
      ]
    },
    {
      "name": "表达不想听建议",
      "definition": "如果尊重对方、希望听到提醒，但某一件事或某个时候不想听，可以说：请给我一些时间，让我想一想。",
      "atom_ids": [
        "s-774f976904f6-c002:a010"
      ]
    },
    {
      "name": "通过原则处理真理未明确的事",
      "definition": "当真理书没有对具体事情给出明确规定时，需要先了解真理中的大逻辑和原则，把底层逻辑搞清楚。",
      "atom_ids": [
        "s-774f976904f6-c003:a001"
      ]
    },
    {
      "name": "课程与训练营",
      "definition": "可以通过认知提升团体课程、自我认知团体课程、表达与界限训练课程、育儿训练营等课程和活动，提升认知和智慧。",
      "atom_ids": [
        "s-774f976904f6-c003:a002"
      ]
    }
  ],
