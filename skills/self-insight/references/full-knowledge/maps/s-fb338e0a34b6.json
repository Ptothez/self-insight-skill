{
  "concepts": [
    {
      "name": "情绪联结",
      "definition": "满足孩子的基本需求（need），建立在认知孩子困难的基础上，目的是长远引导孩子学习独立管理和平衡情绪。",
      "atom_ids": [
        "s-fb338e0a34b6-c001:a001",
        "s-fb338e0a34b6-c001:a013",
        "s-fb338e0a34b6-c001:a014"
      ]
    },
    {
      "name": "溺爱",
      "definition": "无条件、无原则、无止境地满足孩子的欲望（desire），是父母为避免冲突、贪图一时方便的短暂行为。",
      "atom_ids": [
        "s-fb338e0a34b6-c001:a001",
        "s-fb338e0a34b6-c001:a006",
        "s-fb338e0a34b6-c001:a014"
      ]
    },
    {
      "name": "需求",
      "definition": "孩子的基本需要，如每天吃饭。",
      "atom_ids": [
        "s-fb338e0a34b6-c001:a001",
        "s-fb338e0a34b6-c001:a002"
      ]
    },
    {
      "name": "欲望",
      "definition": "孩子想要但并非基本需要的东西，如饭后每天吃冰激凌。",
      "atom_ids": [
        "s-fb338e0a34b6-c001:a001",
        "s-fb338e0a34b6-c001:a002"
      ]
    },
    {
      "name": "3F状态",
      "definition": "当人面临压力时，下丘脑受刺激释放压力荷尔蒙，导致 freeze、flight 或 fight 的状态，此时大脑无法正常运行。",
      "atom_ids": [
        "s-fb338e0a34b6-c001:a003",
        "s-fb338e0a34b6-c001:a004"
      ]
    },
    {
      "name": "身体溺爱",
      "definition": "替孩子做他本可以自己做的事情，如替七八岁孩子背书包。",
      "atom_ids": [
        "s-fb338e0a34b6-c001:a009"
      ]
    },
    {
      "name": "情绪溺爱",
      "definition": "父母过度保护孩子，不让孩子受挫折，替孩子做所有决定、安排好所有路。",
      "atom_ids": [
        "s-fb338e0a34b6-c001:a010"
      ]
    },
    {
      "name": "行为溺爱",
      "definition": "孩子不需要对自己的行为负责任，如不打扫自己房间或不参与家务。",
      "atom_ids": [
        "s-fb338e0a34b6-c001:a011"
      ]
    }
  ],
