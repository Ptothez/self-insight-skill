{
  "concepts": [
    {
      "name": "情绪连接的前提",
      "definition": "情绪连接的前提包括给孩子策略、方法和选择，以及以身作则。",
      "atom_ids": [
        "s-bbb943717768-c001:a001",
        "s-bbb943717768-c001:a002",
        "s-bbb943717768-c001:r001"
      ]
    },
    {
      "name": "认可而非改变孩子的情绪",
      "definition": "对于该年龄段孩子，情绪连接要认可孩子的情绪，而不是试图改变。",
      "atom_ids": [
        "s-bbb943717768-c001:a003"
      ]
    },
    {
      "name": "家长对负面情绪的接受度",
      "definition": "约90%的家长不能坦然面对孩子负面情绪。",
      "atom_ids": [
        "s-bbb943717768-c001:a004"
      ]
    },
    {
      "name": "智慧父母知道自己的有限",
      "definition": "智慧的父母知道什么是自己能控制的，什么是不能控制的，不能缩短孩子处理情绪的过程。",
      "atom_ids": [
        "s-bbb943717768-c001:a005"
      ]
    },
    {
      "name": "孩子未被邀请参加同学生日",
      "definition": "当孩子未被邀请参加同学生日时，父母常想跳过情绪部分直接解决问题，但应让孩子先处理悲伤情绪。",
      "atom_ids": [
        "s-bbb943717768-c001:a006"
      ]
    },
    {
      "name": "正常化孩子的情绪",
      "definition": "要正常化孩子的情绪，让孩子知道情绪是正常的，避免孩子认为自己是唯一遇到挫折的人。",
      "atom_ids": [
        "s-bbb943717768-c001:a007"
      ]
    },
    {
      "name": "父母不扮演超人角色",
      "definition": "父母在孩子面前不要扮演超人或完美女神，要让孩子知道父母也经历过类似困难。",
      "atom_ids": [
        "s-bbb943717768-c001:a008"
      ]
    },
    {
      "name": "做真实的父母",
      "definition": "情绪连接的关键是做真实的父母，让孩子知道父母也经历过类似情绪。",
      "atom_ids": [
        "s-bbb943717768-c001:a009"
      ]
    },
    {
      "name": "情绪失联的后果（5-8岁）",
      "definition": "如果在该年龄段情绪失联，孩子容易产生醉酒感、自责、内疚，可能发展出讨好型人格。",
      "atom_ids": [
        "s-bbb943717768-c001:a010"
      ]
    },
    {
      "name": "9-12岁情绪特征",
      "definition": "9-12岁孩子荷尔蒙快速改变，大脑发育未成熟，对他人敏感，自尊受外表影响。",
      "atom_ids": [
        "s-bbb943717768-c001:a011",
        "s-bbb943717768-c001:a012",
        "s-bbb943717768-c001:a013",
        "s-bbb943717768-c001:a014"
      ]
    },
    {
      "name": "讲师童年用湿头发编辫子",
      "definition": "讲师回忆自己童年时长头发，洗完头后湿着编辫子，干了后打开头发就卷了。",
      "atom_ids": [
        "s-bbb943717768-c001:a015"
      ]
    },
    {
      "name": "不制止孩子关注外表",
      "definition": "父母不要制止孩子关注外表和与同伴比较，因为这是正常自然的生理状况。",
      "atom_ids": [
        "s-bbb943717768-c001:a016"
      ]
    },
    {
      "name": "9-12岁情绪连接方法",
      "definition": "包括成为情绪表达榜样、认识孩子的朋友、聆听孩子的感受、开放自己的感受、讨论人际关系性别和性行为。",
      "atom_ids": [
        "s-bbb943717768-c001:a017",
        "s-bbb943717768-c001:a019",
        "s-bbb943717768-c001:a020",
        "s-bbb943717768-c001:a022",
        "s-bbb943717768-c001:a023"
      ]
    },
    {
      "name": "母亲表达疲倦和烦躁",
      "definition": "母亲可以告诉孩子自己很累、心情不好，需要先睡一觉，之后再散步谈话。",
      "atom_ids": [
        "s-bbb943717768-c001:a018"
      ]
    },
    {
      "name": "家庭传统：孩子说重要事情时停下",
      "definition": "讲师家庭有传统，不管在做什么，只要孩子说重要事情，就立刻停下来听。",
      "atom_ids": [
        "s-bbb943717768-c001:a021"
      ]
    },
    {
      "name": "孩子谈论校草被家长评判",
      "definition": "孩子说学校有个男生很帅是校草，家长若评判，孩子就不愿再分享。",
      "atom_ids": [
        "s-bbb943717768-c001:a024"
      ]
    },
    {
      "name": "9-12岁情绪失联的后果：积怨",
      "definition": "9-12岁情绪失联会导致孩子对父母产生积怨，积累到13-17岁会爆发。",
      "atom_ids": [
        "s-bbb943717768-c001:a025"
      ]
    },
    {
      "name": "13-17岁情绪特征",
      "definition": "13-17岁孩子情绪极度敏感，与父母接触时间减少，但父母仍是关键影响。",
      "atom_ids": [
        "s-bbb943717768-c001:a026"
      ]
    },
    {
      "name": "朋友与父母的影响范围",
      "definition": "朋友只在短期选择上影响孩子，而父母在长期决定上占据绝对主要影响。",
      "atom_ids": [
        "s-bbb943717768-c001:a027"
      ]
    },
    {
      "name": "13-17岁情绪连接方法",
      "definition": "包括给孩子归属感、设立情绪界限、养成聊天习惯、尊重不同看法、关注外表和兴趣。",
      "atom_ids": [
        "s-bbb943717768-c001:a028",
        "s-bbb943717768-c001:a029",
        "s-bbb943717768-c001:a030",
        "s-bbb943717768-c001:a031",
        "s-bbb943717768-c001:a032"
      ]
    },
    {
      "name": "13-17岁情绪失联的后果：上瘾",
      "definition": "13-17岁情绪失联会导致孩子出现一系列上瘾行为。",
      "atom_ids": [
        "s-bbb943717768-c001:a033"
      ]
    },
    {
      "name": "18-25岁情绪特征",
      "definition": "18-25岁孩子需要转变为成人角色和责任，同理心很强。",
      "atom_ids": [
        "s-bbb943717768-c001:a034",
        "s-bbb943717768-c001:a035"
      ]
    },
    {
      "name": "18-25岁情绪连接方法",
      "definition": "包括给自己设立界限、欣赏优点和强处、提供亲密关系并尊重隐私、提供指导但尊重拒绝。",
      "atom_ids": [
        "s-bbb943717768-c001:a036",
        "s-bbb943717768-c001:a037",
        "s-bbb943717768-c001:a038",
        "s-bbb943717768-c001:a039"
      ]
    }
  ],
