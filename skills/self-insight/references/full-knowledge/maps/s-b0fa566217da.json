{
  "concepts": [
    {
      "name": "情绪联结",
      "definition": "父母与孩子之间建立的情感连接，使孩子愿意向父母吐露心声，并使父母的话语对孩子产生重要影响。",
      "atom_ids": [
        "s-b0fa566217da-c001:a002",
        "s-b0fa566217da-c001:a004",
        "s-b0fa566217da-c001:a007",
        "s-b0fa566217da-c001:a008"
      ]
    },
    {
      "name": "右脑情感需求与左脑逻辑回应的错位",
      "definition": "孩子用右脑表达情感需求，而父母用左脑的逻辑和事实回应，导致情绪联结失败。",
      "atom_ids": [
        "s-b0fa566217da-c001:a006",
        "s-b0fa566217da-c001:a007"
      ]
    },
    {
      "name": "情绪联结的建立方法",
      "definition": "通过接纳和兴奋的态度回应孩子的情感表达，从而建立情绪联结。",
      "atom_ids": [
        "s-b0fa566217da-c001:a001",
        "s-b0fa566217da-c001:a002"
      ]
    },
    {
      "name": "情绪联结缺失的后果",
      "definition": "如果孩子小时候没有建立情绪联结，长大后在行为、情绪和心理上容易出现各种问题。",
      "atom_ids": [
        "s-b0fa566217da-c001:a004"
      ]
    },
    {
      "name": "情绪联结失败导致孩子封闭心扉",
      "definition": "当父母总是用左脑逻辑回应孩子的右脑情感需求时，情绪联结失败，孩子宁愿对手机说话，也不再对母亲吐露心声，甚至产生抑郁。",
      "atom_ids": [
        "s-b0fa566217da-c001:a007"
      ]
    }
  ],
