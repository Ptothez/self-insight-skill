{
  "concepts": [
    {
      "name": "高质量陪伴",
      "definition": "3-7岁孩子接受爱的方式，强调全身心投入、与孩子同一水平、排外、参与孩子的世界，核心是投入程度而非时间长短。",
      "atom_ids": [
        "s-6f1cf2842956-c001:a001",
        "s-6f1cf2842956-c001:a003",
        "s-6f1cf2842956-c001:a007",
        "s-6f1cf2842956-c001:a009",
        "s-6f1cf2842956-c001:a010"
      ]
    },
    {
      "name": "同一水平",
      "definition": "高质量陪伴的第一个要素，包括情绪水平、身体水平和认知水平与孩子一致。",
      "atom_ids": [
        "s-6f1cf2842956-c001:a003",
        "s-6f1cf2842956-c001:a004",
        "s-6f1cf2842956-c001:a005",
        "s-6f1cf2842956-c001:a006"
      ]
    },
    {
      "name": "排外",
      "definition": "高质量陪伴的第二个要素，全身心投入，排除外界打扰，包括其他孩子和配偶也不能打扰。",
      "atom_ids": [
        "s-6f1cf2842956-c001:a007",
        "s-6f1cf2842956-c001:a008"
      ]
    },
    {
      "name": "参与孩子的世界",
      "definition": "高质量陪伴的第三个要素，一起做孩子感兴趣的事情，而不是家长感兴趣的事情。",
      "atom_ids": [
        "s-6f1cf2842956-c001:a009"
      ]
    },
    {
      "name": "肯定的语言",
      "definition": "8-12岁孩子接受爱的方式，帮助孩子发展自我认知、提升自信、打下自律基础。",
