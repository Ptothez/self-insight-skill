{
  "concepts": [
    {
      "name": "行为控制",
      "definition": "父母不断监督和管理孩子行为的一种控制类型。",
      "atom_ids": [
        "s-87d4c96ce60e-c001:a001"
      ]
    },
    {
      "name": "心理控制",
      "definition": "父母对孩子的情绪和心理需要视而不见、满不在乎，通过操控、贬低、羞辱等方式对孩子的心理进行操控的控制类型。",
      "atom_ids": [
        "s-87d4c96ce60e-c001:a002"
      ]
    },
    {
      "name": "行为控制与心理控制的区别",
      "definition": "行为控制是父母不断监督和管理孩子的行为，心理控制是父母对孩子的情绪和心理需要视而不见，通过操控、贬低、羞辱等方式进行心理操控。",
      "atom_ids": [
        "s-87d4c96ce60e-c001:r001"
      ]
    }
  ],
