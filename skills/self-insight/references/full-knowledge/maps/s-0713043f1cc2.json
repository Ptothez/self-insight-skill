{
  "concepts": [
    {
      "name": "ADHD 的两个组成部分",
      "definition": "ADHD 分为 AD（注意力障碍）和 HD（多动障碍）两个部分，AD 部分表现为注意力无法集中，人可能不一定动。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a001",
        "s-0713043f1cc2-c001:r003"
      ]
    },
    {
      "name": "AD 诊断的前提条件",
      "definition": "判断孩子是否有 AD 前，必须先排除所有其他病理因素（如身体疼痛）和家庭环境因素（如天天打架的家庭环境）。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a002",
        "s-0713043f1cc2-c001:a021"
      ]
    },
    {
      "name": "AD 诊断的年龄和持续时间标准",
      "definition": "16 岁以内，症状需持续六个月以上才能开始判断；超过 16 岁，需有五个以上症状且至少持续六个月。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a003"
      ]
    },
    {
      "name": "AD 诊断的症状数量标准",
      "definition": "16 岁以内需至少六点症状，16 岁以上需至少五点症状，才能判断为 AD。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a017"
      ]
    },
    {
      "name": "AD 症状：难以集中注意力",
      "definition": "很难在做事情时集中注意力。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a004"
      ]
    },
    {
      "name": "AD 症状：忽略细节",
      "definition": "在细节上很难注意到很多事情，会在细节处犯错，即使错误简单且有能力做到，也会忽略细节。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a005"
      ]
    },
    {
      "name": "AD 症状：难以专注完成任务",
      "definition": "很难专注地完成一个任务，无法在短时间内集中注意力把任务做完。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a006"
      ]
    },
    {
      "name": "AD 症状：似乎没有在听",
      "definition": "经常在别人跟他说话时没有在听，不是因为专心看电视或拼乐高，而是好像没有能力专心听人说话。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a007"
      ]
    },
    {
      "name": "AD 症状：经常丢东西",
      "definition": "经常丢东西，即使东西很重要且知道重要，也会丢。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a008"
      ]
    },
    {
      "name": "AD 孩子与普通孩子丢东西的区别",
      "definition": "普通孩子丢东西后会自己发现并告知；AD 孩子丢了重要东西根本不会意识到，需要别人问起才知道。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a009",
        "s-0713043f1cc2-c001:a022"
      ]
    },
    {
      "name": "AD 症状：难以提前规划",
      "definition": "很难提前做规划，例如计划明天需要带什么东西，且很难保持计划，难以执行计划。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a010",
        "s-0713043f1cc2-c001:a025"
      ]
    },
    {
      "name": "AD 症状：做事混乱无序",
      "definition": "做事情时很难保证工整，会把东西弄得混乱凌乱。普通孩子的混乱是有序的，AD 孩子的混乱完全无序且没有细节控制。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a011",
        "s-0713043f1cc2-c001:a023"
      ]
    },
    {
      "name": "AD 症状：难以记住事情",
      "definition": "很难记住事情，经常忘记事情，好像第一次听到一样；难以遵从指导，如忘记放学后该去哪里。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a012"
      ]
    },
    {
      "name": "AD 症状：无法完成任务",
      "definition": "无法完成作业或其他交给的任务，因为注意力很快被吸引，例如下楼打酱油中途被其他事情分散，无法保持注意力并执行。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a013"
      ]
    },
    {
      "name": "AD 症状：避免需要长时间用脑的任务",
      "definition": "会尽可能避免需要长时间用脑力的事情或任务。普通孩子小时候喜欢学习，但 AD 孩子不喜欢或避免这类任务。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a014",
        "s-0713043f1cc2-c001:a024"
      ]
    },
    {
      "name": "AD 症状：容易分心且分心不持续",
      "definition": "很容易分心，一点点声音就分神，且分神是持续性的，一会儿分到这边，一会儿分到那边，连分神都不能持续。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a015"
      ]
    },
    {
      "name": "AD 症状：忘记日常活动",
      "definition": "常常忘记日常活动或日常性的事情。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a016"
      ]
    },
    {
      "name": "ADHD 误诊与药物副作用",
      "definition": "ADHD 容易被误诊，如果孩子没有多动症却被误诊并吃药，药物副作用非常大，因此需要正确判断。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a019",
        "s-0713043f1cc2-c001:r002"
      ]
    },
    {
      "name": "调皮与多动症的区别",
      "definition": "孩子调皮、好动，特别是男孩，不代表有多动症；需要区分病理性的多动症和普通调皮。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a020"
      ]
    },
    {
      "name": "ADHD 误诊的普遍性与家长焦虑",
      "definition": "ADHD 在全世界范围内是最常被误诊的儿童疾病之一，许多家长因孩子好动而焦虑，频繁询问孩子是否有多动症，但不知道如何分辨。",
      "atom_ids": [
        "s-0713043f1cc2-c001:r001"
      ]
    },
    {
      "name": "用所学判断孩子是否有 AD",
      "definition": "课程要求用刚才学到的 AD 症状和标准来判断自己的孩子是否有 AD 情况。",
      "atom_ids": [
        "s-0713043f1cc2-c001:a018"
      ]
    }
  ],
