{
  "concepts": [
    {
      "name": "讲道理",
      "definition": "父母用成人道理体系判断孩子情绪和行为的合理性，试图通过逻辑说服控制孩子情绪。",
      "atom_ids": [
        "s-61e65dbd90b6-c001:a001",
        "s-61e65dbd90b6-c001:a002",
        "s-61e65dbd90b6-c001:a003",
        "s-61e65dbd90b6-c001:a004",
        "s-61e65dbd90b6-c001:a005",
        "s-61e65dbd90b6-c001:a007"
      ]
    },
    {
      "name": "打孩子",
      "definition": "与讲道理相对的另一极端育儿方式，同样被课程视为糟糕、失败、低级。",
      "atom_ids": [
        "s-61e65dbd90b6-c001:a004"
      ]
    },
    {
      "name": "平衡点",
      "definition": "介于讲道理和打孩子之间的正确育儿方式，需要父母找到中间地带。",
      "atom_ids": [
        "s-61e65dbd90b6-c001:a004"
      ]
    },
    {
      "name": "情绪接纳",
      "definition": "允许孩子表达情绪，不评判、不讲道理，理解并接受其情绪，有助于孩子情绪健康。",
      "atom_ids": [
        "s-61e65dbd90b6-c001:a006",
        "s-61e65dbd90b6-c001:a013"
      ]
    },
    {
      "name": "逻辑覆盖情绪",
      "definition": "父母用逻辑和道理压制或替代对情绪的感知和处理，导致不断讲道理。",
      "atom_ids": [
        "s-61e65dbd90b6-c001:a007"
      ]
    },
    {
      "name": "处理过去伤害",
      "definition": "父母处理自身童年伤害的步骤：挖出伤害、指认伤害、为伤害悲痛、夺回力量。",
      "atom_ids": [
        "s-61e65dbd90b6-c001:a008",
        "s-61e65dbd90b6-c001:a009"
      ]
    },
    {
      "name": "自我同情",
      "definition": "父母同情和可怜自己，承认脆弱和需要帮助，而非拒绝同情、假装强悍。",
      "atom_ids": [
        "s-61e65dbd90b6-c001:a010"
      ]
    },
    {
      "name": "心理辅导",
      "definition": "寻求专业心理帮助处理情绪和伤害，被视为健康且值得骄傲的行为。",
      "atom_ids": [
        "s-61e65dbd90b6-c001:a011"
      ]
    },
    {
      "name": "分离孩子与记忆",
      "definition": "父母将孩子与自身过去伤害记忆分开，意识到孩子无辜且独立。",
      "atom_ids": [
        "s-61e65dbd90b6-c001:a012"
      ]
    },
    {
      "name": "发脾气",
      "definition": "孩子表达负面情绪的正常行为，健康且有益，长期潜力大于讲道理的孩子。",
      "atom_ids": [
        "s-61e65dbd90b6-c001:a014",
        "s-61e65dbd90b6-c001:a015"
      ]
    },
    {
      "name": "乱发脾气",
      "definition": "与发脾气不同的不当行为，需要引导，后续课程讲解。",
      "atom_ids": [
        "s-61e65dbd90b6-c001:a015"
      ]
    },
    {
      "name": "控制情绪行为",
      "definition": "教孩子控制情绪时的行为，而非情绪本身，情绪无法控制但行为可以。",
      "atom_ids": [
        "s-61e65dbd90b6-c001:a016"
      ]
    }
  ],
