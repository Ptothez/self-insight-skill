{
  "concepts": [
    {
      "name": "优缺点",
      "definition": "优点和缺点互为因果，无所谓优缺点只有特点，构成光谱，中间地带蕴藏本质，不应被定义而应超越。",
      "atom_ids": [
        "s-ee1e2c407724-c001:a001",
        "s-ee1e2c407724-c001:a002",
        "s-ee1e2c407724-c001:a003"
      ]
    },
    {
      "name": "原生家庭信息",
      "definition": "小时候最常听见的信息，带来恐惧并影响现在生活，其中包含谎言。",
      "atom_ids": [
        "s-ee1e2c407724-c001:a005",
        "s-ee1e2c407724-c001:a006"
      ]
    },
    {
      "name": "父母图片",
      "definition": "父母带来的关于男人和女人的印象，影响两性关系认知，可能包含谎言。",
      "atom_ids": [
        "s-ee1e2c407724-c001:a007",
        "s-ee1e2c407724-c001:a008"
      ]
    },
    {
      "name": "人设",
      "definition": "因过去伤害未解决而创造出来自我保护的东西，如同面具，时间长了会反噬自己，阻挡获得真正想要的东西。",
      "atom_ids": [
        "s-ee1e2c407724-c001:a009",
        "s-ee1e2c407724-c001:a010",
        "s-ee1e2c407724-c001:a011"
      ]
    },
    {
      "name": "核心信念",
      "definition": "由伤害导致的错误自我认知，是穿上真理外衣的羞耻，包括我不够好、我不安全等。",
      "atom_ids": [
        "s-ee1e2c407724-c001:a012",
        "s-ee1e2c407724-c001:a013",
        "s-ee1e2c407724-c001:a014"
      ]
    },
    {
      "name": "焦虑",
      "definition": "人设受到威胁产生的情绪，人设用来保护自己远离核心信念。",
      "atom_ids": [
        "s-ee1e2c407724-c001:a015",
        "s-ee1e2c407724-c001:a016"
      ]
    },
    {
      "name": "重写故事",
      "definition": "整合七课内容的模板，通过描述美好特质、打破原生家庭谎言、分析父母图片、识别人设、处理伤害、连接焦虑与核心信念、展望新可能性来重写个人故事。",
      "atom_ids": [
        "s-ee1e2c407724-c001:a017"
      ]
    },
    {
      "name": "逻辑闭环",
      "definition": "本相→受伤失去力量带来谎言和错误认知→产生核心信念→生出人设保护→人设与受伤后的自己分不清→人设反噬→人设受威胁保护无效→勾起核心信念陷入痛苦。",
      "atom_ids": [
        "s-ee1e2c407724-c001:a018"
      ]
    }
  ],
