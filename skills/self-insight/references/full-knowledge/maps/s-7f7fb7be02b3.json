{
  "concepts": [
    {
      "name": "8-12岁阶段特征",
      "definition": "8-12岁孩子开始与父母疏远，父母感到失去控制，孩子情绪波动大，前额叶未发育成熟导致冲动。",
      "atom_ids": [
        "s-7f7fb7be02b3-c001:a002",
        "s-7f7fb7be02b3-c001:a005",
        "s-7f7fb7be02b3-c001:a010",
        "s-7f7fb7be02b3-c001:a011"
      ]
    },
    {
      "name": "父母自身问题处理",
      "definition": "父母应趁孩子还小处理自己的原生家庭问题和心理情绪问题，以便更好地应对孩子。",
      "atom_ids": [
        "s-7f7fb7be02b3-c001:a004"
      ]
    },
    {
      "name": "不当管教方法",
      "definition": "父母常用语言暴力、行为威胁等不当方法处理矛盾，这些方法可能导致孩子出现严重问题。",
      "atom_ids": [
        "s-7f7fb7be02b3-c001:a006",
        "s-7f7fb7be02b3-c001:a007",
        "s-7f7fb7be02b3-c001:a008"
      ]
    },
    {
      "name": "生理变化告知",
      "definition": "父母应告知孩子生理变化，帮助孩子理解情绪波动，减少恐惧。",
      "atom_ids": [
        "s-7f7fb7be02b3-c001:a009"
      ]
    },
    {
      "name": "矛盾处理四步法",
      "definition": "教孩子处理矛盾的四个步骤：数到十冷静、陈述情绪并理解问题、认真道歉、找出解决方法。",
      "atom_ids": [
        "s-7f7fb7be02b3-c001:r001",
        "s-7f7fb7be02b3-c001:a012",
        "s-7f7fb7be02b3-c001:a013",
        "s-7f7fb7be02b3-c001:a016",
        "s-7f7fb7be02b3-c001:a019"
      ]
    },
    {
      "name": "3R道歉法",
      "definition": "道歉包括Regret（后悔）、Remedy（补救）、Responsibility（负责任）三个要素。",
      "atom_ids": [
        "s-7f7fb7be02b3-c001:a017",
        "s-7f7fb7be02b3-c001:a018"
      ]
    },
    {
      "name": "给予后果夹带恩典",
      "definition": "在管教孩子时，给予后果后告知后果，允许选择，并夹带恩典，但孩子多次重复问题时不给予恩典。",
      "atom_ids": [
        "s-7f7fb7be02b3-c001:a001"
      ]
    },
    {
      "name": "帮助孩子梳理矛盾过程",
      "definition": "当孩子大脑有矛盾时，帮助孩子一步一步梳理矛盾过程，反推问题核心。",
      "atom_ids": [
        "s-7f7fb7be02b3-c001:a015"
      ]
    },
    {
      "name": "情绪爆发案例",
      "definition": "孩子因被问分数而爆发，真正问题是情绪需求未满足。",
      "atom_ids": [
        "s-7f7fb7be02b3-c001:a014"
      ]
    }
  ],
