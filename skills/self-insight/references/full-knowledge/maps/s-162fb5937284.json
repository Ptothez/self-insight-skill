{
  "concepts": [
    {
      "name": "管教与惩罚的区别",
      "definition": "管教是赋能，目的是让孩子知道错在哪里并帮助他下次不再犯；惩罚的目的是让孩子痛苦和受伤。两者目的根本不同。",
      "atom_ids": [
        "s-162fb5937284-c001:a002",
        "s-162fb5937284-c001:a003",
        "s-162fb5937284-c001:r001"
      ]
    },
    {
      "name": "Time Out（面壁思过）",
      "definition": "一种惩罚方式，让孩子独自到房间面壁思过，思考自己做错了什么。",
      "atom_ids": [
        "s-162fb5937284-c001:a004"
      ]
    },
    {
      "name": "Time Out的危险",
      "definition": "传递给孩子“做错事、父母生气时只能自己面对”的信息，可能导致青少年时期遇到问题不告诉父母，感到孤独。",
      "atom_ids": [
        "s-162fb5937284-c001:a005"
      ]
    },
    {
      "name": "Time In（陪伴冷静）",
      "definition": "替代Time Out的方法：当孩子失控、大吼大闹时，父母陪孩子一起到房间冷静，允许孩子哭闹、打滚、发脾气、捶床，传递“我不离开你，一起经历”的信息。",
      "atom_ids": [
        "s-162fb5937284-c001:a006"
      ]
    },
    {
      "name": "父母行为传递信息",
      "definition": "父母每时每刻做什么或不做什么都在给孩子传递信息。",
      "atom_ids": [
        "s-162fb5937284-c001:a007"
      ]
    },
    {
      "name": "孩子哭闹是求救信号",
      "definition": "孩子在哭闹、犯错时，其实是在向父母求救，尤其需要父母的支持、鼓励和保护。",
      "atom_ids": [
        "s-162fb5937284-c001:a008"
      ]
    },
    {
      "name": "打孩子的无效性",
      "definition": "讲师不支持打孩子，即使是轻轻打也不可以，因为轻轻打不能让孩子知道错、受管教或顺服。",
      "atom_ids": [
        "s-162fb5937284-c001:a009"
      ]
    },
    {
      "name": "语言暴力的伤害",
      "definition": "语言暴力（责骂、大吼）会刺痛孩子，大脑中疼痛区域被激活，与被打时激活的疼痛区域相同。",
      "atom_ids": [
        "s-162fb5937284-c001:a010"
      ]
    },
    {
      "name": "没收物品的弊端",
      "definition": "没收手机、电子产品、玩具等不是自然结果，孩子不知道为什么失去东西，只知道做错事会失去东西。",
      "atom_ids": [
        "s-162fb5937284-c001:a011"
      ]
    },
    {
      "name": "没收物品后的困境",
      "definition": "当所有东西都收完了，父母该怎么办？当孩子长大不怕没收或自己购买物品时，没收会失效，甚至可能引发冲突。",
      "atom_ids": [
        "s-162fb5937284-c001:a012"
      ]
    },
    {
      "name": "不理睬作为惩罚",
      "definition": "一种惩罚方式：父母不和孩子说话，让孩子知道父母不高兴。",
      "atom_ids": [
        "s-162fb5937284-c001:a013"
      ]
    },
    {
      "name": "不理睬导致讨好型人格",
      "definition": "不理睬惩罚的第一个后果：孩子可能成为讨好型人格，为了重新获得父母关注，会努力做好家务、考好成绩等来讨好父母。",
      "atom_ids": [
        "s-162fb5937284-c001:a014"
      ]
    },
    {
      "name": "不理睬导致孩子不会沟通",
      "definition": "不理睬惩罚的第三个后果：孩子以后也会成为同样的人，不知道如何沟通矛盾，生气时不讲话，把自己关闭起来。",
      "atom_ids": [
        "s-162fb5937284-c001:a016"
      ]
    },
    {
      "name": "高知家庭孩子的狂躁愤怒案例",
      "definition": "一个高知家庭，父母非常自控、内敛，不讲情绪，生气时不讲话。结果青少年孩子非常愤怒，会打父母、砸东西。原因是家庭太控制、太冷，孩子用狂暴方式试图引起父母情绪反应。",
      "atom_ids": [
        "s-162fb5937284-c001:a015"
      ]
    },
    {
      "name": "反思自己的惩罚方式",
      "definition": "讲师请听众思考：自己习惯用什么样的惩罚方式？使用这些惩罚方式后，在孩子身上已经造成了什么样的影响？",
      "atom_ids": [
        "s-162fb5937284-c001:a017"
      ]
    },
    {
      "name": "先讲错误再讲正确",
      "definition": "讲师提出教学顺序：在讲正确的管教方法之前，必须先讲错误的方法。因为很多人普遍认为某些育儿方式是正确且高级的，但实际上它们是错误的。",
      "atom_ids": [
        "s-162fb5937284-c001:xe001"
      ]
    },
    {
      "name": "迫于社交压力使用管教尺",
      "definition": "很多父母使用管教尺（打孩子工具）并非出于教育目的，而是因为身边朋友都有管教尺，迫于社交压力而跟风。",
      "atom_ids": [
        "s-162fb5937284-c001:xe002"
      ]
    }
  ],
