{
  "concepts": [
    {
      "name": "情绪重塑六步骤",
      "definition": "重塑情绪共有六个步骤：觉察、指认情绪背后的情绪、定义感受之后的行为、找到需求、重议（重构故事）、转变（行为改变）。",
      "atom_ids": [
        "s-f8591e3708ce-c001:a001"
      ]
    },
    {
      "name": "觉察内心感受",
      "definition": "情绪过后要敏锐觉察内心感受，发现自己在什么情绪里面。觉察时不是用情绪轮对照情绪，而是感受内心的感受，让自己浸泡在感受中，享受当下的感受。",
      "atom_ids": [
        "s-f8591e3708ce-c001:a002"
      ]
    },
    {
      "name": "情绪与感受的区别",
      "definition": "情绪是对外的，如愤怒、生气、同情；感受是对内的，如疼痛、无助、不知所措、悲伤。外部事件勾起情绪，情绪转换到内部变成感受。",
      "atom_ids": [
        "s-f8591e3708ce-c001:a003"
      ]
    },
    {
      "name": "感受的来源",
      "definition": "感受可能来自过去的记忆、内在声音、未解决的伤害。",
      "atom_ids": [
        "s-f8591e3708ce-c001:a004",
        "s-f8591e3708ce-c001:a005",
        "s-f8591e3708ce-c001:a006"
      ]
    },
    {
      "name": "指认情绪背后的情绪",
      "definition": "问自己真正导致情绪的问题是什么。情绪背后有另一个情绪，如愤怒可能掩盖羞愧、悲伤、不确定、疲惫、被拒绝、无助、焦虑等。",
      "atom_ids": [
        "s-f8591e3708ce-c001:a007"
      ]
    },
    {
      "name": "愤怒作为情绪反应",
      "definition": "愤怒常是表面情绪，掩盖深层情绪如羞愧、悲伤、不确定、疲惫、被拒绝、无能为力、无助、焦虑。孩子受伤时特别容易以愤怒表达，可能是在求助。",
      "atom_ids": [
        "s-f8591e3708ce-c001:a008"
      ]
    },
    {
      "name": "定义感受之后的行为",
      "definition": "定义感受之后想做什么行为，如打人、骂脏话、跑步、喝酒、吃东西、购物等。了解自己在受伤后倾向于做什么行为。",
      "atom_ids": [
        "s-f8591e3708ce-c001:a009"
      ]
    },
    {
      "name": "找到需求",
      "definition": "找到行为背后的愿望和心理需要。需求被满足后情绪可以重塑。需求包括独立自主、与人连接、意义、身体健康、诚实诚信、平衡等。",
      "atom_ids": [
        "s-f8591e3708ce-c001:a010"
      ]
    },
    {
      "name": "重议（重构故事）",
      "definition": "通过重构扭转负面情绪。暂停后重新书写故事，改变对事件的解释。",
      "atom_ids": [
        "s-f8591e3708ce-c001:a011"
      ]
    },
    {
      "name": "转变（行为改变）",
      "definition": "思维看法认知改变后发生行为改变。包括积极自我对话（喊自己名字可减轻痛苦）、用事实挑战自己、同情并鼓励自己。",
      "atom_ids": [
        "s-f8591e3708ce-c001:a012"
      ]
    },
    {
      "name": "积极自我对话喊名字",
      "definition": "研究表明，自我对话时喊自己的名字可以有效减轻痛苦感。",
      "atom_ids": [
        "s-f8591e3708ce-c001:a019"
      ]
    },
    {
      "name": "用事实挑战自己",
      "definition": "用事实挑战自己的负面认知，问自己“这是真的吗？有事实证明还是猜测？”",
      "atom_ids": [
        "s-f8591e3708ce-c001:a020"
      ]
    },
    {
      "name": "同情并鼓励自己",
      "definition": "重构后对自己产生廉洁和接纳，开始同情和安抚自己，从负面情绪走向正向。",
      "atom_ids": [
        "s-f8591e3708ce-c001:a021"
      ]
    },
    {
      "name": "情绪轮使用时机",
      "definition": "平时可用情绪轮指认情绪，但在觉察内心感受时不要用情绪轮，而是直接感受。",
      "atom_ids": [
        "s-f8591e3708ce-c001:a022"
      ]
    },
    {
      "name": "婚姻辅导建议",
      "definition": "如果从未与配偶吵过架，建议寻求婚姻辅导，因为婚姻可能已非常危险。",
      "atom_ids": [
        "s-f8591e3708ce-c001:a023"
      ]
    },
    {
      "name": "用事实挑战认知偏差以重塑情绪",
      "definition": "当个体因某次失败而自我否定时，可以通过查找客观事实数据来挑战原有的认知偏差，从而减轻自我愤怒，转向自我同情和鼓励。",
      "atom_ids": [
        "s-f8591e3708ce-c002:a001"
      ]
    },
    {
      "name": "从自我愤怒到自我同情的情绪转变",
      "definition": "当个体意识到自己的行为并非出于愚蠢，而是基于正确的价值观时，情绪会从自我愤怒转变为光明正向的状态，进而产生自我同情和安抚的意愿。",
      "atom_ids": [
        "s-f8591e3708ce-c002:a002"
      ]
    },
    {
      "name": "情绪重塑的步骤",
      "definition": "情绪重塑包括：认知自己、接纳自己、明白情绪原因；重新思考和处理思维过程中的错误；通过行为改变安慰自己；心理需求满足，情绪重塑。",
      "atom_ids": [
        "s-f8591e3708ce-c002:a003"
      ]
    },
    {
      "name": "情绪重塑需要反复练习",
      "definition": "情绪重塑的方法需要反复练习才能掌握，学习后不会立即熟练，过程中可能会感到困难，这是正常现象。",
      "atom_ids": [
        "s-f8591e3708ce-c002:a004"
      ]
    }
  ],
