{
  "concepts": [
    {
      "name": "聆听不同意见的能力",
      "definition": "能够接受与自己不同的意见、批评或观点，而不是本能地拒绝或防御，需要建立多维思考能力（open mind）。",
      "atom_ids": [
        "s-807656851c89-c001:a001"
      ]
    },
    {
      "name": "多维思考能力",
      "definition": "从多个角度理解问题的能力，是接受不同意见的基础。",
      "atom_ids": [
        "s-807656851c89-c001:a001",
        "s-807656851c89-c001:a004"
      ]
    },
    {
      "name": "人类拒绝不同意见的惯性",
      "definition": "人类普遍不喜欢听到与自己不同的意见，因为希望得到认同、认可和赞许，而不喜欢被指出问题。",
      "atom_ids": [
        "s-807656851c89-c001:a002"
      ]
    },
    {
      "name": "父母对孩子不接受不同意见的误区",
      "definition": "父母常误认为孩子不接受不同意见是因为骄傲、胆小或固执，忽略了孩子缺乏多维思考能力的根本原因。",
      "atom_ids": [
        "s-807656851c89-c001:a003"
      ]
    },
    {
      "name": "多维思考能力的发展阶段",
      "definition": "孩子小时候没有逻辑思维能力，容易接受不同意见；约七八岁到十五六七岁逻辑思维形成，多维思考能力逐步形成；若父母不允许发展，孩子会停留在叛逆期，成年后仍无法接受不同意见。",
      "atom_ids": [
        "s-807656851c89-c001:a004"
      ]
    },
    {
      "name": "对未知的恐惧导致拒绝不同意见",
      "definition": "接受不同意见的最大挑战是对未知事物的恐惧，人们倾向于认为熟悉的是好的，不熟悉的是不好的。",
      "atom_ids": [
        "s-807656851c89-c001:a005"
      ]
    },
    {
      "name": "处理批评的第一步：处理即时反应",
      "definition": "听到批评时的第一反应往往是防御、拒绝，伴随惊讶、尴尬、受伤、恐惧或哭泣等情绪，需要先处理这些即时反应。",
      "atom_ids": [
        "s-807656851c89-c001:a006"
      ]
    },
    {
      "name": "保持冷静的方法",
      "definition": "与孩子讨论在生气瞬间可以控制行为的方法，如深呼吸和数数（从1数到30），并反复练习直到自动运用。",
      "atom_ids": [
        "s-807656851c89-c001:a007"
      ]
    },
    {
      "name": "重复所听到的批评或不同意见",
      "definition": "处理批评的第二步，重复对方的话以确保正确理解，保持眼神交流，用平静语气澄清，既不接受也不否认。",
      "atom_ids": [
        "s-807656851c89-c001:a009"
      ]
    },
    {
      "name": "找出具体批评",
      "definition": "当批评不够具体时，通过提问澄清具体方面，如老板说PPT不好，需问清是颜色、内容、字体还是呈现方式。",
      "atom_ids": [
        "s-807656851c89-c001:a011"
      ]
    },
    {
      "name": "缓冲期的作用",
      "definition": "通过重复批评和澄清，孩子获得缓冲期，不会立刻爆发或拒绝，而是有空间处理情绪和思考。",
      "atom_ids": [
        "s-807656851c89-c001:a012"
      ]
    },
    {
      "name": "建立多维思考能力：允许孩子挑战",
      "definition": "第一步是允许孩子表达不同意见和挑战，父母不应打压，而应鼓励。",
      "atom_ids": [
        "s-807656851c89-c001:a013"
      ]
    },
    {
      "name": "建立多维思考能力：询问对方想法",
      "definition": "第二步是经常问孩子“你觉得他为什么会这么想？”，通过共情训练从对方角度理解不同观念。",
      "atom_ids": [
        "s-807656851c89-c001:a014"
      ]
    },
    {
      "name": "认可孩子的好奇心",
      "definition": "当孩子问“为什么”时，父母不应逃避或直接给答案，而应认可好奇心，与孩子讨论，建立连接。",
      "atom_ids": [
        "s-807656851c89-c001:a015"
      ]
    },
    {
      "name": "连接促进接受不同意见",
      "definition": "与提出不同意见的人有良好关系时，更容易接受其观点，因此与孩子建立连接有助于接受父母的不同意见。",
      "atom_ids": [
        "s-807656851c89-c001:a016"
      ]
    },
    {
      "name": "禁止好奇心的负面影响",
      "definition": "禁止孩子对与自己不同的人或事物感到好奇，会传递“不要对和我们不一样的人感兴趣”的信息，导致孩子认为不同是羞耻或可怕的。",
      "atom_ids": [
        "s-807656851c89-c001:a018"
      ]
    },
    {
      "name": "处理批评的完整步骤",
      "definition": "包括：1. 处理即时反应，保持冷静；2. 重复批评以澄清；3. 找出具体批评；4. 建立缓冲期；5. 建立多维思考能力；6. 认可好奇心并建立连接。",
      "atom_ids": [
        "s-807656851c89-c001:a019"
      ]
    },
    {
      "name": "孩子对批评的常见反应",
      "definition": "孩子听到不同意见或批评时，常见反应包括火冒三丈、爆发、大哭、崩溃、狂躁、吵架等。",
      "atom_ids": [
        "s-807656851c89-c001:a020"
      ]
    },
    {
      "name": "用讨论而非打压回应孩子对差异的好奇",
      "definition": "当孩子对与自己不同的人或事物感到好奇时，父母应鼓励和认可其好奇，用讨论的方式回应，而不是拒绝或打压。",
      "atom_ids": [
        "s-807656851c89-c002:a002"
      ]
    },
    {
      "name": "帮助孩子从差异中看到共性",
      "definition": "父母应帮助孩子从差异中看到共性，例如引导孩子发现轮椅使用者穿着相似的衣服，或在夫妻冲突中找到共性。",
      "atom_ids": [
        "s-807656851c89-c002:a003"
      ]
    },
    {
      "name": "面对孩子对差异的反应，第一反应是帮助而非打压",
      "definition": "当孩子对差异有负面反应（如害怕）时，父母的第一反应不应是打压或反驳，而是帮助孩子看到相同点。",
      "atom_ids": [
        "s-807656851c89-c002:a005"
      ]
    },
    {
      "name": "父母传递的价值信息影响孩子接受不同意见",
      "definition": "父母日常语言中若传递“与我不同就是不好”的信息，孩子会形成“凡与我不同都是不好”的观念，从而难以接受不同意见。",
      "atom_ids": [
        "s-807656851c89-c002:a006"
      ]
    },
    {
      "name": "父母需检查自己传递的信息",
      "definition": "父母应经常检查自己传递的价值信息，避免使用贬低与自己不同的人或行为的语言。",
      "atom_ids": [
        "s-807656851c89-c002:a007"
      ]
    },
    {
      "name": "鼓励孩子学习另一种语言以理解不同文化",
      "definition": "学习语言不应仅为考试，而应帮助孩子理解语言背后的文化、价值观和立场，从而打开世界观和认知，培养包容性。",
      "atom_ids": [
        "s-807656851c89-c002:a008"
      ]
    },
    {
      "name": "不包容或极端主义来源于误会和沟通失误",
      "definition": "不包容或极端主义往往来源于对其他不同外部事物的误会和沟通失误，对文化理解狭隘、认知有限的人容易成为“杠精”。",
      "atom_ids": [
        "s-807656851c89-c002:a009"
      ]
    },
    {
      "name": "英文“I see”反映的文化：看见才相信",
      "definition": "英文“I see”实际意思是“我明白了”，反映美国文化中“我看见，我就相信”的特点，与这种文化背景的人打交道时需要呈现视觉化的东西。",
      "atom_ids": [
        "s-807656851c89-c002:a010"
      ]
    },
    {
      "name": "英文拒绝方式反映文化的开放性和多维思考",
      "definition": "英文中拒绝时常用“I'm not sure if that's necessary”，反映美国文化包容性强、多维性思考，拒绝中包含开放性。",
      "atom_ids": [
        "s-807656851c89-c002:a011"
      ]
    },
    {
      "name": "英文中批评与鼓励的表达差异",
      "definition": "英文中说缺点时不用“your weakness”，而用“the area you can do better”，以委婉方式表达，反映该文化大力鼓励人，批评时特别小心对方感受。",
      "atom_ids": [
        "s-807656851c89-c002:a012"
      ]
    },
    {
      "name": "通过体验另一种文化打开眼界",
      "definition": "鼓励孩子经历另一种文化，而非仅打卡式旅游，真正的文化体验是在当地住下来，观察交往方式、生活习惯等。",
      "atom_ids": [
        "s-807656851c89-c002:a013"
      ]
    },
    {
      "name": "不能旅游时通过做网上攻略体验文化",
      "definition": "如果不能出门旅游，可以在网上做旅游攻略，选择酒店、景点、美食，看图片和网评，读风土人情，打开眼界。",
      "atom_ids": [
        "s-807656851c89-c002:a014"
      ]
    },
    {
      "name": "尊重孩子个性，避免性别偏见",
      "definition": "父母应尊重孩子的个性，避免性别偏见语言，性别偏见会固化孩子思维，使其更不容易接受不同意见。",
      "atom_ids": [
        "s-807656851c89-c002:a015"
      ]
    },
    {
      "name": "不允许孩子发声导致其不愿接受不同意见",
      "definition": "如果孩子小时候为自己发声时被父母打压，久而久之孩子不知道如何为自己辩护，于是干脆不听父母的不同意见。",
      "atom_ids": [
        "s-807656851c89-c002:a016"
      ]
    },
    {
      "name": "教孩子在接受不同意见的同时为自己发声",
      "definition": "父母应教孩子在接受不同意见的同时为自己发声，首先帮助孩子辨别不同的意见和批评，区分善意与恶意。",
      "atom_ids": [
        "s-807656851c89-c002:a017"
      ]
    },
    {
      "name": "不同意见分为善意和恶意两种",
      "definition": "不同的意见分两种：善意的和恶意的。有时孩子将善意的意见误识别为恶意而拒绝；有时父母以为善意，但以恶意方式传递。",
      "atom_ids": [
        "s-807656851c89-c002:a018"
      ]
    },
    {
      "name": "公平批评（善意意见）的定义",
      "definition": "公平的批评或善意的意见是以尊重的、建设性的、非威胁性的方式进行的，包括事实的陈述和客观的观察，侧重于行为而不是人。",
      "atom_ids": [
        "s-807656851c89-c002:a019"
      ]
    },
    {
      "name": "面对善意批评时为自己发声的方法",
      "definition": "关键步骤：1. 表达理解对方想法；2. 说明自己从另一个角度看事情；3. 诚恳介绍自己这样做的真实原因和背景；4. 获得对方理解；5. 提出以后要改变的计划。",
      "atom_ids": [
        "s-807656851c89-c002:a021"
      ]
    },
    {
      "name": "恶意批评（恶意意见）的特征",
      "definition": "不公平，对人不对事，语气刺耳，使用宽泛不具体的语言，常在公共场合表达，目的是针对人，让人觉得自己不好。",
      "atom_ids": [
        "s-807656851c89-c002:a022"
      ]
    },
    {
      "name": "面对恶意批评时为自己发声的方法",
      "definition": "第一，告诉对方“你不是真理本身”，对方说你坏、小气等都不算数；第二，用后果表明态度，可以离开或拒绝这样的批评，让对方知道无法改变你。即使恶意批评的内容是对的，如果以恶意方式讲出，也不用接受。",
      "atom_ids": [
        "s-807656851c89-c002:r001",
        "s-807656851c89-c003:a002"
      ]
    },
    {
      "name": "善意与恶意批评的区分",
      "definition": "善意的批评是客观公平的、对事不对人，语气平和，目的是帮助改进；恶意的批评是不公平的、对人不对事，语气刺耳，使用宽泛语言，常在公共场合，目的是攻击人格。",
      "atom_ids": [
        "s-807656851c89-c003:a001"
      ]
    },
    {
      "name": "辨别与拒绝恶意批评对开放性的影响",
      "definition": "当孩子能够辨别恶意批评并理直气壮地拒绝时，他不再对未知感到恐惧，因此不再那么拒绝不同意见，反而对不同的意见更加持有开放性。",
      "atom_ids": [
        "s-807656851c89-c003:a003"
      ]
    },
    {
      "name": "育儿学习的长期性",
      "definition": "育儿是一条漫长的路，涉及界限、能力、优秀父母的习惯等多个方面，需要慢慢学习，并在实践中逐步应用所学知识。",
      "atom_ids": [
        "s-807656851c89-c003:a004"
      ]
    }
  ],
