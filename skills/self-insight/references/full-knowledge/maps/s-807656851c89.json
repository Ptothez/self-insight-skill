  "tensions": [
    {
      "atom_ids": [
        "s-807656851c89-c001:a004",
        "s-807656851c89-c001:a001"
      ],
      "description": "a004指出多维思考能力在约七八岁到十五六七岁逐步形成，而a001定义聆听不同意见的能力需要多维思考能力，但未说明年龄适用范围，可能产生矛盾：是否所有年龄段都需要多维思考能力才能接受不同意见？",
      "needed_evidence": "需要明确多维思考能力在不同年龄段的具体表现，以及聆听不同意见的能力是否在儿童早期就存在。"
    },
    {
      "atom_ids": [
        "s-807656851c89-c001:a005",
        "s-807656851c89-c003:a003"
      ],
      "description": "a005指出对未知的恐惧导致拒绝不同意见，而c003:a003指出辨别并拒绝恶意批评后，孩子不再对未知恐惧，因此更开放。但未说明如何从恐惧未知转变为不恐惧，可能缺少中间步骤。",
      "needed_evidence": "需要证据说明辨别恶意批评如何具体减少对未知的恐惧。"
    }
  ],
  "path": [
    {
      "name": "处理批评的完整步骤",
      "steps": [
        {
          "action": "处理即时反应，保持冷静",
          "atom_ids": [
            "s-807656851c89-c001:a006",
            "s-807656851c89-c001:a007"
          ],
          "condition": "当听到批评或不同意见时，首先处理防御、拒绝等即时反应。"
        },
        {
          "action": "重复所听到的批评以澄清",
          "atom_ids": [
            "s-807656851c89-c001:a009"
          ],
          "condition": "在冷静后，重复对方的话以确保正确理解。"
        },
        {
          "action": "找出具体批评",
          "atom_ids": [
            "s-807656851c89-c001:a011"
          ],
          "condition": "如果批评不够具体，通过提问澄清具体方面。"
        },
        {
          "action": "建立缓冲期",
          "atom_ids": [
            "s-807656851c89-c001:a012"
          ],
          "condition": "通过重复和澄清，获得缓冲期，避免立刻爆发。"
        },
        {
          "action": "建立多维思考能力",
          "atom_ids": [
            "s-807656851c89-c001:a013",
            "s-807656851c89-c001:a014"
          ],
          "condition": "允许孩子挑战，并询问对方想法，培养从多角度理解。"
        },
        {
          "action": "认可好奇心并建立连接",
          "atom_ids": [
            "s-807656851c89-c001:a015",
            "s-807656851c89-c001:a016"
          ],
          "condition": "认可孩子的好奇心，与孩子讨论，建立连接，促进接受不同意见。"
        }
      ]
    }
  ],
