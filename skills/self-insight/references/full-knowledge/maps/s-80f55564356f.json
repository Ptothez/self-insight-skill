{
  "concepts": [
    {
      "name": "界限原则",
      "definition": "界限原则是在设立界限过程中起定海神针作用的根本准则，用于判断某个界限是否属于界限范畴、是否应该设立，避免因学习界限后过于敏感而设立不当界限或不敢设立应设界限。",
      "atom_ids": [
        "s-80f55564356f-c001:a001",
        "s-80f55564356f-c001:a002"
      ]
    },
    {
      "name": "界限提供安全感",
      "definition": "界限给人安全感，因为它让人知道安全的范围在哪里。没有界限的人一定没有安全感，如同没有门的房子不会让人感到安全。安全感主要通过界限获得，但界限不是获得安全感的唯一途径。",
      "atom_ids": [
        "s-80f55564356f-c001:a003",
        "s-80f55564356f-c001:a013",
        "s-80f55564356f-c002:r001"
      ]
    },
    {
      "name": "无界限导致关系破裂",
      "definition": "没有界限的关系如同没有栏杆的公路，最终可能冲入海中。例如朋友之间因不敢设立界限而一直忍耐，最终忍无可忍而断绝关系；朋友合伙做生意因最初没有立好界限而导致散伙反目。",
      "atom_ids": [
        "s-80f55564356f-c001:a004"
      ]
    },
    {
      "name": "界限与个人认知相互促进",
      "definition": "界限给人个人认知，个人认知和界限相互推进：个人认知让一个人更有界限，更有界限时个人认知又更加明确，形成良性循环。缺乏界限观念的人个人认知未建立，容易受到PUA等伤害。",
      "atom_ids": [
        "s-80f55564356f-c001:a005"
      ]
    },
    {
      "name": "界限保护自我价值",
      "definition": "界限帮助人阻止别人对自己有任何暴力（包括冷暴力）和损害自我价值的行为。当人有界限时，能保护自己不被他人贬低和攻击。",
      "atom_ids": [
        "s-80f55564356f-c001:a008"
      ]
    },
    {
      "name": "界限让人感知愉悦和快乐",
      "definition": "人只有在安全的环境中才能感受美好和愉悦。界限提供安全感，使人能够放松和享受生活。在关系中，即使与喜欢的人在一起，如果没有界限，也无法感知真正的愉悦。",
      "atom_ids": [
        "s-80f55564356f-c001:a009"
      ]
    },
    {
      "name": "界限通过教导他人如何对待自己而赋予力量",
      "definition": "界限通过教导别人如何正确对待自己而让自己感到力量。在关系初期，有界限的人就在教对方哪些行为可以接受、哪些不可以。没有界限的人会吸引不良对待。",
      "atom_ids": [
        "s-80f55564356f-c001:a010"
      ]
    },
    {
      "name": "健康界限与过度强硬界限的区别",
      "definition": "有些人外表强硬、刀枪不入，认为界限就是不行就不行，没有商量余地，但这并不是健康界限。健康界限既不太软也不太硬。",
      "atom_ids": [
        "s-80f55564356f-c001:a011"
      ]
    },
    {
      "name": "无界限导致失控与讨好行为",
      "definition": "没有界限会让人感到失控，于是想用各种方法获得控制感。讨好型人格通过讨好别人来控制对方对自己的印象，完美主义也是通过不断追求优秀来控制他人评价。但控制别人是可怕的，最终导致无力感。",
      "atom_ids": [
        "s-80f55564356f-c001:a012"
      ]
    },
    {
      "name": "界限原则一：种什么收什么",
      "definition": "种什么收什么是指让一个人承担自己行为的后果。如果一个人没有界限，他就不会承担自己行为的后果，问题会转移到别人身上。",
      "atom_ids": [
        "s-80f55564356f-c001:a014",
        "s-80f55564356f-c002:a001"
      ]
    },
    {
      "name": "界限原则二：责任",
      "definition": "责任原则是“我对你负责，但我不为你负责”（I'm responsible to you, but not for you）。意思是对他人有责任帮助其成长或建立安全感，但不承担对方因自身原因产生的问题。",
      "atom_ids": [
        "s-80f55564356f-c002:a004",
        "s-80f55564356f-c002:r005"
      ]
    },
    {
      "name": "界限原则三：尊重",
      "definition": "尊重原则是要求他人尊重自己的界限，同时自己也尊重他人的界限。界限不是双重标准，不能对自己一套标准，对别人另一套标准。",
      "atom_ids": [
        "s-80f55564356f-c002:a006",
        "s-80f55564356f-c002:r006"
      ]
    },
    {
      "name": "伤害与受伤的区别",
      "definition": "伤害（harm）是主动词，指主动伤害他人；受伤（hurt）是被动词，指自己感到受伤。立界限时，我们尽量不主动伤害别人，但如果用对的方法、对的目的、对的语言做了对的事情，对方仍然感到受伤，那不是我们的错，而是对方需要处理自己的问题。",
      "atom_ids": [
        "s-80f55564356f-c002:a008",
        "s-80f55564356f-c002:r007",
        "s-80f55564356f-c002:r008"
      ]
    },
    {
      "name": "界限原则五：行动",
      "definition": "行动原则是指立界限必须自己主动采取行动（take initiative），而不是等待别人改变或期待别人有界限意识。自己是行为发起人、选择决定者、立界限和持守界限的贯彻人。",
      "atom_ids": [
        "s-80f55564356f-c002:a009",
        "s-80f55564356f-c002:r009"
      ]
    },
    {
      "name": "界限原则六：沟通",
      "definition": "沟通原则是指立界限前必须事先与对方沟通，说明为什么立界限，目的是让关系更亲近而不是破裂。沟通方式有三种：被动型、攻击型、坚定型。",
      "atom_ids": [
        "s-80f55564356f-c002:a010"
      ]
    },
    {
      "name": "被动型沟通",
      "definition": "被动型沟通是指一个人把他人的感受、需要和想法放在自己之前，哪怕自己付出很高代价。不表达自己的需要，不为自己站出来说话，容易被人占便宜。特点包括说话小声、不敢看人眼睛、允许别人占便宜、不能理直气壮表达需要。这种人可能很优秀但缺乏自信，容易自卑。",
      "atom_ids": [
        "s-80f55564356f-c002:a011",
        "s-80f55564356f-c002:r011"
      ]
    },
    {
      "name": "攻击型沟通",
      "definition": "攻击型沟通的人容易不耐烦、生气，经常使用批评、嘲笑、讽刺或强硬要求。说话声量大，攻击性强，不愿意妥协，经常打断对方，不尊重他人。",
      "atom_ids": [
        "s-80f55564356f-c002:a012"
      ]
    },
    {
      "name": "坚定型沟通（温柔而坚定）",
      "definition": "坚定型沟通关注双方的需要，既在乎自己的需要也在乎对方的需要。能自信表达感受、需要和想法，同时聆听并尊重对方。有真正的自信、健全的自我认知、富有同情心，愿意在自己同意的范围内妥协。表现包括不打断别人、为自己发声、清楚表达需要、自信的语气和身体语言、目光注视对方。",
      "atom_ids": [
        "s-80f55564356f-c002:a013",
        "s-80f55564356f-c002:r012",
        "s-80f55564356f-c002:r013"
      ]
    },
    {
      "name": "界限原则七：关系不同，界限不同",
      "definition": "不同关系有不同的界限。界限是循序渐进的，如果一个人能遵守第一层界限，就可以放松；如果不能遵守，就要设置更紧的界限来保护。",
      "atom_ids": [
        "s-80f55564356f-c002:a016",
        "s-80f55564356f-c002:a018",
        "s-80f55564356f-c002:r015",
        "s-80f55564356f-c003:a001",
        "s-80f55564356f-c003:a002"
      ]
    },
    {
      "name": "界限的层次与关系亲密度",
      "definition": "关系亲密度决定界限层次：快递员、邮递员、不熟邻居只能在前院；好一点的朋友可以进客厅；闺蜜可以在厨房边做饭边聊天；更亲密的可以到楼上卧室聊悄悄话；夫妻最亲密。界限随关系亲密度递增而放宽。",
      "atom_ids": [
        "s-80f55564356f-c002:a017",
        "s-80f55564356f-c003:r001"
      ]
    },
    {
      "name": "根据原则灵活立界限",
      "definition": "由于生活中情况多变，立界限时应回到界限原则，根据具体关系灵活应用，而不是套用固定规则。",
      "atom_ids": [
        "s-80f55564356f-c003:a003"
      ]
    }
  ],
