{
  "concepts": [
    {
      "name": "模仿父母",
      "definition": "孩子通过观察父母行为来学习，而非听从说教，并希望成为父母的样子。",
      "atom_ids": [
        "s-da96650b496a-c001:a001",
        "s-da96650b496a-c001:a002"
      ]
    },
    {
      "name": "代际传递",
      "definition": "父母的行为模式（如不自我照顾、牺牲、缺乏生活美感）会传递给孩子，导致孩子重复相同模式。",
      "atom_ids": [
        "s-da96650b496a-c001:a003",
        "s-da96650b496a-c001:a004",
        "s-da96650b496a-c001:a005",
        "s-da96650b496a-c001:a006",
        "s-da96650b496a-c001:a008",
        "s-da96650b496a-c001:r001"
      ]
    },
    {
      "name": "自我照顾",
      "definition": "用自己的资源来获得所需要的调整休息，与自私（损害他人利益）有本质区别。",
      "atom_ids": [
        "s-da96650b496a-c001:a010"
      ]
    },
    {
      "name": "寻求帮助",
      "definition": "自我照顾的方法之一，主动向他人请求支持，如婚姻辅导、请人帮忙带孩子等。",
      "atom_ids": [
        "s-da96650b496a-c001:a011"
      ]
    },
    {
      "name": "缺乏关注自己的记忆",
      "definition": "大脑中没有关注自己的记忆，导致不愿意关注自己，这是不关注自己的第一个原因。",
      "atom_ids": [
        "s-da96650b496a-c001:a009"
      ]
    },
    {
      "name": "自私与自我照顾的区别",
      "definition": "自私是损害他人利益来达到自己的目的，自我照顾是用自己的资源调整休息，两者有本质区别。",
      "atom_ids": [
        "s-da96650b496a-c001:a010"
      ]
    }
  ],
