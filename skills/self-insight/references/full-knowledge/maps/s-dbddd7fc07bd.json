{
  "concepts": [
    {
      "name": "同理心",
      "definition": "孩子非常重要的能力，通过提问帮助孩子了解其他人的感受。富有同理心的孩子长大后更能平衡和管理自己的情绪，处于情绪健康状态，也更善于处理人际关系矛盾，最终拥有和谐关系。",
      "atom_ids": [
        "s-dbddd7fc07bd-c001:a001"
      ]
    },
    {
      "name": "诠释",
      "definition": "左脑引导的最后一个方法，不是替孩子解释行为背后的原因，而是通过提问帮助他们理解自己行为背后的动机。",
      "atom_ids": [
        "s-dbddd7fc07bd-c001:a002",
        "s-dbddd7fc07bd-c001:r001"
      ]
    },
    {
      "name": "诠释性提问",
      "definition": "通过提问帮助孩子思考行为背后的原因，例如：你觉得为什么刚才你选择抢走弟弟的东西，而不是向他借呢？或者你觉得这一次为什么考试没有考好呢？是因为时间不够吗？还是因为确实题太难了？",
      "atom_ids": [
        "s-dbddd7fc07bd-c001:a003",
        "s-dbddd7fc07bd-c001:r003"
      ]
    },
    {
      "name": "前额叶",
      "definition": "当孩子听到问题时，前额叶（原文为FRONTOBOB，中文翻译额夜，疑为额叶）开始运作，处理大脑各部分吸收的信息，并将处理后的答案或决定通过身体传递出去。",
      "atom_ids": [
        "s-dbddd7fc07bd-c001:a004"
      ]
    },
    {
      "name": "负面批评性问题",
      "definition": "带有负面批评性质的问题，如“你怎么这个考试就考不好呢？你为什么就不能多用点心，多努力一下呢？”，孩子的大脑会开始回答“为什么我不努力？为什么我不用心？”，但由于大脑未发育成熟，无法辩证全面分析，孩子容易得出畸形而错误的答案，并在今后行为中传递出去。",
      "atom_ids": [
        "s-dbddd7fc07bd-c001:a005",
        "s-dbddd7fc07bd-c001:r004"
      ]
    },
    {
      "name": "正面提问",
      "definition": "如“你怎么那么聪明，你的脑子怎么想出那么奇妙的问题”，孩子会寻找“我怎么那么聪明”的答案，结果成绩优异。",
      "atom_ids": [
        "s-dbddd7fc07bd-c001:a007"
      ]
    },
    {
      "name": "父母好奇心",
      "definition": "父母需要有非常强烈的好奇心，才能用诠释的方法引导孩子的左脑。父母往往习惯认为自己非常了解孩子，觉得孩子做什么、为什么做都一清二楚，不需要再问，因此没有习惯向孩子提出类似问题，往往心里已经替他们有了答案。",
      "atom_ids": [
        "s-dbddd7fc07bd-c001:a009",
        "s-dbddd7fc07bd-c001:r002"
      ]
    },
    {
      "name": "左脑锻炼",
      "definition": "孩子的左脑需要通过思考诠释性问题来锻炼，随着年龄增长，他对自己情绪的了解越来越深，相应也越来越能把控情绪所带来的行为。",
      "atom_ids": [
        "s-dbddd7fc07bd-c001:a010"
      ]
    },
    {
      "name": "综合运用",
      "definition": "在爸爸与儿子的对话中，爸爸使用了延伸、同理心和诠释三种方法进行沟通。孩子从最初的“不知道”变成后来开始思考问题出现后的解决办法，以及为什么要用这样的方法来解决。",
      "atom_ids": [
        "s-dbddd7fc07bd-c001:a012"
      ]
    },
    {
      "name": "长期影响",
      "definition": "日复一日、年复一年的对话，会让孩子在心智成熟度、情绪平衡、行为控制上与其他孩子逐渐显出区别。",
      "atom_ids": [
        "s-dbddd7fc07bd-c001:a013"
      ]
    }
  ],
