{
  "concepts": [
    {
      "name": "情绪联结",
      "definition": "家长将自己的情绪调整到和孩子当下的情绪同一频道上，通过进入孩子的情绪世界，与孩子产生情感上深厚的连接，让孩子感到安全、被爱、被了解、被懂得、被听见。",
      "atom_ids": [
        "s-076f3ff5a28e-c001:a001",
        "s-076f3ff5a28e-c001:a002"
      ]
    },
    {
      "name": "情绪联结缺失的后果",
      "definition": "情绪联结缺失导致青少年疏远父母、出现行为和心理问题，父母影响力减低。",
      "atom_ids": [
        "s-076f3ff5a28e-c001:a003",
        "s-076f3ff5a28e-c001:a004"
      ]
    },
    {
      "name": "原生家庭伤害",
      "definition": "成功人士在原生家庭中受到伤害，而父母不知情。",
      "atom_ids": [
        "s-076f3ff5a28e-c001:a006"
      ]
    },
    {
      "name": "父母科学学习",
      "definition": "父母需要科学学习和训练才能正确培养孩子，否则导致孩子焦虑、自杀、网络成瘾、吸毒等行为。",
      "atom_ids": [
        "s-076f3ff5a28e-c001:a007"
      ]
    },
    {
      "name": "情绪联结的隐蔽性",
      "definition": "情绪联结是否正确在孩子小时候看不出来，除非父母有很强认识、了解儿童心理学并经常自我反省，否则只能等到孩子长大后从行为问题上发现。",
      "atom_ids": [
        "s-076f3ff5a28e-c001:r001"
      ]
    }
  ],
