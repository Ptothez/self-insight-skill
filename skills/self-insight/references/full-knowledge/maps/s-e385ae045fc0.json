{
  "concepts": [
    {
      "name": "一次只问一个问题",
      "definition": "提问时不要一次性问一堆问题，而是一次只问一个问题，给孩子发挥空间。",
      "atom_ids": [
        "s-e385ae045fc0-c001:a001",
        "s-e385ae045fc0-c001:a002"
      ]
    },
    {
      "name": "开放式问题",
      "definition": "不能用简短回答（如“是/不是”“好/不好”）的问题，能让孩子自然进入聊天模式。",
      "atom_ids": [
        "s-e385ae045fc0-c001:a003",
        "s-e385ae045fc0-c001:a004"
      ]
    },
    {
      "name": "封闭式问题",
      "definition": "可以用简短回答的问题，限制了孩子的回答。",
      "atom_ids": [
        "s-e385ae045fc0-c001:a004",
        "s-e385ae045fc0-c001:a005"
      ]
    },
    {
      "name": "具体问题",
      "definition": "针对具体情境或情绪的问题，给孩子指明回答方向。",
      "atom_ids": [
        "s-e385ae045fc0-c001:a006",
        "s-e385ae045fc0-c001:a007",
        "s-e385ae045fc0-c001:a010"
      ]
    },
    {
      "name": "概括性问题",
      "definition": "过于宽泛的问题，孩子难以回答，因为孩子大脑组织能力不如成人。",
      "atom_ids": [
        "s-e385ae045fc0-c001:a009",
        "s-e385ae045fc0-c001:a010",
        "s-e385ae045fc0-c001:a011"
      ]
    },
    {
      "name": "建立关系的问题",
      "definition": "以建立亲子关系为目的的问题，特别是关于情绪和感受的问题。",
      "atom_ids": [
        "s-e385ae045fc0-c001:a012",
        "s-e385ae045fc0-c001:a013",
        "s-e385ae045fc0-c001:a015"
      ]
    },
    {
      "name": "鼓励性问题",
      "definition": "让孩子自我肯定、感到被欣赏的问题，例如询问成功的原因。",
      "atom_ids": [
        "s-e385ae045fc0-c001:a016",
        "s-e385ae045fc0-c001:a018",
        "s-e385ae045fc0-c001:a019"
      ]
    },
    {
      "name": "用问题回答问题",
      "definition": "当孩子提问时，父母用反问引导孩子自己思考，而不是直接给答案。",
      "atom_ids": [
        "s-e385ae045fc0-c001:a020",
        "s-e385ae045fc0-c001:a021",
        "s-e385ae045fc0-c001:a022"
      ]
    }
  ],
