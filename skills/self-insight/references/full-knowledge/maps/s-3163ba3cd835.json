{
  "concepts": [
    {
      "name": "专注力的前提条件",
      "definition": "专注力的前提条件被比喻为树的土壤，只有土壤肥沃，专注力这棵树才能长好。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a001"
      ]
    },
    {
      "name": "关键前提条件缺失导致努力前功尽弃",
      "definition": "如果关键的前提条件没有做到，后面做的所有事情都会前功尽弃。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a002"
      ]
    },
    {
      "name": "孩子专注力糟糕的案例",
      "definition": "一对夫妻的孩子专注力非常糟糕，上课不能全神贯注，眼睛盯着老师慢慢分神；做卷子时老师喊停，孩子会慢半拍，低头看老师笑一笑再继续做一阵才停。老师怀疑孩子智力有问题，父母带孩子测智力结果正常。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a003"
      ]
    },
    {
      "name": "17岁以下孩子心理辅导的前提条件",
      "definition": "讲师做孩子心理辅导的习惯：17岁以下的孩子，如果父母希望帮助孩子，父母必须同时接受帮助。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a004"
      ]
    },
    {
      "name": "父母同时接受帮助的原因",
      "definition": "孩子在家浸泡时间长，如果辅导50分钟后回家，父母继续用错误方式育儿，辅导会前功尽弃。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a005"
      ]
    },
    {
      "name": "家庭暴力案例",
      "definition": "孩子小时候，父母经常打架吵架，孩子曾看到爸爸打妈妈、掐妈妈脖子，小女孩跳到爸爸身上打爸爸让他下来；妈妈报过警；最严重一次爸爸拿铁锅扔向妈妈，没扔到妈妈但差点伤到小女孩。孩子都看到并记住了。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a006"
      ]
    },
    {
      "name": "家庭暴力对孩子大脑发育的影响",
      "definition": "讲师了解孩子大脑发育后，判断问题出在家庭暴力环境。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a007"
      ]
    },
    {
      "name": "家庭环境调整后专注力改善案例",
      "definition": "对父母在家庭环境创造方面进行调整，经过约19个月（不到两年），孩子专注力越来越提高，家庭氛围也越来越好。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a008"
      ]
    },
    {
      "name": "专注力的三个前提条件",
      "definition": "专注力的前提条件有三点：家庭条件、父母的婚姻、父母的认知。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a009"
      ]
    },
    {
      "name": "家庭条件的定义",
      "definition": "家庭条件不是经济条件，而是家庭氛围中创造的条件，如颜色、声音、感觉等。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a010"
      ]
    },
    {
      "name": "想象自己成长家庭的画面",
      "definition": "请大家想象自己长大的家庭画面：颜色是明亮还是暗沉？声音是争吵还是寂静？感觉是冰冷还是温暖？",
      "atom_ids": [
        "s-3163ba3cd835-c001:a011"
      ]
    },
    {
      "name": "家庭条件的具体内容",
      "definition": "家庭条件是父母为家庭创造的条件，包括让人感到愉悦、被爱、温暖、被拥抱、被接纳，还是害怕、恐惧、冷冰冰、拒绝。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a012"
      ]
    },
    {
      "name": "父母创造家庭条件的方式",
      "definition": "父母创造家庭条件的方式包括：父母是乐观还是悲观；是否相信外面的人；是否每天讲谁想害自己；是否喜欢尝试新鲜事物；周末是否带孩子到处走走。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a013"
      ]
    },
    {
      "name": "低成本创造家庭条件的例子",
      "definition": "不一定要花费很高，比如带孩子蹲在路边看一朵野花，也是为家庭创造条件。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a014"
      ]
    },
    {
      "name": "家庭条件对专注力的影响",
      "definition": "在温暖、被接纳、喜悦的家庭中，孩子需要专注时比长期处在恐怖、父母打架、被打的孩子专注力更好，因为心里没有恐惧时更能发挥优秀。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a015"
      ]
    },
    {
      "name": "父母婚姻的定义",
      "definition": "父母的婚姻包括：是否经常吵架、是否爱对方、是否用讽刺嘲讽的话、是否在孩子面前讲对方不好、是否一起哈哈大笑、是否有亲密小动作、上街是否牵手还是各走各的。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a016"
      ]
    },
    {
      "name": "父母相爱对孩子大脑的刺激",
      "definition": "孩子从零岁开始看见父母相爱，大脑会受到刺激，视觉带入信息，大脑释放荷尔蒙，让孩子得到极大快感。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a017"
      ]
    },
    {
      "name": "突触连接与协调能力",
      "definition": "大脑中有很多连接点叫突触，经历幸福喜悦时突触会大量增加，协调能力快速连接，眼睛看到东西后大脑发出指令手去拿。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a018"
      ]
    },
    {
      "name": "突触连接好对专注力的影响",
      "definition": "突触连接好，大脑发育更好，孩子更能在需要专注时专注下来。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a019"
      ]
    },
    {
      "name": "父母认知的定义",
      "definition": "父母的认知不是指学历，而是育儿认知，包括是否懂儿童科学、是否知道如何正确教育孩子。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a020"
      ]
    },
    {
      "name": "术业有专攻",
      "definition": "在一个领域研究很深是专家，不代表在另一个领域也是专家，育儿认知需要专门学习。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a021"
      ]
    },
    {
      "name": "父母育儿认知低下的表现",
      "definition": "很多父母不愿意承认自己不懂育儿，不知道自己在儿童心理科学领域有漏洞和空白，不知道孩子几岁需要如何沟通，不知道如何赋能孩子。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a022"
      ]
    },
    {
      "name": "高学历父母育儿失败的案例",
      "definition": "讲师见过很多高学历父母（教授、总裁、博士）的孩子自杀或伤害自己，父母很惊讶。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a023"
      ]
    },
    {
      "name": "提升父母育儿认知的方法",
      "definition": "父母要有正确认知，知道如何正确管教孩子、如何赋能、如何创造更好的家庭条件来帮助孩子成功和专注。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a024"
      ]
    },
    {
      "name": "课后作业：自我反省三个改进点",
      "definition": "从三个前提条件（家庭条件、父母婚姻、父母认知）中自我反省，列出三个需要改进的地方，并想到改进方法。",
      "atom_ids": [
        "s-3163ba3cd835-c001:a025"
      ]
    },
    {
      "name": "家庭暴力对专注力的影响机制",
      "definition": "长期处在恐怖、父母打架、被打环境中的孩子，在需要专注时专注力较差；而感觉愉悦、没有恐惧的孩子更能发挥优秀。",
      "atom_ids": [
        "s-3163ba3cd835-c001:r001"
      ]
    }
  ],
