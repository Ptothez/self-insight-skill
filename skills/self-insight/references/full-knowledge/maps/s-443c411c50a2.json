{
  "concepts": [
    {
      "name": "HD（多动/冲动）",
      "definition": "ADHD 中的多动/冲动部分，表现为持续地动和冲动性行为。",
      "atom_ids": [
        "s-443c411c50a2-c001:a001"
      ]
    },
    {
      "name": "HD 与普通好动的区别",
      "definition": "HD 孩子的多动带有强迫性和冲动性，无法控制，不做不行；普通孩子的好动是出于好奇和贪玩，可以自我调节。",
      "atom_ids": [
        "s-443c411c50a2-c001:a002",
        "s-443c411c50a2-c001:a010",
        "s-443c411c50a2-c001:r001",
        "s-443c411c50a2-c001:r002"
      ]
    },
    {
      "name": "HD 行为表征",
      "definition": "包括坐立不安、要求坐着时站起来、不合适环境奔跑攀爬、停不下来带强迫性等。",
      "atom_ids": [
        "s-443c411c50a2-c001:a003",
        "s-443c411c50a2-c001:a007",
        "s-443c411c50a2-c001:a008",
        "s-443c411c50a2-c001:a010",
        "s-443c411c50a2-c001:r002"
      ]
    },
    {
      "name": "HD 语言表征",
      "definition": "包括说话快且跳跃、打断别人说话、抢答问题等。",
      "atom_ids": [
        "s-443c411c50a2-c001:a012",
        "s-443c411c50a2-c001:a014",
        "s-443c411c50a2-c001:a015"
      ]
    },
    {
      "name": "ADHD 诊断条件",
      "definition": "症状在12岁前出现、出现在两个以上环境、严重影响社交生活学习或工作、排除其他精神或身体原因。",
      "atom_ids": [
        "s-443c411c50a2-c001:a016",
        "s-443c411c50a2-c001:a017",
        "s-443c411c50a2-c001:a018",
        "s-443c411c50a2-c001:a019"
      ]
    },
    {
      "name": "判断孩子是否有多动症的方法",
      "definition": "根据 HD 的行为表征和 ADHD 诊断条件来判断。",
      "atom_ids": [
        "s-443c411c50a2-c001:a020"
      ]
    },
    {
      "name": "不要随意贴多动症标签",
      "definition": "标签会给孩子带来心理压力，即使孩子调皮也不应贴标签。",
      "atom_ids": [
        "s-443c411c50a2-c001:a022"
      ]
    },
    {
      "name": "精力旺盛孩子的成长优势",
      "definition": "精力旺盛的孩子在接纳和鼓励下长大，会有更充沛的精力，对学习和事业带来祝福。",
      "atom_ids": [
        "s-443c411c50a2-c001:a023"
      ]
    }
  ],
