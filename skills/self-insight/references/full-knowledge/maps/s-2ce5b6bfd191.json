  "tensions": [],
  "path": [
    {
      "name": "道歉的七个步骤",
      "steps": [
        {
          "action": "表达父母的情绪",
          "atom_ids": [
            "s-2ce5b6bfd191-c001:a002"
          ],
          "condition": "道歉开始时，先表达自己的情绪，如羞愧、伤心、后悔"
        },
        {
          "action": "陈述行为",
          "atom_ids": [
            "s-2ce5b6bfd191-c001:a004",
            "s-2ce5b6bfd191-c001:a005",
            "s-2ce5b6bfd191-c001:a006"
          ],
          "condition": "具体描述对孩子做了什么，不添加评价，并询问孩子是否全面，不纠正孩子的说法"
        },
        {
          "action": "描述孩子的感受",
          "atom_ids": [
            "s-2ce5b6bfd191-c001:a007",
            "s-2ce5b6bfd191-c001:a008",
            "s-2ce5b6bfd191-c001:a009",
            "s-2ce5b6bfd191-c001:a010"
          ],
          "condition": "指认孩子的感受，即使孩子说不出也要指认"
        },
        {
          "action": "指认孩子的伤害",
          "atom_ids": [
            "s-2ce5b6bfd191-c001:a011",
            "s-2ce5b6bfd191-c001:a012"
          ],
          "condition": "指出行为伤害了孩子的信任、安全感等"
        },
        {
          "action": "请求孩子原谅",
          "atom_ids": [
            "s-2ce5b6bfd191-c001:a013",
            "s-2ce5b6bfd191-c001:a014",
            "s-2ce5b6bfd191-c001:a015",
            "s-2ce5b6bfd191-c001:a016",
            "s-2ce5b6bfd191-c001:a017",
            "s-2ce5b6bfd191-c001:a018"
          ],
          "condition": "真诚希望原谅但允许孩子选择不原谅，不强迫立即原谅"
        },
        {
          "action": "预期未来",
          "atom_ids": [
            "s-2ce5b6bfd191-c001:a019",
            "s-2ce5b6bfd191-c001:a020",
            "s-2ce5b6bfd191-c001:a021",
            "s-2ce5b6bfd191-c001:a022"
          ],
          "condition": "说明以后会怎么做，承诺必须可行，并给出具体改变计划"
        },
        {
          "action": "和好的仪式",
          "atom_ids": [
            "s-2ce5b6bfd191-c001:a023",
            "s-2ce5b6bfd191-c001:a024"
          ],
          "condition": "通过拥抱、亲吻等仪式让事情画上句号"
        }
      ]
    }
  ],
