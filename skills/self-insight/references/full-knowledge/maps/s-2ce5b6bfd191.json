{
  "concepts": [
    {
      "name": "道歉的七个步骤",
      "definition": "承认错误有七个步骤，必须按照顺序进行，缺一不可。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a001"
      ]
    },
    {
      "name": "第一步：表达父母的情绪",
      "definition": "道歉的第一步是表达父母的情绪，如羞愧、伤心、后悔，并说明鼓起勇气来道歉。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a002"
      ]
    },
    {
      "name": "情绪先开路",
      "definition": "讲任何事情一定要情绪先开路，情绪没到，什么事情都不会做。广告先铺垫情绪再推出产品，道歉也应先连接情绪。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a003"
      ]
    },
    {
      "name": "第二步：陈述行为",
      "definition": "道歉的第二步是陈述行为，具体描述父母对孩子做了什么，如打骂、冤枉等，不添加评价。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a004"
      ]
    },
    {
      "name": "陈述行为后询问孩子是否全面",
      "definition": "陈述行为后要问孩子“妈妈讲的全面吗？你觉得我漏掉了什么吗？”，给孩子机会说话。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a005"
      ]
    },
    {
      "name": "不要纠正孩子的感受",
      "definition": "如果孩子说父母说了某句话而父母认为没说，不要纠正，因为无法证明，要让孩子说话。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a006"
      ]
    },
    {
      "name": "第三步：描述孩子的感受",
      "definition": "道歉的第三步是描述孩子的感受，因为孩子（包括青少年）可能无法完全明白和理解自己的感受，需要父母指认。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a007"
      ]
    },
    {
      "name": "指认感受让孩子知道父母懂他",
      "definition": "指认孩子的感受能让孩子知道父母了解如何伤害了他，孩子会感到舒服，就像成人被理解一样。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a008"
      ]
    },
    {
      "name": "指认孩子感受的具体表达",
      "definition": "指认感受时可以说“你一定觉得对我非常的失望”“你一定很难过”“你当时一定很害怕吧”，并询问孩子感受。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a009"
      ]
    },
    {
      "name": "即使孩子说不出感受也要指认",
      "definition": "即使孩子无法指认自己的感受，父母也一定要指认出他的感受。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a010"
      ]
    },
    {
      "name": "第四步：指认孩子的伤害",
      "definition": "道歉的第四步是指认孩子的伤害，感受与伤害不同，要指出行为伤害了孩子的信任、安全感等。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a011"
      ]
    },
    {
      "name": "指认伤害的示例",
      "definition": "例如说“我这样做伤害了你对我的信任”“我这样做伤害了你的安全感”“让你觉得自己孤零无助”。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a012"
      ]
    },
    {
      "name": "第五步：请求孩子原谅",
      "definition": "道歉的第五步是请求孩子原谅，要真诚希望原谅但允许孩子选择不原谅，不强迫立即原谅。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a013"
      ]
    },
    {
      "name": "请求原谅与强迫原谅的区别",
      "definition": "“请你原谅我”是强迫原谅，真正的请求原谅是“我衷心希望你可以原谅我，但你可以选择不原谅我”。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a014"
      ]
    },
    {
      "name": "允许不原谅让孩子有权利感受情绪",
      "definition": "允许孩子不原谅，让孩子知道他有权利充分感受自己的情绪，而不需要被道德绑架。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a015"
      ]
    },
    {
      "name": "道歉后不一定要立即原谅",
      "definition": "很多人条件反射说“没事”，但伤害是真实的，孩子可以暂时不原谅。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a016"
      ]
    },
    {
      "name": "孩子拒绝立即原谅的案例",
      "definition": "讲师的孩子有时会说“我现在不想跟你说话，我很生气，我想自己安静一下”，讲师会退出；或孩子设五分钟闹钟后再决定是否原谅。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a017"
      ]
    },
    {
      "name": "允许不原谅让孩子从被动变主动",
      "definition": "允许孩子不原谅，孩子在道歉环节中就是主动的，不再是被动的；如果不给不原谅的机会，孩子一直处于被动状态。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a018"
      ]
    },
    {
      "name": "第六步：预期未来",
      "definition": "道歉的第六步是预期未来，说明父母以后会怎么做，但承诺必须可行、做得到。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a019"
      ]
    },
    {
      "name": "预期未来必须可行",
      "definition": "预期未来一定要做得到，不要说“以后绝对不再打你”等无法保证的话；如果做不到，孩子会愤怒，觉得父母是骗子。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a020"
      ]
    },
    {
      "name": "预期未来的具体表达",
      "definition": "可以说“妈妈以后会特别小心我的这种行为”“妈妈以后会尽量努力改正，虽然可能还会犯错，但会再道歉”，并说明具体改变计划，如学习课程、咬住舌头等。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a021"
      ]
    },
    {
      "name": "告诉孩子具体改变计划的原因",
      "definition": "就像孩子考不好不能只说“下次考好”，而要说明如何做到，父母也要告诉孩子具体改变计划。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a022"
      ]
    },
    {
      "name": "第七步：和好的仪式",
      "definition": "道歉的第七步是和好的仪式，如拥抱、亲吻、拉勾、击掌等，让事情画上句号。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a023"
      ]
    },
    {
      "name": "讲师与孩子的和好仪式",
      "definition": "讲师与孩子和好时会拥抱、亲吻，讲师还会祷告，认错自己没有行使好做父母的权利，孩子会看到这个仪式。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a024"
      ]
    },
    {
      "name": "道歉步骤需要练习",
      "definition": "道歉步骤听起来简单但做起来难，需要不断练习，建立肌肉记忆，才会越来越自然。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a025"
      ]
    },
    {
      "name": "道歉前先写下来并演练",
      "definition": "建议先写下每一步要怎么说，演练两次，再去找孩子认错；可以拿着纸让孩子知道父母在认真学习。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a026"
      ]
    },
    {
      "name": "孩子打断道歉时的应对",
      "definition": "如果孩子说“没事算了”，父母应说“让妈妈练习一下”，继续完成七步，不要停止。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a027",
        "s-2ce5b6bfd191-c001:r002"
      ]
    },
    {
      "name": "找不到该认错的地方是问题",
      "definition": "父母一定有很多应该给孩子认错的地方，如果找不到，是非常大的问题。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:a028"
      ]
    },
    {
      "name": "道歉步骤顺序必须背下来",
      "definition": "道歉的七个步骤顺序必须背下来，就像孩子背单词一样。",
      "atom_ids": [
        "s-2ce5b6bfd191-c001:r001"
      ]
    }
  ],
