  "path": [
    {
      "name": "排除管教障碍的步骤",
      "steps": [
        {
          "action": "学习管教知识，获得底气",
          "atom_ids": [
            "s-e3d3031f10c2-c001:a003",
            "s-e3d3031f10c2-c001:a004"
          ],
          "condition": "适用于所有家长"
        },
        {
          "action": "识别管教障碍（如教育观不一致、婚姻问题、依赖父母等）",
          "atom_ids": [
