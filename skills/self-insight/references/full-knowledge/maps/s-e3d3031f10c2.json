            "s-e3d3031f10c2-c001:a013",
            "s-e3d3031f10c2-c001:a015"
          ],
          "condition": "根据家庭具体情况"
        },
        {
          "action": "尝试说服家人配合（包括邀请一起学习、借助专业老师）",
          "atom_ids": [
            "s-e3d3031f10c2-c001:a008",
