{
  "concepts": [
    {
      "name": "管教障碍：不知道正确做法",
      "definition": "家长缺乏正确管教的记忆或模式，只知道错误做法，导致被动不敢管教。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a001"
      ]
    },
    {
      "name": "家长因愤怒不敢管教",
      "definition": "家长因极度愤怒怕说出伤害孩子的话而后悔，选择不行动。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a002"
      ]
    },
    {
      "name": "学习带来满足和底气",
      "definition": "学习虽枯燥但带来真正满足和底气，优于短暂娱乐。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a003",
        "s-e3d3031f10c2-c001:a004"
      ]
    },
    {
      "name": "教育观不一致",
      "definition": "配偶或长辈教育观不一致导致管教矛盾。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a005"
      ]
    },
    {
      "name": "谁学习谁说了算",
      "definition": "管教原则：谁学习管教知识谁有决定权，不学习者不得干涉。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a006",
        "s-e3d3031f10c2-c001:a012"
      ]
    },
    {
      "name": "值得吵的架",
      "definition": "当配偶不学习却干涉育儿时，这种架值得吵，以维护界限。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a007"
      ]
    },
    {
      "name": "全家一起学习",
      "definition": "邀请配偶或长辈一起听课，若不听则育儿由学习者决定。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a008"
      ]
    },
    {
      "name": "借助专业老师说服家人",
      "definition": "利用专业老师背景说服家人接受管教方法。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a010",
        "s-e3d3031f10c2-c001:r001"
      ]
    },
    {
      "name": "老一代育儿观念",
      "definition": "老一代认为不学习也能养大孩子，需智慧立界限。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a011"
      ]
    },
    {
      "name": "婚姻不和谐导致反对",
      "definition": "婚姻不和谐可能导致配偶反对管教，需解决婚姻问题。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a013",
        "s-e3d3031f10c2-c001:a014"
      ]
    },
    {
      "name": "父母帮忙带孩子的困境",
      "definition": "依赖祖辈带孩子导致难以立界限，需付出代价独立。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a015",
        "s-e3d3031f10c2-c001:a016",
        "s-e3d3031f10c2-c001:a018"
      ]
    },
    {
      "name": "父母尊重时的理想状态",
      "definition": "父母尊重子女时，可告知学习内容并共同执行。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a017"
      ]
    },
    {
      "name": "挪走障碍需要付出代价",
      "definition": "排除管教障碍需付出代价，如吵架、请父母走等。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a019"
      ]
    },
    {
      "name": "尽量说服家人配合",
      "definition": "先说服家人配合，若不行则立界限排除障碍。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a020"
      ]
    },
    {
      "name": "孩子扇母亲耳光案例",
      "definition": "孩子不尊重母亲源于外婆强势，母亲依赖外婆不敢立界限。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a021",
        "s-e3d3031f10c2-c001:a022"
      ]
    },
    {
      "name": "建议父母搬出去住",
      "definition": "通过物理界限让父母搬出，恢复孩子对母亲的尊重。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a023",
        "s-e3d3031f10c2-c001:a024",
        "s-e3d3031f10c2-c001:a025"
      ]
    },
    {
      "name": "不抓狂的管教",
      "definition": "有底气地面对育儿，不追求绝对不抓狂。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a026"
      ]
    },
    {
      "name": "下一课程：不上瘾的孩子",
      "definition": "预防孩子电子产品上瘾。",
      "atom_ids": [
        "s-e3d3031f10c2-c001:a027"
      ]
    }
  ],
