{
  "concepts": [
    {
      "name": "关注自己的喜好",
      "definition": "了解自己在某个领域喜欢的具体事物，如大提琴、法语、架子鼓，而非泛泛的逛街、睡觉或陪孩子玩。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a001",
        "s-8eed2d3f98b8-c001:a004"
      ]
    },
    {
      "name": "忽略自我喜好的后果",
      "definition": "父母忽略自己的喜好后，除了陪孩子玩就不知道该玩什么，导致生活单调。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a002"
      ]
    },
    {
      "name": "讲师的喜好举例",
      "definition": "讲师喜欢大提琴（听曲子、搜集专辑）和法语（想学法语）。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a003"
      ]
    },
    {
      "name": "关注自己的需要",
      "definition": "包括生理需要、情绪需要和心理需要三个层面。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a005"
      ]
    },
    {
      "name": "生理需要",
      "definition": "基本的身体需求，如睡眠，需要照顾自己的生理健康。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a006"
      ]
    },
    {
      "name": "情绪需要",
      "definition": "了解自己的愤怒、悲伤等情绪，不压抑情绪，并确保情绪有表达途径且被允许表达。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a007"
      ]
    },
    {
      "name": "心理需要",
      "definition": "关注自己的抑郁、焦虑状态，判断是否需要心理辅导或与朋友交谈，并评估对自己的满意度和成就感。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a008"
      ]
    },
    {
      "name": "忽略需要的后果",
      "definition": "长期忽略某种需要，会在该领域出现问题。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a009"
      ]
    },
    {
      "name": "自我满足感提问",
      "definition": "问自己：我想要做的事情我有做吗？我每天在家带孩子，我感到满足吗？",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a010"
      ]
    },
    {
      "name": "耶鲁教授辞职做全职妈妈",
      "definition": "一位即将成为某高校终身教授的女性因怀孕辞职，从六岁起梦想就是当妈妈，现已生育六个孩子，感到开心满足。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a011"
      ]
    },
    {
      "name": "全职妈妈的价值判断",
      "definition": "全职妈妈只要心里满足就是好的，不一定要做女强人才有价值。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a012"
      ]
    },
    {
      "name": "成就感提问",
      "definition": "问自己：你现在在做的事情，是让你有成就感的吗？让你感到满足的吗？",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a013"
      ]
    },
    {
      "name": "关注自己需要与关注孩子的区别",
      "definition": "关注自己的需要不是指通过孩子的健康或成就来获得满足，而是关注自身的需要。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a014"
      ]
    },
    {
      "name": "关注自己的成长",
      "definition": "关注自己是否有进步，包括工作职位、经验等方面的提升，以及其他个人发展。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a015"
      ]
    },
    {
      "name": "成长的身高比喻",
      "definition": "用给孩子量身高比喻关注自己的成长，但这里的“身高”指个人进步，需要定期问自己“我最近有在长吗？”。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a016"
      ]
    },
    {
      "name": "讲师考取执照的成长案例",
      "definition": "讲师在怀孕到生完第一个孩子的前一年，拼尽全力考取了三个非常难拿的执照，虽然辛苦但感到满足，因为自己在成长。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a017"
      ]
    },
    {
      "name": "成长动机的区分",
      "definition": "成长应是为了自己，而不是为了孩子或功利目的。例如考取执照不是为了给孩子做榜样，而是为了自己成长。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a018"
      ]
    },
    {
      "name": "讲师当前成长活动",
      "definition": "讲师现在学大提琴、法语，并搜集前沿心理学知识，这些都是为了自我成长。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a019"
      ]
    },
    {
      "name": "成长动机的判断问题",
      "definition": "判断成长动机：如果做了这件事没有任何好处（不加薪、不升职、对孩子无益），但能提升自己，你还会去做吗？如果会，就是关注自我成长。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a020"
      ]
    },
    {
      "name": "功利性成长与自我成长的区别",
      "definition": "功利性成长是为了孩子或外在利益，如为了孩子更好的教育；自我成长是为了自己变得更好，即使孩子已得到最好，仍想提升自己。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a021"
      ]
    },
    {
      "name": "关注自己的感受",
      "definition": "经常问自己“这件事情让我感受如何？”，例如为什么感到孤独、疲倦等。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a022"
      ]
    },
    {
      "name": "感受与情绪的区别",
      "definition": "情绪是感受的反应。例如感受到孤独，情绪是伤心；感受到不被尊重，情绪是愤怒。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a023"
      ]
    },
    {
      "name": "感受与情绪的例子",
      "definition": "与丈夫整天说话但没有一句关心自己，感受到伤心难过，觉得丈夫很久没关心自己。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a024"
      ]
    },
    {
      "name": "关注自己的婚姻",
      "definition": "关注自己的婚姻是优秀父母的重要习惯，婚姻习惯糟糕会影响成为优秀父母，将在下一课详细讲解。",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:a025"
      ]
    },
    {
      "name": "自我成长提问",
      "definition": "需要定期问自己：我最近有在成长吗？",
      "atom_ids": [
        "s-8eed2d3f98b8-c001:r001"
      ]
    }
  ],
