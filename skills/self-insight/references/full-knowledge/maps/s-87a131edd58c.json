{
  "concepts": [
    {
      "name": "原生家庭复刻模式",
      "definition": "孩子出生后，父母进入原生家庭的家庭复刻模式或育儿复刻模式，原生家庭与现在的家庭在一定程度上重叠。",
      "atom_ids": [
        "s-87a131edd58c-c001:a001",
        "s-87a131edd58c-c001:r001"
      ]
    },
    {
      "name": "原生家庭影响的表现",
      "definition": "如果一个人在自己家和在父母家表现不同，说明仍被原生家庭影响，且影响力大，现在的家庭一定有重叠。",
      "atom_ids": [
        "s-87a131edd58c-c001:a002"
      ]
    },
    {
      "name": "父母在孩子身上看到小时候的自己",
      "definition": "父母有时发脾气的样子很像自己的父母，或者看着孩子的眼神像当年自己看父母的眼神，或者看配偶不顺眼因为配偶像自己的父亲或母亲，这些现象表明在现在的家庭中时常会看到小时候自己的样子。",
      "atom_ids": [
        "s-87a131edd58c-c001:a003"
      ]
    },
    {
      "name": "孩子情绪引发不安全感",
      "definition": "如果小时候的情绪被接纳，看到孩子情绪时会感到安全；如果小时候的情绪未被接纳，当孩子发脾气时，心底深处的伤害记忆被搅动，导致父母对孩子发脾气或内心愤怒。",
      "atom_ids": [
        "s-87a131edd58c-c001:a004",
        "s-87a131edd58c-c001:r002"
      ]
    },
    {
      "name": "失控感源于重新经历家庭",
      "definition": "孩子让父母重新经历家庭，潜意识里想重新来过，小时候被伤害时没有力量控制局面，现在有了同样小的孩子，要严格控制确保伤害不再发生。",
      "atom_ids": [
        "s-87a131edd58c-c001:a005"
      ]
    },
    {
      "name": "性侵创伤导致过度保护",
      "definition": "一个案例：小时候因父母疏忽，被邻居家叔叔性侵，有了孩子后会特别注意不让孩子到邻居家去。",
      "atom_ids": [
        "s-87a131edd58c-c001:a006"
      ]
    },
    {
      "name": "孩子长大导致控制失效引发焦虑",
      "definition": "随着孩子年龄增长，尤其在发脾气时越来越难控制和安抚，父母无法保持想要的掌控感，容易焦虑、烦躁、崩溃、生气。",
      "atom_ids": [
        "s-87a131edd58c-c001:a007"
      ]
    },
    {
      "name": "团体辅导中焦虑与原生家庭伤害的关联",
      "definition": "讲师做团体辅导发现，所有客人的孩子带来的焦虑点都源于从父母那边受到的伤害，没有一个例外。",
      "atom_ids": [
        "s-87a131edd58c-c001:a008",
        "s-87a131edd58c-c001:r003"
      ]
    },
    {
      "name": "害怕孩子不信任自己的案例",
      "definition": "一个客人特别不能接受孩子不信任他，很害怕孩子更喜欢奶奶，每天焦虑。最后发现他自己从未在父母那里得到过信任。",
      "atom_ids": [
        "s-87a131edd58c-c001:a009"
      ]
    },
    {
      "name": "过度控制孩子的案例",
      "definition": "一个家长从小被父母控制得非常厉害，现在对孩子连喝水多少、穿什么颜色的袜子都要管，一旦孩子没听就暴怒、崩溃。",
      "atom_ids": [
        "s-87a131edd58c-c001:a010"
      ]
    },
    {
      "name": "潜意识驱动讲道理行为",
      "definition": "为了平息被搅动的不安全感、看到小时候的自己、重新经历伤害和失控等潜意识内容，父母会轻车熟路地讲道理，希望孩子讲道理。",
      "atom_ids": [
        "s-87a131edd58c-c001:a011"
      ]
    },
    {
      "name": "人寻求逻辑关系的倾向",
      "definition": "人作为有逻辑思维的生物，总是寻找逻辑关系，事情要有原因、有理可循。",
      "atom_ids": [
        "s-87a131edd58c-c001:a012"
      ]
    },
    {
      "name": "孩子用讲道理保护自己的案例",
      "definition": "一个小孩从小父母很忙没时间陪他，多次哀求陪伴未果，慢慢开始给自己讲道理：不是父母不陪我，是我根本不想他们陪我。于是对父母表现出冷淡，拒绝亲近行为。",
      "atom_ids": [
        "s-87a131edd58c-c001:a013",
        "s-87a131edd58c-c001:r005"
      ]
    },
    {
      "name": "电视剧《小欢喜》片段分析",
      "definition": "电视剧《小欢喜》中，父母从小很忙，孩子跟着舅舅长大。父母回来后孩子表现出极度反感和排斥。从心理学分析，是因为孩子小时候用讲道理保护自己。",
      "atom_ids": [
        "s-87a131edd58c-c001:a014"
      ]
    }
  ],
