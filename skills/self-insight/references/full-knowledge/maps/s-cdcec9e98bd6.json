{
  "concepts": [
    {
      "name": "认知三角",
      "definition": "想法、情绪、行为三者相互影响的关系，事实不可控且不变，而想法、情绪、行为可变。",
      "atom_ids": [
        "s-cdcec9e98bd6-c001:a001",
        "s-cdcec9e98bd6-c001:a007"
      ]
    },
    {
      "name": "情绪影响行为",
      "definition": "情绪严重影响行为，基本上最后做不做一件事情都是情绪决定的。",
      "atom_ids": [
        "s-cdcec9e98bd6-c001:a003",
        "s-cdcec9e98bd6-c001:a004",
        "s-cdcec9e98bd6-c001:a005"
      ]
    },
    {
      "name": "想法影响情绪",
      "definition": "情绪被想法（认知）影响，如何看待事情影响情绪。",
      "atom_ids": [
        "s-cdcec9e98bd6-c001:a006"
      ]
    },
    {
      "name": "恶性循环",
      "definition": "想法、情绪、行为相互影响形成的负面循环。",
      "atom_ids": [
        "s-cdcec9e98bd6-c001:a008",
        "s-cdcec9e98bd6-c001:a009",
        "s-cdcec9e98bd6-c001:a011"
      ]
    },
    {
      "name": "情绪是信念的反射",
      "definition": "情绪是对信念（belief）的反射，不解决根源只控制行为是治标不治本。",
      "atom_ids": [
        "s-cdcec9e98bd6-c001:a010"
      ]
    },
    {
      "name": "改变恶性循环的切入点",
      "definition": "在想法、情绪、行为三个点中，想法是最容易改变恶性循环的切入点。",
      "atom_ids": [
        "s-cdcec9e98bd6-c001:a012",
        "s-cdcec9e98bd6-c001:r001"
      ]
    },
    {
      "name": "改变想法练习",
      "definition": "通过识别原想法、提出替代想法、评估新想法对情绪和行为的影响来改变认知。",
      "atom_ids": [
        "s-cdcec9e98bd6-c001:a014",
        "s-cdcec9e98bd6-c001:r002"
      ]
    },
    {
      "name": "认知改变影响情绪和行为",
      "definition": "改变对事情的认知（想法）会改变情绪和行为。",
      "atom_ids": [
        "s-cdcec9e98bd6-c002:a001"
      ]
    },
    {
      "name": "通过发言促进认知加工",
      "definition": "在课堂上多发言（包括打字发言）可以促进大脑对事情的认知加工，使认知更加通透和透彻。",
      "atom_ids": [
        "s-cdcec9e98bd6-c002:a002"
      ]
    },
    {
      "name": "非黑即白思维",
      "definition": "一种畸形的思维方式，指看待事情只有两个极端，没有中间地带。",
      "atom_ids": [
        "s-cdcec9e98bd6-c002:a003"
      ]
    },
    {
      "name": "心理过滤",
      "definition": "一种畸形的思维方式，指只看到某一种类型的现象，忽略其他信息。",
      "atom_ids": [
        "s-cdcec9e98bd6-c002:a004"
      ]
    },
    {
      "name": "应该/必须思维",
      "definition": "一种畸形的思维方式，指经常对自己或他人使用“我应该……”“我必须……”的表述，导致负罪感或焦虑。",
      "atom_ids": [
        "s-cdcec9e98bd6-c002:a005"
      ]
    },
    {
      "name": "否定正面",
      "definition": "一种畸形的思维方式，指不承认自己的优点或正面特质，认为它们不算数，而只关注缺点。",
      "atom_ids": [
        "s-cdcec9e98bd6-c002:a006",
        "s-cdcec9e98bd6-c002:a007"
      ]
    },
    {
      "name": "情绪化推理",
      "definition": "一种畸形的思维方式，指将自己的情绪当作事实。",
      "atom_ids": [
        "s-cdcec9e98bd6-c002:a008",
        "s-cdcec9e98bd6-c002:a009"
      ]
    },
    {
      "name": "过度概括",
      "definition": "一种畸形的思维方式，指从单一事件推广到所有情况，使用“从来”“总是”“每次”等绝对化词语。",
      "atom_ids": [
        "s-cdcec9e98bd6-c002:a010",
        "s-cdcec9e98bd6-c002:a011"
      ]
    },
    {
      "name": "妄下结论",
      "definition": "一种畸形的思维方式，指在没有充分事实依据的情况下做出结论，包括读心和预测未来。",
      "atom_ids": [
        "s-cdcec9e98bd6-c002:a012"
      ]
    },
    {
      "name": "读心",
      "definition": "妄下结论的一种形式，指在没有证据的情况下认为自己知道别人在想什么。",
      "atom_ids": [
        "s-cdcec9e98bd6-c002:a013",
        "s-cdcec9e98bd6-c003:a001"
      ]
    },
    {
      "name": "预测未来",
      "definition": "妄下结论的一种形式，指在没有依据的情况下预测将来会发生不好的事情。",
      "atom_ids": [
        "s-cdcec9e98bd6-c002:a014",
        "s-cdcec9e98bd6-c003:a002"
      ]
    },
    {
      "name": "责任归因偏差",
      "definition": "一种不健康的思维方式，表现为要么把错误全部归咎于自己，要么把错误全部归咎于他人。",
      "atom_ids": [
        "s-cdcec9e98bd6-c003:a003"
      ]
    },
    {
      "name": "贴标签",
      "definition": "一种不健康的思维方式，指用片面的负面评价来定义自己。",
      "atom_ids": [
        "s-cdcec9e98bd6-c003:a004"
      ]
    },
    {
      "name": "夸大或缩小",
      "definition": "一种不健康的思维方式，指对事情的重要性进行不合理的放大或缩小。",
      "atom_ids": [
        "s-cdcec9e98bd6-c003:a005"
      ]
    },
    {
      "name": "十种不健康思维方式",
      "definition": "包括读心、预测未来、责任归因偏差、贴标签、夸大或缩小等，80%以上的同学可能全部具备，至少占其中五种。",
      "atom_ids": [
        "s-cdcec9e98bd6-c003:a006",
        "s-cdcec9e98bd6-c003:a016"
      ]
    },
    {
      "name": "识别并挑战不健康思维方式",
      "definition": "当产生一个想法时，验证它是否属于十种不健康思维方式之一，如果是则挑战该想法，进行逆向思考。",
      "atom_ids": [
        "s-cdcec9e98bd6-c003:a007"
      ]
    },
    {
      "name": "像对朋友说话一样对自己说话",
      "definition": "当感到焦虑时，想象如果朋友遇到同样的情况，自己会对朋友说什么，然后用同样的话对自己说。",
      "atom_ids": [
        "s-cdcec9e98bd6-c003:a008"
      ]
    },
    {
      "name": "场景练习：改变认知以改变情绪和行为",
      "definition": "通过具体场景练习，运用改变认知的方法来改变情绪和行为。",
      "atom_ids": [
        "s-cdcec9e98bd6-c003:a009"
      ]
    },
    {
      "name": "持续练习的重要性",
      "definition": "学习情绪管理方法后，必须不断练习，才能有效管理焦虑情绪。",
      "atom_ids": [
        "s-cdcec9e98bd6-c003:a010"
      ]
    },
    {
      "name": "对自己说话与对朋友说话的差异",
      "definition": "人们往往对自己说话时负面、苛刻，而对朋友说话时积极、鼓励、宽容。",
      "atom_ids": [
        "s-cdcec9e98bd6-c003:a014"
      ]
    },
    {
      "name": "认知影响情绪和行为的机制",
      "definition": "认知（想法）会影响情绪，情绪会影响行为。改变对事情的认知，可以改变情绪和行为。",
      "atom_ids": [
        "s-cdcec9e98bd6-c003:a015"
      ]
    },
    {
      "name": "家长对孩子说话应像对朋友说话",
      "definition": "家长在很多情况下，对孩子说话要像对朋友说话一样，注意自己对孩子说什么、怎么说。",
      "atom_ids": [
        "s-cdcec9e98bd6-c003:a017"
      ]
    },
    {
      "name": "中国学生对自己过于严苛",
      "definition": "中国学生对自己过于严苛，应该对自己宽容、温柔一些。",
      "atom_ids": [
        "s-cdcec9e98bd6-c003:a018"
      ]
    },
    {
      "name": "通过书写梳理想法",
      "definition": "将想法写下来，因为仅仅在脑子里想往往想不清楚，书写是一个梳理的过程。",
      "atom_ids": [
        "s-cdcec9e98bd6-c003:a019"
      ]
    }
  ],
