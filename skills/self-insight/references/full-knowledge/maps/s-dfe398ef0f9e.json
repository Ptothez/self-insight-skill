{
  "concepts": [
    {
      "name": "建立问对问题习惯的三点方法",
      "definition": "父母建立问对问题习惯的三点方法：每天见孩子前列问题清单；提问前先想孩子可能的答案；明确提问的目的。",
      "atom_ids": [
        "s-dfe398ef0f9e-c001:a001"
      ]
    },
    {
      "name": "列问题清单",
      "definition": "每天见孩子前，在心里或纸上列出今天要问的问题清单，包含具体问题、开放式问题、建立关系的问题、鼓励的问题、用问题回答问题、让孩子感到被理解的问题、让孩子感到被爱的问题。",
      "atom_ids": [
        "s-dfe398ef0f9e-c001:a002"
      ]
    },
    {
      "name": "列清单防止滑回旧习惯",
      "definition": "列问题清单有助于防止父母滑回旧习惯，即见到孩子后不停问一堆问题，像机关枪一样停不下来，孩子还没回答就继续问。",
      "atom_ids": [
        "s-dfe398ef0f9e-c001:a003"
      ]
    },
    {
      "name": "在见孩子前反复练习问题",
      "definition": "在还没见到孩子时，例如在下班路上，父母应在脑中一遍遍过要问的问题，以做好准备。",
      "atom_ids": [
        "s-dfe398ef0f9e-c001:a004"
      ]
    },
    {
      "name": "提问前先想答案",
      "definition": "提问前先想孩子可能的答案，因为父母对孩子有一定了解，能大致猜出孩子的回答。如果猜到孩子会回答“还好”“还行”“可以”等敷衍答案，就换一种方式提问。",
      "atom_ids": [
        "s-dfe398ef0f9e-c001:a005"
      ]
    },
    {
      "name": "先想答案有助于提出开放性和鼓励性问题",
      "definition": "先想孩子的反应和回答，有助于提出开放性问题和鼓励性问题。如果预测孩子会生气，就换一种问法；如果预测孩子会笑，即使年龄较大不好意思，也是好问题。",
      "atom_ids": [
        "s-dfe398ef0f9e-c001:a006"
      ]
    },
    {
      "name": "提问需经大脑，不能随意",
      "definition": "成年人说话前会经大脑思考，对孩子提问更应如此，不能不过大脑随意提问。父母对朋友更严谨小心，对孩子却容易放松随意。",
      "atom_ids": [
        "s-dfe398ef0f9e-c001:a007"
      ]
    },
    {
      "name": "明确提问目的",
      "definition": "提问前问自己：我问这个问题的目的是什么？明确目的有助于选择正确的提问方式。同一件事可以有多种提问方法，目的不同，提问方式就不同。",
      "atom_ids": [
        "s-dfe398ef0f9e-c001:a008"
      ]
    },
    {
      "name": "表达高兴的提问示例",
      "definition": "如果目的是让孩子知道父母因他考第一名而高兴，可以问：“哇，这么难的题，你居然考了第一名，你是怎么做到的呀？你到底做了什么？”",
      "atom_ids": [
        "s-dfe398ef0f9e-c001:a009"
      ]
    },
    {
      "name": "引导思考的提问示例",
      "definition": "如果目的是引导孩子思考，可以问：“哇，这次居然考了第一名，你觉得这次你做了什么？你在复习当中，在学习当中，做了什么以前没有做过的，但这次做了，然后就突然考得这么好？”",
      "atom_ids": [
        "s-dfe398ef0f9e-c001:a010"
      ]
    },
    {
      "name": "实操打卡课提供提问练习",
      "definition": "实操打卡课会提供大量练习，让父母不断思考提问问题，以巩固提问习惯。",
      "atom_ids": [
        "s-dfe398ef0f9e-c001:a011"
      ]
    }
  ],
