{
  "concepts": [
    {
      "name": "左脑引导方法",
      "definition": "引导孩子左脑的四种方法：转移注意、延伸引导、同理心和诠释。",
      "atom_ids": [
        "s-34543af921fd-c001:a001"
      ]
    },
    {
      "name": "左脑引导方法的练习过程",
      "definition": "开始使用左脑引导方法时可能不习惯、别扭、忘记使用，通过多练习、反复思考能逐渐自然熟练运用。",
      "atom_ids": [
        "s-34543af921fd-c001:a002",
        "s-34543af921fd-c001:a003"
      ]
    },
    {
      "name": "每天15分钟高质量陪伴方法",
      "definition": "以孩子为中心陪他玩，适用于任何年龄（3岁、10岁、16岁），只要孩子愿意被陪伴。",
      "atom_ids": [
        "s-34543af921fd-c001:a004",
        "s-34543af921fd-c001:r001"
      ]
    },
    {
      "name": "全职父母的时间焦虑与内疚",
      "definition": "全职父母常因没有足够时间陪伴孩子而感到亏欠、内疚，并处于焦虑和矛盾状态。",
      "atom_ids": [
        "s-34543af921fd-c001:a005"
      ]
    },
    {
      "name": "错误陪伴方式案例",
      "definition": "父母主导玩乐高，要求孩子递积木；或提问颜色并纠正，导致陪伴质量不高。",
      "atom_ids": [
        "s-34543af921fd-c001:a006",
        "s-34543af921fd-c001:a007"
      ]
    },
    {
      "name": "高质量陪伴的三个不原则",
      "definition": "不提问、不纠正、不引导。不提问指不突然问颜色或英文名称；不纠正指15分钟内不纠正孩子的错误；不引导指不引导孩子如何玩玩具。",
      "atom_ids": [
        "s-34543af921fd-c001:a008"
      ]
    },
    {
      "name": "年龄较大孩子的陪伴时间调整",
      "definition": "对于年龄稍大的孩子，同样遵循三个不原则，但陪伴时间可能需要加长。",
      "atom_ids": [
        "s-34543af921fd-c001:a009"
      ]
    },
    {
      "name": "高质量陪伴中的具体做法",
      "definition": "叙述孩子当前正在做的事情、表达惊叹、以孩子为中心玩他想玩的、想他所想的、感受他所感受的。",
      "atom_ids": [
        "s-34543af921fd-c001:a010",
        "s-34543af921fd-c001:r002"
      ]
    },
    {
      "name": "高质量陪伴与情绪联结",
      "definition": "以孩子为中心、玩他想玩的、想他所想的、感受他所感受的陪伴，是带有情绪联结的高质量陪伴。",
      "atom_ids": [
        "s-34543af921fd-c001:a011"
      ]
    },
    {
      "name": "每天15分钟陪伴的充分性",
      "definition": "每天15分钟的高质量陪伴就完全足够。",
      "atom_ids": [
        "s-34543af921fd-c001:a012"
      ]
    }
  ],
