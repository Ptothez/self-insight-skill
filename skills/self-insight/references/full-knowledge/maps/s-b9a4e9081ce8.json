{
  "concepts": [
    {
      "name": "情绪平静后的引导开放状态",
      "definition": "当孩子的情绪平静下来后，右脑平静，下丘脑恢复关闭状态，传递安全信息，孩子对引导开放。",
      "atom_ids": [
        "s-b9a4e9081ce8-c001:a001"
      ]
    },
    {
      "name": "左脑引导时避免话太多",
      "definition": "对左脑引导时家长最容易犯的第一个错误是话说的太多。情绪连接成功后，父母通常不需要说太多话就可以实现引导。",
      "atom_ids": [
        "s-b9a4e9081ce8-c001:a002"
      ]
    },
    {
      "name": "孩子冷静后能自己判断对错",
      "definition": "大多数时间当孩子冷静下来以后，其实是可以知道自己对错的。就算孩子确实不明白，也可以通过简单的几句话或几个问题帮助孩子了解。孩子越大，越不需要长篇大论地重复道理。",
      "atom_ids": [
        "s-b9a4e9081ce8-c001:a003"
      ]
    },
    {
      "name": "根据行为背后的原因选择不同引导方法",
      "definition": "家长常犯的第二个错误是用同样的引导方法对待孩子同样的行为。即使行为相同，背后的原因和情绪可能不同，应使用不同的引导方式。",
      "atom_ids": [
        "s-b9a4e9081ce8-c001:a004"
      ]
    },
    {
      "name": "因大便被冲走而尖叫的引导案例",
      "definition": "讲师家老大两岁左右时，因保姆冲走马桶里的大便，没来得及说再见而悲伤尖叫。情绪连接成功后，讲师使用转移注意的方法进行引导。",
      "atom_ids": [
        "s-b9a4e9081ce8-c001:a005"
      ]
    },
    {
      "name": "因乐高搭不起来而尖叫的引导案例",
      "definition": "讲师家老大因无法搭建乐高而尖叫，情绪是沮丧和自我怀疑。情绪连接成功后，讲师使用了与上次不同的引导方法（具体方法未说明）。",
      "atom_ids": [
        "s-b9a4e9081ce8-c001:a006"
      ]
    },
    {
      "name": "与孩子说话时保持视线低于孩子水平线",
      "definition": "与孩子说话时应蹲下来，眼睛低于他们的视线水平线。仰头听人说话会让身体累，大脑分散注意力处理压迫感，不舒服。保持低于视线水平线能让孩子感到安全，更可能接受引导。",
      "atom_ids": [
        "s-b9a4e9081ce8-c001:a007"
      ]
    },
    {
      "name": "引导时避免用力过猛",
      "definition": "家长常犯的第四个错误是引导用力过猛。引导时可能加入自己的想象和理解，导致过度反应。应尽可能客观，警觉并排除干扰因素，客观分析孩子行为及其背后动机。",
      "atom_ids": [
        "s-b9a4e9081ce8-c001:a008"
      ]
    },
    {
      "name": "家长因自身经历对推人行为反应过度的假设案例",
      "definition": "假设女儿在游乐场推了另一个孩子。如果大儿子曾因推人导致对方眼睛摔伤、赔钱惹官司，家长可能对女儿的行为感到恐惧和愤怒，引导更激烈。如果家长小时候被欺负过，可能用另一种方式解读女儿的行为。",
      "atom_ids": [
        "s-b9a4e9081ce8-c001:a009"
      ]
    },
    {
      "name": "情绪连接与溺爱的区别及溺爱类型",
      "definition": "上一期节目讲到了情绪连接和溺爱的区别，并提到了溺爱的三种类型。",
      "atom_ids": [
        "s-b9a4e9081ce8-c001:r001"
      ]
    }
  ],
