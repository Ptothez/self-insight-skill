        "s-4f0c40c16251-c001:a012"
      ]
    },
    {
      "name": "培养好奇心的方法",
      "definition": "家长通过保持开放思维、允许并引导孩子问高质量问题、自身保持好奇心等方式来培养孩子的好奇心。",
      "atom_ids": [
        "s-4f0c40c16251-c001:a007",
        "s-4f0c40c16251-c001:a009",
        "s-4f0c40c16251-c001:a010",
        "s-4f0c40c16251-c001:a011"
      ]
    },
    {
      "name": "开放思维",
      "definition": "不轻易否定孩子的非常规想法，允许尝试，问“为什么不可以”，从而保护孩子的好奇心。",
      "atom_ids": [
        "s-4f0c40c16251-c001:a007",
        "s-4f0c40c16251-c001:a008"
      ]
    },
    {
      "name": "高质量问题引导",
      "definition": "家长通过肯定孩子的问题、提出引导性问题、一起探索答案，帮助孩子从简单问题过渡到更深层次的问题，从而提升注意力。",
      "atom_ids": [
        "s-4f0c40c16251-c001:a009",
        "s-4f0c40c16251-c001:a012"
      ]
    },
    {
      "name": "家长自身好奇心",
      "definition": "家长每天带着好奇心发现一件新事物，以身作则，从而鼓励孩子有好奇心。",
      "atom_ids": [
        "s-4f0c40c16251-c001:a010",
        "s-4f0c40c16251-c001:a011"
      ]
    },
    {
      "name": "无聊",
      "definition": "大脑消极、觉得没意思的状态，会降低专注力。",
      "atom_ids": [
        "s-4f0c40c16251-c001:a002"
      ]
    },
    {
      "name": "精力与生命力",
      "definition": "好奇心带来的高能量、旺盛生命力状态，使专注变得容易。",
      "atom_ids": [
        "s-4f0c40c16251-c001:a005",
        "s-4f0c40c16251-c001:a006"
      ]
    },
    {
      "name": "育儿阶段付出",
      "definition": "孩子越小家长应越辛苦，前期辛苦后期轻松。",
      "atom_ids": [
        "s-4f0c40c16251-c001:a013"
      ]
    }
  ],
