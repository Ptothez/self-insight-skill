{
  "concepts": [
    {
      "name": "好奇心",
      "definition": "对新鲜事物感兴趣、愿意探索和学习的心理状态，能促进思维活跃、吸收新信息、发现兴趣、带来高能量状态，从而提升专注力。",
      "atom_ids": [
        "s-4f0c40c16251-c001:a001",
