      ]
    },
    {
      "name": "专注力",
      "definition": "能够集中注意力于某事物而不易分散的能力，受好奇心、思维活跃度、无聊程度、精力状态等因素影响。",
      "atom_ids": [
        "s-4f0c40c16251-c001:a001",
        "s-4f0c40c16251-c001:a002",
        "s-4f0c40c16251-c001:a003",
