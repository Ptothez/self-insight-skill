{
  "concepts": [
    {
      "name": "转移注意方法",
      "definition": "引导孩子左脑的第一个方法，用于在孩子情绪爆发时，通过提供选择或转移话题来帮助孩子启动左脑逻辑思考，从而控制情绪。",
      "atom_ids": [
        "s-fb8f8103f73e-c001:a002"
      ]
    },
    {
      "name": "转移注意方法的适用情况",
      "definition": "通常在无法跟孩子解释清楚道理时使用转移注意方法，例如孩子太小无法明白道理，或当前情况没有条件说道理（如着急出门、赶飞机，孩子却不愿走而大哭）。此时只能通过快速转移注意来引导左脑，控制情绪爆发。",
      "atom_ids": [
        "s-fb8f8103f73e-c001:a005"
      ]
    },
    {
      "name": "提供选择空间的重要性",
      "definition": "对孩子说“你可以选择继续生气，或者……”很重要，因为让孩子觉得有选择是重要的引导原则。提供选择空间会帮助左脑开始逻辑思考，孩子会想哪个选择对自己更好更有利，从而启动左脑运作。",
      "atom_ids": [
        "s-fb8f8103f73e-c001:a007"
      ]
    },
    {
      "name": "左脑运作与情绪管理的关系",
      "definition": "一旦孩子负责控制情绪和逻辑思考的左脑开始运作，孩子就距离平衡左右脑、健康管理情绪更近一步。",
      "atom_ids": [
        "s-fb8f8103f73e-c001:a008"
      ]
    },
    {
      "name": "引导孩子左脑的三个原则",
      "definition": "引导孩子左脑时有三个重要原则：第一，了解自己的原生背景，避免让自身经历和未解决的伤害影响对孩子行为的解读和引导程度；第二，在引导前先搞清楚孩子行为背后的原因，否则引导可能没有意义；第三，选择正确的方式引导孩子，因为说话方式会影响孩子对自己和父母的感知，孩子会从父母说话方式学习如何与他人交流，并影响当下对引导的回应。",
      "atom_ids": [
        "s-fb8f8103f73e-c001:a001"
      ]
    }
  ],
