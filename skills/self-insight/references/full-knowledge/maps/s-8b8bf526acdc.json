{
  "concepts": [
    {
      "name": "父母行为控制削弱孩子自信",
      "definition": "父母替孩子控制一切、规划道路，使孩子几乎没有失败和犯错机会，导致孩子对自己能力不自信。",
      "atom_ids": [
        "s-8b8bf526acdc-c001:a001",
        "s-8b8bf526acdc-c001:a003"
      ]
    },
    {
      "name": "从未经历失败导致不自信",
      "definition": "讲师认为最失败的人生是从来没有经历过失败，因为这样的人一定不自信。",
      "atom_ids": [
        "s-8b8bf526acdc-c001:a002"
      ]
    },
    {
      "name": "不自信男孩的伴侣选择倾向",
      "definition": "不自信的男孩很可能喜欢找比自己大很多的女性做女朋友或老婆。",
      "atom_ids": [
        "s-8b8bf526acdc-c001:a004"
      ]
    },
    {
      "name": "不自信女孩的伴侣选择倾向",
      "definition": "不自信的女孩基本上会找一个非常强势、甚至有暴力倾向的人来强迫她、压着她，或者对她很粗暴地说话，这是因为她内心极度不自信。",
      "atom_ids": [
        "s-8b8bf526acdc-c001:a005"
      ]
    },
    {
      "name": "父母过度帮助导致孩子自我怀疑",
      "definition": "孩子做事时父母过多帮助或打断，会让孩子对自己的能力感到深深怀疑，不确定自己行不行。",
      "atom_ids": [
        "s-8b8bf526acdc-c001:a006",
        "s-8b8bf526acdc-c001:a007"
      ]
    },
    {
      "name": "被控制导致自尊心低和敏感",
      "definition": "被控制的人自我调节能力较差，自尊心在高压统治下形成，所以自尊心很低、很敏感。",
      "atom_ids": [
        "s-8b8bf526acdc-c001:a008"
      ]
    },
    {
      "name": "自卑又自尊心强导致难以相处",
      "definition": "这种人既自卑又自尊心很强，很难相处，别人说话要小心翼翼，因为一不小心就会碰到他的自尊心。",
      "atom_ids": [
        "s-8b8bf526acdc-c001:a009"
      ]
    },
    {
      "name": "内部控制导致讨好型人格",
      "definition": "内部控制的父母使用操纵等手段，可能导致孩子小时候对父母过度忠诚、遵守权威，成为很听话、不反抗父母的孩子；这种孩子到社会上会习惯性通过讨好别人来获得认同感和安全感。",
      "atom_ids": [
        "s-8b8bf526acdc-c001:a010",
        "s-8b8bf526acdc-c001:a011"
      ]
    },
    {
      "name": "顺从为避免内疚或失去爱导致怨恨和越界控制",
      "definition": "如果孩子的顺从是为了避免感到内疚或失去父母的爱，那么当他们被父母拒绝时就会感到怨恨，因此被控制的孩子会想要越界去控制自己的父母。",
      "atom_ids": [
        "s-8b8bf526acdc-c001:a012",
        "s-8b8bf526acdc-c001:a013"
      ]
    },
    {
      "name": "父母打破孩子界限导致孩子没有界限感",
      "definition": "孩子的生活环境中界限不断被父母打破、穿越，孩子慢慢也变成没有界限的人，会随意打乱别人的界限。",
      "atom_ids": [
        "s-8b8bf526acdc-c001:a014"
      ]
    },
    {
      "name": "被控制导致心理问题和内心矛盾",
      "definition": "被控制的孩子对父母有矛盾混合的感觉：既想顺服父母获得认同，又极度抵御被控制的感觉和独立的需要，这种矛盾造成内心紧张和张力，长期心理紧张会导致焦虑、抑郁甚至反社会行为。",
      "atom_ids": [
        "s-8b8bf526acdc-c001:a015",
        "s-8b8bf526acdc-c001:a016"
      ]
    }
  ],
