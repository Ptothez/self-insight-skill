{
  "concepts": [
    {
      "name": "羞辱式管教",
      "definition": "一种通过让孩子感到羞耻来教育孩子的方式，源于中国传统文化中的“知耻而后勇”观念，认为孩子必须知道羞耻才能有所作为。",
      "atom_ids": [
        "s-be9567f81cb9-c001:a001",
        "s-be9567f81cb9-c001:a003",
        "s-be9567f81cb9-c001:r002"
      ]
    },
    {
      "name": "羞耻文化",
      "definition": "中国文化中普遍存在的一种现象，表现为从小用“羞不羞”、“羞羞羞”等语言让孩子感到羞耻，讲师认为这种文化对心理不健康。",
      "atom_ids": [
        "s-be9567f81cb9-c001:a002",
        "s-be9567f81cb9-c001:r001",
        "s-be9567f81cb9-c001:r003",
        "s-be9567f81cb9-c001:r004"
      ]
    },
    {
      "name": "错误羞耻心",
      "definition": "个体形成的错误的羞耻感，例如认为哭是羞耻的，导致个体习惯性地觉得自己不好，甚至使被性侵的孩子认为被性侵是自己的羞耻。",
      "atom_ids": [
        "s-be9567f81cb9-c001:a005",
        "s-be9567f81cb9-c001:r001",
        "s-be9567f81cb9-c001:r005"
      ]
    },
    {
      "name": "放任式管教",
      "definition": "一种错误的教育方式，表现为父母只要求孩子快乐，不批评、不反对、不管教孩子，或声称与孩子做朋友。",
      "atom_ids": [
        "s-be9567f81cb9-c001:a010",
        "s-be9567f81cb9-c001:a012",
        "s-be9567f81cb9-c001:r007",
        "s-be9567f81cb9-c001:r008",
        "s-be9567f81cb9-c001:r009",
        "s-be9567f81cb9-c001:r010"
      ]
    },
    {
      "name": "父母自身羞耻感",
      "definition": "父母内心充满羞耻感，孩子做某事可能激发父母的羞耻感，父母便想纠正孩子，将羞耻感加在孩子身上，这是一种投射机制。",
      "atom_ids": [
        "s-be9567f81cb9-c001:a009",
        "s-be9567f81cb9-c001:r006"
      ]
    },
    {
      "name": "父母角色与朋友角色",
      "definition": "孩子可以有很多朋友，但只有一个爸爸和一个妈妈。父母不应只做孩子的朋友，而应承担管教责任。",
      "atom_ids": [
        "s-be9567f81cb9-c001:a018"
      ]
    },
    {
      "name": "孩子自由发挥的年龄界限",
      "definition": "孩子小的时候不应该自由发挥，父母不能让孩子自由发挥；孩子年龄大了该独立时，父母应让孩子独立。",
      "atom_ids": [
        "s-be9567f81cb9-c001:a017"
      ]
    }
