{
  "concepts": [
    {
      "name": "赋能式管教",
      "definition": "管教目标不应只是行为要求，而应赋能给孩子，让孩子明白行为对自己的伤害，从而自己做对的决定。",
      "atom_ids": [
        "s-0fd758c071ac-c001:a009",
        "s-0fd758c071ac-c001:a010",
        "s-0fd758c071ac-c001:a011",
        "s-0fd758c071ac-c001:a014"
      ]
    },
    {
      "name": "自然后果",
      "definition": "让孩子承受自己行为的自然结果，父母不应因保护孩子而破坏自然后果。",
      "atom_ids": [
        "s-0fd758c071ac-c001:a012",
        "s-0fd758c071ac-c001:r001",
        "s-0fd758c071ac-c002:a011"
      ]
    },
    {
      "name": "父母一致",
      "definition": "父母在管教孩子时应保持一致，避免孩子操纵父母关系。",
      "atom_ids": [
        "s-0fd758c071ac-c001:a012",
        "s-0fd758c071ac-c001:r001"
      ]
    },
    {
      "name": "游戏上瘾",
      "definition": "孩子沉迷游戏是因为游戏提供了他们在现实生活中缺乏的东西，如趣味、轻松感、归属感和力量感。打游戏和游戏上瘾是两回事，目标是培养不上瘾的孩子。",
      "atom_ids": [
        "s-0fd758c071ac-c002:a005",
        "s-0fd758c071ac-c002:a006"
      ]
    },
    {
      "name": "社交排斥处理",
      "definition": "处理兄弟姐妹间社交排斥的方法，包括家长组织游戏、避免剥夺哥哥社交权利、为被排斥的孩子安排单独陪伴时间。",
      "atom_ids": [
        "s-0fd758c071ac-c002:a001",
        "s-0fd758c071ac-c002:a002",
        "s-0fd758c071ac-c002:a003",
        "s-0fd758c071ac-c002:r001"
      ]
    },
    {
      "name": "奖励原则",
      "definition": "奖励孩子时，不用物质奖励，不是每次必奖励，随机奖励是可以的，可以用精神奖励。",
      "atom_ids": [
        "s-0fd758c071ac-c002:a012",
        "s-0fd758c071ac-c002:a013"
      ]
    },
    {
      "name": "家长力量",
      "definition": "家长自身需要有力量，才能赋能给孩子，保护孩子免受伤害。",
      "atom_ids": [
        "s-0fd758c071ac-c002:a019",
        "s-0fd758c071ac-c002:a024",
        "s-0fd758c071ac-c002:a026"
      ]
    },
    {
      "name": "上学哭闹处理",
      "definition": "当孩子上学哭闹时，家长应大大方方地告别，承诺下午接孩子，每天坚持，孩子会逐渐适应。",
      "atom_ids": [
        "s-0fd758c071ac-c002:a022",
        "s-0fd758c071ac-c003:a001"
      ]
    },
    {
      "name": "挫折教育",
      "definition": "当孩子因外部原因未得到想要的东西而伤心时，家长应陪伴安慰，但不要求道歉，让孩子明白不是每件事都能如愿。",
      "atom_ids": [
        "s-0fd758c071ac-c003:a003",
        "s-0fd758c071ac-c003:a007"
      ]
    },
    {
      "name": "感受表达",
      "definition": "当孩子关心家长时，家长应表达因为孩子的关心而感到开心，而不是对事情本身感到高兴。",
      "atom_ids": [
        "s-0fd758c071ac-c003:a002",
        "s-0fd758c071ac-c003:a004"
      ]
    }
  ],
