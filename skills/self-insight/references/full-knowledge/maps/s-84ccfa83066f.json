{
  "concepts": [
    {
      "name": "唠叨",
      "definition": "一方持续重复说，另一方持续不听，导致双方生气，使关系角色不平等，类似妈妈与青少年或爸爸与青少年的关系，造成彼此不信任和负面情绪。",
      "atom_ids": [
        "s-84ccfa83066f-c001:a001"
      ]
    },
    {
      "name": "不切实际的期待",
      "definition": "一方对另一方抱有不合理的高要求，导致对方觉得自己是失败者。具体类型包括：只要要求合理，对方就应该每次都提供；自己强的方面对方也应该强；自己弱的方面对方也应该强；如果爱我就应该知道我的需求而不需明说；幸福的婚姻不吵架。",
      "atom_ids": [
        "s-84ccfa83066f-c001:a002",
        "s-84ccfa83066f-c001:r001"
      ]
    },
    {
      "name": "正确期待",
      "definition": "允许配偶和自己一样有软弱之处，不强求对方在所有方面与自己相同或互补。",
      "atom_ids": [
        "s-84ccfa83066f-c001:a003"
      ]
    },
    {
      "name": "修复争吵",
      "definition": "高质量婚姻中的夫妻学会如何结束争吵或在争吵失控时修复状况。具体方法包括：使用幽默、关怀的小动作（如挤牙膏、倒水、叫吃饭）、积极的话语（如“我相信我们一定可以搞定这个问题”）、退让、向配偶表达感激。",
      "atom_ids": [
        "s-84ccfa83066f-c001:a004",
        "s-84ccfa83066f-c001:r002"
      ]
    },
    {
      "name": "正面回应与负面回应",
      "definition": "正面回应包括肯定、赞美和鼓励的话语；负面回应包括贬低、嘲讽的话语。高质量婚姻中正面回应频率远高于负面回应，低质量婚姻中负面回应更多。",
      "atom_ids": [
        "s-84ccfa83066f-c001:a007",
        "s-84ccfa83066f-c001:r003"
      ]
    },
    {
      "name": "培养正面回应习惯",
      "definition": "建议夫妻数一下每天对配偶说的正面积极的话是否达到负面话的5倍，并刻意改变习惯，多讲正面积极的话，即使反对某事也先以正面话语开头。",
      "atom_ids": [
        "s-84ccfa83066f-c001:a008"
      ]
    },
    {
      "name": "21天习惯养成法",
      "definition": "习惯需要培养，天生性格可能倾向负面。养成好习惯过程艰难且不自然，但持续记录21天后习惯基本定型，之后会越来越自然，最终像呼吸一样自然。",
      "atom_ids": [
        "s-84ccfa83066f-c001:a009"
      ]
    }
  ],
