{
  "concepts": [
    {
      "name": "家庭环境与上瘾抵抗力",
      "definition": "健康、温暖的家庭环境能增强孩子对上瘾的抵抗力，即使接触致瘾物也不会上瘾。",
      "atom_ids": [
        "s-42ca5837b22a-c001:a001",
        "s-42ca5837b22a-c003:a002"
      ]
    },
    {
      "name": "上瘾风险因素",
      "definition": "增加孩子上瘾可能性的个人特质或环境因素，包括喜欢冒险、冲动、父母上瘾、童年创伤、社会边缘化、情绪失联、角色错位等。",
      "atom_ids": [
        "s-42ca5837b22a-c001:a004",
        "s-42ca5837b22a-c001:a006",
        "s-42ca5837b22a-c001:a013",
        "s-42ca5837b22a-c001:a015",
        "s-42ca5837b22a-c001:a017",
        "s-42ca5837b22a-c001:a020",
        "s-42ca5837b22a-c001:a024"
      ]
    },
    {
      "name": "延迟满足训练",
      "definition": "通过让孩子等待或提供替代选择来培养控制冲动和延迟满足的能力，降低上瘾风险。",
      "atom_ids": [
        "s-42ca5837b22a-c001:a007",
        "s-42ca5837b22a-c001:a008",
        "s-42ca5837b22a-c001:a010",
        "s-42ca5837b22a-c001:a011"
      ]
    },
    {
      "name": "情绪失联",
      "definition": "父母在情绪上不接纳孩子，如不允许孩子表达负面情绪、对孩子情绪有错误期待，导致孩子情绪需求未被满足，增加上瘾风险。",
      "atom_ids": [
        "s-42ca5837b22a-c001:a020",
        "s-42ca5837b22a-c001:a022",
        "s-42ca5837b22a-c001:r001"
      ]
    },
    {
      "name": "角色错位",
      "definition": "父母将不属于孩子的责任强加给孩子，使孩子承受过大压力，容易逃避到上瘾物质中。",
      "atom_ids": [
        "s-42ca5837b22a-c001:a024",
        "s-42ca5837b22a-c002:a012"
      ]
    },
    {
      "name": "引导冒险",
      "definition": "不压制孩子的冒险天性，而是引导其将冒险渴望投入到积极有意义的活动中，满足冒险需求并降低上瘾风险。",
      "atom_ids": [
        "s-42ca5837b22a-c001:a026",
        "s-42ca5837b22a-c001:a027",
        "s-42ca5837b22a-c001:r004"
      ]
    },
    {
      "name": "情绪表达与冲动控制",
      "definition": "允许孩子健康表达情绪，尤其是激烈情绪，能减少冲动行为，因为语言表达激活左脑理性，抑制右脑冲动。",
      "atom_ids": [
        "s-42ca5837b22a-c001:a029",
        "s-42ca5837b22a-c001:a030",
        "s-42ca5837b22a-c002:a003"
      ]
    },
    {
      "name": "归属感缺失与上瘾",
      "definition": "社会边缘化、隔离或家庭环境导致孩子缺乏归属感，孩子可能通过上瘾物质获得虚幻的归属感。",
      "atom_ids": [
        "s-42ca5837b22a-c002:a009",
        "s-42ca5837b22a-c002:r001"
      ]
    },
    {
      "name": "父母角色与界限",
      "definition": "父母应明确自己的角色，建立界限感，不把孩子当朋友，不推卸责任，角色随孩子年龄调整，否则增加孩子上瘾风险。",
      "atom_ids": [
        "s-42ca5837b22a-c002:a012",
        "s-42ca5837b22a-c002:a014",
        "s-42ca5837b22a-c002:a015"
      ]
    },
    {
      "name": "家庭暴力与上瘾",
      "definition": "家暴（身体、语言、精神）让孩子产生恐惧和怒气，可能通过暴力游戏等上瘾行为发泄，增加上瘾风险。",
      "atom_ids": [
        "s-42ca5837b22a-c002:a020",
        "s-42ca5837b22a-c002:a021"
      ]
    },
    {
      "name": "父母要求与上瘾",
      "definition": "父母对孩子要求过高或过低都可能导致孩子寻求上瘾物质以获得认可或满足感。",
      "atom_ids": [
        "s-42ca5837b22a-c002:a027",
        "s-42ca5837b22a-c002:a029"
      ]
    },
    {
      "name": "父母自身生活与上瘾",
      "definition": "父母没有自己的生活，过度关注孩子，会给孩子带来压力，增加上瘾风险；父母有自己的生活则对孩子有保护作用。",
      "atom_ids": [
        "s-42ca5837b22a-c002:a030",
        "s-42ca5837b22a-c003:a004"
      ]
    }
  ],
