{
  "concepts": [
    {
      "name": "核心信念",
      "definition": "深埋于潜意识中、导致个体对自己产生根本性负面定论的根源，被描述为“穿上真理外衣的羞耻”。",
      "atom_ids": [
        "s-ba123ba43f93-c001:a001",
        "s-ba123ba43f93-c001:a002",
        "s-ba123ba43f93-c001:a003",
        "s-ba123ba43f93-c001:a004",
        "s-ba123ba43f93-c001:a025",
        "s-ba123ba43f93-c001:a031"
      ]
    },
    {
      "name": "人设",
      "definition": "小时候的伤害未被解决，于是创造出来的东西，如同一个“面具”，用于自我保护，隔离伤害，避免核心信念被触及。",
      "atom_ids": [
        "s-ba123ba43f93-c001:a005",
        "s-ba123ba43f93-c001:a006",
        "s-ba123ba43f93-c001:a007",
        "s-ba123ba43f93-c001:a008",
        "s-ba123ba43f93-c001:a023"
      ]
    },
    {
      "name": "焦虑",
      "definition": "人设受到威胁时产生的情绪，是线索而非终点，意味着人设正在失效，通过追问可触动核心信念。",
      "atom_ids": [
        "s-ba123ba43f93-c001:a009",
        "s-ba123ba43f93-c001:a010"
      ]
    },
    {
      "name": "谎言",
      "definition": "伴随伤害而来的错误认知，是对事实的扭曲，存在于对优缺点的评价、原生家庭信息、两性关系认知及人设中。",
      "atom_ids": [
        "s-ba123ba43f93-c001:a011",
        "s-ba123ba43f93-c001:a012"
      ]
    },
    {
      "name": "本相",
      "definition": "被造时独特的本质，无所谓优点和缺点，只有特点，位于优缺点光谱的中间地带，蕴藏着无限可能性，疗愈的终局是活出本相。",
      "atom_ids": [
        "s-ba123ba43f93-c001:a014",
        "s-ba123ba43f93-c001:a015"
      ]
    },
    {
      "name": "第1课",
      "definition": "打破对优点和缺点的固化认知，识别其中的谎言，回归特点与本相。",
      "atom_ids": [
        "s-ba123ba43f93-c001:a016",
        "s-ba123ba43f93-c001:a017"
      ]
    },
    {
      "name": "第2课",
      "definition": "识别原生家庭施加的直接伤害及带来的恐惧，包括信息、恐惧、谎言。",
      "atom_ids": [
        "s-ba123ba43f93-c001:a018",
        "s-ba123ba43f93-c001:a019"
      ]
    },
    {
      "name": "第3课",
      "definition": "识别从父母相处模式中习得的间接伤害及关系认知谎言，包括印象和影响。",
      "atom_ids": [
        "s-ba123ba43f93-c001:a020",
        "s-ba123ba43f93-c001:a021"
      ]
    },
    {
      "name": "第4课",
      "definition": "识别用于防御的面具，并意识到其反噬作用，包括设立原因和现状识别。",
      "atom_ids": [
        "s-ba123ba43f93-c001:a022",
        "s-ba123ba43f93-c001:a023"
      ]
    },
    {
      "name": "第5课",
      "definition": "精准定位最底层的核心信念与丢失的力量，路径为伤害事件→丢失力量→核心信念，并明确告知核心信念是错误的。",
      "atom_ids": [
        "s-ba123ba43f93-c001:a024",
        "s-ba123ba43f93-c001:a025"
      ]
    },
    {
      "name": "第6课",
      "definition": "利用当下的情绪作为入口，验证并攻击核心信念，使用下探工具和替代思维。",
      "atom_ids": [
        "s-ba123ba43f93-c001:a026",
        "s-ba123ba43f93-c001:a027"
      ]
    },
    {
      "name": "第7课",
      "definition": "形成逻辑闭环，完成认知改写，严格按照七步模版串联碎片信息。",
      "atom_ids": [
        "s-ba123ba43f93-c001:a028",
        "s-ba123ba43f93-c001:a029"
      ]
    },
    {
      "name": "七步法逻辑闭环",
      "definition": "从本相到破局的完整心理机制路径，包括受伤、谎言、核心信念、人设生成、人设运行、反噬与混淆、危机爆发、痛苦循环、破局。",
      "atom_ids": [
        "s-ba123ba43f93-c001:a030"
      ]
    }
  ],
