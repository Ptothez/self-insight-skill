{
  "concepts": [
    {
      "name": "自控力像肌肉需要练习",
      "definition": "孩子一旦有控制自己的能力，就应该一直控制自己的行为，但自控力像肌肉一样需要练习，父母应像健身教练一样鼓励、示范和手把手教，而不是责骂。",
      "atom_ids": [
        "s-999b3958d908-c001:a001"
      ]
    },
    {
      "name": "父母应像健身教练一样对待孩子失败",
      "definition": "当孩子失败时，父母应像健身教练一样鼓励、手把手示范，而不是责骂或比较。例如，希望孩子有规律，可以买日程表并手把手教他计划时间。",
      "atom_ids": [
        "s-999b3958d908-c001:a002"
      ]
    },
    {
      "name": "健身教练式鼓励：关注进步并持续称赞",
      "definition": "好的父母像健身教练一样，在孩子每次有进步时告诉他离目标更近了，并不断称赞任何一点改变；若孩子退步，则鼓励说上次做到了，以后会越来越多做到，给予满满鼓励。",
      "atom_ids": [
        "s-999b3958d908-c001:a003"
      ]
    },
    {
      "name": "反例：教练在孩子多次失败后责骂",
      "definition": "如果健身教练在孩子第一次做到后，连续多次做不到时责骂“你怎么回事？不是做到过一次吗？”，孩子就不会想让他做教练。父母若如此，孩子无法更换父母，会想尽办法折磨和反抗，导致亲子关系糟糕。",
      "atom_ids": [
        "s-999b3958d908-c001:a004"
      ]
    },
    {
      "name": "错误期待：孩子长大后会明白",
      "definition": "认为现在对孩子严格，孩子长大后会明白是错误的期待。即使孩子长大后明白，伤害仍然存在，可能成为一生遗憾，影响婚姻、育儿和自我认知。",
      "atom_ids": [
        "s-999b3958d908-c001:a005"
      ]
    },
    {
      "name": "案例：被母亲抛弃的孩子长大后明白但痛苦",
      "definition": "一位来访者的母亲在他小时候将他留给家暴的父亲后离家出走。长大后他明白母亲当时因怕被打死且没钱带孩子而逃跑是正确选择，但内心仍痛苦无比，被抛弃的伤害已造成。",
      "atom_ids": [
        "s-999b3958d908-c001:a006"
      ]
    },
    {
      "name": "错误期待：批评打压能让孩子进步",
      "definition": "认为经常提醒孩子不足、批评打压、不让他得意忘形就能进步是错误的期待。讲师以自身经历为例：小时候是学渣，母亲整天打压，老师冷嘲热讽，导致破罐子破摔。",
      "atom_ids": [
        "s-999b3958d908-c001:a007"
      ]
    },
    {
      "name": "案例：讲师因教授夸奖而爱上经济学",
      "definition": "讲师在美国上经济学课时，全班无人回答出问题，教授大力夸奖他作为唯一外国学生回答出高难度词汇，从此他喜欢经济学，修完该教授所有经济学课程，并作为学校代表参加全美经济学大奖赛辩论赛，担任组长，最终获得第三名。",
      "atom_ids": [
        "s-999b3958d908-c001:a008"
      ]
    },
    {
      "name": "错误期待：孩子能感受到父母的爱",
      "definition": "认为孩子能感受到父母的爱是错误的期待。讲师做青少年心理辅导十多年，发现很多孩子理性上相信父母爱自己，但心底深处感受不到。",
      "atom_ids": [
        "s-999b3958d908-c001:a009"
      ]
    },
    {
      "name": "错误期待：付出爱就必须接受",
      "definition": "认为“我给你爱，你就要接受”是错误的期待。父母常强调自己付出很多，但孩子并未要求这些付出，也不应被要求回报。当父母期待孩子按自己要求做而孩子不做时，期待变得不正常。",
      "atom_ids": [
        "s-999b3958d908-c001:a010"
      ]
    },
    {
      "name": "错误期待：孩子至少要像其他孩子一样",
      "definition": "认为孩子至少要像其他孩子一样是错误的期待。讲师母亲曾要求他至少像普通同学，但每个人能力不同，有些领域怎么努力也只能勉强及格，有些领域则轻松擅长。",
      "atom_ids": [
        "s-999b3958d908-c001:a011"
      ]
    },
    {
      "name": "错误期待：孩子长大后明白并感激",
      "definition": "认为孩子长大后不仅会明白，还会感激父母当初的严格是错误的期待。讲师强调不要觉得孩子有一天会懂得并感激，因为伤害已经造成。",
      "atom_ids": [
        "s-999b3958d908-c001:r001"
      ]
    }
  ],
