{
  "concepts": [
    {
      "name": "左右脑功能区分",
      "definition": "右脑负责情绪、冲动、情感、艺术、视觉和想象；左脑负责逻辑、理性、语言、数字、时间和线性条理。",
      "atom_ids": [
        "s-0aae59d14ce8-c001:a001"
      ]
    },
    {
      "name": "视觉辅助时间概念",
      "definition": "孩子左脑时间观念未发育好，右脑视觉已发育，用视觉工具（如计时器、彩色闹钟）帮助孩子理解时间，提升专注力。",
      "atom_ids": [
        "s-0aae59d14ce8-c001:a003"
      ]
    },
    {
      "name": "视觉辅助语言理解",
      "definition": "孩子语言（左脑）发育慢于情绪（右脑），用视觉工具（如情绪脸谱）帮助孩子表达和理解情绪，辅助语言发展。",
      "atom_ids": [
        "s-0aae59d14ce8-c001:a005"
      ]
    },
    {
      "name": "情绪辅助逻辑理解",
      "definition": "孩子左脑逻辑未发育好，难以理解抽象逻辑（如打人会痛），用饱满的情绪展示（如夸张的痛苦表情和哭泣）帮助孩子理解行为后果。",
      "atom_ids": [
        "s-0aae59d14ce8-c001:a007"
      ]
    },
    {
      "name": "用右脑想象力提升记忆",
      "definition": "发现孩子右脑想象力丰富，引导其将需要记忆的内容编成故事，用右脑想象力帮助左脑记忆。",
      "atom_ids": [
        "s-0aae59d14ce8-c001:a004"
      ]
    },
    {
      "name": "视觉演示改变行为",
      "definition": "通过展示视觉结构或画面，帮助理解抽象概念或行为后果，从而改变行为。",
      "atom_ids": [
        "s-0aae59d14ce8-c001:a006",
        "s-0aae59d14ce8-c001:a008"
      ]
    }
  ],
