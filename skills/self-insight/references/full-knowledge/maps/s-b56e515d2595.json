{
  "concepts": [
    {
      "name": "父母对幼儿自控能力的错误期待",
      "definition": "许多父母错误地认为幼儿能够控制冲动、分享玩具、轮流玩耍和控制情绪，这些期待与脑科学不符。",
      "atom_ids": [
        "s-b56e515d2595-c001:a001"
      ]
    },
    {
      "name": "幼儿自控能力发展的实际时间线",
      "definition": "自我控制的概念和逐渐开始的能力在三岁半到四岁之间发展起来；分享玩具、轮流玩玩具的能力大约在四到五岁之间发展出来；情绪背后的行为控制大约在三岁半到四岁左右开始慢慢发展。",
      "atom_ids": [
        "s-b56e515d2595-c001:a002"
      ]
    },
    {
      "name": "高知父母过早要求婴儿控制情绪的案例",
      "definition": "一对台湾夫妇均为医学博士，在孩子约12个月大时就要求孩子在公共场合控制情绪，不允许尖叫、哭闹或发脾气，认为孩子是人就应该可以控制，需要训练。",
      "atom_ids": [
        "s-b56e515d2595-c001:a003"
      ]
    },
    {
      "name": "婴儿可训练与不可训练的方面",
      "definition": "婴儿在情绪某些方面确实不能被训练，但有些方面可以训练。四个月之前的婴儿不用考虑训练；四个月之后的婴儿可以慢慢开始训练睡眠。孩子不跟父母睡觉不会失去安全感，但可能感到不安全。",
      "atom_ids": [
        "s-b56e515d2595-c001:a004"
      ]
    },
    {
      "name": "四个月后婴儿睡眠训练方法",
      "definition": "四个月后的婴儿可以通过制定日程表来训练睡眠：每天按照“睡醒就吃，吃完就玩，玩累就睡”的循环进行，根据孩子能玩多久来安排，累了就睡，按照日程表训练孩子，让他晚上可以尽快睡过夜。",
      "atom_ids": [
        "s-b56e515d2595-c001:a005"
      ]
    },
    {
      "name": "八岁左右孩子能听懂简单行为指示",
      "definition": "孩子在八岁左右已经能够听懂父母的指示，但父母应给予最简单的行为指示，例如“放”、“拿”、“说”等，一次只给一个行为指令。不要给两个以上的行为指令。",
      "atom_ids": [
        "s-b56e515d2595-c001:a006"
      ]
    },
    {
      "name": "幼儿行为控制的现实与解决方法",
      "definition": "期待幼儿控制自己的行为（如收玩具、好好坐在餐椅上吃饭、乖乖去幼儿园）是不太可能的。解决方法包括：通过夸奖、解释自己的计划、因地制宜、使用计时器帮助轮流。",
      "atom_ids": [
        "s-b56e515d2595-c001:a007"
      ]
    },
    {
      "name": "向幼儿解释计划的具体做法",
      "definition": "向幼儿解释计划时，要详细说明今天要去哪里、接下来去哪里、要做什么、过程中会遇到什么、会经历什么。例如，孩子玩玩具时妈妈需要去洗手间，可以解释具体安排，然后按照承诺回来，并感谢孩子。",
      "atom_ids": [
        "s-b56e515d2595-c001:a008"
      ]
    },
    {
      "name": "使用计时器帮助幼儿轮流",
      "definition": "对于幼儿，很难让他们理解别人也想玩同一个玩具，因为他们觉得这不关自己的事。可以使用计时器来帮助轮流：设定每人玩两分钟，时间到了就轮到另一个人。这个年龄段的孩子能理解并期望获得公平，所以只要让他知道是公平的，就可以很好地解决轮流问题。",
      "atom_ids": [
        "s-b56e515d2595-c001:a009"
      ]
    },
    {
      "name": "幼儿同理心与道德尚未发育",
      "definition": "幼儿仍然在学习同理心和道德，这些东西其实还没有发育起来，所以很难让他明白别人也想玩同一个玩具，他觉得这不关自己的事情。",
      "atom_ids": [
        "s-b56e515d2595-c001:a010"
      ]
    }
  ],
