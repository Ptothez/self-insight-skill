{
  "concepts": [
    {
      "name": "父母对亲子关系的错误期待",
      "definition": "父母希望孩子还像小时候那样粘自己，当孩子疏远时感到失望。",
      "atom_ids": [
        "s-beeeba1ede11-c001:a002"
      ]
    },
    {
      "name": "父母自我怀疑与焦虑",
      "definition": "在13-18岁阶段，父母开始自我怀疑并因此导致焦虑，包括因之前做错的事显现而焦虑。",
      "atom_ids": [
        "s-beeeba1ede11-c001:a003",
        "s-beeeba1ede11-c001:a004"
      ]
    },
    {
      "name": "父母情绪反应",
      "definition": "孩子拒绝父母导致父母情绪上严重焦虑、后悔、恐惧、害怕，担心孩子将来怎么办。",
      "atom_ids": [
        "s-beeeba1ede11-c001:a005"
      ]
    },
    {
      "name": "父母心路历程",
      "definition": "从失望、自我怀疑、焦虑到为将来感到害怕。",
      "atom_ids": [
        "s-beeeba1ede11-c001:a007"
      ]
    },
    {
      "name": "被动攻击",
      "definition": "父母常用的矛盾处理方法之一，例如不理孩子、冷处理，或者孩子叫自己做某事但自己就是不去做。",
      "atom_ids": [
        "s-beeeba1ede11-c001:a008"
      ]
    },
    {
      "name": "冷嘲热讽",
      "definition": "父母常用的矛盾处理方法之二，例如对孩子说“你得意呀，你不是以为你什么都懂了吗？”，因为父母心里有很深的怨恨，但不敢打孩子。",
      "atom_ids": [
        "s-beeeba1ede11-c001:a009"
      ]
    },
    {
      "name": "真实表达内心感受",
      "definition": "父母要真实地向孩子表达内心的感受，而不是寻找解决方案，这样孩子才有可能允许父母进入他的世界。",
      "atom_ids": [
        "s-beeeba1ede11-c001:a011",
        "s-beeeba1ede11-c001:a018"
      ]
    },
    {
      "name": "聆听孩子",
      "definition": "父母要聆听孩子，并且开始跟孩子交换意见，以进入他的世界，了解年轻人的想法和看法。",
      "atom_ids": [
        "s-beeeba1ede11-c001:a012"
      ]
    },
    {
      "name": "交换意见",
      "definition": "父母可以跟孩子讲自己的感受和看法，同时必须尊重孩子的想法和意见，双方交换意见以影响孩子。",
      "atom_ids": [
        "s-beeeba1ede11-c001:a013",
        "s-beeeba1ede11-c001:a019"
      ]
    },
    {
      "name": "尊重孩子的想法和意见",
      "definition": "父母必须尊重孩子的想法和意见，不能嘲笑或否定，否则孩子会烦父母。",
      "atom_ids": [
        "s-beeeba1ede11-c001:a014"
      ]
    },
    {
      "name": "学员关于孩子关心自己的矛盾",
      "definition": "学员的孩子出国读书，孩子来关心学员，学员不希望孩子担心自己，但不知道该怎么讲，怕孩子不担心自己就不关心自己了。",
      "atom_ids": [
        "s-beeeba1ede11-c001:a015"
      ]
    },
    {
      "name": "讲师示范的真实表达方式",
      "definition": "讲师示范如何真实表达内心的纠结：既希望孩子担心自己，又怕孩子太过担心，又不甘愿孩子不担心。",
      "atom_ids": [
        "s-beeeba1ede11-c001:a017"
      ]
    }
  ],
