{
  "concepts": [
    {
      "name": "五到九岁孩子的发展特点",
      "definition": "五到九岁被称为黄金年龄，孩子精力充沛、好奇、快速掌握新信息；开始发展价值观和道德观；个性鲜明、喜欢独立并希望才智得到认可；喜欢互动和归属感；仍需要成人指导。",
      "atom_ids": [
        "s-b8ac34b77e63-c001:a001",
        "s-b8ac34b77e63-c001:a002",
        "s-b8ac34b77e63-c001:a003",
        "s-b8ac34b77e63-c001:a004",
        "s-b8ac34b77e63-c001:a006"
      ]
    },
    {
      "name": "五到九岁孩子的情绪表达",
      "definition": "约51%的孩子能健康表达情绪，但并非每次都能做到；父母应保持冷静，使用情绪词汇表帮助孩子认识并用语言表达情绪。",
      "atom_ids": [
        "s-b8ac34b77e63-c001:a007",
        "s-b8ac34b77e63-c001:a008",
        "s-b8ac34b77e63-c001:a009"
      ]
    },
    {
      "name": "五到九岁孩子的金钱观培养",
      "definition": "父母常误以为孩子没有金钱概念，应通过做家务挣钱、在父母帮助下理财、多接触钱来培养金钱观。",
      "atom_ids": [
        "s-b8ac34b77e63-c001:a010",
        "s-b8ac34b77e63-c001:a011"
      ]
    },
    {
      "name": "十到18岁孩子的睡眠需求",
      "definition": "十到18岁孩子应睡十个小时，十到11个小时对大脑有利。",
      "atom_ids": [
        "s-b8ac34b77e63-c001:a013"
      ]
    },
    {
      "name": "十到18岁孩子的记忆特点",
      "definition": "孩子可能不记得细节，但一定记得伤害；父母做错后应及时真诚道歉。",
      "atom_ids": [
        "s-b8ac34b77e63-c001:a014",
        "s-b8ac34b77e63-c001:a015"
      ]
    },
    {
      "name": "十到18岁孩子的独立与管教",
      "definition": "孩子可能给父母假象不想被管，但实际需要正确方式引导；父母仍是监督管理者，应在保护前提下给予判断机会。",
      "atom_ids": [
        "s-b8ac34b77e63-c001:a016",
        "s-b8ac34b77e63-c001:a017",
        "s-b8ac34b77e63-c001:a018"
      ]
    },
    {
      "name": "十到18岁孩子的恐惧与自尊",
      "definition": "孩子内心充满恐惧，自尊心增强但失败容忍度降低；父母应允许示弱而非强迫坚强。",
      "atom_ids": [
        "s-b8ac34b77e63-c001:a019",
        "s-b8ac34b77e63-c001:a021",
        "s-b8ac34b77e63-c001:a022",
        "s-b8ac34b77e63-c001:a023"
      ]
    },
    {
      "name": "19到25岁孩子的独立与感激",
      "definition": "独立和感激取决于早期教育，如教育得当则独立，否则可能不感激；用“种什么收果子”比喻。",
      "atom_ids": [
        "s-b8ac34b77e63-c001:a024",
        "s-b8ac34b77e63-c001:a025",
        "s-b8ac34b77e63-c001:a026"
      ]
    }
  ],
