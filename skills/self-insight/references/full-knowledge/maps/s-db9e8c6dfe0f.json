      ]
    },
    {
      "name": "惩罚",
      "definition": "惩罚是未提前告知的、带有情绪的行为，与后果的区别在于是否事先告知和有无因果关系。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c001:a004",
