        "s-db9e8c6dfe0f-c003:a002",
        "s-db9e8c6dfe0f-c003:a004"
      ]
    },
    {
      "name": "人为后果",
      "definition": "人为后果是父母设定的规则，如要求道歉，与自然后果相对。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c001:a015",
        "s-db9e8c6dfe0f-c003:r001"
      ]
    },
    {
      "name": "补偿计划",
      "definition": "补偿计划是让对方通过补偿在事情上进步，适用于真心改变且努力进步的人，操作较麻烦。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c003:a007",
        "s-db9e8c6dfe0f-c003:a008",
        "s-db9e8c6dfe0f-c003:r003",
        "s-db9e8c6dfe0f-c003:r004"
      ]
    },
    {
      "name": "亲子关系",
      "definition": "亲子关系不是朋友关系，父母的主要责任是教养孩子，成年后才可成为朋友。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c002:a012"
      ]
    },
    {
      "name": "伤害",
      "definition": "伤害不是指孩子被管教后哭泣或害怕，而是指父母因害怕伤害关系而不履行教养责任。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c002:a013"
      ]
    },
    {
      "name": "父母角色",
      "definition": "父母不应做保姆或老板，而应在管教与爱之间平衡。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c002:a015"
      ]
    },
    {
      "name": "被动后果",
      "definition": "被动后果如不接电话，只有在非常肯定对方一定会主动联系时才有效。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c002:a009"
      ]
    },
    {
      "name": "主动后果",
      "definition": "主动后果是当被动后果不可靠时，改为自己主动施加的后果，并附加要求。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c002:a011"
      ]
    },
    {
      "name": "立界限步骤",
      "definition": "立界限的步骤是观察行为、提出明确要求、给出后果。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c001:a009",
        "s-db9e8c6dfe0f-c002:a004"
      ]
    },
    {
      "name": "大脑训练",
      "definition": "通过立界限训练孩子大脑听指令，只说一次，要求孩子抬头看着妈妈。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c001:a014",
        "s-db9e8c6dfe0f-c001:r001"
      ]
    },
    {
      "name": "沟通漏洞",
      "definition": "孩子钻漏洞时，若因沟通漏洞确实没搞清楚，不应执行后果；若漏洞明显，则仍执行。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c001:a010"
      ]
    },
    {
      "name": "年龄与漏洞",
      "definition": "年龄小的孩子立界限易有漏洞，主要是教；年龄大的孩子钻漏洞需更明确界限。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c001:a011"
      ]
    },
    {
      "name": "规矩与后果",
      "definition": "立规矩是设定行为标准，立后果是违反规矩后的惩罚，两者相辅相成。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c001:a012"
      ]
    },
    {
      "name": "钻漏洞应对",
      "definition": "应对孩子钻漏洞的方法：立刻再立界限或赋能孩子离开现场。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c001:a013"
      ]
    },
    {
      "name": "特例与普遍原则",
      "definition": "父亲因爱护母亲而打孩子是特例，普遍原则是未告知后果不能施加后果。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c002:a007"
      ]
    },
    {
      "name": "极端情况",
      "definition": "在极端情况下如孩子上瘾，父母不能民主，应坚持界限。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c003:a009",
        "s-db9e8c6dfe0f-c003:a010",
        "s-db9e8c6dfe0f-c003:r005"
      ]
    },
    {
      "name": "过程与终局",
      "definition": "父母应关注终局而非过程，过程糟糕但终局好应坚持。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c003:a011",
        "s-db9e8c6dfe0f-c003:r006"
      ]
    }
  ],
