        "s-db9e8c6dfe0f-c003:a005"
      ]
    },
    {
      "name": "恩典",
      "definition": "恩典是额外给予的、本不在界限内的东西，不是义务，需在对方知错愿改或表现好时给予。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c001:a006",
        "s-db9e8c6dfe0f-c001:a016",
        "s-db9e8c6dfe0f-c002:a016"
      ]
    },
    {
      "name": "自然后果",
      "definition": "自然后果是行为自然导致的结果，必须与行为有直接因果关系，且基于明确事实而非模糊状态。",
      "atom_ids": [
        "s-db9e8c6dfe0f-c001:a015",
        "s-db9e8c6dfe0f-c002:a017",
        "s-db9e8c6dfe0f-c002:a021",
