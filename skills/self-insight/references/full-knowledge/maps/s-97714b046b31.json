{
  "concepts": [
    {
      "name": "崩溃",
      "definition": "一种对情绪有排山倒海的无力感，从而觉得无法应对的反应，无法控制。",
      "atom_ids": [
        "s-97714b046b31-c001:a001"
      ]
    },
    {
      "name": "发脾气",
      "definition": "在某种程度上孩子能够控制的情绪反应，若未及时有效处理可能升级为崩溃。",
      "atom_ids": [
        "s-97714b046b31-c001:a002"
      ]
    },
    {
      "name": "崩溃诱因",
      "definition": "多种因素可能引发崩溃，包括疼痛、恐惧、日常生活状况变化、感官信息过载等。",
      "atom_ids": [
        "s-97714b046b31-c001:a004",
        "s-97714b046b31-c001:a005"
      ]
    },
    {
      "name": "感官超负荷",
      "definition": "当从感官中获得太多信息时，大脑过于刺激导致超负荷，可能引发战斗或逃跑反应。",
      "atom_ids": [
        "s-97714b046b31-c001:a005",
        "s-97714b046b31-c001:a006"
      ]
    },
    {
      "name": "崩溃表现形式",
      "definition": "崩溃形式多样，包括戏剧性大喊大叫和静悄悄崩溃，不能因没有吵闹就认为没有崩溃。",
      "atom_ids": [
        "s-97714b046b31-c001:a007"
      ]
    },
    {
      "name": "崩溃结束方式",
      "definition": "崩溃通常以三种方式结束：改变或减少感觉输入、给予休息空间、伤害自己。",
      "atom_ids": [
        "s-97714b046b31-c001:a009"
      ]
    },
    {
      "name": "减少感觉输入",
      "definition": "通过改变或减少感觉输入量，使大脑不再超负荷，可以慢慢终止崩溃。",
      "atom_ids": [
        "s-97714b046b31-c001:a010"
      ]
    },
    {
      "name": "休息空间",
      "definition": "给予休息的空间可以帮助崩溃的人恢复，包括睡觉、自我封闭等，帮助神经系统重置。",
      "atom_ids": [
        "s-97714b046b31-c001:a014",
        "s-97714b046b31-c001:a016"
      ]
    },
    {
      "name": "自伤",
      "definition": "极端崩溃结束方式，伤害自己，父母应保持敏感避免孩子走到这一步。",
      "atom_ids": [
        "s-97714b046b31-c001:a017"
      ]
    },
    {
      "name": "父母应对崩溃方法",
      "definition": "包括闭嘴、走开、回顾三个步骤，帮助孩子从崩溃中恢复。",
      "atom_ids": [
        "s-97714b046b31-c001:a018",
        "s-97714b046b31-c001:a020",
        "s-97714b046b31-c001:a021"
      ]
    },
    {
      "name": "咬舌头",
      "definition": "具体方法：把舌头伸出来，用牙齿咬住，在嘴巴不张开的情况下咬住舌头，强制自己不说话。",
      "atom_ids": [
        "s-97714b046b31-c001:a019"
      ]
    },
    {
      "name": "前额叶",
      "definition": "在崩溃时，孩子的前额叶试图让他停下来，但父母持续的语言刺激会不断冲击前额叶，使其无法抵挡。",
      "atom_ids": [
        "s-97714b046b31-c001:a023"
      ]
    }
  ],
