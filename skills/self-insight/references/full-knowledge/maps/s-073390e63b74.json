{
  "concepts": [
    {
      "name": "分清轻重缓急的能力",
      "definition": "按照主次区分真正需要做的事情，而不是盲目排序。缺乏会导致忙碌却无法完成真正想做的事，长期紧绷。",
      "atom_ids": [
        "s-073390e63b74-c001:a001"
      ]
    },
    {
      "name": "错误排序方式",
      "definition": "每天从所有事情中分轻重缓急，导致被临时紧急事务干扰，重要但不紧急的事只能深夜完成，长期紧绷焦虑。",
      "atom_ids": [
        "s-073390e63b74-c001:a002",
        "s-073390e63b74-c001:r001",
        "s-073390e63b74-c001:a022"
      ]
    },
    {
      "name": "正确排序方法",
      "definition": "先建立象限框架，再放入事情，而不是先有一堆事情再分类。",
      "atom_ids": [
        "s-073390e63b74-c001:a003"
      ]
    },
    {
      "name": "四象限分类",
      "definition": "第一象限紧急且重要；第二象限重要但不紧急；第三象限紧急但不重要；第四象限不重要也不紧急。",
      "atom_ids": [
        "s-073390e63b74-c001:a004"
      ]
    },
    {
      "name": "第一象限",
      "definition": "紧急且重要，如家庭突发状况、有时限的缴费、危机事件。处理过多会让人烧干，导致危机事件增加。",
      "atom_ids": [
        "s-073390e63b74-c001:a004",
        "s-073390e63b74-c001:a005",
        "s-073390e63b74-c001:r005"
      ]
    },
    {
      "name": "第二象限",
      "definition": "重要但不紧急，如建立关系、发现新机会、做计划、读书。应占60%时间，投入越多第一象限危机越少。",
      "atom_ids": [
        "s-073390e63b74-c001:a004",
        "s-073390e63b74-c001:a007",
        "s-073390e63b74-c001:a008",
        "s-073390e63b74-c001:a020"
      ]
    },
    {
      "name": "第三象限",
      "definition": "紧急但不重要，如换尿布、工作电话、买酱油。处理过多会变成讨好型人，注意力短暂，失去生活控制，关系肤浅。",
      "atom_ids": [
        "s-073390e63b74-c001:a004",
        "s-073390e63b74-c001:a005",
        "s-073390e63b74-c001:r006"
      ]
    },
    {
      "name": "第四象限",
      "definition": "不重要也不紧急，如扔垃圾、娱乐活动。过度关注会导致不负责任的生活，如啃老、沉迷游戏。",
      "atom_ids": [
        "s-073390e63b74-c001:a004",
        "s-073390e63b74-c001:a006",
        "s-073390e63b74-c001:r007"
      ]
    },
    {
      "name": "时间分配比例",
      "definition": "第二象限占60%，第一象限占15%，第三象限占剩余时间，第四象限尽量减少。",
      "atom_ids": [
        "s-073390e63b74-c001:a007"
      ]
    },
    {
      "name": "资源有限性",
      "definition": "资源是有限的，不是别人有的自己都一定要有。孩子需要明白资源有限，帮助思考资源获取。",
      "atom_ids": [
        "s-073390e63b74-c002:a001",
        "s-073390e63b74-c002:a004"
      ]
    },
    {
      "name": "情绪接纳",
      "definition": "当孩子因资源有限而难过时，父母应接纳情绪，不劝他们不要难过，因为难过是生活常态。",
      "atom_ids": [
        "s-073390e63b74-c001:a011",
        "s-073390e63b74-c002:a003"
      ]
    },
    {
      "name": "父母心态",
      "definition": "父母不应因无法给孩子提供更好的经济、学业或生活环境而内疚自责，因为资源有限。",
      "atom_ids": [
        "s-073390e63b74-c001:a012"
      ]
    },
    {
      "name": "儿童发展研究",
      "definition": "约92.8%的10岁以下孩子很难指认一个月中重要的事情；15岁以下孩子中67%到72%无法指认。",
      "atom_ids": [
        "s-073390e63b74-c001:a013",
        "s-073390e63b74-c001:r003"
      ]
    },
    {
      "name": "时间审计方法",
      "definition": "写下一天实际做的事情，与计划对比，发现计划中大部分没完成，只完成必须马上做的，反而做了很多琐碎小事。",
      "atom_ids": [
        "s-073390e63b74-c001:a016"
      ]
    },
    {
      "name": "父母榜样作用",
      "definition": "如果父母自己都不知道如何分清轻重缓急，就不可能让孩子有条理地打理生活。",
      "atom_ids": [
        "s-073390e63b74-c001:a017",
        "s-073390e63b74-c001:r004"
      ]
    },
    {
      "name": "象限重要性",
      "definition": "第二象限最重要，第一象限不是最重要的。",
      "atom_ids": [
        "s-073390e63b74-c001:a019",
        "s-073390e63b74-c001:a020"
      ]
    },
    {
      "name": "能力效果",
      "definition": "能够分清轻重缓急的人生活会放松很多，越能分清越不忙，日子越不紧迫。",
      "atom_ids": [
        "s-073390e63b74-c001:a023"
      ]
    },
    {
      "name": "效率与精力",
      "definition": "除了分清轻重缓急，工作效率高和精力充沛也是能完成很多事情的关键。",
      "atom_ids": [
        "s-073390e63b74-c001:a024",
        "s-073390e63b74-c001:r002"
      ]
    },
    {
      "name": "想要与需要",
      "definition": "想要不等于需要。需要是离开了这个事情生活会受到影响；想要是没有它生活不会受到太大影响。",
      "atom_ids": [
        "s-073390e63b74-c002:a007",
        "s-073390e63b74-c002:a014",
        "s-073390e63b74-c002:a015"
      ]
    },
    {
      "name": "需要与紧急的关联",
      "definition": "需要是紧急的，想要是不紧急的。",
      "atom_ids": [
        "s-073390e63b74-c002:a013"
      ]
    },
    {
      "name": "机会成本",
      "definition": "有所失有所得。选择意味着放弃其他可能。",
      "atom_ids": [
        "s-073390e63b74-c002:a020",
        "s-073390e63b74-c002:a022"
      ]
    },
    {
      "name": "收益与成本",
      "definition": "收益是从自己的选择中可以享受的；成本是在选择A时放弃的B、C、D等。",
      "atom_ids": [
        "s-073390e63b74-c002:a024"
      ]
    },
    {
      "name": "延迟满足",
      "definition": "训练孩子延迟满足的两个字：等和忍。延迟满足能力不足导致混乱。",
      "atom_ids": [
        "s-073390e63b74-c002:a028",
        "s-073390e63b74-c002:a029"
      ]
    },
    {
      "name": "12种能力相通",
      "definition": "12种能力不是独立的，而是相通、相辅相成的。建立一种能力后，其他事情也会通。",
      "atom_ids": [
        "s-073390e63b74-c002:a019"
      ]
    }
  ],
