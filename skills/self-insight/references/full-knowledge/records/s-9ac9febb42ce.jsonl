{"type": "concept", "subtype": "distinction", "title": "情绪廉洁影响劝导接受度", "content": "当情绪廉洁没有建立时，他人的劝导和教育会被视为阻碍，引发抵挡之心；当情绪廉洁建立后，即使是无心的话也能深刻影响孩子的思想和行为，批评也更容易被接受。", "steps": [], "conditions": [], "limits": [], "modules": ["理解情绪"], "tags": ["情绪联结", "沟通", "劝导"], "evidence": "course_claim", "risk_flags": [], "id": "s-9ac9febb42ce-c001:a003", "source_refs": [{"source_id": "s-9ac9febb42ce", "blocks": ["b00014"], "source_kind": "B"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-2", "relations": [{"target": "s-9ac9febb42ce-c001:a001", "kind": "supports", "condition": "情绪联结状态影响沟通效果", "evidence": "source_extraction", "reason": "前者说明情绪廉洁建立与否会影响劝导接受度，后者定义情绪廉洁并强调情感连接，前者具体揭示了情感连接对沟通效果的影响，支持后者关于情绪廉洁重要性的定义。", "review_status": "supported", "review_notes": ""}, {"target": "s-9ac9febb42ce-c001:a010", "kind": "association", "condition": "关系亲近程度与情绪联结的类比", "reason": "前者指出情绪廉洁影响劝导接受度，后者以关系亲近程度影响劝导接受度作类比，两者主题相似但不构成直接支持或因果，只能是类比关联。", "evidence": "knowledge_synthesis", "review_status": "revised", "review_notes": "原 supports 不准确，调整为 association。"}], "knowledge_units": ["s-9ac9febb42ce-c001:u0012"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
