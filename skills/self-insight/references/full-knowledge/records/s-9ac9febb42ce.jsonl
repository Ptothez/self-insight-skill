{"type": "concept", "subtype": "method", "title": "课程内容概述", "content": "课程将分享美国心理辅导案例，讲解孩子左右脑及每一边脑控制的情绪板块，如何通过连接右脑引导左脑工作达到左右脑平衡，建立心理抗压能力，利用两脑互补帮助学习，以及通过日常生活习惯建立情绪廉洁，并指出父母容易犯的错误和迷思，包括父母自以为做得好但专业儿童心理科学认为会对孩子造成不可逆转伤害的行为。", "steps": [], "conditions": [], "limits": [], "modules": ["理解情绪"], "tags": ["课程内容", "左右脑", "情绪联结", "父母教育"], "evidence": "course_claim", "risk_flags": [], "id": "s-9ac9febb42ce-c001:a008", "source_refs": [{"source_id": "s-9ac9febb42ce", "blocks": ["b00016"], "source_kind": "B"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-2", "relations": [], "knowledge_units": ["s-9ac9febb42ce-c001:u0013"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
