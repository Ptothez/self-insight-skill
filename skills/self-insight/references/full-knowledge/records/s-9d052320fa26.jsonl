{"type": "concept", "subtype": "distinction", "title": "引导孩子时需区分自身经历与孩子真实状况", "content": "引导孩子时，父母必须区分自己曾经走过的路与孩子当前真实走的路。不能把孩子走的路想象成自己曾经走过的路，否则引导会让孩子反感。", "steps": [], "conditions": [], "limits": [], "modules": ["界限"], "tags": ["引导原则", "区分", "真实状况", "反感"], "evidence": "course_claim", "risk_flags": [], "id": "s-9d052320fa26-c001:r001", "source_refs": [{"source_id": "s-9d052320fa26", "blocks": ["b00008"], "source_kind": "B"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [{"target": "s-9d052320fa26-c001:a002", "kind": "supports", "condition": "该区分是了解原生背景原则的具体应用", "evidence": "source_extraction"}], "knowledge_units": ["s-9d052320fa26-c001:u0009"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
