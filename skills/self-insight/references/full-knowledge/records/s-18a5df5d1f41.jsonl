{"type": "concept", "subtype": "recommendation", "title": "预防孩子上瘾的建议", "content": "如果孩子还没有上瘾，父母应赶紧预防，因为大趋势下大部分孩子会上瘾。建议去听相关课程。", "steps": [], "conditions": [], "limits": [], "modules": ["依赖与失控"], "tags": ["预防", "上瘾", "建议"], "evidence": "course_claim", "risk_flags": [], "id": "s-18a5df5d1f41-c001:a022", "source_refs": [{"source_id": "s-18a5df5d1f41", "blocks": ["b00019", "b00020"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [], "knowledge_units": ["s-18a5df5d1f41-c001:u0022"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
