{"type": "concept", "subtype": "definition", "title": "0-1.5岁核心情感需求：安全", "content": "0-1.5岁期间孩子的核心情感需求是安全。这个年龄阶段孩子的弱小无助让安全感成为他最强烈的渴望。", "steps": [], "conditions": [], "limits": [], "modules": ["阶段与角色"], "tags": ["安全", "情感需求", "婴儿期"], "evidence": "course_claim", "risk_flags": [], "id": "s-04492c118b9b-c001:a004", "source_refs": [{"source_id": "s-04492c118b9b", "blocks": ["b00003"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [{"target": "s-04492c118b9b-c001:a001", "kind": "supports", "condition": "", "evidence": "source_extraction"}, {"target": "s-04492c118b9b-c001:a007", "kind": "supports", "condition": "提供安全的家庭环境", "reason": "安全的家庭环境满足孩子的安全需求。", "evidence": "knowledge_synthesis"}, {"target": "s-04492c118b9b-c001:a010", "kind": "causes", "condition": "如果孩子没有获得安全感", "reason": "没有安全感会导致对亲密关系不感兴趣、婚姻问题、出轨。", "evidence": "knowledge_synthesis"}, {"target": "s-04492c118b9b-c001:v2-n001", "kind": "complements", "condition": "0-1.5岁", "reason": "source 强调不同年龄不同核心情感需求；candidate 明确0-1.5岁核心需求是安全，补足了具体年龄的情感需求。", "evidence": "source_atom_relationship_review"}, {"target": "legacy:nl-c-13", "kind": "equivalent", "condition": "共同适用：0-1.5岁核心情感需求；旧库同时列出阶段任务为信任，新库仅提需求安全。", "reason": "两者均认为0-1.5岁核心情感需求是安全。", "evidence": "cross_library_review"}, {"target": "legacy:nl-c-14", "kind": "complements", "condition": "均适用于年龄阶段与核心需求的话题；候选提供0-1.5岁具体例子。", "reason": "候选给出具体年龄段核心需求的例证，补充旧原子的一般原则。", "evidence": "cross_library_review"}], "knowledge_units": ["s-04492c118b9b-c001:u0005"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
