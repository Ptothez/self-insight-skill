{"type": "concept", "subtype": "method", "title": "正确的和好方式：先恢复关系再解决问题", "content": "正确的和好方式第一步是恢复关系，然后再解决问题。和好的第一步绝对不是解决问题。", "steps": [], "conditions": [], "limits": [], "modules": ["界限"], "tags": ["和好步骤", "恢复关系", "解决问题"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a018", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00025", "b00026"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [{"target": "s-54e16185d7df-c001:a019", "kind": "step_of", "condition": "恢复关系", "reason": "撒娇是恢复关系的一种方法，属于正确和好方式的第一步。", "evidence": "knowledge_synthesis"}, {"target": "s-54e16185d7df-c001:a020", "kind": "step_of", "condition": "恢复关系", "reason": "谈感受是恢复关系的一种方法。", "evidence": "knowledge_synthesis"}, {"target": "s-54e16185d7df-c001:a021", "kind": "step_of", "condition": "解决问题", "reason": "谈为什么生气属于解决问题阶段，在恢复关系之后。", "evidence": "knowledge_synthesis"}, {"target": "s-54e16185d7df-c001:a022", "kind": "step_of", "condition": "解决问题", "reason": "分析吵架中发生了什么属于解决问题阶段。", "evidence": "knowledge_synthesis"}], "knowledge_units": ["s-54e16185d7df-c001:u018"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
