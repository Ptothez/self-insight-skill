{"type": "concept", "subtype": "definition", "title": "课程目标：赋能孩子达到不抓狂状态", "content": "课程强调，要培养不抓狂的孩子，父母需要赋能给孩子，帮助孩子自己达到不抓狂的状态，而不是替孩子达到不抓狂的状态。", "steps": [], "conditions": [], "limits": [], "modules": ["理解情绪"], "tags": ["赋能", "不抓狂", "育儿目标"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a001", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00003"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [], "knowledge_units": ["s-54e16185d7df-c001:u001"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "mechanism", "title": "婴幼儿情绪发展：0-2岁基础情绪学习", "content": "孩子从出生到两岁左右，是大量积累和学习有关情绪的事情的时期。在这个阶段，孩子的情绪非常简单粗暴，主要是第一情绪，如咯咯笑、哇哇哭、啊啊生气。他们主要从父母或养育者那里学习情绪。", "steps": [], "conditions": [], "limits": [], "modules": ["理解情绪"], "tags": ["情绪发展", "婴幼儿", "基础情绪"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a002", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00004"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [{"target": "s-54e16185d7df-c001:a004", "kind": "prerequisite", "condition": "年龄阶段递进", "reason": "0-2岁是基础情绪学习，2-4岁延伸出社交情绪，后者建立在前者基础上。", "evidence": "knowledge_synthesis"}], "knowledge_units": ["s-54e16185d7df-c001:u002"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "mechanism", "title": "养育者表情对婴幼儿情绪理解的影响", "content": "如果孩子平时看到的是面无表情或严肃的养育者（如孤儿院中照顾者面无表情），孩子对情绪的理解会非常片面，并更容易出现焦虑情绪。如果父母与孩子互动活泼，孩子学到的情绪会更全面、广泛。", "steps": [], "conditions": [], "limits": [], "modules": ["理解情绪"], "tags": ["养育者表情", "情绪理解", "焦虑"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a003", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00005"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [{"target": "s-54e16185d7df-c001:a002", "kind": "applies_to", "condition": "养育者表情影响情绪学习", "reason": "养育者表情是0-2岁孩子学习情绪的重要来源，影响情绪理解。", "evidence": "knowledge_synthesis"}], "knowledge_units": ["s-54e16185d7df-c001:u003"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "mechanism", "title": "2-4岁社交情绪发展", "content": "孩子在两到四岁之间开始延伸出社交情绪，如恐惧、害羞、因输而产生的愤怒等。这些情绪是孩子与他人和外界建立联系后延伸出来的。随着孩子成熟和家庭成员交往方式不同，孩子的情绪发展出不同特点。", "steps": [], "conditions": [], "limits": [], "modules": ["理解情绪"], "tags": ["社交情绪", "情绪发展", "2-4岁"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a004", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00006", "b00007"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [], "knowledge_units": ["s-54e16185d7df-c001:u004"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "mechanism", "title": "0-2岁情绪学习无反馈", "content": "0-2岁是孩子大量学习情绪的时期，但孩子学习后不会反馈给父母，父母无法知道教的内容是对是错。很多父母误以为婴儿都一样就不用互动或陪伴，把孩子扔在一边玩，但0-2岁恰恰是大量学习的时候。因此，父母越早学习育儿（如备孕时开始）越正确明智。", "steps": [], "conditions": [], "limits": [], "modules": ["理解情绪"], "tags": ["情绪学习", "无反馈", "早期育儿"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a005", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00008"], "source_kind": "A1"}, {"source_id": "s-54e16185d7df", "blocks": ["b00007", "b00008"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-2", "relations": [], "knowledge_units": ["s-54e16185d7df-c001:u005"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "mechanism", "title": "夫妻界限影响孩子情绪安全感", "content": "夫妻关系会影响孩子跟别人打交道的情绪。夫妻之间有没有界限会影响孩子情绪里的安全感、以后跟人的亲密度以及对情感的兴趣度。当今社交恐惧症增多，年轻人对谈恋爱不感兴趣，更愿意打游戏、一个人生活，对情感没兴趣也没耐性。", "steps": [], "conditions": [], "limits": [], "modules": ["界限"], "tags": ["夫妻界限", "安全感", "亲密度", "情感兴趣"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a006", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00009"], "source_kind": "A1"}, {"source_id": "s-54e16185d7df", "blocks": ["b00008", "b00009"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-2", "relations": [{"target": "s-54e16185d7df-c001:a007", "kind": "supports", "condition": "当夫妻界限影响情感兴趣度时", "reason": "“夫妻界限影响孩子情绪安全感”提出夫妻界限会影响孩子对情感的兴趣度，使年轻人更愿打游戏、对情感没兴趣；“父母婚姻不幸福与孩子上瘾行为关联”观察到父母婚姻不幸福与上瘾及对恋爱无兴趣相关，前者为后者提供解释性支持。", "evidence": "knowledge_synthesis", "review_status": "supported", "review_notes": ""}, {"target": "legacy:qx-r-07", "kind": "complements", "condition": "共同适用条件：夫妻界限影响孩子与人打交道情绪、安全感及亲密兴趣；区别：候选仅强调界限因素，未涵盖沟通、共同决定等，但结果描述与旧原子一致。", "reason": "补充界限这一因素的具体影响。", "evidence": "cross_library_review"}], "knowledge_units": ["s-54e16185d7df-c001:u006"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "mechanism", "title": "父母婚姻不幸福与孩子上瘾行为关联", "content": "讲师观察到，很多沉迷于游戏、色情、毒品等上瘾行为的人，追溯到其父母的婚姻往往不幸福。很少看到父母健康恩爱的孩子对谈恋爱不感兴趣。年轻人不谈恋爱不是因为生活压力大——从经济层面看两人一起生活成本更低——更深的原因是对人际关系提不起兴趣。", "steps": [], "conditions": [], "limits": [], "modules": ["界限"], "tags": ["上瘾行为", "父母婚姻", "情感兴趣"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a007", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00010", "b00011"], "source_kind": "A1"}, {"source_id": "s-54e16185d7df", "blocks": ["b00010", "b00011"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-2", "relations": [], "knowledge_units": ["s-54e16185d7df-c001:u007"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "mechanism", "title": "夫妻冲突对儿童情绪和行为的负面影响机制", "content": "夫妻冲突对儿童的情绪、行为和学业完成有负面影响，通过多种直接或间接机制发生，例如羞耻和恐惧的内化（孩子将羞耻藏到内部，转变成自己的内在声音），或孩子模仿在家看到的倾向。", "steps": [], "conditions": [], "limits": [], "modules": ["界限"], "tags": ["夫妻冲突", "内化", "模仿", "负面影响"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a008", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00012"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [{"target": "s-54e16185d7df-c001:a009", "kind": "example_of", "condition": "模仿机制", "reason": "家暴家庭孩子模仿暴力行为是夫妻冲突负面影响中模仿机制的具体例子。", "evidence": "knowledge_synthesis"}], "knowledge_units": ["s-54e16185d7df-c001:u008"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "mechanism", "title": "家暴家庭孩子模仿暴力行为", "content": "在家暴家庭中，孩子可能出现打同学、伤害路边野猫野狗等暴力行为，这是模仿在家看到的倾向。", "steps": [], "conditions": [], "limits": [], "modules": ["界限"], "tags": ["家暴", "模仿", "暴力行为"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a009", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00012", "b00013"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [], "knowledge_units": ["s-54e16185d7df-c001:u009"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "distinction", "title": "错误的吵架方式", "content": "错误的吵架方式包括：拿刀砍等暴力行为；语言侮辱（如攻击对方软肋）；冷暴力（不理对方）；讽刺（sarcastic）。这些方式会让孩子感受到人与人之间刺透人心的伤害，因为父母是孩子最爱的两个人，当父母互相伤害时，孩子内心会产生恐惧和焦虑。", "steps": [], "conditions": [], "limits": [], "modules": ["界限"], "tags": ["错误吵架", "暴力", "语言侮辱", "冷暴力", "讽刺"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a010", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00013", "b00014", "b00015", "b00016"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [{"target": "s-54e16185d7df-c001:a011", "kind": "example_of", "condition": "语言侮辱", "reason": "丈夫对孤儿妻子的语言侮辱是错误吵架方式中语言侮辱的案例。", "evidence": "knowledge_synthesis"}, {"target": "s-54e16185d7df-c001:a012", "kind": "contrasts", "condition": "吵架方式", "reason": "“错误的吵架方式”列举暴力、侮辱、冷暴力、讽刺等方式，“正确的吵架方式”列举提高音量、生气、指责行为等方式，两者形成对比。", "evidence": "knowledge_synthesis", "review_status": "supported", "review_notes": ""}], "knowledge_units": ["s-54e16185d7df-c001:u010"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "case", "subtype": "case", "title": "案例：丈夫语言侮辱孤儿妻子", "content": "一对夫妻，妻子是孤儿，丈夫在吵架时对她说：“你是一个没有人要的人，怪不得你爸妈要抛弃你。”这是语言侮辱的错误吵架方式。", "steps": [], "conditions": [], "limits": [], "modules": ["界限"], "tags": ["语言侮辱", "孤儿", "案例"], "evidence": "reported_case", "risk_flags": [], "id": "s-54e16185d7df-c001:a011", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00014"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [], "knowledge_units": ["s-54e16185d7df-c001:u011"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "method", "title": "正确的吵架方式", "content": "正确的吵架方式包括：可以提高音量；可以生气；可以指责行为（而非人格），例如说“我哭泣，我的感受指责你的行为”；可以哭；可以走开；可以拒绝继续对话（如说“我现在没有办法跟你讲话”）。", "steps": [], "conditions": [], "limits": [], "modules": ["界限"], "tags": ["正确吵架", "表达情绪", "指责行为"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a012", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00016", "b00017"], "source_kind": "A1"}, {"source_id": "s-54e16185d7df", "blocks": ["b00016", "b00017"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-2", "relations": [], "knowledge_units": ["s-54e16185d7df-c001:u012"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "mechanism", "title": "夫妻和好对孩子的重要性", "content": "夫妻吵架后一定要在孩子面前和好。如果孩子知道父母吵架但从未见证过父母和好，孩子以后与人发生矛盾时容易崩溃，因为不知道接下来该怎么办，脑子里没有和好的模型。很多客人不知道怎么撒娇，是因为脑子里从来没有妈妈对爸爸撒娇的记忆和模式。", "steps": [], "conditions": [], "limits": [], "modules": ["界限"], "tags": ["夫妻和好", "孩子情绪", "和好模型"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a013", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00018", "b00019"], "source_kind": "A1"}, {"source_id": "s-54e16185d7df", "blocks": ["b00018", "b00019"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-2", "relations": [{"target": "s-54e16185d7df-c001:a014", "kind": "supports", "condition": "当孩子见证父母和好并建立和好模型时", "reason": "“夫妻和好对孩子的重要性”指出孩子见证父母和好才拥有和好模型；“知道如何和好的孩子更少极端行为”承接该模型，说明知道和好可减少崩溃和极端行为，故前者支持后者。", "evidence": "knowledge_synthesis", "review_status": "revised", "review_notes": "原causes按允许类型调整为supports；方向与含义仍成立。"}, {"target": "legacy:qx-r-07", "kind": "complements", "condition": "共同适用条件：夫妻和好对孩子的重要性；区别：候选解释孩子没见证和好会缺少和好模型，导致未来冲突崩溃，旧原子只要求和好。", "reason": "补充和好作为示范的关键作用。", "evidence": "cross_library_review"}], "knowledge_units": ["s-54e16185d7df-c001:u013"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "mechanism", "title": "知道如何和好的孩子更少极端行为", "content": "知道如何与别人和好的孩子，在与人闹矛盾后（如与伴侣分手后）崩溃的几率更少，因为心里有底，知道如何和好。同时，出现伤害他人或伤害自己等极端情绪和行为的几率也更小。", "steps": [], "conditions": [], "limits": [], "modules": ["界限"], "tags": ["和好能力", "极端行为", "情绪调节"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a014", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00020"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [], "knowledge_units": ["s-54e16185d7df-c001:u014"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "case", "subtype": "case", "title": "案例：未婚夫自残削肉", "content": "一位男性客人与未婚妻吵架后，觉得被逼到不行，拿起削水果的刀在自己手上削掉了一块肉。他不知道如何处理矛盾，不知道如何和好，觉得未婚妻要离开他，着急之下自残。他的家庭是传统有信仰的家庭，父母婚姻支离破碎但坚决不离婚，在所有人面前表现高高兴兴，积怨很深但表面维系很好，父母从不在孩子面前吵架，也从不在孩子面前和好。", "steps": [], "conditions": [], "limits": [], "modules": ["界限"], "tags": ["自残", "和好缺失", "父母婚姻", "案例"], "evidence": "reported_case", "risk_flags": ["自残行为描述，需谨慎对待，不可模仿"], "id": "s-54e16185d7df-c001:a015", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00020", "b00021", "b00022"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [{"target": "s-54e16185d7df-c001:a013", "kind": "example_of", "condition": "缺乏和好模型", "reason": "“案例：未婚夫自残削肉”中当事人父母从不在孩子面前吵架和好，导致没有和好模型；“夫妻和好对孩子的重要性”强调见证和好才能建立模型，该案例作为其具体例证。", "evidence": "knowledge_synthesis", "review_status": "supported", "review_notes": ""}], "knowledge_units": ["s-54e16185d7df-c001:u015"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "distinction", "title": "错误的和好方式", "content": "错误的和好方式包括：找个别的话题（如问“今天晚上吃什么”）来转移；大家都装没发生过，过一两天后若无其事地说别的；开玩笑把事平了（如“你还在生气啊”）。这些方式没有真正解决问题。", "steps": [], "conditions": [], "limits": [], "modules": ["界限"], "tags": ["错误和好", "转移话题", "假装没发生", "开玩笑"], "evidence": "course_claim", "risk_flags": [], "id": "s-54e16185d7df-c001:a016", "source_refs": [{"source_id": "s-54e16185d7df", "blocks": ["b00023", "b00024"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [{"target": "s-54e16185d7df-c001:a017", "kind": "example_of", "condition": "开玩笑和好", "reason": "三姨父开玩笑和好是错误和好方式中开玩笑平事的案例。", "evidence": "knowledge_synthesis"}, {"target": "s-54e16185d7df-c001:a018", "kind": "contrasts", "condition": "和好方式", "reason": "错误和好方式与正确和好方式形成对比。", "evidence": "knowledge_synthesis"}], "knowledge_units": ["s-54e16185d7df-c001:u016"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
