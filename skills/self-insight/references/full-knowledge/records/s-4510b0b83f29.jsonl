{"type": "concept", "subtype": "definition", "title": "左脑的功能", "content": "左脑负责逻辑事实、数学现象、思考时间、准确语言和次序。", "steps": [], "conditions": [], "limits": [], "modules": ["理解情绪"], "tags": ["左脑", "大脑功能"], "evidence": "course_claim", "risk_flags": [], "id": "s-4510b0b83f29-c001:a001", "source_refs": [{"source_id": "s-4510b0b83f29", "blocks": ["b00006"], "source_kind": "B"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [{"target": "s-4510b0b83f29-c001:a007", "kind": "applies_to", "condition": "左脑对事实概念尚未建立", "reason": "左脑负责逻辑事实，孩子左脑发育不成熟导致对事实概念缺失，出现类似撒谎的行为。", "evidence": "knowledge_synthesis"}, {"target": "legacy:zz-c-15", "kind": "equivalent", "condition": "均涉及左脑功能；legacy 列出逻辑、语言、时间、次序，candidate 同样。", "reason": "左脑功能列表一致。", "evidence": "cross_library_review"}], "knowledge_units": ["s-4510b0b83f29-c001:u0001"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "mechanism", "title": "左脑发育的时间特点", "content": "如果父母没有有意识地刻意引导孩子的左右脑连结，孩子的左脑在七岁之前发育非常缓慢，与右脑发育速度完全不成正比。", "steps": [], "conditions": ["父母未刻意引导左右脑连结"], "limits": [], "modules": ["阶段与角色"], "tags": ["左脑发育", "左右脑连结", "父母引导"], "evidence": "course_claim", "risk_flags": [], "id": "s-4510b0b83f29-c001:a002", "source_refs": [{"source_id": "s-4510b0b83f29", "blocks": ["b00006"], "source_kind": "B"}, {"source_id": "s-4510b0b83f29", "blocks": ["b00006"], "source_kind": "B"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "alternate_titles": ["左脑发育与左右脑连结引导的关系"], "relations": [{"target": "s-4510b0b83f29-c001:a003", "kind": "prerequisite", "condition": "父母未刻意引导左右脑连结", "reason": "左脑在七岁前发育缓慢，七岁后开始飞速发展，因此七岁前发育缓慢是七岁后加速的前提。", "evidence": "knowledge_synthesis"}], "knowledge_units": ["s-4510b0b83f29-c001:u0002"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded"}
{"type": "concept", "subtype": "mechanism", "title": "七岁后左脑发育加速", "content": "左脑在孩子七岁过后开始飞速发展，但在七岁以前发育非常缓慢。", "steps": [], "conditions": [], "limits": [], "modules": ["阶段与角色"], "tags": ["左脑发育", "年龄阶段"], "evidence": "course_claim", "risk_flags": [], "id": "s-4510b0b83f29-c001:a003", "source_refs": [{"source_id": "s-4510b0b83f29", "blocks": ["b00008"], "source_kind": "B"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [], "knowledge_units": ["s-4510b0b83f29-c001:u0003"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "mechanism", "title": "七岁后孩子仍偏向使用右脑", "content": "孩子七岁后左脑开始发育，但不会自动平衡使用左右脑。因为在人生最初七年中绝大部分时间都在用右脑，左脑发育时右脑也在继续发育，所以孩子最熟悉和最擅长的仍然是使用右脑（原文相关分句为“左脑”，结合上下文疑为口误，仍按右脑记录）。", "steps": [], "conditions": [], "limits": [], "modules": ["阶段与角色"], "tags": ["左右脑使用偏好", "右脑主导"], "evidence": "course_claim", "risk_flags": [], "id": "s-4510b0b83f29-c001:a004", "source_refs": [{"source_id": "s-4510b0b83f29", "blocks": ["b00008"], "source_kind": "B"}, {"source_id": "s-4510b0b83f29", "blocks": ["b00008"], "source_kind": "B"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-2", "relations": [{"target": "s-4510b0b83f29-c001:a005", "kind": "supports", "condition": "七岁后仍偏向使用右脑会导致情绪化冲动", "reason": "“七岁后孩子仍偏向使用右脑”指出孩子最熟悉和擅长右脑，“七岁后孩子情绪化冲动的脑机制”将此作为情绪化、冲动的原因；前者为后者提供机制解释。", "evidence": "knowledge_synthesis", "review_status": "supported", "review_notes": ""}], "knowledge_units": ["s-4510b0b83f29-c001:u0004"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
{"type": "concept", "subtype": "mechanism", "title": "七岁后孩子情绪化冲动的脑机制", "content": "七岁后的孩子很多时候仍然非常极端、情绪化、冲动，是因为他们最熟悉和擅长的还是使用右脑，而非左脑（原文“所以当然孩子最熟悉的和最擅长的还是使用他们的左脑”疑为口误，按上下文保留右脑）。", "steps": [], "conditions": [], "limits": [], "modules": ["理解情绪"], "tags": ["情绪化", "冲动", "右脑主导"], "evidence": "course_claim", "risk_flags": [], "id": "s-4510b0b83f29-c001:a005", "source_refs": [{"source_id": "s-4510b0b83f29", "blocks": ["b00008"], "source_kind": "B"}, {"source_id": "s-4510b0b83f29", "blocks": ["b00008"], "source_kind": "B"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-2", "relations": [], "knowledge_units": ["s-4510b0b83f29-c001:u0005"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
