{"type": "concept", "subtype": "mechanism", "title": "缺乏健康养育环境导致荷尔蒙紊乱", "content": "孩子早期大脑发育最快，激素水平变化对大脑结构和功能及其他器官产生巨大影响，导致终身身心健康问题。缺乏健康养育环境时，孩子荷尔蒙会紊乱。", "steps": [], "conditions": [], "limits": [], "modules": ["阶段与角色"], "tags": ["荷尔蒙", "养育环境"], "evidence": "course_claim", "risk_flags": [], "id": "s-3dc91c6aa94d-c001:a023", "source_refs": [{"source_id": "s-3dc91c6aa94d", "blocks": ["b00036", "b00037"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [{"target": "s-3dc91c6aa94d-c001:a024", "kind": "supports", "condition": "缺乏健康养育环境", "reason": "缺乏健康养育环境导致荷尔蒙紊乱和免疫系统削弱。", "evidence": "knowledge_synthesis"}], "knowledge_units": ["s-3dc91c6aa94d-c001:u025"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
