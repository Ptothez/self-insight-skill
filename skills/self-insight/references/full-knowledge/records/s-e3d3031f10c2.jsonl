{"type": "concept", "subtype": "method", "title": "用专业老师背景说服家人", "content": "如果家人觉得学习者不专业，可以让他们听专业老师的课。介绍老师在美国学了十多年、做了十多年，见过无数案例，被多所高校邀请讲心理学，是学儿童心理学的专业老师。", "steps": ["向家人介绍专业老师的背景", "让家人听专业老师的课", "用专业老师的方法来育儿"], "conditions": ["适用于家人质疑学习者专业性的情况"], "limits": [], "modules": ["界限"], "tags": ["专业权威", "说服"], "evidence": "course_claim", "risk_flags": ["涉及讲师个人宣传，需核验资质"], "id": "s-e3d3031f10c2-c001:r001", "source_refs": [{"source_id": "s-e3d3031f10c2", "blocks": ["b00017", "b00018"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [{"target": "s-e3d3031f10c2-c001:a008", "kind": "supports", "condition": "全家一起学习的补充方法", "evidence": "source_extraction"}], "retrieval_scope": "context", "knowledge_layer": "expanded", "knowledge_units": [], "alternate_titles": []}
