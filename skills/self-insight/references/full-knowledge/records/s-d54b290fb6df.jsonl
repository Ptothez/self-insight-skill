{"type": "concept", "subtype": "principle", "title": "引导前需先理解孩子行为背后的原因", "content": "在引导孩子之前，必须先搞清楚孩子行为背后的“为什么”。如果这个问题没有搞清楚，引导可能没有任何意义，也不会对孩子的行为产生真正的影响。", "steps": [], "conditions": [], "limits": [], "modules": ["理解情绪"], "tags": ["引导原则", "行为原因"], "evidence": "course_claim", "risk_flags": [], "id": "s-d54b290fb6df-c001:a001", "source_refs": [{"source_id": "s-d54b290fb6df", "blocks": ["b00006"], "source_kind": "B"}, {"source_id": "s-d54b290fb6df", "blocks": ["b00006"], "source_kind": "B"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [], "knowledge_units": ["s-d54b290fb6df-c001:u001"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
