{"type": "case", "subtype": "case", "title": "讲师自己孩子语言能力超常的案例", "content": "讲师母亲曾建议带孩子要像疯子一样。讲师自己带老大时，在孩子不会讲话时持续与他讲话，现在老大五岁半，语言能力超然，会讲三种不同语言，词汇丰富。讲师认为这与当时持续讲话有很大关系。", "steps": [], "conditions": [], "limits": [], "modules": ["阶段与角色"], "tags": ["案例", "语言能力", "持续讲话"], "evidence": "reported_case", "risk_flags": [], "id": "s-e20c762aae0b-c001:a011", "source_refs": [{"source_id": "s-e20c762aae0b", "blocks": ["b00009"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [{"target": "s-e20c762aae0b-c001:a007", "kind": "example_of", "condition": "讲师自己实践持续讲话", "evidence": "source_extraction"}, {"target": "s-e20c762aae0b-c001:a007", "kind": "example_of", "condition": "讲师持续与孩子讲话的案例", "reason": "a011是讲师持续与孩子讲话导致孩子语言能力超常的案例，是a007持续讲话做法的实例", "evidence": "knowledge_synthesis"}], "knowledge_units": ["s-e20c762aae0b-c001:u011"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
