{"type": "case", "subtype": "case", "title": "通过放松提升观察力的实践", "content": "讲师在需要观察卡住的事情时，会让自己处于非常放松的状态。发现点香薰蜡烛可以帮助放松，之后观察变得敏锐，思维和注意力集中。这个方法是从两岁多快三岁的孩子身上学到的。", "steps": [], "conditions": [], "limits": [], "modules": ["专注力"], "tags": ["放松", "观察力", "香薰蜡烛"], "evidence": "reported_case", "risk_flags": [], "id": "s-0be9fd6dd863-c001:a023", "source_refs": [{"source_id": "s-0be9fd6dd863", "blocks": ["b00018", "b00019"], "source_kind": "A1"}], "review_status": "point_source_reviewed", "version": "2026-11-05.full-1", "relations": [{"target": "s-0be9fd6dd863-c001:a024", "kind": "example_of", "condition": "公司棘手事情", "reason": "a023 提到讲师在需要观察时使用香薰蜡烛，a024 具体说明在公司棘手事情时使用该方法。", "evidence": "knowledge_synthesis"}], "knowledge_units": ["s-0be9fd6dd863-c001:u23"], "retrieval_scope": "knowledge", "knowledge_layer": "expanded", "alternate_titles": []}
